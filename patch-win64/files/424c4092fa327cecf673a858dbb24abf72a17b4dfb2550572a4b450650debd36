"""Threads 帳號連結 API（P26）。

真正的登入態在 FB_Auto 的 threads_profile 目錄（Playwright persistent
context），DB 的 threads_accounts 只是 UI 快取。連結流程與 FB first-login
同構：spawn 開視窗的 CLI ＋ 前端輪詢；全域瀏覽器鎖沿用 fbauto_bridge。
"""
import datetime
import shutil

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select

from .. import platform_block
from ..database import get_session, ThreadsAccount

router = APIRouter(prefix="/api/threads", tags=["threads"], redirect_slashes=False)

_MODULE = "src.run_threads_post"


def _profile_dir():
    from ..fbauto_bridge import FB_AUTO_DATA_DIR
    return FB_AUTO_DATA_DIR / "threads_profile"


def _iso_utc(dt: datetime.datetime | None) -> str | None:
    """DB 存 naive UTC；補上時區再給前端，new Date() 才不會偏 8 小時。"""
    if dt is None:
        return None
    return dt.replace(tzinfo=datetime.timezone.utc).isoformat()


def _status_payload(row: ThreadsAccount | None) -> dict:
    if row is None:
        return {"linked": False, "username": "", "status": "",
                "bound_at": None, "last_ok_at": None,
                "ig_username": "", "ig_status": "", "ig_last_ok_at": None,
                "threads_blocked_until": None, "threads_block_note": "",
                "ig_blocked_until": None, "ig_block_note": ""}
    return {
        "linked": True,
        "username": row.username,
        "status": row.status,
        "bound_at": _iso_utc(row.bound_at),
        "last_ok_at": _iso_utc(row.last_ok_at),
        # IG 與 Threads 共用同一份登入 profile，狀態各記各的（P27）
        "ig_username": row.ig_username or "",
        "ig_status": row.ig_status or "",
        "ig_last_ok_at": _iso_utc(row.ig_last_ok_at),
        # P28 平台級暫停：被限制動作時停手，時間到自動恢復
        "threads_blocked_until": _iso_utc(row.threads_blocked_until),
        "threads_block_note": platform_block.block_note(row, "threads"),
        "ig_blocked_until": _iso_utc(row.ig_blocked_until),
        "ig_block_note": platform_block.block_note(row, "ig"),
    }


async def _get_row(session: AsyncSession) -> ThreadsAccount | None:
    return (await session.execute(
        select(ThreadsAccount).order_by(ThreadsAccount.id))).scalars().first()


@router.get("/status")
async def threads_status(session: AsyncSession = Depends(get_session)):
    """DB 快取值，不開瀏覽器；要實測登入態用 POST /check。"""
    return _status_payload(await _get_row(session))


def _spawn(op: str, cli_args: list[str]) -> dict:
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，先等它跑完再操作 Threads。")
    job_id = start_long_op(op, _MODULE, cli_args)
    return {"job_id": job_id, "state": "pending"}


@router.post("/login")
async def threads_login():
    """開視窗讓使用者手動登入 Threads（不代登、不碰密碼）。回 job_id 輪詢。"""
    return _spawn("threads_login", ["--login"])


@router.post("/check")
async def threads_check():
    """headless 實測登入態並回寫 DB。回 job_id 輪詢。"""
    return _spawn("threads_check", ["--check", "--headless"])


@router.post("/open")
async def threads_open():
    """用存好的登入態開一個有視窗的 Threads 給人用（看通知、處理驗證）。
    最多 30 分鐘自動關；開著期間排程的 Threads/IG 發文會被擋（profile 被占用），
    所以 UI 要講清楚。回 job_id 可輪詢（視窗關閉時結束）。"""
    return _spawn("threads_open", ["--open", "--open-minutes", "30"])


@router.post("/open-ig")
async def ig_open():
    """同上，開 Instagram。"""
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，先等它跑完再開 IG。")
    job_id = start_long_op("ig_open", "src.run_ig_post", ["--open", "--open-minutes", "30"])
    return {"job_id": job_id, "state": "pending"}


@router.post("/check-ig")
async def ig_check():
    """headless 實測 IG 登入態（同一份 profile）。回 job_id 輪詢同一個 jobs 端點。"""
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，先等它跑完再操作 IG。")
    job_id = start_long_op("ig_check", "src.run_ig_post", ["--check", "--headless"])
    return {"job_id": job_id, "state": "pending"}


@router.get("/jobs/{job_id}")
async def threads_job(job_id: str, session: AsyncSession = Depends(get_session)):
    """login/check 共用的輪詢端點：成功時就地 upsert threads_accounts。"""
    from ..fbauto_bridge import get_long_op, poll_long_op
    job = get_long_op(job_id)
    op = job.op if job else None
    poll = poll_long_op(job_id)
    state = poll["state"]
    if state in ("none", "pending"):
        return {"state": state, "elapsed_sec": poll.get("elapsed_sec", 0)}

    result = poll["result"]
    data = result.data or {}
    logged_in = bool(data.get("logged_in"))
    username = data.get("username") or ""
    now = datetime.datetime.utcnow()

    row = await _get_row(session)
    if op == "ig_check":
        # IG 分流：只動 ig_* 欄位（同一份登入 profile，狀態各記各的）
        if logged_in:
            if row is None:
                row = ThreadsAccount(bound_at=now)
                session.add(row)
            if username:
                row.ig_username = username
            row.ig_status = "active"
            row.ig_last_ok_at = now
            await session.commit()
            await session.refresh(row)
        elif result.success and row is not None:
            row.ig_status = "expired"
            await session.commit()
            await session.refresh(row)
    elif logged_in:
        # 登入有效：沒有列就補一列（mini 這種「profile 已有登入態、DB 還沒
        # 記錄」的情況，第一次檢查就自動補上）
        if row is None:
            row = ThreadsAccount(bound_at=now)
            session.add(row)
        elif op == "threads_login" and not row.bound_at:
            row.bound_at = now
        if username:
            row.username = username
        row.status = "active"
        row.last_ok_at = now
        await session.commit()
        await session.refresh(row)
    elif result.success and op == "threads_check" and row is not None:
        # check 正常跑完但未登入 → 登入態失效
        row.status = "expired"
        await session.commit()
        await session.refresh(row)

    return {
        "state": state,
        "op": op,
        "logged_in": logged_in,
        "error": result.error,
        "elapsed_sec": poll.get("elapsed_sec", 0),
        **_status_payload(row),
    }


@router.post("/retry/{platform}")
async def clear_platform_block(platform: str, session: AsyncSession = Depends(get_session)):
    """手動清掉某平台的暫停（風險自負）——比照養號期的「強制解除」。

    留這顆按鈕的理由：偶爾會誤判，或客戶自己去平台上處理完了，
    不該逼他等滿 24 小時。"""
    if platform not in platform_block.VALID_PLATFORMS:
        raise HTTPException(status_code=422, detail="平台只收 threads / ig")
    row = await _get_row(session)
    if row is None:
        raise HTTPException(status_code=404, detail="尚未連結")
    platform_block.clear_block(row, platform)
    await session.commit()
    await session.refresh(row)
    print(f"[threads] 手動解除 {platform} 暫停", flush=True)
    return _status_payload(row)


@router.delete("/unlink")
async def threads_unlink(session: AsyncSession = Depends(get_session)):
    """登出語意：刪 DB 快取＋刪本機登入 profile。Threads 上的貼文不受影響。"""
    from ..fbauto_bridge import browser_busy_reason
    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，先等它跑完再解除連結。")
    row = await _get_row(session)
    if row is not None:
        await session.delete(row)
        await session.commit()
    shutil.rmtree(_profile_dir(), ignore_errors=True)
    return _status_payload(None)     # 欄位形狀跟 /status 一致，前端不必分兩套
