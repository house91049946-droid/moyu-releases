# 「東區」「北區」這種多個縣市都有的區名，單獨出現時不猜縣市
_AMBIGUOUS = {"東區", "北區", "西區", "南區", "中區", "中正", "大安區", "信義", "中山", "安平"}

# 先判斷「是不是房地產社團」。實測正式機 697 個社團有 420 個是魚缸、多肉、養殖這種
# 興趣社團——往那裡發物件就是垃圾訊息，被檢舉的機率比發到對的社團高得多。
# 名字裡沒有任何房地產線索的，一律標「非房產」，讓使用者一鍵排除。
RE_MARKERS = ("房", "屋", "宅", "不動產", "地產", "店面", "透天", "大樓", "公寓", "套房", "雅房",
              "建案", "土地", "農地", "建地", "廠房", "別墅", "華廈", "社區", "房東", "仲介",
              "預售", "新成屋", "中古", "買房", "賣房", "租屋", "建商", "厝", "物件", "格局", "坪")

ALL_TAGS = ("非房產",) + tuple(TAG_RULES.keys()) + ("其他",)


def _norm(name: str) -> str:
    return re.sub(r"\s+", "", (name or "")).replace("臺", "台")


def classify_name(name: str) -> dict:
    """{'tags': [...], 'region': '台中'}。認不出類別就 tags=['其他']；認不出區域就 ''。"""
    n = _norm(name)
    if not any(m in n for m in RE_MARKERS):
        # 「二手魚缸買賣」也有「買賣」兩個字——沒有房地產線索就不套類別規則，直接非房產
        return {"tags": ["非房產"], "region": _region_of(n)}
    tags = [tag for tag, kws in TAG_RULES.items() if any(k in n for k in kws)]
    return {"tags": tags or ["其他"], "region": _region_of(n)}


def _region_of(n: str) -> str:
    region = ""
    # 先找縣市本名（最可靠），再找行政區
    for city, kws in REGIONS.items():
        if kws[0] in n or (len(kws) > 1 and kws[1] in n and kws[1].startswith(("臺", "台", "北市", "中市", "南市"))):
            region = city
            break
    if not region:
        for city, kws in REGIONS.items():
            for k in kws[1:]:
                if k in n and k not in _AMBIGUOUS:
                    region = city
                    break
            if region:
                break
    return region


def classify_many(names: list[str]) -> list[dict]:
    return [classify_name(x) for x in names]


def ai_classify_leftovers(names: list[str], timeout: float = 60) -> dict[str, dict]:
    """規則認不出的丟給 AI。回 {name: {'tags': [...], 'region': ''}}；沒有 AI 可用就回空 dict。

    只走本機 DeepSeek 後備（雲端目前沒有分類端點）。任何失敗都安靜回空，
    分類是加分項，不能讓「一鍵抓取社團」因為它掛掉。
    """
    if not names:
        return {}
    try:
        from .deepseek_client import _load_key, _MODEL, _API_URL  # type: ignore[attr-defined]
        import json as _json
        from . import http_client
    except Exception:
        return {}
    key = _load_key() if callable(_load_key) else ""
    if not key:
        return {}
    allowed = "、".join(TAG_RULES.keys())
    regions = "、".join(REGIONS.keys())
    prompt = (
        "以下是台灣 Facebook 房地產社團的名稱，請幫每一個判斷：\n"
        f"1) tags：從【{allowed}】裡挑 0~3 個最貼切的，都不像就給空陣列；\n"
        f"2) region：從【{regions}】挑一個縣市，看不出來就給空字串。\n"
        "只回 JSON：{\"items\": [{\"name\": \"...\", \"tags\": [...], \"region\": \"...\"}]}\n\n"
        + "\n".join(f"- {x}" for x in names[:60])
    )
    try:
        with http_client.client(timeout) as c:
            r = c.post(_API_URL, headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
                       json={"model": _MODEL, "messages": [{"role": "user", "content": prompt}],
                             "temperature": 0.1, "response_format": {"type": "json_object"}})
        data = r.json()
        content = data["choices"][0]["message"]["content"]
        items = _json.loads(content).get("items", [])
    except Exception:
        return {}
    out = {}
    for it in items:
        nm = (it.get("name") or "").strip()
        tags = [t for t in (it.get("tags") or []) if t in TAG_RULES]
        region = it.get("region") if it.get("region") in REGIONS else ""
        if nm:
            out[nm] = {"tags": tags or ["其他"], "region": region or ""}
    return out
