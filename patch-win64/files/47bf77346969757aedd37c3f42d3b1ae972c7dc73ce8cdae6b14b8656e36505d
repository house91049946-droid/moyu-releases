"""IG 自動追蹤的離線測試（SPEC-P31 §7）。

執行：cd FB_Auto && python3 -m pytest tests/test_ig_follow.py -v

守的是「保守」：額度不能被隨手調大、自己不會被列進候選、跨來源不重複、
已追蹤／已要求的不會被再點（再點＝取消）、被擋會停但保留已做的部分、
後端已記錄過的人在進頁面前就略過。全部不開真瀏覽器。
"""
import json
import subprocess
import sys
import types
from pathlib import Path

import pytest

pytest.importorskip("playwright")
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src import meta_block as mb  # noqa: E402
from src import run_ig_follow as fol  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]


class Test追蹤額度:
    def test_預設五人(self):
        assert fol.effective_limit(None) == 5
        assert fol.effective_limit(0) == 5

    def test_不准超過硬上限十人(self):
        """IG 是三個平台裡管制最嚴的，額度要比 Threads 更小。"""
        assert fol.effective_limit(100) == fol.HARD_CAP == 10

    def test_合理值照收(self):
        assert fol.effective_limit(3) == 3


class Test來源與標籤:
    def test_來源去重保序(self):
        assert fol.parse_sources(" hashtags , own_posts ,hashtags,") == ["hashtags", "own_posts"]

    def test_不認得的來源報錯(self):
        """設定打錯不該默默跑成空。"""
        with pytest.raises(ValueError):
            fol.parse_sources("own_posts,pymk")

    def test_標籤去井號去空白去重(self):
        assert fol.parse_hashtags("#台中買房, 台中 租屋 ,台中買房,, #") == ["台中買房", "台中租屋"]


class Test候選整理:
    def test_跨來源去重_第一個來源優先(self):
        raw = [fol.make_target("a", "own_posts"), fol.make_target("b", "hashtags"),
               fol.make_target("A", "hashtags"), fol.make_target("@b", "own_posts")]
        out = fol.dedupe_targets(raw)
        assert [(t["key"], t["source"]) for t in out] == [("a", "own_posts"), ("b", "hashtags")]

    def test_不把自己列進候選(self):
        """自己貼文的留言區一定有自己——追蹤自己很蠢。"""
        raw = [fol.make_target("Me", "own_posts"), fol.make_target("other", "own_posts")]
        assert [t["key"] for t in fol.dedupe_targets(raw, me="me")] == ["other"]

    def test_href過濾成帳號名(self):
        hrefs = ["/wang.xm/", "/explore/tags/x/", "/p/ABC123/", "/wang.xm/?next=1",
                 "/accounts/login/", "/lin_99", None, "/reel/XYZ/"]
        assert fol.usernames_from_hrefs(hrefs) == ["wang.xm", "lin_99"]

    def test_同行帳號略過(self):
        assert fol.looks_like_agency("taichung_realty") is True
        assert fol.looks_like_agency("abc123", "信義房屋 王經理") is True
        assert fol.looks_like_agency("wang.xm", "王小明") is False


class Test已追過清單:
    def test_缺檔或壞JSON都是空集合(self, tmp_path):
        """這個檔壞了不能讓整輪掛掉。"""
        assert fol.load_exclude(None) == set()
        assert fol.load_exclude(tmp_path / "nope.json") == set()
        bad = tmp_path / "bad.json"
        bad.write_text("{not json", encoding="utf-8")
        assert fol.load_exclude(bad) == set()

    def test_讀清單並正規化(self, tmp_path):
        p = tmp_path / "known.json"
        p.write_text(json.dumps(["@Wang.XM", "lin_99", "", 7]), encoding="utf-8")
        assert fol.load_exclude(p) == {"wang.xm", "lin_99"}

    def test_進頁面前就剔掉並計數(self):
        targets = [fol.make_target("wang.xm", "own_posts"), fol.make_target("new1", "hashtags")]
        kept, n = fol.apply_exclude(targets, {"wang.xm"})
        assert [t["key"] for t in kept] == ["new1"] and n == 1
        assert fol.apply_exclude(targets, set()) == (targets, 0)


class Test被擋判斷:
    @pytest.mark.parametrize("text,reason", [
        ("很抱歉，你的動作已遭封鎖", mb.ACTION_BLOCKED),
        ("Action Blocked", mb.ACTION_BLOCKED),
        ("動作已封鎖\n請稍後再試", mb.ACTION_BLOCKED),          # IG 專用句，meta_block 沒收
        ("你的動作太快，請稍後再試", mb.RATE_LIMITED),
        ("We limit how often you can do certain things on Instagram", mb.RATE_LIMITED),
    ])
    def test_封鎖與節流都要停(self, text, reason):
        assert fol.block_reason(page_text=text) == reason

    def test_正常頁面不會被判成封鎖(self):
        assert fol.block_reason(page_text="追蹤中\n貼文 12\n粉絲 340\n台中買房分享") == ""
        assert fol.block_reason(error_text="Timeout 30000ms exceeded") == ""


