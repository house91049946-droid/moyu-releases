class Test單人流程:
    def test_已追蹤的不再點(self, quiet):
        """再點一次＝取消追蹤，比不追蹤更糟。"""
        pg = FakePage(buttons={"追蹤中"})
        assert fol._follow_one(pg, fol.make_target("x", "hashtags"), 0.0) == "existing"
        assert pg.follow_clicks == 0

    def test_已要求的算pending(self, quiet):
        pg = FakePage(buttons={"Requested"})
        assert fol._follow_one(pg, fol.make_target("x", "hashtags"), 0.0) == "pending"

    def test_進頁就看到封鎖警告(self, quiet):
        pg = FakePage(body="動作已封鎖", buttons={"追蹤"})
        assert fol._follow_one(pg, fol.make_target("x", "hashtags"), 0.0) == "blocked"
        assert pg.follow_clicks == 0

    def test_按了追蹤變追蹤中才算sent(self, quiet):
        pg = FakePage(buttons={"Follow"})
        t = fol.make_target("x", "hashtags")
        assert fol._follow_one(pg, t, 0.0) == "sent"
        assert pg.follow_clicks == 1 and t["name"] == "王小明" and t["liked"] is False

    def test_找不到追蹤鈕算failed(self, quiet):
        assert fol._follow_one(FakePage(buttons=set()), fol.make_target("x", "hashtags"), 0.0) == "failed"


class Test主程式結果JSON:
    def _run(self, out, argv, fake_body):
        code = (
            "import sys; sys.argv=%r\n"
            "import src.run_ig_follow as m\n"
            "%s\n"
            "try: m.main()\n"
            "except SystemExit as e: print('EXIT', e.code)\n"
        ) % (argv, fake_body)
        r = subprocess.run([sys.executable, "-c", code], cwd=ROOT, capture_output=True, text=True)
        assert r.returncode == 0, r.stderr
        return r.stdout, json.loads(out.read_text(encoding="utf-8"))

    def test_被擋保留部分結果並exit1(self, tmp_path):
        out = tmp_path / "r.json"
        fake = (
            "def fake(p,sources,tags,mx,h,dry_run=False,like_probability=0.3,exclude=None):\n"
            "    assert mx==10, mx\n"                       # --max 99 被夾到硬上限
            "    assert 'wang.xm' in exclude, exclude\n"
            "    return {'targets':[{'key':'a','name':'','source':'own_posts','url':'u','liked':True,'status':'sent'},"
            "{'key':'b','name':'','source':'hashtags','url':'u','liked':False,'status':'sent'},"
            "{'key':'c','name':'','source':'hashtags','url':'u','liked':False,'status':'existing'},"
            "{'key':'d','name':'','source':'hashtags','url':'u','liked':False,'status':'failed'}],"
            "'blocked':True,'block_reason':'action_blocked','skipped_known':1}\n"
            "m.do_follow=fake"
        )
        known = tmp_path / "known.json"
        known.write_text('["wang.xm"]', encoding="utf-8")
        argv = ["x", "--max", "99", "--sources", "own_posts,hashtags", "--hashtags", "台中買房",
                "--exclude-file", str(known), "--result-json", str(out)]
        stdout, d = self._run(out, argv, fake)
        assert "EXIT 1" in stdout
        assert d["success"] is False and d["platform"] == "ig"
        assert d["blocked"] is True and d["block_reason"] == "action_blocked"
        assert d["sent"] == 2 and d["skipped_existing"] == 1 and d["skipped_known"] == 1
        assert len(d["targets"]) == 4                     # 已做的不能白做

    def test_只給hashtags來源但沒給標籤就不跑(self, tmp_path):
        out = tmp_path / "r.json"
        argv = ["x", "--sources", "hashtags", "--result-json", str(out)]
        stdout, d = self._run(out, argv, "m.do_follow=lambda *a,**k: (_ for _ in ()).throw(AssertionError('不該開瀏覽器'))")
        assert "EXIT 1" in stdout and d["success"] is False and "hashtags" in d["error"]


