class _Loc:
    def __init__(self, n=0, on_click=None):
        self.n, self.on_click, self.clicks = n, on_click, 0

    @property
    def first(self):
        return self

    def count(self):
        return self.n

    def is_visible(self):
        return self.n > 0

    def click(self):
        self.clicks += 1
        if self.on_click:
            self.on_click()

    def nth(self, i):
        return self


class FakePage:
    """只模擬 _follow_one 會碰到的介面：按了「追蹤」之後按鈕變成「追蹤中」。"""

    def __init__(self, body="", buttons=(), after_follow=("追蹤中",)):
        self.body, self.buttons, self.after_follow = body, set(buttons), set(after_follow)
        self.url = "https://www.instagram.com/x/"
        self.gotos, self.follow_clicks = [], 0
        self.mouse = types.SimpleNamespace(wheel=lambda x, y: None)
        self.keyboard = types.SimpleNamespace(press=lambda k: None)

    def goto(self, url, **kw):
        self.gotos.append(url)

    def evaluate(self, js, *a):
        return self.body if "innerText" in js else []

    def title(self):
        return "王小明 (@x) • Instagram"

    def get_by_role(self, role, name=None, exact=False):
        if name in self.buttons:
            def _clicked():
                if name in fol._FOLLOW_LABELS:
                    self.follow_clicks += 1
                    self.buttons = set(self.after_follow)
            return _Loc(1, _clicked)
        return _Loc(0)

    def get_by_text(self, t, exact=False):
        return _Loc(0)

    def locator(self, sel):
        return _Loc(0)


