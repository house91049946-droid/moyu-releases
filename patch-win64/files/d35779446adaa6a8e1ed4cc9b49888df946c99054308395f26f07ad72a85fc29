"""跨平台子進程 spawn / kill（POSIX ↔ Windows）。

- spawn_kwargs()：讓子進程成為獨立進程組（供之後整組終止）。
  POSIX：start_new_session=True；Windows：CREATE_NEW_PROCESS_GROUP。
- kill_tree()：終止子進程及其所有子孫（含 Chrome）。
  優先 psutil（跨平台、可靠）；退路 POSIX killpg / Windows taskkill。
- raise_fd_limit()：把檔案描述元軟上限拉高，子進程（Chrome）才夠用。
"""
import contextlib
import os
import signal
import subprocess
import sys

IS_WIN = sys.platform.startswith("win")


def spawn_kwargs() -> dict:
    """Popen kwargs：讓子進程有獨立進程組。
    Windows 另加 CREATE_NO_WINDOW：常駐服務隱藏啟動後，子 CLI 才不會彈出新主控台黑窗
    （Playwright 開的 Chrome 是 GUI 程序，不受此旗標影響）。"""
    # stdin 一律接 /dev/null：CLI 若有 input()，在 Windows 上會以為有主控台而真的等輸入，最後 EOFError（2026-09-14）
    if IS_WIN:
        return {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW,
                "stdin": subprocess.DEVNULL}
    return {"start_new_session": True, "stdin": subprocess.DEVNULL}


def raise_fd_limit(target: int = 8192) -> int | None:
    """把本進程的檔案描述元軟上限拉高，回傳實際生效值（Windows 沒這概念，回 None）。

    為什麼一定要做：從 .app／launchd 啟動的進程，軟上限只有 **256**（終端機裡跑
    是 1048576，差了四千倍），而且會被所有子進程繼承。Chrome 拉一個現代網頁會同
    時開幾十條連線加上快取檔與 IPC 管線，256 個 fd 一下就見底——症狀不是明確的
    錯誤，而是**導覽永遠等不到 domcontentloaded**，最後以 Timeout 收場。客戶回報
    「網址匯入失敗」就是這個：同一支程式在終端機跑 13 秒成功，被後端叫就必定超時。

    軟上限可以自己往上調到硬上限為止（不需要 root）。macOS 的硬上限雖然回報成
    無限大，實際仍受 kern.maxfilesperproc 限制，所以調不動就往下退。
    """
    if IS_WIN:
        return None
    import resource
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    if soft >= target:
        return soft
    for want in (target, 4096, 2048, 1024):
        if want <= soft:
            break
        capped = want if hard == resource.RLIM_INFINITY else min(want, hard)
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (capped, hard))
            return capped
        except (ValueError, OSError):
            continue                    # 超過系統上限，換小一點的再試
    return soft


def _chrome_holding_marker(marker: str):
    """--user-data-dir 含 marker 的 Chrome 主進程（psutil.Process 清單）。marker 空就不掃。"""
    out = []
    if not marker:
        return out
    try:
        import psutil
    except ImportError:
        return out
    low = marker.replace("\\", "/").lower()
    try:
        procs = list(psutil.process_iter())
    except Exception:                                 # noqa: BLE001 — 掃不到就當沒有
        return out
    for p in procs:
        try:
            cmd = p.cmdline() or []
        except (psutil.Error, OSError, ValueError):
            continue
        if not cmd or "chrome" not in " ".join(cmd).lower():
            continue
        if any(a.startswith("--type=") for a in cmd):
            continue                                  # 渲染／GPU 子進程跟主進程一起死
        udd = next((a[len("--user-data-dir="):] for a in cmd if a.startswith("--user-data-dir=")), "")
        if udd and low in udd.strip('"').replace("\\", "/").lower():
            out.append(p)
    return out


def kill_tree(proc, sig=signal.SIGTERM, profile_marker: str = "") -> None:
    """終止 proc 及其所有子孫。任何錯誤都吞掉。

    先把子孫清單收齊再砍父進程（父先死，子會被 init 收養、children() 就找不到了）。
    父進程早已結束時，它開的 Chrome 可能還活著（孤兒）：給 profile_marker（profile 目錄路徑）
    就另外掃一遍 --user-data-dir 含該路徑的 Chrome 一起收掉（2026-10-06 審查）。"""
    if proc is None and not profile_marker:
        return
    exited = True
    if proc is not None:
        with contextlib.suppress(Exception):
            exited = proc.poll() is not None

    if not exited:
        # 優先 psutil：跨平台、砍整棵樹最可靠
        done = False
        try:
            import psutil
            parent = psutil.Process(proc.pid)
            children = parent.children(recursive=True)     # 先收齊，再砍
            for child in children:
                with contextlib.suppress(Exception):
                    child.kill()
            with contextlib.suppress(Exception):
                parent.kill()
            done = True
        except Exception:
            pass
        if not done:
            # 退路
            if IS_WIN:
                with contextlib.suppress(Exception):
                    subprocess.run(["taskkill", "/F", "/T", "/PID", str(proc.pid)], capture_output=True)
            else:
                with contextlib.suppress(ProcessLookupError, Exception):
                    os.killpg(os.getpgid(proc.pid), sig)

    # 孤兒 Chrome：父進程已退（或 psutil 沒掃到的）還佔著 profile 的，照 profile 路徑再掃一次
    for p in _chrome_holding_marker(profile_marker):
        try:
            kids = p.children(recursive=True)
        except Exception:
            kids = []
        for k in kids:
            with contextlib.suppress(Exception):
                k.kill()
        with contextlib.suppress(Exception):
            p.kill()
