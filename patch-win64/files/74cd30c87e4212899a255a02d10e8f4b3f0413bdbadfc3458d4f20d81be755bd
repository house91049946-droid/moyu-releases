"""授權管理（本地 UI 用）：查狀態、輸入/清除 license key。"""
import asyncio

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel

from ..cloud_client import (license_status, set_license_key, clear_license_key,
                            apply_trial, referral_info, redeem_extension, CloudError,
                            pay_plans, pay_create_order, pay_order_status, promo_check)

router = APIRouter(prefix="/api/license", tags=["license"], redirect_slashes=False)


@router.get("/status")
async def get_status(probe: bool = True):
    """授權狀態。probe=true 會先打一次 heartbeat（短逾時）取即時結果。"""
    return await asyncio.to_thread(license_status, probe)


class KeyIn(BaseModel):
    license_key: str


@router.post("/key")
async def save_key(data: KeyIn):
    """儲存授權金鑰並立即嘗試啟用，回啟用後狀態。"""
    key = data.license_key.strip()
    if not key:
        raise HTTPException(status_code=422, detail="授權金鑰不可為空")
    return await asyncio.to_thread(set_license_key, key)


@router.delete("/key")
async def delete_key():
    """清除本機授權金鑰與快取狀態。"""
    await asyncio.to_thread(clear_license_key)
    return {"ok": True}


@router.get("/referral")
async def get_referral():
    """我的介紹碼＋可分享的綁定連結（朋友點了 → 申請試用自動綁定介紹碼）。"""
    try:
        return await asyncio.to_thread(referral_info)
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


class RedeemIn(BaseModel):
    code: str


@router.post("/redeem")
async def post_redeem(data: RedeemIn):
    """貼展期代碼延長會期。"""
    if not data.code.strip():
        raise HTTPException(status_code=422, detail="請輸入展期代碼")
    try:
        return await asyncio.to_thread(redeem_extension, data.code.strip())
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


@router.get("/pay/plans")
async def get_pay_plans():
    """線上購買的方案（綠界，老闆 2026-10-06）。"""
    try:
        return await asyncio.to_thread(pay_plans)
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


@router.get("/plans")
async def get_plans():
    """新申請流程的方案卡（老闆 2026-10-06）：付費方案＋免費試用天數，同一包。"""
    try:
        return await asyncio.to_thread(pay_plans)
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


@router.get("/promo-check")
async def get_promo_check(code: str = ""):
    """即時查優惠碼／介紹碼效果（不消耗）。"""
    if not code.strip():
        return {"valid": False, "kind": "", "value": 0, "message": ""}
    try:
        return await asyncio.to_thread(promo_check, code.strip())
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


class PayIn(BaseModel):
    plan_id: str


@router.post("/pay/order")
async def post_pay_order(data: PayIn):
    """建付款訂單，回付款網址（畫面在新視窗開）。"""
    try:
        return await asyncio.to_thread(pay_create_order, data.plan_id)
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


@router.get("/pay/order/{order_no}")
async def get_pay_order(order_no: str):
    """付款結果（畫面每幾秒問一次，付完就更新授權）。"""
    try:
        return await asyncio.to_thread(pay_order_status, order_no)
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))


class ApplyIn(BaseModel):
    name: str
    phone: str
    email: str
    company: str = ""
    referral_code: str = ""
    promo_code: str = ""        # 優惠碼（老闆 2026-10-06）；REF- 開頭會自動歸到 referral_code


@router.post("/apply")
async def apply(data: ApplyIn):
    """申請試用：雲端自動發鑰（同機器只能領一次）→ 立即存檔啟用。"""
    if not (data.name.strip() and data.phone.strip() and data.email.strip()):
        raise HTTPException(status_code=422, detail="姓名、電話、email 為必填")
    try:
        result = await asyncio.to_thread(
            apply_trial, data.name.strip(), data.phone.strip(), data.email.strip(),
            data.company.strip(), data.referral_code.strip(), data.promo_code.strip())
    except CloudError as e:
        raise HTTPException(status_code=400, detail=str(e))
    status = await asyncio.to_thread(set_license_key, result["license_key"])
    return {**status, "applied": True, "trial_days": result.get("trial_days"),
            "promo_applied": result.get("promo_applied"),
            "referral_bonus_days": result.get("referral_bonus_days", 0)}
