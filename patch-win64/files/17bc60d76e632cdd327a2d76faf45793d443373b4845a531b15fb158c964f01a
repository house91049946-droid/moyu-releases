class TestIG自動化警告:
    """老闆 2026-09-23：IG 跳出「自動化行為」警告。這是最明確的被盯上訊號，
    原本卻判成 unknown → 系統隔天照發，等於把帳號往真正的封鎖推。"""

    def test_中文自動化警告算被限制(self):
        for txt in ("我們偵測到你的帳號有自動化行為",
                    "系統偵測到自動化工具",
                    "我們偵測到自動化系統的操作"):
            assert m.classify(page_text=txt) == m.AUTOMATION_SUSPECTED, txt

    def test_英文自動化警告算被限制(self):
        assert m.classify(page_text="We Detected Automated Behavior") == m.AUTOMATION_SUSPECTED
        assert m.classify(page_text="This looks like an automation tool") == m.AUTOMATION_SUSPECTED

    def test_自動化警告要停手(self):
        assert m.is_blocking(m.classify(page_text="偵測到自動化行為")) is True

    def test_不尋常登入活動不算被限制(self):
        """登入驗證不是動作封鎖——誤判會讓 IG 白停 7 天。"""
        assert m.classify(page_text="我們偵測到不尋常的登入活動，請驗證身分") != m.AUTOMATION_SUSPECTED
        assert m.classify(page_text="We detected unusual activity on your account") != m.AUTOMATION_SUSPECTED


def test_客戶截圖的原文(): 
    """2026-09-23 客戶手機上的 IG 警告全文（英文介面）。"""
    txt = ("We suspect automated behavior on your account\n"
           "To prevent your account from being temporarily restricted or permanently disabled, "
           "ensure that no other users or tools have access to your account and that you're "
           "following our Terms of Use.")
    assert m.classify(page_text=txt) == m.AUTOMATION_SUSPECTED
    assert m.is_blocking(m.classify(page_text=txt)) is True


class TestIG發文前暖身:
    """老闆 2026-09-23：被 IG 跳「懷疑自動化」後加的——真人不會開了就貼。"""

    def test_捲動次數與停留時間在合理範圍(self):
        import random
        from src.run_ig_post import warmup_plan
        for seed in range(50):
            scrolls, secs = warmup_plan(random.Random(seed))
            assert 2 <= scrolls <= 5
            assert 20 <= secs <= 60

    def test_每次都不一樣(self):
        import random
        from src.run_ig_post import warmup_plan
        vals = {warmup_plan(random.Random(i))[1] for i in range(20)}
        assert len(vals) > 10        # 固定秒數等於另一種指紋
