class Test主程式結果JSON:
    def _run(self, out, argv, fake_body):
        code = (
            "import sys; sys.argv=%r\n"
            "import src.run_meta_cleanup as m\n"
            "%s\n"
            "try: m.main()\n"
            "except SystemExit as e: print('EXIT', e.code)\n"
        ) % (argv, fake_body)
        r = subprocess.run([sys.executable, "-c", code], cwd=ROOT, capture_output=True, text=True)
        assert r.returncode == 0, r.stderr
        return r.stdout, json.loads(out.read_text(encoding="utf-8"))

    def test_dry_run只列不刪(self, tmp_path):
        out = tmp_path / "r.json"
        fake = (
            "def fake(p,platform,older,mx,h,dry_run=False,only=None):\n"
            "    assert dry_run is True\n"
            "    return {'posts':[{'url':'https://www.threads.com/@me/post/A','age_days':41,'status':'dry_run'},"
            "{'url':'https://www.threads.com/@me/post/B','age_days':None,'status':'undated'},"
            "{'url':'https://www.threads.com/@me/post/C','age_days':3,'status':'recent'}],"
            "'blocked':False,'block_reason':'','skipped_pinned':1}\n"
            "m.do_cleanup=fake"
        )
        argv = ["x", "--platform", "threads", "--older-than", "30", "--dry-run",
                "--result-json", str(out)]
        stdout, d = self._run(out, argv, fake)
        assert "EXIT" not in stdout
        assert d["success"] is True and d["deleted"] == 0
        assert d["skipped_undated"] == 1 and d["skipped_recent"] == 1 and d["skipped_pinned"] == 1
        assert d["posts"][0]["age_days"] == 41 and d["posts"][0]["status"] == "dry_run"
        assert d["data"]["deleted"] == 0 and d["data"]["platform"] == "threads"
        assert "41" in stdout and "post/A" in stdout          # dry-run 清單要看得出網址與天數

    def test_被擋中止但保留已刪的(self, tmp_path):
        out = tmp_path / "r.json"
        fake = (
            "def fake(p,platform,older,mx,h,dry_run=False,only=None):\n"
            "    assert (older,mx)==(7,50),(older,mx)\n"       # 3 天被提高、99 則被夾住
            "    return {'posts':[{'url':'u1','age_days':41,'status':'deleted'},"
            "{'url':'u2','age_days':60,'status':'deleted'},"
            "{'url':'u3','age_days':None,'status':'undated'},"
            "{'url':'u4','age_days':55,'status':'failed'}],"
            "'blocked':True,'block_reason':'action_blocked','skipped_pinned':0}\n"
            "m.do_cleanup=fake"
        )
        argv = ["x", "--platform", "ig", "--older-than", "3", "--max", "99",
                "--result-json", str(out)]
        stdout, d = self._run(out, argv, fake)
        assert "EXIT 1" in stdout
        assert "最少 7" in stdout and "50" in stdout           # 夾住要講明白
        assert d["success"] is False and d["platform"] == "ig"
        assert d["blocked"] is True and d["block_reason"] == "action_blocked"
        assert d["deleted"] == 2 and d["skipped_undated"] == 1
        assert len(d["posts"]) == 4                            # 已刪的不能白刪
        assert d["data"]["blocked"] is True

    def test_例外也留下結果檔(self, tmp_path):
        out = tmp_path / "r.json"
        fake = ("def fake(p,platform,older,mx,h,dry_run=False,only=None):\n"
                "    raise RuntimeError('尚未登入 ig——先到帳號設定連結一次')\n"
                "m.do_cleanup=fake")
        argv = ["x", "--platform", "ig", "--result-json", str(out)]
        stdout, d = self._run(out, argv, fake)
        assert "EXIT 1" in stdout
        assert d["success"] is False and "尚未登入" in d["error"]
        assert d["older_than"] == 30 and d["max"] == 20 and d["data"]["posts"] == []


