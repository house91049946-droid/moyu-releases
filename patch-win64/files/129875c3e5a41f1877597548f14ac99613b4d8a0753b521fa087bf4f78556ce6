            def __init__(self, href): self.href = href
            def evaluate(self, js):
                # 新寫法的選擇器一定含 nav；舊寫法只有 a[href^='/@']
                assert "nav a[href^='/@']" in js, "不可以再抓整頁第一個帳號連結"
                return self.href
        assert t._current_username(P("/@fs_23950868")) == "fs_23950868"
        assert t._current_username(P("")) == ""          # 導覽列沒有＝沒登入

    def test_threads_登入判斷就是有沒有自己的帳號(self, monkeypatch):
        import src.run_threads_post as t
        monkeypatch.setattr(t, "_current_username", lambda page: "fs_23950868")
        assert t._logged_in(object()) is True
        monkeypatch.setattr(t, "_current_username", lambda page: "")
        assert t._logged_in(object()) is False

