def op_label(op: str) -> str:
    return _OP_LABEL.get(op or "", op or "瀏覽器任務")


def _register(key: str | None, proc, op: str = "", eta_sec: int = 0) -> None:
    if key:
        _RUNNING[key] = proc
        # op 沒給就把名稱留空，讓 browser_busy_reason 用 key 前綴（mp_／gp_）判斷，
        # 不要塞一個「瀏覽器任務」把原本講得出口的名字蓋掉
        _RUNNING_META[key] = (op_label(op) if op else "", time.time(), max(0, int(eta_sec or 0)))


def _unregister(key: str | None) -> None:
    if key:
        _RUNNING.pop(key, None)
        _RUNNING_META.pop(key, None)


def kill_job(key: str) -> bool:
    """中止已登記的子進程（連同其進程組）。回傳是否有找到並嘗試中止。"""
    proc = _RUNNING.get(key)
    if proc is None:
        return False
    kill_tree(proc)
    _RUNNING.pop(key, None)
    return True


def automation_chrome_pids() -> list[int]:
    """系統自己開的 Chrome：--user-data-dir 指到 FB_Auto 底下（帳號 profile、threads_profile）。
    使用者自己的 Chrome 用的是 ~/Library/Application Support/Google/Chrome，不會被抓到。"""
    if os.name == "nt":
        return []
    try:
        out = subprocess.run(["ps", "-ax", "-o", "pid=,command="], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    marker = str(FB_AUTO_DIR)
    pids = []
    for line in out.splitlines():
        line = line.strip()
        if not line or "--user-data-dir=" not in line:
            continue
        if "chrome" not in line.lower():
            continue
        # 只抓主進程（帶 --user-data-dir 且路徑在 FB_Auto 底下）；helper 子進程跟著主進程一起死
        if f"--user-data-dir={marker}" in line and "--type=" not in line:
            with contextlib.suppress(ValueError):
                pids.append(int(line.split(None, 1)[0]))
    return pids


def kill_automation_chromes() -> int:
    """關掉系統自己開的 Chrome（見 automation_chrome_pids）。回傳關掉幾個。"""
    import signal
    pids = automation_chrome_pids()
    for pid in pids:
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.kill(pid, signal.SIGTERM)
    if pids:
        time.sleep(1.5)
        for pid in pids:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.kill(pid, signal.SIGKILL)       # 1.5 秒還沒走就硬關；SingletonLock 會由下一次啟動清掉
    return len(pids)


def browser_busy_reason() -> str:
    """目前是否有瀏覽器/CLI 任務在跑（會佔用瀏覽器）。有→回白話說明；無→空字串。
    用於帳號設定區開瀏覽器前的忙碌提醒（單一瀏覽器，排程/發文進行中不可同時再開）。"""
    live = []
    for key, proc in list(_RUNNING.items()):
        try:
            if proc.poll() is None:
                live.append(key)
        except Exception:
            pass
    if not live:
        return ""

    def _one(key: str) -> str:
        label, started, eta = _RUNNING_META.get(key, ("", 0.0, 0))
        if not label:                                   # 沒登記到 meta 的舊路徑
            if key.startswith("mp_"):
                return "Marketplace 排程發文"
            if key.startswith("gp_"):
                return "社團發文"
            return "瀏覽器任務"
        if not started:
            return label
        ran = int(time.time() - started)
        parts = [f"已經跑 {ran // 60} 分鐘" if ran >= 60 else f"已經跑 {ran} 秒"]
        if eta:
            left = eta - ran
            # 估的時間過了還沒完就不要再報一個負數，講「快好了」比較誠實
            parts.append(f"大約還要 {max(1, round(left / 60))} 分鐘" if left > 30 else "快好了")
        return f"{label}（{'，'.join(parts)}）"

    # 同一個名稱只講一次（例如兩筆社團發文），順序照登記先後
    seen, out = set(), []
    for k in live:
        t = _one(k)
        if t not in seen:
            seen.add(t)
            out.append(t)
    return "、".join(out) or "瀏覽器任務"


# ─── 一次性長時操作任務（記憶體追蹤，不落 DB；重啟不還原）───────────

@dataclass
class BridgeJob:
    job_id: str
    op: str                 # comment / nurture / marketplace / detect / delete
    proc: subprocess.Popen
    result_path: str
    started_at: float
    account_id: int | None = None
    fbid: str = ""
    log_id: int | None = None  # 對應 RunLog（P13 貫通用）
    log_path: str = ""         # CLI stdout/stderr 日誌檔
    exited_at: float | None = None  # 首次發現子進程已結束的時間（給 reaper 算寬限）
    # 收尾回呼（P31）：排程啟動的工作沒人輪詢，結果只會被 reaper 收走；
    # 需要把結果落庫的呼叫端（加好友要記「邀過誰」）掛這個，poll/reap 兩條路都會叫。
    on_done: "Callable[[BridgeResult], None] | None" = None
    profile: str = ""          # 用哪個瀏覽器 profile："fb:<fbid>" 或 "meta"（見 profile_key_for）


_BRIDGE_JOBS: dict[str, BridgeJob] = {}
LONG_OP_WAIT_SEC = 20

# ─── 瀏覽器 profile 互斥 ────────────────────────────────
# 同一個 Chrome profile 一次只能被一個任務開（SingletonLock）。兩種 profile：
#   fb:<fbid>  每個 FB 帳號一份（發文、養號、加好友、刪文、加入社團…都用它）
#   meta       Threads 與 IG 共用同一份 threads_profile（發文、養號、追蹤、刪文、開視窗…）
# 2026-09-08 老闆問「會不會有類似問題」盤出來的洞：
#   - 長時任務只用 fbid 互相擋，Meta 任務沒帶 fbid → Threads 養號、IG 追蹤、Threads 順發互相撞
#   - 短任務（MP／社團發文）不看長時任務、長時任務也不看短任務 → 誰晚到誰失敗
#   - MP 發文走 detached 不經 _BRIDGE_LOCK → 跟社團發文可以同時開同一個 FB profile
# 統一做法：所有會開瀏覽器的路徑都先算 profile key，開之前等同 key 的任務結束。
_META_MODULES = frozenset({
    "src.run_threads_post", "src.run_ig_post", "src.run_meta_nurture", "src.run_meta_cleanup",
    "src.run_ig_follow", "src.run_threads_follow", "src.run_threads_search",
})
_PROFILE_SHORT: dict[str, str] = {}      # 短任務正握著的 profile：key → module


def profile_key_for(module: str, args: list[str] | None = None, fbid: str = "") -> str:
    """這個 CLI 會開哪個瀏覽器 profile。認不出來（不開瀏覽器）回空字串＝不互斥。"""
    if module in _META_MODULES:
        return "meta"
    if fbid:
        return f"fb:{fbid}"
    args = list(args or [])
    if "--fbid" in args:
        i = args.index("--fbid")
        if i + 1 < len(args) and args[i + 1]:
            return f"fb:{args[i + 1]}"
    return ""


def _profile_busy(key: str):
    """同 profile 有沒有任務在用：長時任務回 BridgeJob；短任務回帶 .op 的物件；沒有回 None。"""
    if not key:
        return None
    for job in _BRIDGE_JOBS.values():
        # 舊路徑登記的 job 沒有 profile，只有 fbid——也要算
        same = job.profile == key or (not job.profile and job.fbid and key == f"fb:{job.fbid}")
        if same and job.proc.poll() is None:
            return job
    mod = _PROFILE_SHORT.get(key)
    if mod:
        import types
        return types.SimpleNamespace(op=_SHORT_OP_LABEL.get(mod, mod), job_id=f"short:{key}")
    return None


_SHORT_OP_LABEL = {
    "src.run_p2": "Marketplace 發文", "src.run_p1": "社團發文",
    "src.run_threads_post": "Threads 發文", "src.run_ig_post": "IG 發文",
}


def _hold_profile(key: str, module: str) -> None:
    if key:
        _PROFILE_SHORT[key] = module


def _release_profile(key: str) -> None:
    if key:
        _PROFILE_SHORT.pop(key, None)


def _fbid_busy(fbid: str) -> BridgeJob | None:
    """若同 fbid 已有進行中的瀏覽器任務（長時或短任務），回傳該 job。"""
    if not fbid:
        return None
    return _profile_busy(f"fb:{fbid}")


_LONG_OP_LABEL = {"nurture": "養號", "nurture_threads": "Threads 養號", "nurture_ig": "IG 養號",
                  "friend": "自動加好友", "cleanup": "備份刪文", "gjoin": "自動加入社團",
                  "leads": "找潛在客戶", "comment": "留言", "detect": "偵測社團"}


async def wait_profile_free(key: str, max_wait_sec: int = 1500, tag: str = "[bridge]"):
    """開瀏覽器前等同一個 profile 的任務跑完；回傳仍在跑的任務（有 .op），空＝已經空出來。

    mini 2026-09-08 01:18 實例：01:15 起跑的養號要跑 8 分鐘，01:18 的 Marketplace 排程撞上
    同一個 Chrome profile，CLI 等 8 秒就報「這個帳號的瀏覽器還開著」失敗——那一場就白白沒了。
    養號最長也就十來分鐘，等它跑完再發，比失敗合理得多。最多等 25 分鐘（超過代表卡住了）。"""
    import asyncio as _aio
    if not key:
        return None
    busy = _profile_busy(key)
    if busy is None:
        return None
    started = time.time()
    last_said = 0.0
    who = key.split(":", 1)[1] if key.startswith("fb:") else "Threads／IG"
    while busy is not None and time.time() - started < max_wait_sec:
        if time.time() - last_said >= 60:
            mins = int((time.time() - started) // 60)
            print(f"{tag} 帳號 {who} 的{_LONG_OP_LABEL.get(busy.op, busy.op)}還在跑，等它結束再開瀏覽器"
                  f"{f'（已等 {mins} 分鐘）' if mins else ''}", flush=True)
            last_said = time.time()
        await _aio.sleep(10)
        busy = _profile_busy(key)
    return busy


async def wait_fbid_free(fbid: str, max_wait_sec: int = 1500, tag: str = "[bridge]"):
    """wait_profile_free 的 FB 版（排程發文用）。"""
    if not fbid:
        return None
    return await wait_profile_free(f"fb:{fbid}", max_wait_sec=max_wait_sec, tag=tag)


def busy_reason(job, max_wait_sec: int = 1500) -> str:
    """等不到瀏覽器空出來時，給 RunLog 用的人話。"""
    return (f"{_LONG_OP_LABEL.get(job.op, job.op)}還在用這個帳號的瀏覽器，等了 {max_wait_sec // 60} 分鐘還沒結束，"
            "這一場跳過（下一場照常）。若一直這樣，請到帳號設定把該任務停掉。")


def start_long_op(
    op: str,
    module: str,
    args: list[str],
    account_id: int | None = None,
    fbid: str = "",
    on_done: "Callable[[BridgeResult], None] | None" = None,
) -> str:
    """spawn 一個長時操作 CLI，登記後即刻回傳 job_id（不等結束）。
    on_done：結束時（不論成敗）拿 BridgeResult 的回呼，poll 與 reaper 都會觸發，只叫一次。"""
    # 同一個瀏覽器 profile 不可並行開 Chrome（SingletonLock）。這支是同步函式、會卡住事件迴圈，
    # 所以只短等；排程類呼叫端要先 await wait_profile_free() 再來。
    profile = profile_key_for(module, args, fbid)
    if profile:
        busy = _profile_busy(profile)
        if busy is not None:
            deadline = time.time() + LONG_OP_WAIT_SEC
            print(f"[bridge] {profile} 忙於 {busy.op}({busy.job_id})，等待最多 {LONG_OP_WAIT_SEC}s…", flush=True)
            while time.time() < deadline:
                busy = _profile_busy(profile)
                if busy is None:
                    break
                time.sleep(2)
            busy = _profile_busy(profile)
            if busy is not None:
                who = profile.split(":", 1)[1] if profile.startswith("fb:") else "Threads／IG"
                raise RuntimeError(
                    f"帳號 {who} 正有其他瀏覽器任務進行中（{_LONG_OP_LABEL.get(busy.op, busy.op)}），請稍後再試"
                )

    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    job_id = f"{op}_{uuid.uuid4().hex[:12]}"
    # 捕捉 CLI 完整輸出到日誌檔（供除錯 / 未來 SaaS），不再丟 DEVNULL
    LOGIN_LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = str(LOGIN_LOG_DIR / f"{op}_{int(time.time())}_{job_id[-6:]}.log")
    log_file = open(log_path, "w", encoding="utf-8")

    full_args = [sys.executable, "-m", module, "--result-json", result_path, *args]
    try:
        proc = subprocess.Popen(
            full_args,
            cwd=str(FB_AUTO_DIR),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            **spawn_kwargs(),
        )
    finally:
        log_file.close()  # 子進程持有自己的 fd
    # 養號是唯一自己帶時長的任務（--duration 分鐘），順手拿來估剩餘時間
    eta = 0
    if "--duration" in args:
        try:
            eta = int(float(args[args.index("--duration") + 1]) * 60)
        except (IndexError, ValueError):
            eta = 0
    _register(job_id, proc, op=op, eta_sec=eta)
    # RunLog：開一筆 running（op 對映 task_type）
    log_id = None
    with contextlib.suppress(Exception):
        log_id = create_run_log_sync(task_type=op, fbid=fbid, account_id=account_id)
    _BRIDGE_JOBS[job_id] = BridgeJob(
        job_id=job_id, op=op, proc=proc, result_path=result_path,
        started_at=time.time(), account_id=account_id, fbid=fbid, log_id=log_id, log_path=log_path,
        on_done=on_done, profile=profile,
    )
    return job_id


def poll_long_op(job_id: str) -> dict:
    """查詢長時操作狀態：none / pending / success|failed。
    結束時回收 result JSON 並清理登記；回傳含 BridgeResult 供呼叫端落庫。"""
    job = _BRIDGE_JOBS.get(job_id)
    if job is None:
        return {"state": "none"}

    if job.proc.poll() is None:
        return {"state": "pending", "op": job.op, "elapsed_sec": int(time.time() - job.started_at)}

    # 已結束 → 回收
    _unregister(job_id)
    del _BRIDGE_JOBS[job_id]
    try:
        with open(job.result_path, encoding="utf-8") as f:
            raw = json.load(f)
        result = _result_from_raw(raw)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        result = BridgeResult(success=False, error=f"CLI exited {job.proc.returncode}")
    finally:
        with contextlib.suppress(OSError):
            os.unlink(job.result_path)

    # 讀 CLI 日誌尾端塞進 output_tail（供執行紀錄除錯）
    if job.log_path:
        with contextlib.suppress(OSError):
            tail = Path(job.log_path).read_text(encoding="utf-8", errors="replace")
            result.output_tail = tail[-4000:]

    # RunLog：收尾更新
    if job.log_id is not None:
        with contextlib.suppress(Exception):
            update_run_log_sync(job.log_id, result)
    if job.on_done is not None:
        try:
            job.on_done(result)
        except Exception as e:          # 回呼炸掉不能拖垮收尾
            print(f"[bridge] {job.op} on_done 失敗：{e}", flush=True)

    return {
        "state": "success" if result.success else "failed",
        "op": job.op,
        "result": result,
        "elapsed_sec": int(time.time() - job.started_at),
    }


def get_long_op(job_id: str) -> BridgeJob | None:
    return _BRIDGE_JOBS.get(job_id)

