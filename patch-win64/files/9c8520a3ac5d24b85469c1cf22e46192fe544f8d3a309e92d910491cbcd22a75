def _detect_logged_out(text: str) -> bool:
    """CLI 輸出／錯誤訊息看起來是「被登出、要重新登入」。"""
    low = (text or "").lower()
    return any(kw.lower() in low for kw in _LOGOUT_KEYWORDS)


@dataclass
class BridgeResult:
    success: bool
    results: list = field(default_factory=list)
    item_url: str | None = None
    fbid: str = ""
    error: str = ""
    needs_manual_action: bool = False
    manual_action_reason: str = ""
    needs_relogin: bool = False       # 被 FB 登出／cookie 失效，要客戶重新登入
    output_tail: str = ""
    groups: list = field(default_factory=list)
    total_groups: int = 0
    data: dict = field(default_factory=dict)


def _result_from_raw(
    raw: dict,
    needs_manual: bool = False,
    reason: str = "",
    tail: str = "",
) -> BridgeResult:
    """CLI result JSON → BridgeResult 的唯一轉換點。envelope v2：任務欄位在 raw["data"]。"""
    d = raw.get("data") or {}
    groups = d.get("groups") or d.get("mp_groups") or []
    err = raw.get("error", "")
    return BridgeResult(
        success=raw.get("success", False),
        fbid=raw.get("fbid", ""),
        error=err,
        needs_relogin=(not raw.get("success", False)) and _detect_logged_out(f"{err}\n{tail}"),
        results=d.get("results", []),
        item_url=d.get("item_url"),
        groups=groups,
        total_groups=d.get("total_groups") or len(groups),
        needs_manual_action=needs_manual,
        manual_action_reason=reason,
        output_tail=tail,
        data=d,
    )


def cookie_exists(fbid: str) -> bool:
    return (FB_AUTO_COOKIES_DIR / f"{fbid}.json").exists()


def _detect_manual_action(text: str) -> tuple[bool, str]:
    """從 CLI 輸出中檢測是否需要手動操作（驗證/2FA 等）。"""
    for kw in _VERIFY_KEYWORDS:
        if kw.lower() in text.lower():
            return True, kw
    return False, ""


async def _run_cli(
    module: str,
    args: list[str],
    timeout_sec: int,
    keep_open: bool = False,
    job_key: str | None = None,
) -> BridgeResult:
    """以 subprocess 執行 FB_Auto CLI 模組，讀回 result JSON。"""
    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    full_args = [sys.executable, "-m", module, "--result-json", result_path, *args]

    # keep_open 模式：不設全域 timeout（讓 CLI 自己的 --keep-open 互動等待決定何時結束）
    effective_timeout = None if keep_open else timeout_sec

    pkey = profile_key_for(module, args)
    try:
        async with _BRIDGE_LOCK:
            # 同 profile 的長時任務（養號等）或 detached 的 MP 發文還在跑 → 等它結束，不要撞上去失敗
            busy = await wait_profile_free(pkey, tag=f"[{module.rsplit('.', 1)[-1]}]")
            if busy is not None:
                return BridgeResult(success=False, error=busy_reason(busy))
            _hold_profile(pkey, module)
            proc = await asyncio.create_subprocess_exec(
                *full_args,
                cwd=str(FB_AUTO_DIR),
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                **spawn_kwargs(),
            )
            _register(job_key, proc)

            try:
                stdout, stderr = await asyncio.wait_for(proc.communicate(), effective_timeout)
            except asyncio.TimeoutError:
                if keep_open:
                    # 驗證模式不下殺，讓使用者手動處理
                    return BridgeResult(
                        success=False,
                        error="waiting for manual verification (browser kept open)",
                        needs_manual_action=True,
                        manual_action_reason="waiting_for_user",
                    )
                proc.kill()
                await proc.wait()
                return BridgeResult(
                    success=False,
                    error=f"timeout after {timeout_sec}s",
                )
            finally:
                _unregister(job_key)
                _release_profile(pkey)

        return_code = proc.returncode
        stdout_text = stdout.decode("utf-8", errors="replace") if stdout else ""
        stderr_text = stderr.decode("utf-8", errors="replace") if stderr else ""
        tail = (stderr_text + "\n" + stdout_text).strip()[-2000:]

        # 檢查是否需要手動操作
        combined_output = stdout_text + stderr_text
        needs_manual, reason = _detect_manual_action(combined_output)

        # 讀取 result JSON
        try:
            with open(result_path, encoding="utf-8") as f:
                raw = json.load(f)
            return _result_from_raw(raw, needs_manual, reason, tail)
        except (FileNotFoundError, json.JSONDecodeError, OSError):
            error_msg = f"CLI exited {return_code}"
            if tail:
                error_msg += f": {tail[-500:]}"
            return BridgeResult(
                success=False,
                error=error_msg,
                needs_manual_action=needs_manual,
                manual_action_reason=reason,
                needs_relogin=_detect_logged_out(f"{error_msg}\n{tail}"),
                output_tail=tail,
            )

    finally:
        with contextlib.suppress(OSError):
            os.unlink(result_path)


async def _run_cli_detached(
    module: str,
    args: list[str],
    timeout_sec: int,
    job_key: str | None = None,
) -> BridgeResult:
    """spawn 獨立 session 的 CLI 並等待結束（不經 _BRIDGE_LOCK，瀏覽器彈出型操作用）。"""
    # 不經 _BRIDGE_LOCK 也要守 profile 互斥：MP 發文跟社團發文用同一個 FB profile，
    # 兩條排程時間一樣時會同時開 → 後開的那個「瀏覽器還開著」失敗
    pkey = profile_key_for(module, args)
    busy = await wait_profile_free(pkey, tag=f"[{module.rsplit('.', 1)[-1]}]")
    if busy is not None:
        return BridgeResult(success=False, error=busy_reason(busy))
    _hold_profile(pkey, module)
    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    # 捕捉 CLI 輸出到日誌檔（供除錯 / SaaS）
    LOGIN_LOG_DIR.mkdir(parents=True, exist_ok=True)
    mod_short = module.rsplit(".", 1)[-1]
    log_path = LOGIN_LOG_DIR / f"{mod_short}_{int(time.time())}.log"
    log_file = open(log_path, "w", encoding="utf-8")

    full_args = [sys.executable, "-m", module, "--result-json", result_path, *args]
    try:
        proc = subprocess.Popen(
            full_args,
            cwd=str(FB_AUTO_DIR),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            **spawn_kwargs(),
        )
    finally:
        log_file.close()
    _register(job_key, proc)

    loop = asyncio.get_running_loop()
    try:
        await asyncio.wait_for(
            loop.run_in_executor(None, proc.wait),
            timeout=timeout_sec,
        )
    except asyncio.TimeoutError:
        proc.kill()
        proc.wait()
        with contextlib.suppress(OSError):
            os.unlink(result_path)
        return BridgeResult(success=False, error=f"timeout after {timeout_sec}s")
    finally:
        _unregister(job_key)
        _release_profile(pkey)

    tail = ""
    with contextlib.suppress(OSError):
        tail = log_path.read_text(encoding="utf-8", errors="replace")[-4000:]
    try:
        with open(result_path, encoding="utf-8") as f:
            raw = json.load(f)
        r = _result_from_raw(raw)
        r.output_tail = tail
        return r
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return BridgeResult(success=False, error=f"CLI exited {proc.returncode}", output_tail=tail)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(result_path)


async def run_group_post(
    fbid: str,
    group_url: str,
    content: str,
    images: list[str] | None = None,
    headless: bool = False,
    timeout_sec: int = 600,
