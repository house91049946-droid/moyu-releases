@dataclass
class LoginJob:
    """一次 first-login 子進程的追蹤資訊（單帳號情境下同時最多一個）。"""
    account_id: int
    proc: subprocess.Popen
    result_path: str
    log_path: str
    started_at: float


_LOGIN_JOBS: dict[int, LoginJob] = {}


def start_first_login(
    account_id: int,
    email: str,
    password: str,
    headless: bool = False,
    skip_groups: bool = False,
) -> LoginJob:
    """spawn 登入子進程並記住其 result JSON 路徑，供 poll_first_login 回收。
    工作進行中重複呼叫會拋 RuntimeError。"""
    job = _LOGIN_JOBS.get(account_id)
    if job and job.proc.poll() is None:
        raise RuntimeError("login already in progress")

    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    LOGIN_LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = str(LOGIN_LOG_DIR / f"login_{account_id}_{int(time.time())}.log")

    cli_args = ["--email", email, "--password", password]
    if headless:
        cli_args.append("--headless")
    if skip_groups:
        # 只是重新登入拿新 cookie：別再跑暖身瀏覽＋抓社團＋慶祝頁那一整套
        cli_args.append("--skip-groups")
    full_args = [sys.executable, "-m", "src.run_login", "--result-json", result_path, *cli_args]

    log_file = open(log_path, "w", encoding="utf-8")
    try:
        proc = subprocess.Popen(
            full_args,
            cwd=str(FB_AUTO_DIR),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            **spawn_kwargs(),
        )
    finally:
        log_file.close()  # 子進程持有自己的 fd，父進程即刻關閉

    job = LoginJob(
        account_id=account_id,
        proc=proc,
        result_path=result_path,
        log_path=log_path,
        started_at=time.time(),
    )
    _LOGIN_JOBS[account_id] = job
    return job


def poll_first_login(account_id: int) -> dict:
    """查詢 first-login 工作狀態，三態：none / pending / success|failed。
    工作結束時讀回 result JSON 並清理（結果落 DB 由呼叫端負責）。"""
    job = _LOGIN_JOBS.get(account_id)
    if job is None:
        return {"state": "none"}

    if job.proc.poll() is None:
        return {"state": "pending", "elapsed_sec": int(time.time() - job.started_at)}

    # 子進程已結束 → 回收結果並移除工作
    del _LOGIN_JOBS[account_id]
    try:
        with open(job.result_path, encoding="utf-8") as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        data = None
    finally:
        with contextlib.suppress(OSError):
            os.unlink(job.result_path)

    if data and data.get("success") and data.get("fbid"):
        d = (data.get("data") or {}) if data.get("schema") == 2 else data
        return {
            "state": "success",
            "fbid": data["fbid"],
            "groups": d.get("groups", []),
            # v2 為 group_id 清單；舊格式 mp_groups 是 URL 清單（呼叫端會再正規化）
            "mp_group_ids": d.get("mp_group_ids", d.get("mp_groups", [])),
            # 快速重登（--skip-groups）沒抓社團：呼叫端絕不能拿空清單去覆蓋既有社團
            "skipped_groups": bool(d.get("skipped_groups")),
        }

    error = (data or {}).get("error", "")
    if not error:
        tail = ""
        with contextlib.suppress(OSError):
            tail = Path(job.log_path).read_text(encoding="utf-8", errors="replace")[-500:]
        error = tail or f"CLI exited {job.proc.returncode}"
    return {"state": "failed", "error": error}


async def run_first_login(
    email: str,
    password: str,
    headless: bool = False,
    timeout_sec: int = 660,
) -> BridgeResult:
    """純登入：用帳密登入 FB，取得 fbid 並儲存 cookie。
    timeout 預設 11 分鐘以配合人工驗證等待。
    
    使用 subprocess.Popen 直接 spawn，確保瀏覽器視窗能正常彈出。"""
    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    cli_args = ["--email", email, "--password", password]
    if headless:
        cli_args.append("--headless")

    full_args = [sys.executable, "-m", "src.run_login", "--result-json", result_path, *cli_args]

    # 用 subprocess.Popen 而非 create_subprocess_exec，確保瀏覽器能正確彈出
    # （spawn_kwargs 的 CREATE_NO_WINDOW 只隱藏主控台，Chrome 視窗不受影響）
    proc = subprocess.Popen(
        full_args,
        cwd=str(FB_AUTO_DIR),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        **spawn_kwargs(),
    )

    # 用 run_in_executor 避免阻塞 event loop（不做 await asyncio.to_thread 因為後端須同步等待結果）
    try:
        loop = asyncio.get_running_loop()
        stdout, stderr = await asyncio.wait_for(
            loop.run_in_executor(None, proc.communicate),
            timeout=timeout_sec
        )
    except asyncio.TimeoutError:
        proc.kill()
        proc.wait()
        return BridgeResult(success=False, error=f"timeout after {timeout_sec}s")

    # 讀取 result JSON
    try:
        with open(result_path, encoding="utf-8") as f:
            raw = json.load(f)
        return _result_from_raw(raw)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return BridgeResult(
            success=False,
            error=f"CLI exited {proc.returncode}",
        )
    finally:
        with contextlib.suppress(OSError):
            os.unlink(result_path)


