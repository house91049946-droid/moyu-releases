async def run_cookie_login_bg(fbid: str, email: str = "", password: str = "") -> BridgeResult:
    """Cookie 登入（背景）：spawn 獨立 process，不阻塞。瀏覽器保持開啟。
    帶帳密時，cookie 失效會自動改走帳密登入／手動登入。"""
    if not cookie_exists(fbid):
        return BridgeResult(success=False, error=f"cookie 不存在: {fbid}", needs_relogin=True)

    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    full_args = [
        sys.executable, "-m", "src.run_cookie_login",
        "--fbid", fbid,
        "--keep-open",
        "--result-json", result_path,
    ]
    if email and password:
        full_args.extend(["--email", email, "--password", password])

    # 用 subprocess.Popen（同步）確保 process 真的被 fork 出去
    proc = subprocess.Popen(
        full_args,
        cwd=str(FB_AUTO_DIR),
        **spawn_kwargs(),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    # 登記起來（2026-09-07 實測：這個 keep-open 視窗沒登記，後端不知道它在，
    # 「忙碌檢查」放行、真正開瀏覽器才撞 SingletonLock，「強制關閉」也關不到它，
    # 使用者關掉視窗後 python 還空跑了 10 小時）。同一 fbid 只留最新一個。
    key = f"fb_open_{fbid}"
    old = _RUNNING.get(key)
    if old is not None and getattr(old, "poll", lambda: 0)() is None:
        kill_tree(old)
    _register(key, proc, op="fb_open")

    return BridgeResult(success=True, fbid=fbid, error="")


def _apply_log_update(log, result: BridgeResult, screenshot_paths: list[str] | None,
                      context: dict | None = None):
    """把 BridgeResult 套到 RunLog 物件（不 commit）。

    context：呼叫端補充的摘要素材（物件標題、社團名）——CLI 的 result JSON
    裡沒有這些，只有 runner 知道。"""
    import datetime as _dt
    from .runlog_summary import compose_summary
    log.status = "needs_manual" if result.needs_manual_action else ("success" if result.success else "failed")
    log.error_message = result.error or ""
    log.output_tail = result.output_tail or ""
    log.result_json = result.data if isinstance(result.data, dict) else {}
    summary = compose_summary(log.task_type, log.status, log.result_json,
                              log.error_message, context)
    if summary:
        log.summary = summary
    shots = screenshot_paths or (result.data.get("screenshots") if isinstance(result.data, dict) else None)
    if shots:
        log.screenshot_paths = shots
    if log.created_at:
        log.duration_sec = max(0, int((_dt.datetime.utcnow() - log.created_at).total_seconds()))


