def finalize_run_log_sync(log_id: int, error: str) -> None:
    """把一筆還停在 running 的 RunLog 收尾成 failed。

    用在「拿不到 BridgeResult」的情境（使用者中止、重啟後的孤兒）。只動 running 的，
    避免覆蓋掉已經正常收尾的結果。
    """
    import datetime as _dt
    from .database import SyncSession, RunLog
    from sqlalchemy import select
    with SyncSession() as session:
        log = session.execute(select(RunLog).where(RunLog.id == log_id)).scalar_one_or_none()
        if log is not None and log.status == "running":
            log.status = "failed"
            log.error_message = error
            if log.created_at:
                log.duration_sec = max(0, int((_dt.datetime.utcnow() - log.created_at).total_seconds()))
            session.commit()


def shutdown_children(reason: str = "程式重新啟動（更新或關機）時這筆任務中途停止，沒有影響，下一場照常") -> int:
    """後端關閉時：把還在跑的 CLI 子進程（含它開的 Chrome）整棵收掉，紀錄收尾成人話。回傳收掉幾個。

    子進程是獨立 session（spawn_kwargs），後端被砍時不會跟著死——養號的 Chrome 會繼續跑到自己結束，
    期間下一場發文全都「這個帳號的瀏覽器還開著」失敗；而且紀錄被開機收尾標成失敗、實際上可能還發出去了。
    """
    from .proc_utils import kill_tree
    n = 0
    for job_id, job in list(_BRIDGE_JOBS.items()):
        try:
            if job.proc.poll() is None:
                kill_tree(job.proc)
                n += 1
                if job.log_id:
                    with contextlib.suppress(Exception):
                        finalize_run_log_sync(job.log_id, reason)
        except Exception:
            pass
        _BRIDGE_JOBS.pop(job_id, None)
    for key, proc in list(_RUNNING.items()):
        try:
            if proc.poll() is None:
                kill_tree(proc)
                n += 1
        except Exception:
            pass
        _RUNNING.pop(key, None)
    _PROFILE_SHORT.clear()
    return n


def reconcile_orphan_run_logs_sync() -> int:
    """開機時把上次沒收尾的 running 全部標成 failed，回傳筆數。

    長時操作只記在記憶體（_BRIDGE_JOBS），不跨重啟；所以開機當下還是 running 的，
    一定是上次沒收尾的孤兒——留著會在執行紀錄裡永遠轉圈。
    """
    from .database import SyncSession, RunLog
    from sqlalchemy import select
    with SyncSession() as session:
        rows = session.execute(select(RunLog).where(RunLog.status == "running")).scalars().all()
        for log in rows:
            log.status = "failed"
            log.error_message = "程式重新啟動（更新或關機）時這筆任務中途停止，沒有影響，下一場照常"
        if rows:
            session.commit()
        return len(rows)


def reap_finished_jobs(grace_sec: int = 180) -> int:
    """把「子進程已結束但沒人再輪詢」的工作收尾，回傳收尾筆數。

    RunLog 原本只在 poll_long_op() 裡收尾——前端關頁面或不再輪詢，這筆就永遠停在
    running。這裡定期補收。留 grace_sec 給正常輪詢先取走結果，避免把還在等結果的
    呼叫端變成 state=none。
    """
    reaped = 0
    for job_id, job in list(_BRIDGE_JOBS.items()):
        try:
            if job.proc.poll() is None:
                continue
            now = time.time()
            if job.exited_at is None:
                job.exited_at = now      # 第一次發現結束：先記時間，下一輪才收
                continue
            if now - job.exited_at < grace_sec:
                continue
            poll_long_op(job_id)         # 走同一條收尾路徑（會落 RunLog 並清理登記）
            reaped += 1
        except Exception:
            continue
    return reaped


def cancel_long_op(job_id: str) -> bool:
    """中止長時操作，並把它的 RunLog 收尾成「使用者中止」。

    只呼叫 kill_job() 的話，子進程死了但沒人會再輪詢，那筆 RunLog 會永遠卡在
    running（2026-08-09 中止 mp_cleanup 後實際發生）。
    """
    killed = kill_job(job_id)
    job = _BRIDGE_JOBS.pop(job_id, None)
    if job is not None:
        if job.log_id:
            with contextlib.suppress(Exception):
                finalize_run_log_sync(job.log_id, "使用者中止")
        with contextlib.suppress(Exception):
            os.unlink(job.result_path)
    return killed


