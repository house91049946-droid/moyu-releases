class Test排除清單:
    def test_讀檔並剔除(self, tmp_path):
        p = tmp_path / "known.json"
        p.write_text(json.dumps(["100012345", "john.doe", 777, " "]), encoding="utf-8")
        known = fr.load_exclude_keys(str(p))
        assert known == {"100012345", "john.doe", "777"}
        kept, n = fr.drop_known([{"key": "100012345"}, {"key": "x"}, {"key": "john.doe"}], known)
        assert [t["key"] for t in kept] == ["x"] and n == 2

    def test_檔案不在或壞掉當空的(self, tmp_path):
        assert fr.load_exclude_keys(None) == set()
        assert fr.load_exclude_keys(str(tmp_path / "nope.json")) == set()
        bad = tmp_path / "bad.json"
        bad.write_text("{not json", encoding="utf-8")
        assert fr.load_exclude_keys(str(bad)) == set()
        obj = tmp_path / "obj.json"
        obj.write_text('{"a": 1}', encoding="utf-8")
        assert fr.load_exclude_keys(str(obj)) == set()


class Test處理流程:
    """用假的 friend_one 走 process_targets，不開瀏覽器。"""

    @pytest.fixture(autouse=True)
    def _no_sleep(self, monkeypatch):
        monkeypatch.setattr(fr, "human_sleep", lambda *a, **k: None)

    def _targets(self, n):
        return [{"key": str(i), "name": f"人{i}", "source": "pymk", "url": f"u{i}"} for i in range(n)]

    def test_送滿就停(self):
        calls = []

        def fake(page, fbid, t, dry_run, p):
            calls.append(t["key"])
            return "sent", False, ""

        r = fr.process_targets(None, "1", self._targets(10), 3, False, friend_one=fake, gap=(0, 0))
        assert len(calls) == 3 and fr.summarize(r["targets"])["sent"] == 3
        assert r["blocked"] is False

    def test_已好友已送過不算額度(self):
        seq = iter([("existing", False, ""), ("pending", False, ""), ("sent", True, ""), ("sent", False, "")])

        def fake(page, fbid, t, dry_run, p):
            return next(seq)

        r = fr.process_targets(None, "1", self._targets(4), 2, False, friend_one=fake, gap=(0, 0))
        s = fr.summarize(r["targets"])
        assert s == {"sent": 2, "skipped_existing": 1, "skipped_pending": 1, "failed": 0, "dry_run": 0}
        assert r["targets"][2]["liked"] is True

    def test_被擋立刻停但保留已做的(self):
        seq = iter([("sent", False, ""), ("blocked", False, ACTION_BLOCKED), ("sent", False, "")])
        calls = []

        def fake(page, fbid, t, dry_run, p):
            calls.append(t["key"])
            return next(seq)

        r = fr.process_targets(None, "1", self._targets(3), 3, False, friend_one=fake, gap=(0, 0))
        assert r["blocked"] is True and r["block_reason"] == ACTION_BLOCKED
        assert len(calls) == 2                                   # 第三個沒碰
        assert fr.summarize(r["targets"])["sent"] == 1            # 已送的保留

    def test_dry_run不點任何東西(self):
        def fake(page, fbid, t, dry_run, p):
            assert dry_run is True
            return "dry_run", False, ""

        r = fr.process_targets(None, "1", self._targets(2), 2, True, friend_one=fake, gap=(0, 0))
        assert fr.summarize(r["targets"]) == {"sent": 0, "skipped_existing": 0, "skipped_pending": 0,
                                              "failed": 0, "dry_run": 2}


