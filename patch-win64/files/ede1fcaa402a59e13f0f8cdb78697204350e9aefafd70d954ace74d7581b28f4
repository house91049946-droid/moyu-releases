        import inspect
        from src import run_fb_friend as m
        src = inspect.getsource(m)
        for line in src.splitlines():
            if "querySelectorAll" in line or "innerText" in line:
                assert "split('" not in line or "fromCharCode" in line, line


class Test實測校正_2026_09_03:
    """mini 實測踩到的三件事：通知面板被當成候選、自己也在名單裡、加朋友鈕比對不到。"""

    def test_通知文字不是人名(self):
        import src.run_fb_friend as fr
        assert fr.looks_like_notification("未讀郭豈辰在一則貼文中標註了你和其他 8 人。1分鐘")
        assert fr.looks_like_notification("你今天有動態回顧值得看看。4小時")
        assert fr.looks_like_notification("Wei Che Chang 、陳罕青和其他 3 人都說你分享的 1 張相片讚。2小時")
        assert not fr.looks_like_notification("蔣錦堂")
        assert not fr.looks_like_notification("郭豈辰")

    def test_系統頁不是個人檔案(self):
        import src.run_fb_friend as fr
        assert fr.target_key_from_url("https://www.facebook.com/onthisday") == ""

    def test_加朋友鈕的label夾著名字也認得(self):
        import src.run_fb_friend as fr
        # 實際的 aria-label：「將蔣錦堂加為朋友」
        assert fr.button_status("將蔣錦堂加為朋友") == "add"
        assert fr.button_status("加朋友") == "add"
        assert fr.button_status("朋友") == "existing"
        assert fr.button_status("取消邀請") == "pending"

    def test_額度看按了幾次加朋友(self, monkeypatch):
        """驗證誤判成失敗時，額度也不能被繞過（備份刪文踩過同一顆地雷）。"""
        import src.run_fb_friend as fr
        monkeypatch.setattr(fr, "_CLICKED", 2)      # 已經按滿 2 次
        calls = []

        def fake_one(*a, **k):
            calls.append(1)
            return "failed", False, "驗證看不到"

        out = fr.process_targets(None, "1", [{"key": "a"}, {"key": "b"}],
                                 max_send=2, dry_run=False, friend_one=fake_one, gap=(0, 0))
        assert calls == []                          # 一個都不再碰
        assert out["targets"] == []

    def test_只認主角的按鈕_不理會推薦名單裡別人的(self):
        """個人頁下方的「你可能認識的人」每個人都有一顆加朋友鈕。"""
        import src.run_fb_friend as fr

        class El:
            def __init__(self, lab): self.lab = lab
            def is_visible(self): return True
            def get_attribute(self, k): return self.lab
            def inner_text(self): return ""

        class Loc:
            def __init__(self, els): self.els = els
            def count(self): return len(self.els)
            def nth(self, i): return self.els[i]
            def locator(self, sel): return self

        class Page:
            def __init__(self, els): self._loc = Loc(els)
            def locator(self, sel): return self._loc

        els = [El("取消對陳泊廷的邀請"), El("將蕭雅惠加為朋友")]
        st, _ = fr._find_action_button(Page(els), owner="陳泊廷")
        assert st == "pending"          # 主角已送出；隔壁蕭雅惠的「加朋友」不算

    def test_從按鈕label反推主角是誰(self):
        import src.run_fb_friend as fr
        assert fr.owner_from_label("將陳泊廷加為朋友") == "陳泊廷"
        assert fr.owner_from_label("取消對陳泊廷的邀請") == "陳泊廷"
        assert fr.owner_from_label("Add John Smith as friend") == "John Smith"
        assert fr.owner_from_label("發送訊息") == ""
