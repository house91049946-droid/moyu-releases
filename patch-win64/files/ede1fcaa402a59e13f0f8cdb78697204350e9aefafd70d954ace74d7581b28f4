class Test鍵值:
    def test_數字id優先(self):
        assert fr.target_key_from_url("https://www.facebook.com/profile.php?id=100012345&sk=about") == "100012345"
        assert fr.target_key_from_url("https://www.facebook.com/people/王小明/100012345/") == "100012345"

    def test_代稱去掉查詢字串(self):
        assert fr.target_key_from_url("https://www.facebook.com/john.doe?comment_id=99") == "john.doe"

    def test_非個人頁回空(self):
        for u in ("https://www.facebook.com/groups/123/posts/9/",
                  "https://www.facebook.com/photo/?fbid=1",
                  "https://www.facebook.com/friends/requests", ""):
            assert fr.target_key_from_url(u) == ""

    def test_同一個人只留優先來源那筆(self):
        ts = [{"key": "a", "source": "own_posts"}, {"key": "b", "source": "own_posts"},
              {"key": "a", "source": "pymk"}, {"key": "", "source": "pymk"}]
        out = fr.dedupe_targets(ts)
        assert [(t["key"], t["source"]) for t in out] == [("a", "own_posts"), ("b", "own_posts")]


