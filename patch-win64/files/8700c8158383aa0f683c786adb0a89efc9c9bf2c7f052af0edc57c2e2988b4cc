"""CLI — 檢測哪些已加入的社團可以轉發 Marketplace 商品。

利用 Marketplace 上架流程的「對象頁」來抓取 Facebook 列出的可轉發社團清單，
與已同步的社團比對，輸出可轉發的社團名稱列表。
"""
import contextlib
import argparse
import atexit
import json
import sys
from pathlib import Path

from src.utils import launch_browser, capture_screenshot
from src.login import _try_cookie_login
from src.marketplacePost import get_audience_groups

_JSON_PATH: str | None = None
_RESULT: dict | None = None


def _write_result_json():
    if _JSON_PATH and _RESULT is not None:
        try:
            with open(_JSON_PATH, "w", encoding="utf-8") as f:
                try:
                    from src.utils import collect_screenshots
                    _RESULT.setdefault("data", {})["screenshots"] = collect_screenshots()
                except Exception:
                    pass
                json.dump(_RESULT, f, ensure_ascii=False, indent=2)
        except Exception as e:
            print(f"[result-json] 寫檔失敗: {e}", file=sys.stderr)


def _enrich_with_group_ids(fbid: str, names: list[str]) -> list[dict]:
    """把對象頁抓到的社團名稱對照已同步的社團檔，補上 url 與 group_id（對不到的留空）。"""
    import re
    from src.paths import DATA_DIR

    name_to_url: dict[str, str] = {}
    groups_file = DATA_DIR / f"{fbid}.json"
    if groups_file.exists():
        try:
            with open(groups_file, encoding="utf-8") as f:
                name_to_url = json.load(f)
        except (json.JSONDecodeError, OSError):
            pass

    enriched = []
    for name in names:
        url = name_to_url.get(name, "")
        m = re.search(r"/groups/(\d+)/?", url)
        enriched.append({"name": name, "url": url, "group_id": m.group(1) if m else ""})
    return enriched


def _visible_field(page, names: tuple[str, ...], combo: bool = False):
    """只接受可見且唯一、與欄位名稱關聯的控制項。找不到就保留失敗證據。"""
    import re
    pattern = re.compile(r"^\s*(?:" + "|".join(re.escape(n) for n in names) + r")(?:\s|$)", re.I)
    if combo:
        candidates = [page.get_by_label(pattern),
                      page.get_by_role("combobox", name=pattern),
                      page.locator("label").filter(has_text=pattern).locator("[role=combobox]"),
                      page.locator("[role='combobox']").filter(has_text=pattern)]
    else:
        candidates = [page.get_by_label(pattern), page.get_by_placeholder(pattern),
                      page.locator("label").filter(has_text=pattern).locator("input,textarea")]
    counts = []
    for candidate in candidates:
        visible = [el for el in candidate.all() if el.is_visible()]
        counts.append(len(visible))

        if len(visible) == 1:
            return visible[0]
    raise RuntimeError(f"找不到唯一的{names[0]}欄位（候選數 {counts}），停止偵測，請查看截圖")


def _fill_detect_fields(page):
    from src.marketplacePost import _select_combobox_option, _CAT_OPT_SEL
    from src.utils import simulate_human_click, human_sleep
    category = _visible_field(page, ("類別", "类别", "Category"), combo=True)
    simulate_human_click(page, category)
    human_sleep(1, 2)
    opts = [el for el in page.locator(_CAT_OPT_SEL).all() if el.is_visible()]
    if not opts:
        # 實測 FB 類別改成無 option/menuitem role 的文字清單。只選已知葉節點。
        for label in ("工具", "Tools", "家具", "Furniture"):
            opts = [el for el in page.get_by_text(label, exact=True).all() if el.is_visible()]
            if len(opts) == 1:
                break
        else:
            raise RuntimeError("類別選單沒有可辨識的選項")
    chosen = opts[0].inner_text().strip()
    simulate_human_click(page, opts[0])
    human_sleep(0.5, 1)
    if not chosen or chosen not in category.inner_text():
        raise RuntimeError("無法確認類別已選取")
    for names, value in [(("標題", "标题", "Title"), "test"),
                         (("價格", "价格", "Price"), "100")]:
        field = _visible_field(page, names)
        field.fill(value)
        field.press("Tab")
        actual = field.input_value().strip()
        if names[0] == "價格":
            import re
            actual = re.sub(r"^(?:NT\$|\$)\s*", "", actual).replace(",", "")
            valid = bool(re.fullmatch(r"100(?:\.0+)?", actual))
        else:
            valid = actual == value
        if not valid:
            raise RuntimeError(f"{names[0]}填寫後驗證失敗")
    condition = _visible_field(page, ("狀況", "状况", "Condition"), combo=True)
    if not _select_combobox_option(page, condition, "全新"):
        raise RuntimeError("無法確認商品狀況已選取")


def main():
    parser = argparse.ArgumentParser(description="檢測可轉發 Marketplace 的社團")
    parser.add_argument("--fbid", required=True, help="FB numeric ID（需已有 cookie）")
    parser.add_argument("--headless", action="store_true")
    parser.add_argument("--result-json", help="結果 JSON 輸出路徑")

    args = parser.parse_args()

    global _JSON_PATH, _RESULT
    fbid = args.fbid
    _JSON_PATH = args.result_json
    _RESULT = {
        "schema": 2,
        "success": False,
        "fbid": fbid,
        "error": "",
        "data": {"mp_groups": []},
    }
    if _JSON_PATH:
        atexit.register(_write_result_json)

    print(f"[detect-mp] 啟動檢測: fbid={fbid}", flush=True)

    browser, context, page = launch_browser(fbid=fbid, headless=args.headless)

    try:
        # Cookie 登入
        if not _try_cookie_login(page, context, fbid):
            msg = "Cookie 登入失敗"
            print(f"❌ {msg}", flush=True)
            _RESULT["error"] = msg
            return

        # 進入 Marketplace 建立頁 → 到對象頁
        print("[detect-mp] 進入 Marketplace 建立頁...", flush=True)
        page.goto("https://www.facebook.com/marketplace/create/item/", wait_until="domcontentloaded")
        page.wait_for_timeout(5000)

        with contextlib.suppress(Exception):
            capture_screenshot(page, fbid, "detect_form_loaded")

        # ── 填必填欄位以啟用「繼續」：類別 + 標題 + 價格 + 狀況 + 圖片 ──
        # FB 新版 Marketplace 要求「類別」和「狀況」都選了「繼續」才會啟用；
        # 缺任一個按鈕維持灰色 → 進不了對象頁 → 抓到 0 個社團。
        from src.marketplacePost import _upload_images
        from src.paths import DATA_DIR

        # 根據標籤定位，不依賴頁面上的 input/combobox 排序。
        _fill_detect_fields(page)
        with contextlib.suppress(Exception):
            capture_screenshot(page, fbid, "detect_fields_filled")

        # 5. 上傳測試圖片（必填——沒有圖 FB 不會啟用「繼續」，偵測必定失敗）
        # 優先用隨程式發行的 assets（客戶包沒有執行期資料）；相容舊的 data 路徑
        test_img = Path(__file__).resolve().parents[1] / "assets" / "test_product.jpg"
        if not test_img.exists():
            test_img = DATA_DIR / "shop_article_images" / "test_product_1.jpg"
        if not test_img.exists():
            raise RuntimeError("找不到測試圖片（FB_Auto/assets/test_product.jpg）——無法填表進入對象頁")
        print("[detect-mp] 上傳測試圖片...", flush=True)
        _upload_images(page, [str(test_img)])
        with contextlib.suppress(Exception):
            capture_screenshot(page, fbid, "detect_image_uploaded")

        # 觸發 blur / dispatch 讓 React 啟用繼續按鈕
        page.mouse.click(10, 10)
        page.wait_for_timeout(1000)

        from src.marketplacePost import _click_continue
        if not _click_continue(page):
            raise RuntimeError("無法點擊繼續：請查看必填欄位或按鈕狀態")
        page.wait_for_timeout(5000)

        # 診斷截圖：不論成功與否都拍一張，方便從執行紀錄看卡在哪一頁
        try:
            capture_screenshot(page, fbid, "detect_after_continue")
        except Exception:
            pass

        # 確認是否到了對象頁——沒進去就明確失敗（在建立頁硬抓只會存下邊欄雜訊）
        if "step=audience" not in page.url:
            raise RuntimeError(
                f"未進入對象頁（卡在 {page.url}）——表單可能未填完整或 FB 改版，請看截圖")

        # 抓取對象頁社團清單（對象頁 DOM 只有名稱，無連結）
        print("[detect-mp] 抓取對象頁社團...", flush=True)
        mp_names = get_audience_groups(page, fbid)

        # 用已同步的社團檔（data/{fbid}.json: name → url）把名稱 join 成 {name, url, group_id}
        mp_groups = _enrich_with_group_ids(fbid, mp_names)
        resolved = sum(1 for g in mp_groups if g["group_id"])
        print(f"[detect-mp] ✅ 可轉發的社團: {len(mp_groups)} 個（group_id 解析成功 {resolved} 個）", flush=True)

        _RESULT["success"] = True
        _RESULT["data"]["mp_groups"] = mp_groups

        # 覆寫快取檔為 v2 形狀（get_audience_groups 先寫入的是純名稱陣列）
        from src.paths import DATA_DIR
        cache_path = DATA_DIR / f"marketplace_groups_{fbid}.json"
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(mp_groups, f, ensure_ascii=False, indent=2)

    except Exception as e:
        print(f"[detect-mp] ❌ 錯誤: {e}", flush=True)
        _RESULT["error"] = str(e)
        try:
            capture_screenshot(page, fbid, "detect_failed")
        except Exception:
            pass
    finally:
        context.close()
        print("[detect-mp] 完成", flush=True)


if __name__ == "__main__":
    main()
