"""文案管理 API"""
from datetime import datetime
from fastapi import APIRouter, Depends, HTTPException, UploadFile, File
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from pydantic import BaseModel, field_serializer, field_validator
from typing import Optional
import aiofiles
import os
import uuid

from ..database import get_session, Article, ArticleGroup
from ..config import DATA_DIR

router = APIRouter(prefix="/api/articles", tags=["articles"], redirect_slashes=False)


class ArticleCreate(BaseModel):
    title: str = ""
    content: str
    category: str = "general"
    link_url: str = ""


class ArticleUpdate(BaseModel):
    title: Optional[str] = None
    content: Optional[str] = None
    category: Optional[str] = None
    link_url: Optional[str] = None


class ArticleResponse(BaseModel):
    id: int
    title: str
    content: str
    category: str
    image_paths: list
    link_url: str
    created_at: str

    model_config = {"from_attributes": True}

    @field_validator('created_at', mode='before')
    @classmethod
    def coerce_created_at(cls, v):
        if isinstance(v, datetime):
            return v.isoformat()
        return str(v) if v else ''


@router.get("", response_model=list[ArticleResponse])
@router.get("/", response_model=list[ArticleResponse])
async def list_articles(category: Optional[str] = None, session: AsyncSession = Depends(get_session)):
    q = select(Article).order_by(Article.created_at.desc())
    if category:
        q = q.where(Article.category == category)
    result = await session.execute(q)
    return result.scalars().all()


@router.post("", response_model=ArticleResponse)
@router.post("/", response_model=ArticleResponse)
async def create_article(data: ArticleCreate, session: AsyncSession = Depends(get_session)):
    article = Article(**data.model_dump())
    session.add(article)
    await session.commit()
    await session.refresh(article)
    return article


@router.put("/{article_id}", response_model=ArticleResponse)
async def update_article(article_id: int, data: ArticleUpdate, session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(Article).where(Article.id == article_id))
    article = result.scalar_one_or_none()
    if not article:
        raise HTTPException(status_code=404, detail="文案不存在")
    update_data = data.model_dump(exclude_unset=True)
    for k, v in update_data.items():
        setattr(article, k, v)
    await session.commit()
    await session.refresh(article)
    return article


@router.delete("/{article_id}")
async def delete_article(article_id: int, session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(Article).where(Article.id == article_id))
    article = result.scalar_one_or_none()
    if not article:
        raise HTTPException(status_code=404, detail="文案不存在")
    await session.delete(article)
    await session.commit()
    return {"message": "文案已刪除"}


@router.post("/{article_id}/upload")
async def upload_article_image(article_id: int, file: UploadFile = File(...), session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(Article).where(Article.id == article_id))
    article = result.scalar_one_or_none()
    if not article:
        raise HTTPException(status_code=404, detail="文案不存在")

    upload_dir = DATA_DIR / "uploads"
    upload_dir.mkdir(parents=True, exist_ok=True)
    ext = os.path.splitext(file.filename or "image.jpg")[1]
    filename = f"{uuid.uuid4().hex}{ext}"
    filepath = upload_dir / filename

    async with aiofiles.open(filepath, "wb") as f:
        content = await file.read()
        await f.write(content)

    paths = article.image_paths or []
    paths.append(f"/uploads/{filename}")
    article.image_paths = paths
    await session.commit()

    return {"filename": filename, "path": f"/uploads/{filename}"}


# ─── 文案群組 ──────────────────────────────────────────

class ArticleGroupCreate(BaseModel):
    name: str
    article_ids: list[int] = []


@router.get("/groups", response_model=list[dict])
@router.get("/groups/", response_model=list[dict])
async def list_article_groups(session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ArticleGroup).order_by(ArticleGroup.created_at.desc()))
    return [{"id": g.id, "name": g.name, "article_ids": g.article_ids} for g in result.scalars().all()]


@router.post("/groups")
@router.post("/groups/")
async def create_article_group(data: ArticleGroupCreate, session: AsyncSession = Depends(get_session)):
    group = ArticleGroup(name=data.name, article_ids=data.article_ids)
    session.add(group)
    await session.commit()
    await session.refresh(group)
    return {"id": group.id, "name": group.name, "article_ids": group.article_ids}


@router.delete("/groups/{group_id}")
async def delete_article_group(group_id: int, session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ArticleGroup).where(ArticleGroup.id == group_id))
    group = result.scalar_one_or_none()
    if not group:
        raise HTTPException(status_code=404, detail="群組不存在")
    await session.delete(group)
    await session.commit()
    return {"message": "群組已刪除"}
