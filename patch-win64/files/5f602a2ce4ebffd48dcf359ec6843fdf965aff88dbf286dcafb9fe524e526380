"""清單匯入的解析規則——刻意全部是純函式：不碰瀏覽器、不碰網路。

為什麼把 DOM 抽取切成兩段：瀏覽器端的 JS 只負責把「物件連結 + 卡片的文字行」
撈出來（LIST_EXTRACT_JS），欄位怎麼分類完全在 Python 這邊做。這樣最容易出錯的
那一段（哪一行是價格、哪一行是地址）可以直接餵文字行測，不需要瀏覽器、不需要
網路、也不需要維護一份會過期的 HTML fixture。
"""
import contextlib
import re
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

# ─── 價格 ─────────────────────────────────────────────


def parse_price(text: str) -> int:
    """「1,288 萬」→ 12880000；「1288萬」「總價 1,288 萬」皆可。抓不到回 0。"""
    if not text:
        return 0
    m = re.search(r"([\d,]+(?:\.\d+)?)\s*萬", text)
    if m:
        with contextlib.suppress(ValueError):
            return int(float(m.group(1).replace(",", "")) * 10000)
    m = re.search(r"([\d,]{4,})\s*元", text)
    if m:
        with contextlib.suppress(ValueError):
            return int(m.group(1).replace(",", ""))
    return 0


# ─── 網址 ─────────────────────────────────────────────


def is_rent_url(url: str) -> bool:
    """租件網址：rent.rakuya.com.tw/item/<id>（新）或路徑含 rent_item（舊）。（SPEC-P34）"""
    if not url:
        return False
    p = urlsplit(url)
    # community.rakuya.com.tw/<社區id>/rent/info?ehid=… 也是租件（2026-09-10 老闆貼的社區頁網址）
    return p.netloc.lower().startswith("rent.") or "rent_item" in p.path or "/rent/" in p.path


def normalize_item_url(url: str) -> str:
    """物件網址正規化：只留 ehid，砍掉 &from= 這類追蹤參數。非物件頁回 ""。

    同一個物件從不同入口進來會帶不同的 from，不砍掉就會被當成不同物件——
    「已匯入」的比對與去重全靠這個。
    租屋站的新式網址是 rent.rakuya.com.tw/item/<id>?from=…：路徑就是識別，砍掉整個 query。
    """
    if not url:
        return ""
    p = urlsplit(url)
    if p.netloc.lower().startswith("rent.") and re.match(r"^/item/[0-9a-z]+/?$", p.path):
        return urlunsplit((p.scheme, p.netloc, p.path.rstrip("/"), "", ""))
    # 社區頁清單卡片：community.rakuya.com.tw/<社區id>/rent/<物件碼>?from=list——路徑就是識別，砍掉 query
    m = re.match(r"^/\d+/(sell|rent)/([0-9a-z]+)/?$", p.path)
    if m and m.group(2) != "info":
        return urlunsplit((p.scheme, p.netloc, p.path.rstrip("/"), "", ""))
    # 社區頁版本：community.rakuya.com.tw/<社區id>/sell/info?ehid=…（同一筆物件，只是從社區頁進去）
    is_community = bool(re.match(r"^/\d+/(sell|rent)/info/?$", p.path))
    if "sell_item" not in p.path and "rent_item" not in p.path and not is_community:
        return ""
    ehid = dict(parse_qsl(p.query)).get("ehid", "")
    return urlunsplit((p.scheme, p.netloc, p.path, f"ehid={ehid}" if ehid else "", ""))


def city_hint_from_title(title: str) -> str:
    """清單頁標題開頭的縣市（「台中市全區買房…」「台中市方舟團隊出租物件一覽」）→ 補給沒有縣市的地址。"""
    m = _CITY_PREFIX_RE.match((title or "").strip())
    return m.group(0) if m else ""


def is_listing_page(urls: list[str]) -> bool:
    """這一頁本身就是清單頁嗎（使用者直接貼店鋪頁時要吃得下）。

    門檻 5 筆：物件詳情頁通常只帶一兩個推薦物件連結，清單頁動輒二十幾筆。
    """
    return len({u for u in (normalize_item_url(x) for x in urls) if u}) >= 5


_STORE_TEXT_RE = re.compile(r"進入店鋪|店鋪|其他物件|所有物件|全部物件|經紀人")
# 品牌總頁：vip.rakuya.com.tw/hyr（信義）、/grt（大家）、/etw（東森）…——每個物件頁頁尾都有這排連結，
# 進去是全品牌的「最新案源／推薦經紀人」，跟這個經紀人無關（老闆 2026-09-10：抓到不相關的資料）。
# 店鋪頁是 vip.rakuya.com.tw/<手機或編號>（路徑有數字）或 www.rakuya.com.tw/store/my/<id>。
_BRAND_SLUG_RE = re.compile(r"^/[a-z]{2,5}/?$", re.I)


def is_brand_landing(url: str) -> bool:
    """vip.rakuya.com.tw 底下純字母短代號＝品牌總頁，不是店鋪。"""
    p = urlsplit(url or "")
    return p.netloc.lower().startswith("vip.rakuya") and bool(_BRAND_SLUG_RE.match(p.path))


_AGENT_URL_RE = re.compile(r'agentUrl["\']?\s*:\s*["\']((?:https?:)?\\?/\\?/vip\.rakuya\.com\.tw\\?/[^"\'\\]+)')
_STORE_BTN_RE = re.compile(r'sellerActionButton--store[^>]*href="([^"]+)"')


def store_url_from_html(html: str) -> str:
    r"""物件頁 HTML 裡的店鋪：Vue 資料的 agentUrl（"https:\/\/vip.rakuya.com.tw\/0955377283"）或「店鋪」按鈕的 href。
    連結清單有時抓不到（按鈕晚渲染），HTML 裡一定有（2026-09-10 實測）。"""
    for rx in (_STORE_BTN_RE, _AGENT_URL_RE):
        m = rx.search(html or "")
        if m:
            u = m.group(1).replace("\\/", "/").replace("\\", "")
            if u.startswith("//"):
                u = "https:" + u
            if not is_brand_landing(u):
                return u
    return ""


# 沒有店鋪頁的刊登者（公司帳號常見，agentUrl 空）：從物件頁拿「刊登者名字／縣市代碼／標題上的團隊標記」，
# 改用樂屋關鍵字搜尋當清單（2026-09-10 實測「琣琣」「方舟團隊」都搜得到整批）。
# 刊登者名字在 window.itemContact 的 sellerInfo.nick（2026-09-10 實測，買賣頁與社區租屋頁都一樣）；保險再認 <span class="name">
_AGENT_NAME_RE = re.compile(r'"sellerInfo":\{"nick":"((?:[^"\\]|\\.)+)"')
_AGENT_NAME_HTML_RE = re.compile(r'class="name">([^<]{1,20})</span>')
_CITY_CODE_RE = re.compile(r'targetingInfo\s*=\s*\{"itemData":\{"city":(\d+)')
_TAG_RE = re.compile(r"[☆✩✨★◆●♦]\s*([^☆✩✨★◆●♦\s|｜\-–—]{2,10})\s*[☆✩✨★◆●♦]?")
_TAG_STOP = re.compile(r"(代書|團隊|房屋|不動產|地產|經紀|仲介)")


def _unescape(s: str) -> str:
    """JSON 字串片段（\u7423、\/）還原成文字。"""
    import json
    try:
        return json.loads('"' + s + '"')
    except ValueError:
        return s


def agent_hints_from_page(html: str, title: str) -> dict:
    """回 {"agent": 刊登者名字, "city": 縣市代碼字串, "tag": 標題上的團隊標記}；抓不到的留空。"""
    out = {"agent": "", "city": "", "tag": ""}
    m = _AGENT_NAME_RE.search(html or "")
    if m:
        out["agent"] = _unescape(m.group(1)).strip()[:20]
    else:
        m = _AGENT_NAME_HTML_RE.search(html or "")
        if m:
            out["agent"] = m.group(1).strip()[:20]
    m = _CITY_CODE_RE.search(html or "")
    if m:
        out["city"] = m.group(1)
    head = (title or "").split(" - ")[0]
    for m in _TAG_RE.finditer(head):
        t = m.group(1).strip()
        if _TAG_STOP.search(t):
            out["tag"] = t
            break
    return out


_NICK_RE = _AGENT_NAME_RE
_BRANCH_RE = re.compile(r'"branch":"((?:[^"\\]|\\.)*)"')


def lister_identity(html: str) -> dict:
    """物件頁的刊登者：{"nick": 名字, "branch": 分店}。關鍵字搜尋會混到別人的案子（2026-09-10 抓到飛雁團隊），
    每一筆都開頁面對一次刊登者才可靠。"""
    out = {"nick": "", "branch": ""}
    m = _NICK_RE.search(html or "")
    if m:
        out["nick"] = _unescape(m.group(1)).strip()
    m = _BRANCH_RE.search(html or "")
    if m:
        out["branch"] = _unescape(m.group(1)).strip()
    return out


def keyword_search_urls(keyword: str, city: str) -> list[tuple[str, str]]:
    """樂屋關鍵字搜尋：買賣一頁、租屋一頁（都吃 ?page=n）。"""
    from urllib.parse import quote
    if not keyword:
        return []
    q = f"city={city}&keyword={quote(keyword)}" if city else f"keyword={quote(keyword)}"
    return [(f"https://www.rakuya.com.tw/sell/result?{q}", "sale"),
            (f"https://rent.rakuya.com.tw/result?{q}", "rent")]


def find_store_url(links: list[dict], page_url: str = "") -> str:
    """從詳情頁的連結裡找出「這個經紀人／店家」的頁面。找不到回 ""。

    links 每項為 {"href": ..., "text": ...}。先認樂屋網的 vip 店鋪（路徑有數字，最可靠），
    再退回文字比對（「進入店鋪」→ www.rakuya.com.tw/store/my/<id>）。品牌總頁一律跳過；
    物件頁本身一定要排除——跟進去只會抓到另一個單一物件。
    """
    for l in links:
        h = (l.get("href") or "").strip()
        if "vip.rakuya.com.tw" in h and not is_brand_landing(h):
            return h
    for l in links:
        h = (l.get("href") or "").strip()
        t = (l.get("text") or "").strip()
        if not h.startswith(("http://", "https://")):
            continue
        if normalize_item_url(h) or is_brand_landing(h):        # 物件頁／品牌總頁都不是店家頁
            continue
        if _STORE_TEXT_RE.search(t):
            return h
    return ""


_VIP_ROOT_RE = re.compile(r"^/[^/]+/?$")


def store_sections(store_url: str) -> list[tuple[str, str]]:
    """一家店要抓哪幾段：vip 店鋪首頁只列出售，出租在 /rent——兩段都抓，回 [(網址, sale|rent)]。
    已經是 /sell 或 /rent 就只抓那一段；其他網站照原樣一段。"""
    p = urlsplit(store_url or "")
    if p.netloc.lower().startswith("vip.rakuya"):
        path = p.path.rstrip("/")
        if path.endswith("/sell"):
            return [(store_url, "sale")]
        if path.endswith("/rent"):
            return [(store_url, "rent")]
        if _VIP_ROOT_RE.match(p.path) and not is_brand_landing(store_url):
            base = urlunsplit((p.scheme, p.netloc, path, "", ""))
            return [(base + "/sell", "sale"), (base + "/rent", "rent")]
    return [(store_url, "")]


def next_page_url(store_url: str, n: int) -> str:
    """店鋪頁的第 n 頁：覆蓋 page 參數，其餘參數（排序等）原樣保留。"""
    p = urlsplit(store_url)
    q = dict(parse_qsl(p.query))
    q["page"] = str(n)
    return urlunsplit((p.scheme, p.netloc, p.path, urlencode(q), ""))


def pick_list_page(url: str, links: list[dict]) -> str:
    """決定要去哪一頁抓清單。回傳要開的網址，判斷不出來回 ""。

    順序不能反過來——先跟店家連結，最後才看「這頁本身是不是清單頁」：
    物件詳情頁上的「推薦物件／周邊物件」動輒十幾個連結，先用數量判斷會把
    詳情頁當成清單頁，抓回一堆**別人的**物件（實測踩到的）。
    而且貼進來的網址本身若是物件頁，它就一定不是清單頁，不必再猜。
    """
    if is_brand_landing(url):
        return ""                       # 使用者直接貼品牌總頁：那不是任何一家店
    store = find_store_url(links, url)
    if store:
        return store
    if normalize_item_url(url):
        return ""                       # 詳情頁又找不到店家連結 → 沒得抓
    hrefs = [l.get("href") or "" for l in links]
    return url if is_listing_page(hrefs) else ""


def http_error_message(status) -> str:
    """清單頁回了非 200 時，要跟使用者說的話。正常回 ""。

    403／429 一定要單獨講：被暫時擋住跟「這家店沒有出售物件」是完全不同的兩件事，
    講錯會讓人跑去查根本沒問題的地方（實測就是把 403 吞掉，顯示成「沒抓到物件」）。
    """
    if not status or status < 400:
        return ""
    if status in (403, 429):
        return (f"這個網站暫時擋住了自動擷取（HTTP {status}）。"
                f"通常是短時間內抓太多次，等幾分鐘再試一次就會好。")
    return f"店家頁回應 HTTP {status}，可能需要登入，或該站擋自動擷取。"


# ─── 卡片欄位分類 ──────────────────────────────────────

_PRICE_RE = re.compile(r"[\d,.]+\s*(萬|元)")
# 地址行：有縣市又有區鄉鎮。加長度上限，免得把含地名的標題誤判成地址
_ADDR_RE = re.compile(r"[縣市].*[區鄉鎮市]")
_ADDR_MAX = 24
_LAYOUT_RE = re.compile(r"\d\s*房")
_AREA_RE = re.compile(r"^[\d.]+\s*坪$")
_TYPE_RE = re.compile(
    r"^(電梯大廈|大樓|華廈|公寓|透天厝|透天|別墅|農舍|套房|店面|辦公室|廠辦|廠房|土地|農地|車位)$")


# 卡片上的狀態字：不是物件資料，卻常常是「剩下最長的一行」而被誤當標題。
# 2026-09-02 實測：某些店鋪頁的卡片只有 價格／縣市／瀏覽數 三行，
# 沒濾掉的話每一筆標題都變成「瀏覽：0人」。
_NOISE_RE = re.compile(r"^(瀏覽|點閱|人氣)[:：]|^已(售出|成交|下架)|^\d+\s*人$|^\d+次瀏覽$|更新$|^新上架$|^比較$|^追蹤$|^立即預約$|^距離")
# 搜尋結果頁的卡片（2026-09-10 實測 sell/result、rent/result）：地址拆成「太平區」＋「中山路二段」兩行、沒有縣市；
# 價格有「28.47萬/坪」單價與「1,498萬」總價兩行——單價不能當總價。
# 路名行最長 14 字：更長的多半是標題（「…臨路10米路前後庭院雙車別墅」被當成路名，標題就變成「主建51.59坪」，2026-09-10 實測）
_STREET_RE = re.compile(r"^(?=.{2,14}$)[\u4e00-\u9fff0-9０-９]{1,12}(路|街|大道|巷|弄|段|號)[\u4e00-\u9fff0-9]{0,6}$")
_UNIT_PRICE_RE = re.compile(r"/\s*坪")
_CITY_PREFIX_RE = re.compile(r"^.{2,3}[縣市]")
_DISTRICT_RE = re.compile(r"^[\u4e00-\u9fff]{1,3}(區|鄉|鎮|市)$")


def _with_city(address: str, city_hint: str) -> str:
    """地址沒有縣市（搜尋結果頁只給區＋路）就用清單頁標題的縣市補在前面。"""
    a = (address or "").strip()
    if a and city_hint and not _CITY_PREFIX_RE.match(a):
        return city_hint + a
    return a


def _classify(lines: list[str], url: str, city_hint: str = "") -> dict:
    """把一張卡片的文字行分派到各欄位。抓不到就留空——不要猜。"""
    item = {"url": url, "title": "", "address": "", "price": 0, "price_text": "",
            "type": "", "layout": "", "area": "", "age": ""}
    rest, district, street = [], "", ""
    for raw in lines:
        l = (raw or "").strip()
        if not l or l.isdigit():          # 純數字＝相片張數徽章，不是資料
            continue
        if _NOISE_RE.search(l):           # 「瀏覽：0人」「已售出」「33分鐘前更新」之類的狀態字
            continue
        if _UNIT_PRICE_RE.search(l):      # 「28.47萬/坪」是單價，不是總價
            continue
        if not item["price_text"] and _PRICE_RE.search(l) and len(l) <= 20:
            item["price_text"] = l
            item["price"] = parse_price(l)
            continue
        if not item["address"] and len(l) <= _ADDR_MAX and _ADDR_RE.search(l):
            item["address"] = l
            continue
        if not district and _DISTRICT_RE.match(l):
            district = l
            continue
        if not street and _STREET_RE.match(l):
            street = l
            continue
        if not item["layout"] and _LAYOUT_RE.search(l) and len(l) <= 20:
            item["layout"] = l
            continue
        if not item["area"] and _AREA_RE.match(l):
            item["area"] = l
            continue
        if not item["age"] and l.startswith("屋齡"):
            item["age"] = l
            continue
        if not item["type"] and _TYPE_RE.match(l):
            item["type"] = l
            continue
        if l.startswith(("總建", "主建")) and not item["area"]:
            item["area"] = l.replace("總建", "").replace("主建", "")
            continue
        rest.append(l)
    if not item["address"] and (district or street):
        item["address"] = district + street
    item["address"] = _with_city(item["address"], city_hint)
    # 剩下最長的一行當標題：卡片上真正的物件名稱一定是最長的那串
    item["title"] = max(rest, key=len) if rest else ""
    return item


_RENT_TYPE_RE = re.compile(r"^(獨立套房|分租套房|雅房|整層住家|店面|辦公|廠房|土地|車位)$")
_RENT_BUILDING_RE = re.compile(r"^(電梯大廈|透天厝|公寓|華廈|別墅|大樓|套房|其他)$")
_RENT_AGE_RE = re.compile(r"^\d+(\.\d+)?年$")
_RENT_TAGS = ("可養寵物", "可開伙", "附設備", "附傢俱", "租金補貼", "可報稅", "可入籍", "社會住宅")


def _classify_rent(lines: list[str], url: str, city_hint: str = "") -> dict:
    """租屋站的清單卡片：標題／區／路或社區／型式／建物／格局／屋齡／租金／標籤（2026-09-08 實測）。"""
    item = {"url": url, "title": "", "address": "", "price": 0, "price_text": "",
            "type": "", "layout": "", "area": "", "age": "", "tags": [], "deal_type": "rent"}
    rest, district, street = [], "", ""
    for raw in lines:
        l = (raw or "").strip()
        if not l or l.isdigit() or _NOISE_RE.search(l) or _UNIT_PRICE_RE.search(l):
            continue
        if l in _RENT_TAGS:
            item["tags"].append(l)
            continue
        if not item["price_text"] and _PRICE_RE.search(l) and len(l) <= 20:
            item["price_text"] = l
            item["price"] = parse_price(l)
            continue
        if _RENT_TYPE_RE.match(l):
            item["type"] = l if not item["type"] else item["type"]
            continue
        if _RENT_BUILDING_RE.match(l):
            item["type"] = f"{item['type']}/{l}" if item["type"] else l
            continue
        if not item["layout"] and (_LAYOUT_RE.search(l) or l == "開放式格局") and len(l) <= 20:
            item["layout"] = l
            continue
        if not item["area"] and _AREA_RE.match(l):
            item["area"] = l
            continue
        if not item["age"] and (_RENT_AGE_RE.match(l) or l.startswith("屋齡")):
            item["age"] = l if l.startswith("屋齡") else f"屋齡{l}"
            continue
        if not district and _DISTRICT_RE.match(l):
            district = l
            continue
        if not street and ((len(l) <= _ADDR_MAX and _ADDR_RE.search(l)) or _STREET_RE.match(l)):
            street = l
            continue
        if not item["area"] and l.startswith(("總建", "主建")):
            item["area"] = l.replace("總建", "").replace("主建", "")
            continue
        rest.append(l)
    item["address"] = _with_city((district + street) if (district or street) else "", city_hint)
    item["title"] = max(rest, key=len) if rest else ""
    return item


def parse_cards(raw: list[dict]) -> list[dict]:
    """[{url, lines}] → 物件清單。買賣與租件都收（SPEC-P34），去重、正規化網址。"""
    items, seen, seen_fp = [], set(), set()
    for c in raw:
        url = normalize_item_url(c.get("url") or "")
        if not url:
            continue
        if url in seen:
            continue
        seen.add(url)
        hint = c.get("city_hint") or ""
        if is_rent_url(url) or c.get("deal_hint") == "rent":
            it = _classify_rent(c.get("lines") or [], url, hint)
        else:
            it = _classify(c.get("lines") or [], url, hint)
            it["deal_type"] = "sale"
        # 同一地址、同一價格只留一筆——同一間房重複刊登（老闆 2026-09-10：不小心重複就只抓一次）
        fp = (it["deal_type"], "".join((it.get("address") or "").split()), it.get("price") or 0)
        rooms = it["deal_type"] == "rent" and any(k in (it.get("type") or "") for k in ("套房", "雅房", "分租"))
        if fp[1] and fp[2] and not rooms:      # 套房／雅房同一棟多間同租金是正常的，不砍
            if fp in seen_fp:
                continue
            seen_fp.add(fp)
        items.append(it)
    return items


# ─── 瀏覽器端：只撈「連結 + 卡片文字行」，不做任何判斷 ──────

# 卡片容器：從連結往上爬到「仍然只指向一筆物件」的最大節點——那就是卡片。
#
# 判斷用**不重複的物件網址數**，不是連結元素數：卡片裡通常有兩個連結
# （圖片一個、標題一個）指向同一筆，用元素數會在第一層就停住，抓到空字串。
#
# 兩次踩坑都記在這裡（2026-09-02 實測 vip.rakuya.com.tw/hyr）：
#   1. 原本用「文字長度 25～260 且含萬/元」的啟發式 → 該頁卡片文字只有 17 字，
#      條件不成立就一路爬到共同祖先，同組 5 筆共用同一段文字，標題價格全錯。
#   2. 改成「只含一個連結元素」→ 卡片有兩個連結，第一層就停在 <a> 上，全空。
# 結構性判斷不依賴版面文字長度，跨店鋪頁都成立。
LIST_EXTRACT_JS = r"""
() => {
  const SEL = 'a[href*="sell_item"],a[href*="rent_item"],a[href*="rent.rakuya.com.tw/item/"]';
  // 識別：買賣頁用 ehid；租件頁（rent.rakuya.com.tw/item/<碼>?from=store）用路徑——
  // 以前用 query 當識別，租件清單每個連結的 query 都是 from=store，整頁被當成一張卡，標題抓到頁尾的 email
  const idOf = x => { const h = x.href || ''; const m = h.match(/ehid=([0-9a-fA-F]+)/); return m ? m[1] : h.split('?')[0]; };
  const ids = el => new Set([...el.querySelectorAll(SEL)].map(idOf));
  const out = [], seen = new Set();
  document.querySelectorAll(SEL).forEach(a => {
    const href = a.href || '';
    if (!href || seen.has(href)) return;
    seen.add(href);
    let card = a, node = a.parentElement;
    for (let i = 0; i < 8 && node; i++, node = node.parentElement) {
      if (ids(node).size > 1) break;      // 這一層已經含到別筆，停在上一層
      card = node;
    }
    const lines = (card.innerText || '').split('\n').map(s => s.trim()).filter(Boolean);
    out.push({ url: href, lines });
  });
  return out;
}
"""

# 進度判定用：只數「物件連結有幾個」。不看圖片載完沒有——清單匯入根本不下載圖片。
