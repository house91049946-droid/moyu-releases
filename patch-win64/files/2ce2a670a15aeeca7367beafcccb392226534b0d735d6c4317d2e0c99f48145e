"""DeepSeek 文案生成（建立物件時呼叫；發送時不用）。

金鑰來源：env FB_DEEPSEEK_API_KEY 優先，否則讀 backend/data/.deepseek_key（gitignore）。
"""
import json
import os
import re
from pathlib import Path

import httpx

from .config import DATA_DIR

_KEY_FILE = DATA_DIR / ".deepseek_key"
_API_URL = "https://api.deepseek.com/chat/completions"
_MODEL = "deepseek-chat"


class DeepSeekError(Exception):
    pass


def _load_key() -> str:
    key = os.environ.get("FB_DEEPSEEK_API_KEY", "").strip()
    if key:
        return key
    if _KEY_FILE.exists():
        return _KEY_FILE.read_text(encoding="utf-8").strip()
    return ""


def has_key() -> bool:
    return bool(_load_key())


