# 客戶把電話／法定文案寫進基底文案，AI 卻把它吃掉——提示詞已經三令五申
# （雲端與本地兩份都寫了「原封保留、不可刪除」），但模型不是每次都聽話。
# 房仲的聯絡方式與經紀資訊漏掉是會出事的，所以不能只靠提示詞，這裡再補一道
# 確定性的檢查：基底有、生成版本沒有的，直接補回去。
_PHONE_RE = re.compile(r"(?:\+?886[\s\-]?)?0?9\d{2}[\s\-]?\d{3}[\s\-]?\d{3}"
                       r"|\(?0\d\)?[\s\-]?\d{3,4}[\s\-]?\d{4}")
_LEGAL_HINTS = ("經紀人", "經紀業", "字號", "證號", "不動產", "仲介", "公司名稱")


def _digits(s: str) -> str:
    return re.sub(r"\D", "", s)


def must_keep_lines(base_content: str) -> list[str]:
    """從基底文案裡挑出「絕對不能被改寫掉」的行：含電話或法定關鍵字的整行。"""
    keep = []
    for line in (base_content or "").splitlines():
        t = line.strip()
        if not t:
            continue
        if _PHONE_RE.search(t) or any(h in t for h in _LEGAL_HINTS):
            keep.append(t)
    return keep


def restore_dropped_lines(base_content: str, versions: list[dict]) -> list[dict]:
    """生成版本若把 must-keep 的內容弄丟了，補回到內文結尾。

    電話比對只看數字：AI 常把 0912-345-678 改寫成 0912345678 或加空格，
    那種情況不算弄丟，硬補反而會重複。
    """
    keep = must_keep_lines(base_content)
    if not keep:
        return versions
    for v in versions:
        body = v.get("body") or ""
        body_digits = _digits(body)
        missing = []
        for line in keep:
            phones = _PHONE_RE.findall(line)
            if phones:
                if all(_digits(p) in body_digits for p in phones):
                    continue      # 電話還在（可能換了寫法），不必補
            elif line in body:
                continue
            missing.append(line)
        if missing:
            v["body"] = (body.rstrip() + "\n\n" + "\n".join(missing)).strip()
    return versions


def generate_from_base(base_content: str, n_versions: int = 5, timeout: float = 90) -> list[dict]:
    """依使用者貼的基底文案生成 N 個變體。回傳 [{title, body}, ...]（數字/事實鎖定）。

    SaaS 模式（設了 MOYU_CLOUD_URL + 授權金鑰）→ 走雲端 /ai/generate（金鑰在伺服器）。
    否則走本地 DeepSeek（開發後備；SaaS 上線後移除）。
    """
    if not (base_content or "").strip():
        raise DeepSeekError("基底文案是空的")

    # 優先走雲端代理（授權 + 金鑰在伺服器端）
    from .cloud_client import cloud_enabled, ai_generate, CloudError
    if cloud_enabled():
        try:
            return restore_dropped_lines(base_content, ai_generate(base_content, n_versions))
        except CloudError as e:
            raise DeepSeekError(str(e)) from e

    # 後備：本地直呼 DeepSeek（開發用）
    key = _load_key()
    if not key:
        raise DeepSeekError("尚未設定雲端授權，也沒有本地 DeepSeek 金鑰")

    user_prompt = (
        f"基底文案如下（數字/事實必須完全照抄）：\n\n{base_content}\n\n"
        f"請生成 {n_versions} 個不同的變體版本（各含 title 與 body）。"
    )
    payload = {
        "model": _MODEL,
        "messages": [
            {"role": "system", "content": _SYSTEM_PROMPT},
            {"role": "user", "content": user_prompt},
        ],
        "temperature": 1.1,
        "response_format": {"type": "json_object"},
    }
    headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}

    try:
        with httpx.Client(timeout=timeout) as client:
            resp = client.post(_API_URL, json=payload, headers=headers)
    except httpx.HTTPError as e:
        raise DeepSeekError(f"DeepSeek 連線失敗: {e}") from e
    if resp.status_code != 200:
        raise DeepSeekError(f"DeepSeek 回應 {resp.status_code}: {resp.text[:200]}")

    try:
        content = resp.json()["choices"][0]["message"]["content"]
        data = json.loads(content)
    except (KeyError, IndexError, json.JSONDecodeError) as e:
        raise DeepSeekError(f"DeepSeek 回應解析失敗: {e}") from e

    versions = []
    for v in data.get("versions", []):
        if isinstance(v, dict) and v.get("title") and v.get("body"):
            versions.append({"title": str(v["title"]).strip(), "body": str(v["body"]).strip()})
    if not versions:
        raise DeepSeekError("DeepSeek 未生成有效的版本")
    return restore_dropped_lines(base_content, versions)
