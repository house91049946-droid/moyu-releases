class Test22_23匯入解析:
    def test_總價優先_單價不算(self):
        assert ip.parse_price("土地 88 坪｜單價 32 萬｜總價 2,816 萬") == 28160000
        assert ip.parse_price("單價 28.47萬/坪 總價 1,498萬") == 14980000
        assert ip.parse_price("車位價 150萬，售價 1,980萬") == 19800000
        assert ip.parse_price("28.47萬/坪") == 0
        assert ip.parse_price("租金 18,000 元/月") == 18000
        assert ip.parse_price("１，２８８萬") == 12880000
        assert ip.parse_price("1750萬") == 17500000

    def test_坪數各種寫法(self):
        assert ip.parse_area("建坪：38.6坪") == ("38.6坪", 0)
        assert ip.parse_area("權狀 42.31 坪") == ("42.31坪", 0)
        assert ip.parse_area("約28坪")[0] == "28坪"
        assert ip.parse_area("38坪（含車位）")[0] == "38坪"
        assert ip.parse_area("３８．６坪")[0] == "38.6坪"
        assert ip.parse_area("主建物 20.5坪") == ("20.5坪", 1)
        assert ip.parse_area("北屯三房38坪景觀第一排") is None
        assert ip.parse_area("28.47萬/坪") is None

    def test_卡片建物坪數優先於地坪_不被當標題(self):
        item = ip._classify(["台中市北屯區", "地坪 25 坪", "建坪：38.6坪", "北屯機捷特區邊間三房平車", "1,688萬"], "u")
        assert item["area"] == "38.6坪"
        assert item["title"] == "北屯機捷特區邊間三房平車"
        assert item["price"] == 16880000


