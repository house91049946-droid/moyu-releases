class Test1_2_3刊登確認:
    def test_錯誤優先於成功字樣(self):
        kind, _ = mp.classify_publish_feedback(["刊登成功", "無法發佈：發生錯誤，無法建立刊登"])
        assert kind == "error"
        assert mp.classify_publish_feedback(["You've reached the limit for listings"])[0] == "error"

    def test_側欄已發佈商品數不算成功(self):
        assert mp.classify_publish_feedback(["你有 12 件已發佈商品"]) == ("", "")
        assert mp.classify_publish_feedback(["刊登成功"])[0] == "success"
        assert mp.classify_publish_feedback([]) == ("", "")

    def test_只認新的商品ID(self):
        hrefs = ["https://www.facebook.com/marketplace/you/selling",
                 "https://www.facebook.com/marketplace/item/111111/",
                 "https://www.facebook.com/marketplace/item/222222/?ref=x"]
        assert mp.pick_new_item_url(hrefs, {"111111"}).endswith("222222/?ref=x")
        assert mp.pick_new_item_url(hrefs[:2], {"111111"}) is None
        assert marketplace_item_id(hrefs[1]) == "111111"

    def test_你的商品頁要完整標題相等_前24字相同的舊卡不算(self):
        new = "北屯十期臨路雙車電梯豪墅｜四房三衛 景觀戶"
        lines = ["北屯十期臨路雙車電梯豪墅｜四房三衛 邊間", "NT$29,880,000", "上架於 9/30"]
        assert mp.count_listing_matches(lines, new, 29880000) == 0
        assert mp.count_listing_matches(lines + [new.replace("｜", " | "), "NT$29,880,000"], new, 29880000) == 1

    def test_同標題多張用價格分_分不出來就不是1(self):
        t = "北屯三房平車"
        lines = [t, "NT$15,880,000", "x", "x", "x", t, "NT$16,880,000"]
        assert mp.count_listing_matches(lines, t, 15880000) == 1
        assert mp.count_listing_matches(lines, t, 0) == 2

    def test_看不到成功證據回unknown不回成功(self):
        src = inspect.getsource(mp._finish_listing)
        assert 'success=False, status="unknown"' in src
        assert 'success=True, status="審核"' not in src
        assert "known_ids = _known_item_ids(page, fbid)" in src


