class Test4_20認刊登:
    def test_前20字相同的手動刊登不是自己的(self):
        ours = {"台中北屯機捷特區三房平車高樓層"}
        assert dc._title_is_ours("台中北屯機捷特區三房平車屋主自售", ours) is False
        assert dc._title_is_ours("台中北屯機捷特區三房平車高樓層", ours) is True
        assert dc._title_is_ours("🏡台中北屯機捷特區三房平車，高樓層", ours) is True    # emoji、標點不影響

    def test_有ID只看ID(self):
        ids = {"555"}
        assert dc._card_is_ours({"title": "完全不同的標題xxxxxxxx", "item_id": "555"}, set(), ids) is True
        assert dc._card_is_ours({"title": "台中北屯機捷特區三房平車高樓層", "item_id": "999"},
                                {"台中北屯機捷特區三房平車高樓層"}, ids) is False
        assert dc._card_is_ours({"title": "台中北屯機捷特區三房平車高樓層", "item_id": ""},
                                {"台中北屯機捷特區三房平車高樓層"}, ids) is True

    def test_只有ID名單也能刪_沒ID沒相同標題就不刪(self):
        state = [
            {"idx": 0, "title": "台中北屯機捷特區三房平車高樓層", "item_id": "555", "text": "", "age_days": 9},
            {"idx": 1, "title": "台中北屯機捷特區三房平車屋主自售", "item_id": "", "text": "", "age_days": 9},
        ]
        deleted = []

        def fake_delete_one(page, idx):
            nonlocal state
            deleted.append(idx)
            state = [c for c in state if c["idx"] != idx]
            return True

        with mock.patch.object(dc, "perform_checks", return_value=dc.CheckResult.OK), \
             mock.patch.object(dc, "scan_selling_listings", lambda page, fbid, diag=True: list(state)), \
             mock.patch.object(dc, "_collect_cards", lambda page: (list(state), {})), \
             mock.patch.object(dc, "_delete_one_listing", fake_delete_one), \
             mock.patch.object(dc, "_open_selling_page", lambda page: True), \
             mock.patch.object(dc, "human_sleep", lambda *a, **k: None):
            page = mock.MagicMock()
            page.is_closed.return_value = False
            dc.delete_old_marketplace_listings(page, "fbid", max_age_days=7, dry_run=False,
                                               allowed_titles=set(), allowed_ids={"555"})
        assert deleted == [0]

    def test_上架紀錄讀出標題與ID(self, tmp_path, monkeypatch):
        from src import run_delete_marketplace as rd
        (tmp_path / "schedule.log").write_text(
            "2026/10/01 10:00:00;自動上架;成功;fb1;北屯三房平車 高樓景觀;https://www.facebook.com/marketplace/item/777/;1\n"
            "2026/10/01 11:00:00;自動上架;unknown;fb1;北屯三房平車 邊間;;2\n"
            "2026/10/01 12:00:00;自動上架;成功;fb2;別人的;https://www.facebook.com/marketplace/item/888/;3\n",
            encoding="utf-8")
        monkeypatch.setattr(rd, "DATA_DIR", tmp_path)
        posted = rd._load_tool_posted("fb1")
        assert posted[norm_listing_title("北屯三房平車 高樓景觀")] == {"777"}
        assert posted[norm_listing_title("北屯三房平車 邊間")] == set()
        assert "888" not in set().union(*posted.values())

    def test_補刊找卡片帶ID與價格(self):
