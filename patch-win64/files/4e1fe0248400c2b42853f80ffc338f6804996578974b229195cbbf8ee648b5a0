def _gp_next_run_live(sched_id: int):
    from ..scheduler.task_runner import next_run_for
    try:
        return next_run_for(f"gp_{sched_id}_")
    except Exception:
        return None


def _listing_out(row: Property) -> dict:
    return {
        "id": row.id,
        "account_id": row.account_id,
        "name": row.name,
        "base_content": row.base_content or "",
        "source_url": row.source_url or "",
        "enabled": row.enabled if row.enabled is not None else True,
        "titles": row.titles or [],
        "bodies": row.bodies or [],
        "image_pool": row.image_pool or [],
        # 對外欄位名維持原樣（前端不用改），內部讀的是社團發文自己那一份 gp_*
        "target_groups": row.gp_target_groups or [],
        "sleep_min_sec": row.sleep_min_sec,
        "sleep_max_sec": row.sleep_max_sec,
        "success_count": row.gp_success_count or 0,
        "review_count": row.gp_review_count or 0,
        "reject_count": row.gp_reject_count or 0,
        "consecutive_review": row.gp_consecutive_review or 0,
        "health_status": row.gp_health_status or "ok",
        "last_status": row.gp_last_status or "",
        "last_status_at": row.gp_last_status_at.isoformat() if row.gp_last_status_at else None,
        "created_at": row.created_at.isoformat() if row.created_at else None,
    }


