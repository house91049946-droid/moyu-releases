@router.get("/status")
async def gp_status(session: AsyncSession = Depends(get_session)):
    st = get_system_state_sync()
    # 只算掛了「社團發文」通道的——併表後直接 count 會把純 Marketplace 物件也算進來
    rows = (await session.execute(select(Property.channels))).scalars().all()
    listings = sum(1 for c in rows if "gp" in (c or []))
    running = (await session.execute(
        select(func.count(GpSchedule.id)).where(GpSchedule.status == "running")
    )).scalar() or 0
    # 社團發文只寫 RunLog(task_type=group_post)，不寫 PostHistory
    today = datetime.utcnow().date()
    today_posts = (await session.execute(
        select(func.count(RunLog.id)).where(
            RunLog.task_type == "group_post",
            func.date(RunLog.created_at) == today,
            RunLog.status.in_(("success", "needs_manual")),
        )
    )).scalar() or 0
    return {
        "paused": st.get("paused", False),
        "pause_reason": st.get("pause_reason", ""),
        "pause_detail": st.get("pause_detail", ""),
        "listings": listings,
        "running_schedules": running,
        "today_posts": today_posts,
        **_gp_stats_bar(),
    }


def _gp_stats_bar() -> dict:
    from .properties import _stats_bar
    return _stats_bar("group_post", "gp_")


