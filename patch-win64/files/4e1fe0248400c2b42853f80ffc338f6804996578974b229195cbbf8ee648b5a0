    return {
        "id": s.id,
        "account_id": s.account_id,
        "listing_ids": s.listing_ids or [],
        "time_mode": s.time_mode,
        "time_points": s.time_points or [],
        "window_start": s.window_start,
        "window_end": s.window_end,
        "daily_count": s.daily_count,
