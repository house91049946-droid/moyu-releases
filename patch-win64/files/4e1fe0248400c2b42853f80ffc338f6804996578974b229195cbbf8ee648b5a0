@router.delete("/listings/{listing_id}")
async def delete_listing(listing_id: int, session: AsyncSession = Depends(get_session)):
    """在社團發文這一頁刪除＝「這間房不要再發到社團」。

    併表之後（2026-09-06）一筆就是一間房，直接 delete 會連 Marketplace 那邊
    一起消失——使用者只是想收掉社團發文，不該賠上另一個通道。
    所以只有在「社團發文是它唯一的通道」時才真的刪掉整筆。
    """
    row = (await session.execute(
        select(Property).where(Property.id == listing_id)
    )).scalar_one_or_none()
    if not row:
        raise HTTPException(404, "物件不存在")
    chans = [c for c in (row.channels or ["gp"]) if c != "gp"]
    if chans:
        row.channels = chans
        await session.commit()
        return {"message": "已從社團發文移除（Marketplace 那邊保留）", "removed_channel_only": True}
    await session.delete(row)
    await session.commit()
    return {"message": "已刪除", "removed_channel_only": False}


