@router.get("/groups/candidates")
async def gj_candidates(limit: int = 50, session: AsyncSession = Depends(get_session)):
    rows = (await session.execute(select(GroupJoinCandidate)
                                  .order_by(GroupJoinCandidate.members.desc())
                                  .limit(max(1, min(200, limit))))).scalars().all()
    return {"items": [{"id": r.id, "url": r.group_url, "name": r.name, "members": r.members,
                       "privacy": r.privacy, "status": r.status, "keyword": r.keyword,
                       "note": r.note} for r in rows]}


@router.post("/groups/candidates/{cid}/exclude")
async def gj_exclude(cid: int, session: AsyncSession = Depends(get_session)):
    row = (await session.execute(select(GroupJoinCandidate)
                                 .where(GroupJoinCandidate.id == cid))).scalar_one_or_none()
    if row is None:
        raise HTTPException(404, "找不到這個候選")
    row.status = "excluded"
    await session.commit()
    return {"excluded": True}


@router.get("/groups/new-joined")
async def new_joined(account_id: int, session: AsyncSession = Depends(get_session)):
    """剛加入、還不能發文的社團（前端在社團清單旁顯示「X 天後可發」）。"""
    rows = (await session.execute(select(Group).where(
        Group.account_id == account_id, Group.joined_at.isnot(None)))).scalars().all()
    out = []
    for g in rows:
        left = gj.days_until_postable(g.joined_at)
        if left > 0:
            out.append({"name": g.group_name, "url": g.group_url, "days_left": left})
    return {"items": sorted(out, key=lambda x: x["days_left"])}


# ─── 推薦社團（老闆 2026-09-29：直接給一份建議加入清單，不用客戶自己搜） ───

REC_REGIONS = ["台北市", "新北市", "桃園市", "台中市", "台南市", "高雄市"]


def _gid(url: str) -> str:
    import re
    m = re.search(r"/groups/([^/?#]+)", url or "")
    return m.group(1) if m else ""


def mark_recommended(rows: list[dict], joined_ids: set[str], cand_ids: set[str]) -> list[dict]:
    """純函式：推薦清單標上「已加入／已在候選」。"""
    out = []
    for g in rows:
        gid = _gid(g.get("url", ""))
        out.append({**g, "have": "joined" if gid in joined_ids else ("candidate" if gid in cand_ids else "")})
    return out


async def _rec_fetch(region: str, kind: str) -> dict:
    import asyncio
    from urllib.parse import urlencode
    from ..cloud_client import cloud_enabled, _auth_json
    if not cloud_enabled():
        raise HTTPException(422, "推薦社團要連雲端，請先啟用授權")
    try:
        st, body = await asyncio.to_thread(_auth_json, "GET", "/groups/recommended?" + urlencode({"region": region, "kind": kind}))
    except Exception as e:      # noqa: BLE001
        raise HTTPException(502, f"讀不到推薦清單：{e}")
    if st != 200:
        raise HTTPException(502, f"讀不到推薦清單（HTTP {st}）")
    return body


async def _have_ids(session: AsyncSession, account_id: int) -> tuple[set[str], set[str]]:
    joined = {_gid(u) for (u,) in (await session.execute(
        select(Group.group_url).where(Group.account_id == account_id))).all()}
    cands = {_gid(u) for (u,) in (await session.execute(select(GroupJoinCandidate.group_url))).all()}
    return joined - {""}, cands - {""}


@router.get("/groups/recommended")
async def gj_recommended(account_id: int, region: str = "", kind: str = "sale",
                         session: AsyncSession = Depends(get_session)):
    body = await _rec_fetch(region, kind)
    joined, cands = await _have_ids(session, account_id)
    return {"updated": body.get("updated", ""), "regions": body.get("regions") or REC_REGIONS,
            "groups": mark_recommended(body.get("groups") or [], joined, cands)}


class RecAddIn(BaseModel):
    friendly_first: bool = False
    region: str
    kind: str = "sale"
    urls: list[str] | None = None       # 只加客戶勾的這幾個（老闆 2026-09-29：要能自己選）；None＝全部


@router.post("/groups/recommended/add")
async def gj_recommended_add(account_id: int, data: RecAddIn, session: AsyncSession = Depends(get_session)):
    """把這個縣市的推薦社團（還沒加入、還不在候選的）整批放進候選名單，之後照每日上限慢慢加。"""
    import asyncio
    body = await _rec_fetch(data.region, data.kind)
    joined, cands = await _have_ids(session, account_id)
    label = f"推薦·{data.region}·{'租屋' if data.kind == 'rent' else '買賣'}"
    pick = {_gid(u) for u in data.urls} if data.urls is not None else None
    todo = [{**g, "source": "recommend", "keyword": label,
             "join_priority": int((g.get("quality") or {}).get("score", 0) * 1000000)
                 if data.friendly_first and (g.get("quality") or {}).get("enough_data")
                 and ((g.get("quality") or {}).get("success_rate") or 0) >= 80 else 0}
            for g in mark_recommended(body.get("groups") or [], joined, cands)
            if not g["have"] and (pick is None or _gid(g.get("url", "")) in pick)]
    n = await asyncio.to_thread(gj.save_candidates, todo, label)
    return {"added": n, "skipped": (len(pick) if pick is not None else len(body.get("groups") or [])) - n}
