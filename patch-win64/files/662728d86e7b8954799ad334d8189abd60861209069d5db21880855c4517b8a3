def test_budget_remaining_respects_cloud_snapshot(monkeypatch):
    """雲端聚合已用 9/10 → 即使本地只用 2，剩餘 listings 以雲端為準 = 1。"""
    import app.database as db
    monkeypatch.setattr(db, "get_daily_budget_sync", lambda: (2, 5))
    monkeypatch.setattr(db, "current_limits_sync", lambda: (10, 50))
    snap = {"date": "x", "listings": 9, "posts": 10,
            "caps": {"listings": 10, "posts": 50}}
    monkeypatch.setattr(cc, "cloud_usage_snapshot", lambda: snap)
    rl, rp = db.budget_remaining_sync()
    assert rl == 1                                   # min(10-2, 10-9)
    assert rp == 40                                  # min(50-5, 50-10)

    monkeypatch.setattr(cc, "cloud_usage_snapshot", lambda: None)
    rl, rp = db.budget_remaining_sync()
    assert (rl, rp) == (8, 45)                       # 無快照 → 純本地


def test_hardware_fingerprint_stable_hash():
    """有硬體資訊的平台：回 64 位 sha256 hex 且跨次呼叫穩定。"""
    fp1, fp2 = cc._hardware_fingerprint(), cc._hardware_fingerprint()
    if fp1:                                          # CI/容器可能取不到 → 空字串走檔案型
        assert len(fp1) == 64 and fp1 == fp2
    assert cc._machine_fingerprint()                 # 任何平台都要拿得到指紋


def test_set_and_clear_license_key(monkeypatch):
    monkeypatch.delenv("MOYU_LICENSE_KEY", raising=False)   # 讓檔案生效
    monkeypatch.setattr(cc, "license_status", lambda probe=True: {"state": "ok"})
    cc.set_license_key("  LIC-NEW-KEY  ")
    assert cc._LICENSE_FILE.read_text(encoding="utf-8") == "LIC-NEW-KEY"
    assert cc.license_key() == "LIC-NEW-KEY"
    cc.clear_license_key()
    assert not cc._LICENSE_FILE.exists()
    assert cc._load_state() == {}
