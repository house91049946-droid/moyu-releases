async def _reap_jobs_loop():
    """每分鐘收尾「已結束但沒人再輪詢」的長時任務。

    RunLog 原本只在前端輪詢時才收尾，前端關掉就永遠停在「執行中」。
    """
    import asyncio
    import contextlib
    from .fbauto_bridge import reap_finished_jobs
    while True:
        await asyncio.sleep(60)
        with contextlib.suppress(Exception):
            n = await asyncio.to_thread(reap_finished_jobs)
            if n:
                print(f"[reaper] 已收尾 {n} 筆結束但未回收的任務", flush=True)


async def _cloud_heartbeat_loop():
    """SaaS：每 6h 打 heartbeat（續期 token/回報存活）＋ 重抓下發設定。
    啟動時先跑一次；失敗靜默（離線寬限由 cloud_client 處理）。"""
    import asyncio
    import contextlib
    from .cloud_client import cloud_enabled, heartbeat, fetch_config
    while True:
        with contextlib.suppress(Exception):
            if cloud_enabled():
                await asyncio.to_thread(heartbeat)
        with contextlib.suppress(Exception):
            await asyncio.to_thread(fetch_config)
        await asyncio.sleep(6 * 3600)


@asynccontextmanager
async def lifespan(app: FastAPI):
    # 啟動時
    # 舊便攜包 → 安裝版的一次性資料遷移，必須在 init_db() 之前：
    # 一旦建了空的 fb_poster.db，就分不出「全新安裝」和「還沒搬過來」了。
    import traceback
    # 檔案描述元上限：.app／launchd 給的 256 會被所有 CLI 子進程繼承，Chrome 不夠用
    # 就會卡在載入網頁（見 proc_utils.raise_fd_limit）。要在 spawn 任何東西之前做。
    try:
        from .proc_utils import raise_fd_limit
        limit = raise_fd_limit()
        if limit is not None:
            print(f"[startup] 檔案描述元上限：{limit}", flush=True)
    except Exception:
        print("[startup] 調整檔案描述元上限失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    try:
        from .data_migration import migrate_if_needed
        r = migrate_if_needed()
        if r["status"] == "migrated":
            print(f"[startup] 已從舊版搬入 {r['files']} 個檔案"
                  f"（{r['bytes'] / 1e6:.1f} MB）：{r['source']}", flush=True)
    except Exception:
        print("[startup] 資料遷移失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    # 備份還原（兩段式第二段）：必須在 init_db() 之前——此刻資料庫還沒被開啟，
    # Windows 才允許覆蓋 fb_poster.db（匯入當下動手會 WinError 32，2026-08-06 實測）
    try:
        from .api.backup import apply_pending_restore
        r = apply_pending_restore()
        if r:
            print(f"[startup] 備份還原完成：{r['restored']} 個檔案"
                  + (f"，失敗 {len(r['failed'])} 個：{r['failed'][:5]}" if r["failed"] else ""),
                  flush=True)
    except Exception:
        print("[startup] 備份還原失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    init_db()
    from .database import migrate_plaintext_passwords
    migrate_plaintext_passwords()
    # 社團發文物件併進 properties（冪等；gp_listings 不刪，出事可回退）
    try:
        from .database import merge_gp_listings_into_properties
        r = merge_gp_listings_into_properties()
        if r["moved"]:
            print(f"[startup] 社團發文物件已併入：搬 {r['moved']} 筆"
                  f"（合併 {r['linked']}、新建 {r['created']}），"
                  f"重新對映 {r['schedules']} 個排程", flush=True)
    except Exception:
        print("[startup] 合併社團發文物件失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    # 上次沒收尾的 running 任務：子進程不跨重啟，留著會在執行紀錄永遠轉圈
    try:
        from .fbauto_bridge import reconcile_orphan_run_logs_sync
        n = reconcile_orphan_run_logs_sync()
        if n:
            print(f"[startup] 已收尾 {n} 筆上次未完成的執行紀錄", flush=True)
    except Exception:
        print("[startup] 收尾執行紀錄失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    # macOS：進程內停用 App Nap——整夜閒置時計時器被節流，排程一件都不發
    # （2026-08 mini 實案）。失敗無妨，下面另有 watchdog 當第二道防線。
    from .macos_nap import disable_app_nap
    nap_ok, nap_msg = disable_app_nap()
    print(f"[startup] App Nap：{nap_msg}", flush=True)
    task_scheduler.start()
    from .scheduler.task_runner import start_scheduler_watchdog
    start_scheduler_watchdog()
    # 手機開關同步（SPEC-P30 v2）：每 30 秒與雲端信箱對一次。雲端不可用就安靜跳過。
    try:
        from apscheduler.triggers.interval import IntervalTrigger as _IT
        from .scheduler.mobile_sync import sync_once as _mobile_sync
        task_scheduler._scheduler.add_job(_mobile_sync, trigger=_IT(seconds=30), id="mobile_sync",
                                          replace_existing=True, max_instances=1, coalesce=True)
    except Exception as _e:
        print(f"[startup] 手機同步排程未啟動：{_e}", flush=True)
    # 排程還原一律不得阻擋後端啟動：任一失敗只記錄，服務仍要起得來
    from .scheduler.task_runner import restore_jobs
    from .scheduler.marketplace_runner import restore_marketplace_schedules
    from .scheduler.group_post_runner import restore_group_post_schedules
    from .scheduler.nurture_runner import restore_nurture_schedule
    from .scheduler.friend_runner import restore_friend_schedule
    from .scheduler.cleanup_runner import restore_cleanup_schedule
    from .scheduler.group_join_runner import restore_group_join_schedule
    for name, restore in (
        ("task_runner", restore_jobs),
        ("marketplace", restore_marketplace_schedules),
        ("group_post", restore_group_post_schedules),
        ("nurture", restore_nurture_schedule),
        ("friend", restore_friend_schedule),
        ("cleanup", restore_cleanup_schedule),
        ("group_join", restore_group_join_schedule),
    ):
        try:
            await restore()
        except Exception:
            print(f"[startup] {name} 排程還原失敗，服務仍繼續啟動：", flush=True)
            traceback.print_exc()
    # SaaS：heartbeat + 下發設定背景迴圈（含啟動時先跑一次）
    import asyncio
    hb_task = asyncio.create_task(_cloud_heartbeat_loop())
    reap_task = asyncio.create_task(_reap_jobs_loop())
    # 補丁更新：背景下載新版檔案到 staging，下次啟動由 _apply_update.py 套用。
    # 同樣不得阻擋啟動——這裡只起一條 daemon thread，例外全關在裡面。
    try:
        from .update_downloader import start_background_checks
        start_background_checks()
    except Exception:
        print("[startup] 更新檢查啟動失敗，服務仍繼續啟動：", flush=True)
        traceback.print_exc()
    yield
    # 關閉時：停排程器並盡力中止仍在跑的子進程
    reap_task.cancel()
    hb_task.cancel()
    task_scheduler.stop()
    from .fbauto_bridge import _RUNNING, kill_job
    for key in list(_RUNNING.keys()):
        kill_job(key)


