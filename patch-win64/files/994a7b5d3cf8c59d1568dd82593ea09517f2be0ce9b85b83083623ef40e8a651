@app.get("/api/status")
async def system_status():
    """取得系統運行狀態"""
    from sqlalchemy import select, func
    from .database import async_session_factory, Account, PostTask, PostHistory, Group

    async with async_session_factory() as session:
        acc_count = await session.scalar(select(func.count(Account.id)))
        running_tasks = await session.scalar(
            select(func.count(PostTask.id)).where(PostTask.status == "running")
        )
        today = __import__("datetime").datetime.utcnow().date()
        today_posts = await session.scalar(
            select(func.count(PostHistory.id)).where(
                func.date(PostHistory.post_time) == today
            )
        )
        group_count = await session.scalar(select(func.count(Group.id)))

    return {
        "accounts": acc_count,
        "running_tasks": running_tasks,
        "today_posts": today_posts,
        "group_count": group_count,
        "scheduler_running": task_scheduler._scheduler.running if task_scheduler._scheduler else False,
    }


