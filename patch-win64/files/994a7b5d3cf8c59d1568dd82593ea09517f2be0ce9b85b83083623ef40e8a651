# SaaS 授權硬鎖：未啟用授權（或超過離線寬限）→ 除白名單外所有 API 一律 403。
# 白名單：健康檢查、授權管理（要能輸入金鑰）、版本檢查、疑難排解。
# 疑難排解放行的理由：授權出問題時（例如已付款但授權沒生效）客戶正需要匯出診斷包
# 回報，若被 gate 擋住就變成死結。它只讀日誌與環境資訊，不含機密。
# 備份放行的理由：重灌後本機沒有授權金鑰 → 被 gate 擋住 → 但金鑰正好在備份檔裡，
# 不放行就永遠匯不進來（死結）。後端只聽 127.0.0.1，操作者就是本機使用者本人。
# 開發環境由 start_servers 腳本設 MOYU_DEV_MODE=1 放行（客戶包不設）。
# /api/consent 在白名單：同意是在「申請／啟用」當下勾選的，
# 那時還沒有授權，不放行就沒辦法在申請頁記錄同意。
LICENSE_GATE_WHITELIST = ("/api/health", "/api/license", "/api/version",
                          "/api/troubleshoot", "/api/backup", "/api/consent")


def _gate_blocks(path: str) -> bool:
    return path.startswith("/api") and not any(path.startswith(w) for w in LICENSE_GATE_WHITELIST)


@app.middleware("http")
async def license_gate(request, call_next):
    import asyncio as _aio
    from fastapi.responses import JSONResponse

    if _gate_blocks(request.url.path):
        from .cloud_client import license_gate_ok
        if not await _aio.to_thread(license_gate_ok):
            return JSONResponse(status_code=403, content={
                "detail": "尚未啟用授權或授權已失效，請至「工具箱 → 授權管理」輸入金鑰",
                "code": "license_required",
            })
    return await call_next(request)

