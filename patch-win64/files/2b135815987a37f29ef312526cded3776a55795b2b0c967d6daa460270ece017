"""自動加好友的每日排程（SPEC-P31）：FB 送好友邀請、IG 追蹤、Threads 沿用 P29 追蹤。

跟養號排程同一套骨架（window 內隨機一個時間點、每日 00:20 重規劃），但更保守：
- 一天只跑一輪；硬上限寫死（FB 8 / IG 10 / Threads 20），設定再大也不准超過。
- 發文優先：P28 平台暫停、FB 養號保護期、系統暫停、瀏覽器忙 → 這輪略過並寫紀錄。
- 結果透過 fbauto_bridge 的 on_done 回呼落 friend_actions——排程啟動的工作沒人輪詢，
  不掛回呼的話「邀過誰」就丟了，明天會再邀同一個人。
"""
from __future__ import annotations

import datetime
import json
import os
import random
import tempfile

from sqlalchemy import select

from ..database import (async_session_factory, SyncSession, Account, FriendConfig, FriendAction,
                        ThreadsAccount, ThreadsLead, ThreadsLeadConfig)
from .marketplace_planner import plan_daily_times
from .nurture_runner import TAIPEI, _as_taipei
from .task_runner import scheduler

from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.date import DateTrigger

PLATFORMS = ("fb", "ig", "threads")
HARD_CAP = {"fb": 8, "ig": 10, "threads": 20}
DEFAULTS = {
    "fb": dict(daily_max=2, sources="own_posts,pymk", like_probability=20),   # 預設保守（2026-09-07）
    "ig": dict(daily_max=3, sources="own_posts,hashtags", like_probability=30),
}
VALID_SOURCES = {"fb": ("own_posts", "pymk", "groups"), "ig": ("own_posts", "hashtags")}
JOB_PREFIX = "friend_"


def effective_max(platform: str, requested: int | None) -> int:
    cap = HARD_CAP.get(platform, 4)
    n = requested or DEFAULTS.get(platform, {}).get("daily_max", 4)
    return max(1, min(cap, int(n)))


def clean_sources(platform: str, raw: str) -> str:
    """只留該平台認得的來源，保留順序、去重；全空就回預設。"""
    seen = []
    for tok in (raw or "").split(","):
        t = tok.strip()
        if t in VALID_SOURCES.get(platform, ()) and t not in seen:
            seen.append(t)
    return ",".join(seen) or DEFAULTS.get(platform, {}).get("sources", "")


async def get_or_create_config(session, account_id: int, platform: str) -> FriendConfig:
    cfg = (await session.execute(
        select(FriendConfig).where(FriendConfig.account_id == account_id,
                                   FriendConfig.platform == platform))).scalars().first()
    if cfg is None:
        d = DEFAULTS.get(platform, DEFAULTS["fb"])
        cfg = FriendConfig(account_id=account_id, platform=platform, enabled=False, **d)
        session.add(cfg)
        await session.flush()
    return cfg


# ── 結果落庫（sync：on_done 從 poll/reaper 的執行緒叫進來）────────────────────────

def record_actions(platform: str, data: dict, run_log_id: int | None = None) -> int:
    """把 CLI 回報的 targets 寫進 friend_actions；同一個人只留第一筆。回寫入筆數。"""
    action = "request" if platform == "fb" else "follow"
    n = 0
    with SyncSession() as s:
        for t in (data or {}).get("targets") or []:
            key = str(t.get("key") or "").strip()
            # failed 不能記：2026-09-03 實測，驗證誤判成失敗的那兩個人被寫進表裡，
            # 之後永遠被當成「邀過」跳過——邀請其實根本沒送出。
            if not key or t.get("status") in ("dry_run", "failed"):
                continue
            exists = s.execute(select(FriendAction).where(
                FriendAction.platform == platform, FriendAction.target_key == key)).scalar_one_or_none()
            if exists:
                continue
            s.add(FriendAction(platform=platform, target_key=key, target_name=(t.get("name") or "")[:200],
                               target_url=(t.get("url") or "")[:500], source=t.get("source") or "",
                               action=action, liked=bool(t.get("liked")),
                               status=t.get("status") or "sent", run_log_id=run_log_id))
            n += 1
        s.commit()
    return n


def known_keys(platform: str) -> list[str]:
    with SyncSession() as s:
        return [k for (k,) in s.execute(
            select(FriendAction.target_key).where(FriendAction.platform == platform)).all()]


def _write_exclude_file(platform: str) -> str:
    fd, path = tempfile.mkstemp(prefix=f"friend_{platform}_", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(known_keys(platform), f, ensure_ascii=False)
    return path


def _mark_ran(platform: str, account_id: int) -> None:
    with SyncSession() as s:
        cfg = s.execute(select(FriendConfig).where(FriendConfig.account_id == account_id,
                                                   FriendConfig.platform == platform)).scalars().first()
        if cfg is not None:
            cfg.last_run_date = datetime.date.today().isoformat()
            s.commit()


def _apply_block(platform: str, data: dict) -> None:
    """被限制 → 交給 P28 的平台暫停（FB 沒有 P28 欄位，只寫日誌）。"""
    if not (data or {}).get("blocked"):
        return
    if platform not in ("ig", "threads"):
        print(f"[friend] FB 加好友被限制：{data.get('block_reason') or ''}", flush=True)
        return
    from .. import platform_block
    with SyncSession() as s:
        acc = s.execute(select(ThreadsAccount)).scalars().first()
        if acc is not None:
            platform_block.mark_blocked(acc, platform, data.get("block_reason") or "action_blocked")
            s.commit()


def make_on_done(platform: str, account_id: int, exclude_path: str | None = None):
    def _cb(result):
        try:
            data = result.data or {}
            n = record_actions(platform, data)
            _mark_ran(platform, account_id)
            _apply_block(platform, data)
            print(f"[friend] {platform} 收尾：記錄 {n} 人", flush=True)
        finally:
            if exclude_path:
                try:
                    os.unlink(exclude_path)
                except OSError:
                    pass
    return _cb


# ── 啟動一輪 ────────────────────────────────────────────────────────────────────

def build_args(platform: str, cfg: FriendConfig, exclude_path: str, fbid: str = "") -> list[str]:
    args = ["--max", str(effective_max(platform, cfg.daily_max)),
            "--sources", clean_sources(platform, cfg.sources),
            "--like-probability", str((cfg.like_probability or 0) / 100),
            "--exclude-file", exclude_path, "--headless"]
    if platform == "fb":
        args = ["--fbid", fbid] + args
    if platform == "ig" and (cfg.hashtags or "").strip():
        args += ["--hashtags", cfg.hashtags.strip()]
    return args


async def skip_reason(session, account_id: int, platform: str, cfg: FriendConfig | None = None) -> str:
    """回傳這輪該略過的原因（空字串＝可以跑）。發文優先：任何保護機制都比加好友重要。"""
    from ..database import get_system_state_sync, posting_grace_remaining_sync
    import asyncio
    try:
        st = await asyncio.to_thread(get_system_state_sync)
        if getattr(st, "paused", None) or (isinstance(st, dict) and st.get("paused")):
            return "系統已暫停"
    except Exception:
        pass
    if platform == "fb":
        acc = (await session.execute(select(Account).where(Account.id == account_id))).scalar_one_or_none()
        if not acc or not acc.fb_user_id:
            return "FB 尚未綁定"
        from ..fbauto_bridge import cookie_exists
        if not cookie_exists(acc.fb_user_id):
            return "FB 登入態不存在"
        days = await asyncio.to_thread(posting_grace_remaining_sync, getattr(acc, "fb_bound_at", None))
        if days > 0:
            return f"新帳號養號期還剩 {days} 天，不加好友"
    else:
        from .. import platform_block
        acc = (await session.execute(select(ThreadsAccount))).scalars().first()
        if acc is None:
            return f"{'IG' if platform == 'ig' else 'Threads'} 尚未連結"
        if platform_block.is_blocked(acc, platform):
            return platform_block.block_note(acc, platform)
    if cfg is not None and (cfg.last_run_date or "") == datetime.date.today().isoformat():
        return "今天已經跑過一輪"
    return ""


async def run_friend_once(account_id: int, platform: str, force: bool = False) -> dict:
    """跑一輪（排程與「現在跑一次」共用）。回 {"job_id"} 或 {"skipped": 原因}。"""
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    if platform == "threads":
        return await _run_threads_once(force)
    async with async_session_factory() as s:
        cfg = await get_or_create_config(s, account_id, platform)
        await s.commit()
        if not cfg.enabled and not force:
            return {"skipped": "未開啟"}
        why = await skip_reason(s, account_id, platform, None if force else cfg)
        if why:
            print(f"[friend] {platform} 略過：{why}", flush=True)
            return {"skipped": why}
        fbid = ""
        if platform == "fb":
            acc = (await s.execute(select(Account).where(Account.id == account_id))).scalar_one()
            fbid = acc.fb_user_id
    busy = browser_busy_reason()
    if busy:
        return {"skipped": f"目前有「{busy}」正在使用瀏覽器"}
    exclude_path = _write_exclude_file(platform)
    module = "src.run_fb_friend" if platform == "fb" else "src.run_ig_follow"
    try:
        job_id = start_long_op(f"friend_{platform}", module, build_args(platform, cfg, exclude_path, fbid),
                               account_id=account_id, fbid=fbid,
                               on_done=make_on_done(platform, account_id, exclude_path))
    except RuntimeError as e:
        os.unlink(exclude_path)
        return {"skipped": str(e)}
    print(f"[friend] {platform} 加好友啟動（job {job_id}）", flush=True)
    return {"job_id": job_id}


async def _run_threads_once(force: bool) -> dict:
    """Threads：沿用 P29——有待追蹤候選就追，沒有就先探索、探索完自動接著追。"""
    from .. import platform_block
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    async with async_session_factory() as s:
        c = (await s.execute(select(ThreadsLeadConfig))).scalars().first()
        if c is None or (not c.enabled and not force):
            return {"skipped": "未開啟"}
        if not force and (c.last_run_date or "") == datetime.date.today().isoformat():
            return {"skipped": "今天已經跑過一輪"}
        acc = (await s.execute(select(ThreadsAccount))).scalars().first()
        if acc is None:
            return {"skipped": "Threads 尚未連結"}
        if platform_block.is_blocked(acc, "threads"):
            return {"skipped": platform_block.block_note(acc, "threads")}
        limit = max(1, min(HARD_CAP["threads"], c.daily_limit or 10))
        pending = (await s.execute(select(ThreadsLead).where(ThreadsLead.status == "new")
                                   .order_by(ThreadsLead.created_at.desc()).limit(limit))).scalars().all()
        users = [r.username for r in pending]
        keywords, region = c.keywords or "", (c.region or "").strip()
    busy = browser_busy_reason()
    if busy:
        return {"skipped": f"目前有「{busy}」正在使用瀏覽器"}
    if users:
        job_id = start_long_op("leads_follow", "src.run_threads_follow",
                               ["--users", ",".join(users), "--max-follow", str(limit), "--headless"],
                               on_done=_threads_follow_done)
        return {"job_id": job_id}
    args = ["--keywords", keywords, "--max-results", "50", "--headless"]
    if region:
        args += ["--region", region]
    job_id = start_long_op("leads_search", "src.run_threads_search", args,
                           on_done=_threads_search_done(limit))
    return {"job_id": job_id}


def _threads_search_done(limit: int):
    def _cb(result):
        d = result.data or {}
        added = []
        with SyncSession() as s:
            for it in d.get("items", []):
                u = (it.get("username") or "").strip()
                if not u:
                    continue
                if s.execute(select(ThreadsLead).where(ThreadsLead.username == u)).scalar_one_or_none():
                    continue
                s.add(ThreadsLead(username=u, post_url=it.get("post_url", ""),
                                  snippet=it.get("snippet", ""), posted_at=it.get("posted_at", "")))
                added.append(u)
            s.commit()
        if not added:
            print("[friend] Threads 探索沒有新候選，這輪不追蹤", flush=True)
            return
        from ..fbauto_bridge import start_long_op
        try:
            start_long_op("leads_follow", "src.run_threads_follow",
                          ["--users", ",".join(added[:limit]), "--max-follow", str(limit), "--headless"],
                          on_done=_threads_follow_done)
        except RuntimeError as e:
            print(f"[friend] Threads 探索完無法接著追蹤：{e}", flush=True)
    return _cb


def _threads_follow_done(result):
    d = result.data or {}
    with SyncSession() as s:
        for u in d.get("followed", []):
            row = s.execute(select(ThreadsLead).where(ThreadsLead.username == u)).scalar_one_or_none()
            if row:
                row.status = "followed"
                row.followed_at = datetime.datetime.utcnow()
        for sk in d.get("skipped", []):
            u = sk.get("username") if isinstance(sk, dict) else sk
            row = s.execute(select(ThreadsLead).where(ThreadsLead.username == u)).scalar_one_or_none()
            if row and row.status == "new":
                row.status = "skipped"
        c = s.execute(select(ThreadsLeadConfig)).scalars().first()
        if c is not None:
            c.last_run_date = datetime.date.today().isoformat()
        s.commit()
    _apply_block("threads", d)


# ── 排程 ─────────────────────────────────────────────────────────────────────────

def _remove_jobs():
    for job in list(scheduler.get_jobs()):
        if job.id.startswith(JOB_PREFIX) and job.id != "friend_daily_replan":
            job.remove()


async def _scheduled(account_id: int, platform: str):
    r = await run_friend_once(account_id, platform)
    if r.get("skipped") and "瀏覽器" in r["skipped"]:
        # 忙就讓路，30 分鐘後再試一次（同一天只會重試一次，靠 last_run_date 擋）
        t = datetime.datetime.now(TAIPEI) + datetime.timedelta(minutes=30)
        scheduler.add_job(func=_scheduled, trigger=DateTrigger(run_date=t), args=[account_id, platform],
                          id=f"{JOB_PREFIX}{platform}_retry", replace_existing=True)


async def plan_and_schedule() -> list[str]:
    """每個開啟的平台在 window 內隨機排一個時間點（今天剩餘的才排）。"""
    _remove_jobs()
    plans = []
    async with async_session_factory() as s:
        rows = (await s.execute(select(FriendConfig).where(FriendConfig.enabled == True))).scalars().all()  # noqa: E712
        for r in rows:
            plans.append((r.account_id, r.platform, (r.window_start or "10:00", r.window_end or "21:00")))
        tc = (await s.execute(select(ThreadsLeadConfig))).scalars().first()
        if tc is not None and tc.enabled:
            acc = (await s.execute(select(Account).order_by(Account.id))).scalars().first()
            plans.append((acc.id if acc else 0, "threads", (tc.window_start or "10:00", tc.window_end or "21:00")))
    now = datetime.datetime.now(TAIPEI)
    out = []
    for account_id, platform, window in plans:
        times = [_as_taipei(t) for t in plan_daily_times("window", [], window[0], window[1], 1, False, now.date())]
        for t in times:
            if t <= now:
                continue
            scheduler.add_job(func=_scheduled, trigger=DateTrigger(run_date=t), args=[account_id, platform],
                              id=f"{JOB_PREFIX}{platform}", replace_existing=True)
            out.append((t, platform))
    out.sort()
    labels = [f"{t.strftime('%H:%M')}({ {'fb': 'FB', 'ig': 'IG', 'threads': 'Threads'}[p] })" for t, p in out]
    if labels:
        print(f"[friend] 今日自動加好友已排：{'、'.join(labels)}", flush=True)
    return labels


def scheduled_time_today(platform: str) -> str:
    for job in scheduler.get_jobs():
        if job.id == f"{JOB_PREFIX}{platform}" and job.next_run_time:
            return job.next_run_time.astimezone(TAIPEI).strftime("%H:%M")
    return ""


async def restore_friend_schedule():
    try:
        await plan_and_schedule()
    except Exception as e:
        print(f"[friend] 啟動規劃失敗（不影響其他功能）：{e}", flush=True)
    scheduler.add_job(func=plan_and_schedule, trigger=CronTrigger(hour=0, minute=20, timezone=TAIPEI),
                      id="friend_daily_replan", replace_existing=True)
