class Feedback(Base):
    """客戶回饋：記錄操作頁面 + 前端日誌 + 人工輸入內容。"""
    __tablename__ = "feedback"

    id = Column(Integer, primary_key=True, autoincrement=True)
    message = Column(Text, default="")                 # 使用者手動輸入
    page = Column(String(200), default="")             # 當時頁面路徑
    user_agent = Column(String(400), default="")
    logs = Column(Text, default="")                    # 前端擷取的近期 console 日誌
    meta_json = Column(JSON, default=dict)             # 其他脈絡（螢幕尺寸、時間等）
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class NurtureConfig(Base):
    """自動養號設定（單帳號產品 → 實務上一列）。

    老闆 2026-08-06：「養號需可填參數——時間長度 XX-XX 隨機、一日幾次、隨機時間」。
    每天在 window 內隨機灑 N 個時間點（N 也在 min-max 內隨機），每次時長在
    duration 區間內隨機取——三層隨機，行為才不會像鬧鐘一樣準時。
    """
    __tablename__ = "nurture_config"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    enabled = Column(Boolean, default=False)              # 每日自動養號開關
    daily_count_min = Column(Integer, default=1)          # 一日幾次（區間隨機）
    daily_count_max = Column(Integer, default=2)
    duration_min = Column(Integer, default=3)             # 每次時長（分鐘，區間隨機）
    duration_max = Column(Integer, default=8)
    window_start = Column(String(5), default="09:00")     # 允許執行時段
    window_end = Column(String(5), default="22:00")
    headless = Column(Boolean, default=True)              # 自動執行預設背景跑
    updated_at = Column(DateTime, default=datetime.datetime.utcnow,
                        onupdate=datetime.datetime.utcnow)


class PostDedup(Base):
    """發文去重紀錄：同一文案 + 同一社團在 N 天內只發一次。

    為什麼另開一張表而不是查 post_history：社團發文那條路徑只寫 RunLog、
    不寫 PostHistory（見 api/group_post.py），兩條發文路徑的紀錄方式不一致。
    這張表由兩條路徑共用，唯一的職責就是回答「這篇文案這個社團最近發過沒」。
    """
    __tablename__ = "post_dedup"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=True)
    group_key = Column(String(200), index=True)       # 社團 id（取不到才退回網址）
    content_hash = Column(String(64), index=True)     # 正規化內文的 sha256
    group_name = Column(String(500), default="")      # 只為了日誌好讀
    posted_at = Column(DateTime, default=datetime.datetime.utcnow, index=True)


def _ensure_columns():
    """SQLite 無 migration 工具：對既有表補上新增欄位（欄位已存在則略過）。冪等。"""
    from sqlalchemy import text
    # (table, column, DDL 型別與預設)
    additions = [
        ("post_tasks", "group_cursor", "INTEGER DEFAULT 0"),
        ("post_history", "deleted", "BOOLEAN DEFAULT 0"),
        ("legal_info", "footer_text", "TEXT DEFAULT ''"),
        ("properties", "base_content", "TEXT DEFAULT ''"),
