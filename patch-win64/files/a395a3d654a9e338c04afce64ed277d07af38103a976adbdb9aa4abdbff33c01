"""資料庫模型"""
import datetime
from sqlalchemy import (
    Column, Integer, String, Text, Boolean, DateTime, JSON, ForeignKey, create_engine, select
)
from sqlalchemy.orm import DeclarativeBase, relationship, sessionmaker
from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker

from .config import settings, DATA_DIR

_sync_url = settings.database_url.replace("sqlite+aiosqlite:///", "sqlite:///")
sync_engine = create_engine(_sync_url, echo=False)
async_engine = create_async_engine(settings.database_url, echo=False)

async_session_factory = async_sessionmaker(async_engine, class_=AsyncSession, expire_on_commit=False)
SyncSession = sessionmaker(sync_engine)


class Base(DeclarativeBase):
    pass


# ─── FB 帳號 ───────────────────────────────────────────

class Account(Base):
    __tablename__ = "accounts"

    id = Column(Integer, primary_key=True, autoincrement=True)
    email = Column(String(255), unique=True, nullable=False, index=True)
    password = Column(String(255), default="")
    note = Column(String(500), default="")
    two_factor_auth = Column(String(255), default="")  # 2FA 金鑰
    cookie = Column(Text, default="")                    # Cookie 字串
    proxy = Column(String(500), default="")              # Proxy 代理
    user_agent = Column(Text, default="")                # 自訂 User-Agent
    fb_version = Column(String(20), default="www")       # www / m / mbasic
    device = Column(String(50), default="desktop")       # desktop / mobile

    status = Column(String(20), default="active")        # active / limited / locked
    fb_user_id = Column(String(100), default="")
    fb_name = Column(String(255), default="")
    # FB 首次綁定時間：新帳號養號期（前 N 天只養號不發文）就是從這裡起算。
    # 新綁一個 FB 帳號馬上狂發，是最容易被判機器人／新帳號濫用的行為。
    fb_bound_at = Column(DateTime, nullable=True)
    # 強制解除養號期：養號期是保護機制不是死鎖，客戶明白風險後可強制提前發文。
    # True 時發文閘門放行（但 UI 會標「風險自負」）。
    grace_override = Column(Boolean, default=False)

    created_at = Column(DateTime, default=datetime.datetime.utcnow)
    updated_at = Column(DateTime, default=datetime.datetime.utcnow, onupdate=datetime.datetime.utcnow)

    groups = relationship("Group", back_populates="account", cascade="all, delete-orphan")
    tasks = relationship("PostTask", back_populates="account", cascade="all, delete-orphan")


# ─── 社團 ──────────────────────────────────────────────

class Group(Base):
    __tablename__ = "groups"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    group_name = Column(String(500), nullable=False)
    group_url = Column(String(500), nullable=False)
    group_id = Column(String(100), default="")
    member_count = Column(Integer, default=0)
    can_post = Column(Boolean, default=True)

    created_at = Column(DateTime, default=datetime.datetime.utcnow)

    account = relationship("Account", back_populates="groups")


# ─── 文案模板 ──────────────────────────────────────────

class Article(Base):
    __tablename__ = "articles"

    id = Column(Integer, primary_key=True, autoincrement=True)
    title = Column(String(500), default="")
    content = Column(Text, nullable=False)
    category = Column(String(100), default="general")  # general / shopping
    image_paths = Column(JSON, default=list)            # 圖片路徑列表
    link_url = Column(String(500), default="")

    created_at = Column(DateTime, default=datetime.datetime.utcnow)
    updated_at = Column(DateTime, default=datetime.datetime.utcnow, onupdate=datetime.datetime.utcnow)


# ─── 文案群組 ──────────────────────────────────────────

class ArticleGroup(Base):
    __tablename__ = "article_groups"

    id = Column(Integer, primary_key=True, autoincrement=True)
    name = Column(String(255), nullable=False)
    article_ids = Column(JSON, default=list)  # [1, 3, 5] 引用 Article.id

    created_at = Column(DateTime, default=datetime.datetime.utcnow)


# ─── 社團列表 (跨帳號共享) ─────────────────────────────

class ClubList(Base):
    __tablename__ = "club_lists"

    id = Column(Integer, primary_key=True, autoincrement=True)
    name = Column(String(255), nullable=False)
    clubs = Column(JSON, default=list)  # [{"name": "...", "url": "..."}, ...]

    created_at = Column(DateTime, default=datetime.datetime.utcnow)


# ─── 排程任務 ──────────────────────────────────────────

class PostTask(Base):
    __tablename__ = "post_tasks"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    article_id = Column(Integer, ForeignKey("articles.id"), nullable=True)

    # 任務類型: post / comment / share / join_group / nurture
    task_type = Column(String(20), default="post")

    # 目標社團 (JSON list of group URLs)
    target_groups = Column(JSON, default=list)

    # 排程設定
    schedule_type = Column(String(20), default="immediate")  # immediate / once / cycle / weekly
    schedule_time = Column(DateTime, nullable=True)           # 單次/下次執行時間
    cycle_hours = Column(Integer, default=6)                  # 循環間隔(小時)
    week_days = Column(JSON, default=list)                    # [0,1,2,3,4,5,6] 週幾
    time_of_day = Column(String(10), default="02:00")         # HH:MM

    # 進階設定
    sleep_seconds = Column(Integer, default=90)               # 每篇間隔秒數
    groups_per_run = Column(Integer, default=10)              # 每次發幾個社團
    add_timestamp = Column(Boolean, default=False)             # 加入時間戳
    add_sequence = Column(Boolean, default=False)              # 加入序號
    sequence_start = Column(Integer, default=1)               # 序號起始
    shuffle_groups = Column(Boolean, default=False)            # 亂數社團
    screenshot = Column(Boolean, default=False)                # 自動截圖
    headless = Column(Boolean, default=False)                  # 背景執行

    # 狀態
    status = Column(String(20), default="pending")            # pending / running / completed / stopped / error
    progress = Column(Integer, default=0)                     # 進度 (已發數量)
    total_count = Column(Integer, default=0)                  # 總社團數量
    group_cursor = Column(Integer, default=0)                 # 社團輪替游標（cycle 續發用）
    last_run = Column(DateTime, nullable=True)
    next_run = Column(DateTime, nullable=True)

    created_at = Column(DateTime, default=datetime.datetime.utcnow)

    account = relationship("Account", back_populates="tasks")


# ─── 發文歷史記錄 ──────────────────────────────────────

class PostHistory(Base):
    __tablename__ = "post_history"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    task_id = Column(Integer, ForeignKey("post_tasks.id"), nullable=True)
    group_name = Column(String(500), default="")
    group_url = Column(String(500), default="")
    post_url = Column(String(500), default="")
    status = Column(String(20), default="success")  # success / failed / pending_review
    like_count = Column(Integer, default=0)
    comment_count = Column(Integer, default=0)
    screenshot_path = Column(String(500), default="")
    error_message = Column(Text, default="")
    deleted = Column(Boolean, default=False)  # 該貼文是否已被「刪除舊貼文」移除

    post_time = Column(DateTime, default=datetime.datetime.utcnow)


# ─── 留言任務 ──────────────────────────────────────────

class CommentTask(Base):
