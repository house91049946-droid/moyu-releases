# ─── P16 每日預算 / 全域狀態 helper（台北時間） ─────────
import zoneinfo

try:
    TAIPEI = zoneinfo.ZoneInfo("Asia/Taipei")
except zoneinfo.ZoneInfoNotFoundError:
    # Windows 嵌入式 Python 若缺 tzdata，ZoneInfo 會在 import 時崩 → 後端起不來
    # → Next.js「failed to proxy http://127.0.0.1:13081/...」。台北無 DST，用固定 +08 退路。
    TAIPEI = datetime.timezone(datetime.timedelta(hours=8))
# 基礎每日上限；帳號暖機每週 +5% 放量，封頂 200（見 current_limits_sync）
BASE_LISTINGS_PER_DAY = 10
BASE_POSTS_PER_DAY = 50
RAMP_STEP = 0.05                 # 每升一級 +5%
RAMP_DAYS_PER_LEVEL = 7          # 每累積 7 個「達標天」升一級
RAMP_MAX = 200                   # 上限封頂
# 相容舊 import（現以動態 current_limits_sync 為準）
MAX_LISTINGS_PER_DAY = BASE_LISTINGS_PER_DAY
MAX_POSTS_PER_DAY = BASE_POSTS_PER_DAY


def today_taipei() -> str:
    return datetime.datetime.now(TAIPEI).strftime("%Y-%m-%d")


def now_taipei() -> datetime.datetime:
    """現在時間（帶台北時區）。排程比較時間一律用這支，避免 naive/aware 混用。"""
    return datetime.datetime.now(TAIPEI)


def as_taipei(dt: datetime.datetime) -> datetime.datetime:
    """把 naive datetime 視為台北時間補上時區；已有時區則原樣返回。

    plan_daily_times 產出的是 naive datetime，與 now_taipei() 相比會拋
    「can't compare offset-naive and offset-aware datetimes」，務必先過這支。
    """
    return dt if dt.tzinfo else dt.replace(tzinfo=TAIPEI)


def ramp_state_sync() -> dict:
    """暖機放量：只有「當日發文達到當時上限」的天數才算數，每累積 7 個達標天升一級(+5%)。
    沒發到上限的日子不計。回傳 {level, listings_max, posts_max, met_days, to_next}。"""
    with SyncSession() as s:
        rows = s.execute(select(DailyBudget).order_by(DailyBudget.date.asc())).scalars().all()
    level = 0
    met_since = 0           # 本級已累積的達標天
    total_met = 0
    for b in rows:
        pm = min(RAMP_MAX, round(BASE_POSTS_PER_DAY * (1 + RAMP_STEP) ** level))
        lm = min(RAMP_MAX, round(BASE_LISTINGS_PER_DAY * (1 + RAMP_STEP) ** level))
        reached = (b.posts_used or 0) >= pm or (b.listings_used or 0) >= lm
        if reached:
            met_since += 1
            total_met += 1
            if met_since >= RAMP_DAYS_PER_LEVEL:
                level += 1
                met_since = 0
    lm = min(RAMP_MAX, round(BASE_LISTINGS_PER_DAY * (1 + RAMP_STEP) ** level))
    pm = min(RAMP_MAX, round(BASE_POSTS_PER_DAY * (1 + RAMP_STEP) ** level))
    return {"level": level, "listings_max": lm, "posts_max": pm,
            "met_days": total_met, "to_next": max(0, RAMP_DAYS_PER_LEVEL - met_since)}


def current_limits_sync() -> tuple[int, int]:
    """回傳目前動態每日上限 (listings_max, posts_max)。"""
    st = ramp_state_sync()
    return st["listings_max"], st["posts_max"]


