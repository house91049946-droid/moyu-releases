import asyncio

from fastapi import APIRouter

router = APIRouter(prefix="/api/announcements", tags=["announce"], redirect_slashes=False)


@router.get("")
async def list_announcements():
    from ..cloud_client import announcements
    return await asyncio.to_thread(announcements)
