"""社團管理 API"""
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, delete
from pydantic import BaseModel
from typing import Optional

from ..database import get_session, ClubList

router = APIRouter(prefix="/api/clubs", tags=["clubs"], redirect_slashes=False)


class ClubItem(BaseModel):
    name: str
    url: str


class ClubListCreate(BaseModel):
    name: str
    clubs: list[ClubItem] = []


@router.get("/lists")
@router.get("/lists/")
async def list_club_lists(session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ClubList).order_by(ClubList.created_at.desc()))
    return [
        {"id": cl.id, "name": cl.name, "clubs": cl.clubs, "count": len(cl.clubs or [])}
        for cl in result.scalars().all()
    ]


@router.post("/lists")
@router.post("/lists/")
async def create_club_list(data: ClubListCreate, session: AsyncSession = Depends(get_session)):
    cl = ClubList(name=data.name, clubs=[c.model_dump() for c in data.clubs])
    session.add(cl)
    await session.commit()
    await session.refresh(cl)
    return {"id": cl.id, "name": cl.name, "clubs": cl.clubs}


@router.put("/lists/{list_id}")
async def update_club_list(list_id: int, data: ClubListCreate, session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ClubList).where(ClubList.id == list_id))
    cl = result.scalar_one_or_none()
    if not cl:
        raise HTTPException(status_code=404, detail="列表不存在")
    cl.name = data.name
    cl.clubs = [c.model_dump() for c in data.clubs]
    await session.commit()
    return {"id": cl.id, "name": cl.name, "clubs": cl.clubs}


@router.delete("/lists/{list_id}")
async def delete_club_list(list_id: int, session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ClubList).where(ClubList.id == list_id))
    cl = result.scalar_one_or_none()
    if not cl:
        raise HTTPException(status_code=404, detail="列表不存在")
    await session.delete(cl)
    await session.commit()
    return {"message": "列表已刪除"}


@router.post("/lists/{list_id}/add")
async def add_clubs_to_list(list_id: int, clubs: list[ClubItem], session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(ClubList).where(ClubList.id == list_id))
    cl = result.scalar_one_or_none()
    if not cl:
        raise HTTPException(status_code=404, detail="列表不存在")
    existing = cl.clubs or []
    existing_urls = {c.get("url") for c in existing}
    new_clubs = [c.model_dump() for c in clubs if c.url not in existing_urls]
    cl.clubs = existing + new_clubs
    await session.commit()
    return {"added": len(new_clubs), "total": len(cl.clubs)}
