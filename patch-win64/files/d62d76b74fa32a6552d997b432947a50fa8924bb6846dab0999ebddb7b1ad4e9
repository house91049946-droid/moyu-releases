"""每天讀 FB 通知：管理員拒絕了哪個社團的貼文 → 那個社團自動停發（老闆 2026-09-14）。

同一個社團被拒絕一次就停（下次不要再發到這個社團）；社團清單上看得到「管理員拒絕過・已停發」，可手動恢復。
"""
from __future__ import annotations

import datetime

from apscheduler.triggers.cron import CronTrigger
from sqlalchemy import select

from ..database import SyncSession, Account, Group, TAIPEI
from .task_runner import scheduler

RUN_AT = (6, 50)          # 台北時間；發文都在白天，清晨讀通知最不搶瀏覽器


def apply_notices(account_id: int, data: dict) -> dict:
    """把 CLI 撈到的拒絕／移除套到 Group 表。回 {"blocked": [名稱], "already": n, "unknown": [名稱]}。"""
    out = {"blocked": [], "already": 0, "unknown": []}
    hits = list((data or {}).get("declined") or []) + list((data or {}).get("removed") or [])
    if not hits:
        return out
    now = datetime.datetime.utcnow()
    with SyncSession() as s:
        rows = s.execute(select(Group).where(Group.account_id == account_id)).scalars().all()
        by_id = {g.group_id: g for g in rows if g.group_id}
        by_url = {}
        for g in rows:
            for part in (g.group_url or "").rstrip("/").split("/")[-2:]:
                if part.isdigit():
                    by_url[part] = g
        by_name = {(g.group_name or "").strip(): g for g in rows}
        for h in hits:
            g = by_id.get(h.get("group_id") or "") or by_url.get(h.get("group_id") or "") or by_name.get((h.get("group_name") or "").strip())
            if g is None:
                out["unknown"].append(h.get("group_name") or h.get("group_id") or "?")
                continue
            if g.post_blocked:
                out["already"] += 1
                continue
            g.post_blocked = True
            g.declined_count = (g.declined_count or 0) + 1
            g.declined_at = now
            out["blocked"].append(g.group_name)
        s.commit()
    return out


async def run_once() -> dict:
    import asyncio
    from ..fbauto_bridge import start_long_op, wait_fbid_free, cookie_exists

    def _accounts():
        with SyncSession() as s:
            return [(a.id, a.fb_user_id) for a in s.execute(select(Account)).scalars().all() if a.fb_user_id]
    accs = await asyncio.to_thread(_accounts)
    jobs = []
    for account_id, fbid in accs:
        if not cookie_exists(fbid):
            continue
        busy = await wait_fbid_free(fbid, max_wait_sec=600, tag="[notice]")
        if busy is not None:
            print(f"[notice] 帳號 {fbid} 的瀏覽器被「{busy.op}」占著，今天略過", flush=True)
            continue

        def _on_done(result, _aid=account_id):
            if not result.success:
                print(f"[notice] 讀通知失敗：{result.error}", flush=True)
                return
            r = apply_notices(_aid, result.data or {})
            if r["blocked"]:
                print(f"[notice] 管理員拒絕過，已停發：{'、'.join(r['blocked'])}", flush=True)
            elif r["already"]:
                print(f"[notice] 拒絕通知 {r['already']} 則，社團先前已停發", flush=True)
            if r["unknown"]:
                print(f"[notice] 通知裡的社團不在清單：{'、'.join(r['unknown'][:5])}", flush=True)
        try:
            jobs.append(start_long_op("group_notice", "src.run_group_notices", ["--fbid", fbid, "--headless"],
                                      account_id=account_id, fbid=fbid, on_done=_on_done))
        except RuntimeError as e:
            print(f"[notice] 略過：{e}", flush=True)
    return {"jobs": jobs}


async def restore_group_notice_check():
    scheduler.add_job(func=run_once, trigger=CronTrigger(hour=RUN_AT[0], minute=RUN_AT[1], timezone=TAIPEI),
                      id="group_notice_check_daily", replace_existing=True)
