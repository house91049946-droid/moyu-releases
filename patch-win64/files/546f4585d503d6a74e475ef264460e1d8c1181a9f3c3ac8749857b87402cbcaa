def generate_from_base(base_content: str, n_versions: int = 7, timeout: float = 90,
                       deal_type: str = "sale", style: str = "mixed") -> list[dict]:
    """依使用者貼的基底文案生成 N 個變體。回傳 [{title, body}, ...]（數字/事實鎖定）。

    SaaS 模式（設了 MOYU_CLOUD_URL + 授權金鑰）→ 走雲端 /ai/generate（金鑰在伺服器）。
    否則走本地 DeepSeek（開發後備；SaaS 上線後移除）。
    """
    if not (base_content or "").strip():
        raise DeepSeekError("基底文案是空的")

    # 優先走雲端代理（授權 + 金鑰在伺服器端）
    from .cloud_client import cloud_enabled, ai_generate, CloudError
    if cloud_enabled():
        try:
            return restore_dropped_lines(base_content, ai_generate(base_content, n_versions, deal_type=deal_type, style=style))
        except CloudError as e:
            raise DeepSeekError(str(e)) from e

    # 後備：本地直呼 DeepSeek（開發用）
    key = _load_key()
    if not key:
        raise DeepSeekError("尚未設定雲端授權，也沒有本地 DeepSeek 金鑰")

    deal_type = "rent" if (deal_type or "").lower() == "rent" else "sale"
    style = ",".join(parse_styles(style)) or "mixed"          # 可多選：'lively,spec'；沒有合法的就 mixed
    user_prompt = (
        f"基底文案如下（數字/事實必須完全照抄）：\n\n{base_content}\n\n"
        f"請生成 {n_versions} 個不同的變體版本（各含 title 與 body）。"
        + (owner_voice_hint(deal_type, n_versions) if style == "mixed"
           else "每一版都要照指定風格寫，但切入角度、句子、表情符號組合要不一樣。") +
        "再次提醒：照台灣房仲社團實際的寫法——表情符號當項目符號、價格放前面、賣點分區塊、"
        "結尾一句鉤子；每版換一組表情符號、換區塊順序、句子重寫，數字一個都不能動。"
        + ("這是租件：月租放最前面、押金與內含費用要寫、標題帶「出租」或「月租」。" if deal_type == "rent" else "")
    )
    payload = {
        "model": _MODEL,
        "messages": [
            {"role": "system", "content": _SYSTEM_PROMPT + (_RENT_STYLE if deal_type == "rent" else "") + style_block(style)},
            {"role": "user", "content": user_prompt},
        ],
        "temperature": 1.1,
        "response_format": {"type": "json_object"},
    }
    headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}

    try:
        with http_client.client(timeout) as client:
            resp = client.post(_API_URL, json=payload, headers=headers)
    except httpx.HTTPError as e:
        raise DeepSeekError(f"DeepSeek 連線失敗: {e}") from e
    if resp.status_code != 200:
        raise DeepSeekError(f"DeepSeek 回應 {resp.status_code}: {resp.text[:200]}")

    try:
        content = resp.json()["choices"][0]["message"]["content"]
        data = json.loads(content)
    except (KeyError, IndexError, json.JSONDecodeError) as e:
        raise DeepSeekError(f"DeepSeek 回應解析失敗: {e}") from e

    versions = []
    for v in data.get("versions", []):
        if isinstance(v, dict) and v.get("title") and v.get("body"):
            versions.append({"title": str(v["title"]).strip(), "body": str(v["body"]).strip()})
    if not versions:
        raise DeepSeekError("DeepSeek 未生成有效的版本")
    return restore_dropped_lines(base_content, versions)
