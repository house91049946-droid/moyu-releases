    if n < 3:
        return ""
    if deal_type == "rent":
        return ("其中『一定』要有一版是條列式基本資訊（規格一項一行、幾乎不寫感受），"
                "另外『一定』要有一版用第一人稱房東口氣寫（「我這間房子整理好了…」，"
                "講房子的狀況、希望租給什麼樣的人），但不可出現「自租」「非仲介」「免服務費」這類字眼。")
    return ("其中『一定』要有一版是條列式基本資訊（規格一項一行、幾乎不寫感受），"
