def parse_styles(style: str) -> list[str]:
    """「lively,spec」→ ['lively','spec']；mixed／空／不認得的都不算（老闆 2026-09-10：風格可以多選）。"""
    out = []
    for k in (style or "").lower().replace("，", ",").split(","):
        k = k.strip()
        if k in _STYLE_BLOCKS and k not in out:
            out.append(k)
    return out


def style_block(style: str) -> str:
    """一種：照那種寫；多種：每一版輪流用（第 1 版第 1 種、第 2 版第 2 種…用完從頭）。"""
    keys = parse_styles(style)
    if not keys:
        return ""
    if len(keys) == 1:
        return _STYLE_BLOCKS[keys[0]]
    lines = "".join(f"第 {i + 1} 種：{_STYLE_BLOCKS[k].strip()}\n" for i, k in enumerate(keys))
    return ("\n【指定風格（輪流）】客戶勾了幾種風格，每一版依序輪流：第 1 版用第 1 種、第 2 版用第 2 種…"
            "用完再從第 1 種開始，同一種風格的各版切入角度要不一樣。\n" + lines)


