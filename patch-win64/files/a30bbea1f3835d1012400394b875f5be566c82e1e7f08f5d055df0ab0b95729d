"""照物件自動挑社團（老闆 2026-09-07：「預設社團可以設定成 AI 辨識，自動選擇適合的群嗎」）。

做法：把物件也用同一套分類器分一次（名稱＋文案＋縣市 → 類別、區域），
再跟已分類的社團比對打分——同區域最重要，其次是同類型（透天／大樓／預售／中古），
買賣 vs 租賃對不上就扣分。「非房產」社團一律不選。

不用真的叫 AI：規則分類在 697 個真社團上已經分掉 93%，而且結果可預期、可離線、
零成本。之後雲端有 /ai/classify 再把「其他」那些補進來即可。
"""
from __future__ import annotations

import re

from .group_classify import classify_name, TAG_RULES, REGIONS

TYPE_TAGS = ("土地", "中古屋", "透天", "大樓", "預售")
INTENT_TAGS = ("買賣", "租賃")

# 沒有任何線索時：Marketplace 幾乎都是賣，預設當買賣
_RENT_HINTS = ("出租", "租金", "月租", "押金", "租屋", "招租", "承租")


def classify_property(name: str, base_content: str = "", city: str = "") -> dict:
    """物件 → {'tags': [...], 'region': '台中'}。"""
    text = f"{name or ''}\n{(base_content or '')[:400]}"
    c = classify_name(text)
    tags = [t for t in c["tags"] if t not in ("非房產", "其他")]
    # 買賣／租賃：物件文案常沒寫「買賣」兩個字，用租的線索反推
    if not any(t in INTENT_TAGS for t in tags):
        tags.append("租賃" if any(h in text for h in _RENT_HINTS) else "買賣")
    region = c["region"]
    if not region and city:
        cn = re.sub(r"[縣市]$", "", city.replace("臺", "台"))
        if cn in REGIONS:
            region = cn
    return {"tags": tags, "region": region}


def score_group(g_tags: list[str], g_region: str, p_tags: list[str], p_region: str) -> int:
    """分數 > 0 才算「適合」。"""
    if "非房產" in (g_tags or []):
        return -100
    s = 0
    if p_region and g_region:
        s += 3 if g_region == p_region else -3          # 同區加、異區扣（台中的房不該發到高雄社團）
    elif p_region and not g_region:
        s += 1                                           # 全國性／看不出區域的社團：可以，但排後面
    p_intent = next((t for t in p_tags if t in INTENT_TAGS), "買賣")
    g_intents = [t for t in (g_tags or []) if t in INTENT_TAGS]
    if g_intents:
        s += 2 if p_intent in g_intents else -4          # 賣房的別發到租屋社團：這條要壓過同區域的 +3
    shared_types = set(TYPE_TAGS) & set(g_tags or []) & set(p_tags)
    # 類型相符要壓過「泛用買賣」：老闆 2026-09-07 實測土地物件，55 個土地社團跟 202 個
    # 買賣社團同分，前 40 名被買賣社團擠滿、一個土地社團都沒選到。
    s += 4 * len(shared_types)                           # 土地對土地、透天對透天、預售對預售
    g_types = set(TYPE_TAGS) & set(g_tags or [])
    p_types = set(TYPE_TAGS) & set(p_tags)
    if g_types and not shared_types and p_types:
        s -= 2                                           # 社團專講大樓、物件是土地：不對
    if p_types and not g_types and "土地" in p_types:
        s -= 1                                           # 土地物件：泛用住宅買賣社團排後面一點
    if not g_types and not g_intents and "其他" in (g_tags or []):
        s += 0                                           # 泛用房產社團：靠區域決定
    return s


def pick_groups(groups: list[dict], name: str, base_content: str = "", city: str = "",
                limit: int = 40, mp_only: bool = False) -> dict:
    """groups: [{'group_name','tags','region','can_post'}, ...]。
    回 {'tags','region','groups':[names 依分數高→低], 'scored':[(name,score)]}。
    一個都配不上就回空清單，讓呼叫端決定要不要退回「全部可轉發」。"""
    p = classify_property(name, base_content, city)
    facts = property_facts(name, base_content, city)
    cands = [g for g in groups if (g.get("can_post") or not mp_only)
             and not g.get("post_blocked") and not group_unfit_reason(g.get("rules"), facts)]
    scored = []
    for g in cands:
        sc = score_group(g.get("tags") or [], g.get("region") or "", p["tags"], p["region"])
        if sc > 0:
            scored.append((g["group_name"], sc))
    scored.sort(key=lambda x: (-x[1], x[0]))
    return {"tags": p["tags"], "region": p["region"],
            "groups": [n for n, _ in scored[:limit]], "scored": scored[:limit]}



# ─── 社團規則 vs 物件（老闆 2026-09-15：AI 讀社團規則，發之前先比，減少被拒絕） ───

_AGE_RES = (re.compile(r"屋齡\s*[:：]?\s*約?\s*(\d+(?:\.\d+)?)\s*年"), re.compile(r"(\d+(?:\.\d+)?)\s*年\s*(?:屋齡|老屋|新古屋)"))
_TYPE_WORDS = {"預售": ("預售",), "土地": ("土地", "建地", "農地", "工業地"), "套房": ("套房", "雅房"),
               "店面": ("店面", "店住"), "廠房": ("廠房", "廠辦"), "車位": ("車位出售", "車位出租", "售車位", "租車位")}


def property_facts(name: str, base_content: str = "", city: str = "", deal_type: str = "") -> dict:
    """物件要跟社團規則比的事實：區域、買賣／出租、屋齡、特殊類型。"""
    text = f"{name or ''}\n{base_content or ''}"
    p = classify_property(name, base_content, city)
    age = None
    for rx in _AGE_RES:
        m = rx.search(text)
        if m:
            try:
                age = float(m.group(1))
            except ValueError:
                age = None
            break
    types = {t for t, kws in _TYPE_WORDS.items() if any(k in text for k in kws)}
    if "土地" in p["tags"]:
        types.add("土地")
    deal = deal_type if deal_type in ("sale", "rent") else ("rent" if "租賃" in p["tags"] and "買賣" not in p["tags"] else "sale")
    return {"region": p["region"], "deal": deal, "age": age, "types": types, "has_age_text": "屋齡" in text}


def group_unfit_reason(rules: dict | None, facts: dict) -> str:
    """AI 讀出的社團規則跟這個物件衝突就回原因（人話），沒衝突回空字串。沒讀過規則＝不擋。"""
    r = rules or {}
    if not r:
        return ""
    if r.get("real_estate") is False:
        return "不是房地產社團"
    if r.get("agent_allowed") is False:
        return "社團禁止仲介"
    if r.get("ads_allowed") is False:
        return "社團禁止發物件"
    if r.get("deal") == "sale" and facts.get("deal") == "rent":
        return "社團只收買賣"
    if r.get("deal") == "rent" and facts.get("deal") == "sale":
        return "社團只收出租"
    ro = r.get("region_only") or ""
    if ro and facts.get("region") and facts["region"] != ro:
        return f"社團只收{ro}的物件"
    mx = r.get("max_age_years")
    if mx and facts.get("age") is not None and facts["age"] > mx:
        return f"社團限屋齡 {mx} 年內"
    bad = set(r.get("excluded_types") or []) & set(facts.get("types") or set())
    if bad:
        return f"社團不收{'、'.join(sorted(bad))}"
    if "屋齡" in (r.get("required") or []) and not facts.get("has_age_text") and "土地" not in (facts.get("types") or set()):
        return "社團規定要寫屋齡，文案沒寫"
    return ""


def filter_by_rules(names: list[str], rules_by_name: dict[str, dict], facts: dict) -> tuple[list[str], dict[str, str]]:
    """純函式：把規則不合的社團拿掉。回 (留下的名單, {被拿掉的名稱: 原因})。"""
    keep, dropped = [], {}
    for n in names:
        why = group_unfit_reason(rules_by_name.get(n), facts)
        if why:
            dropped[n] = why
        else:
            keep.append(n)
    return keep, dropped
