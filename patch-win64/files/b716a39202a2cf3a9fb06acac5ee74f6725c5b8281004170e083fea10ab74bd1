    acc.status = "inactive"
    await session.commit()
    return {"id": acc.id, "email": acc.email, "message": "已解除綁定"}


@router.post("/{account_id}/sync-groups")
async def sync_groups(account_id: int, use_cache: bool = False,
                      session: AsyncSession = Depends(get_session)):
    """重新抓取帳號社團（開瀏覽器真的去 FB 翻一次）。

    ⚠️ 這支原本是「優先從本機 data 檔讀取，檔案不存在才開瀏覽器」。問題有兩個，
    都是客戶實際踩到的（2026-08-02 Windows 客戶「抓社團馬上跳掉」）：

    1. 只要 FB_Auto/data/<fbid>.json 存在，這顆按鈕就**永遠只讀舊檔、從不重抓**，
       瞬間回應——客戶按下去畫面閃一下、社團一個都沒多，看起來就像壞掉。而首次
       登入之後那個檔案一定存在，等於這顆按鈕從那之後就再也沒有作用。
    2. 讀完舊檔會先 delete 掉資料庫裡**全部**社團再重建。舊檔殘缺或是空的，
       社團就整批消失（7/30 另一位客戶回報「找不到我原有的社團」很可能是這個）。

    現在預設一律重抓；use_cache=true 才走本機快取（供內部流程沿用剛抓好的結果）。
    無論走哪條路，抓到 0 個社團時一律不動資料庫——寧可不更新，也不能把客戶的
    社團清單清空。
    """
    from ..fbauto_bridge import cookie_exists

    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="尚未綁定 FB ID")

    fbid = acc.fb_user_id

    import re
    from ..fbauto_bridge import FB_AUTO_DATA_DIR
    data_path = FB_AUTO_DATA_DIR / f"{fbid}.json"
    groups_list = []

    if use_cache and data_path.exists():
        try:
            with open(data_path, encoding="utf-8") as f:
                raw = json.load(f)
        except (json.JSONDecodeError, OSError) as e:
            raise HTTPException(422, f"本機社團快取讀取失敗：{e}")
        if isinstance(raw, dict):
            for name, url in raw.items():
                gid = ""
                m = re.search(r"/groups/(\d+)/?", url)
                if m:
                    gid = m.group(1)
                groups_list.append({"name": name, "url": url, "group_id": gid})
    else:
        if not cookie_exists(fbid):
            raise HTTPException(status_code=422, detail="cookie 已失效或尚未登入，請先到帳號設定重新登入")
        from ..fbauto_bridge import run_sync_groups, create_run_log_sync, update_run_log_sync
        # 留一筆 RunLog：抓社團失敗原本什麼紀錄都沒有，執行紀錄與診斷包都看不到，
        # 客戶回報「抓不到社團」時我們手上一片空白（2026-08-04）
        log_id = create_run_log_sync("sync_groups", fbid, account_id)
        bridge_result = await run_sync_groups(fbid=fbid)
        update_run_log_sync(log_id, bridge_result)
        if not bridge_result.success:
            raise HTTPException(status_code=422, detail=f"社團抓取失敗: {bridge_result.error}")
        groups_list = bridge_result.groups

    # 抓到 0 個 → 一定是哪裡出錯（帳號沒社團也不會按這顆）。直接擋下，
    # 不可以拿空清單去 delete 客戶既有的社團。
    if not groups_list:
        existing = await session.scalar(
            select(func.count(Group.id)).where(Group.account_id == account_id))
        raise HTTPException(
            422,
            f"這次一個社團都沒抓到，已保留原本的 {existing or 0} 個不動。"
            "常見原因：FB 未登入或 cookie 失效、社團頁面載入逾時。請先重新登入再試。",
        )

    # ── 寫入 DB ──
    await session.execute(delete(Group).where(Group.account_id == account_id))
    for g in groups_list:
        gid = g.get("group_id", "")
        if not gid:
            m = re.search(r"/groups/(\d+)/?", g.get("url", ""))
            if m:
                gid = m.group(1)
        session.add(Group(
            account_id=account_id,
            group_name=g.get("name", ""),
            group_url=g.get("url", ""),
            group_id=gid,
            can_post=False,
        ))
    await session.commit()

    # Auto-trigger MP group detection in background (fire-and-forget)
    import asyncio as _asyncio
    async def _auto_detect():
        try:
            from ..fbauto_bridge import run_detect_mp_groups
            br = await run_detect_mp_groups(fbid=fbid, headless=True)
            if br.success and br.groups:
                mp_id_set = _normalize_mp_ids(br.groups)
                fallback_names = _unresolved_names(br.groups)
                async with async_session_factory() as s2:
                    all_g = await s2.execute(select(Group).where(Group.account_id == account_id))
                    for g in all_g.scalars().all():
                        hit = (g.group_id and g.group_id in mp_id_set) or \
                              (g.group_name in fallback_names)
                        if hit and not g.can_post:
                            g.can_post = True
                    await s2.commit()
        except Exception:
            pass  # auto-detect 失敗不影響主流程

    _asyncio.create_task(_auto_detect())

    return {
        "total_groups": len(groups_list),
        "groups": groups_list,
    }


@router.get("/{account_id}/sync-progress")
async def sync_progress(account_id: int):
    """抓社團的即時進度（輕量文字流）。

    做法：CLI 的 stdout 會**即時**寫進 data/logs/run_sync_groups_*.log，
    這裡回傳最新那個檔的尾端幾行；前端在等 sync-groups 回應期間每幾秒拿一次，
    顯示「正在做什麼、抓到幾個」。成本只有讀一個小檔案的尾端——刻意不用
    畫面串流（CDP screencast 很吃 CPU，會拖慢抓取本身）。
    """
    import time as _time
    from ..fbauto_bridge import LOGIN_LOG_DIR
    try:
        files = sorted(LOGIN_LOG_DIR.glob("run_sync_groups_*.log"),
                       key=lambda f: f.stat().st_mtime, reverse=True)
    except OSError:
        files = []
    if not files:
        return {"active": False, "lines": []}
    newest = files[0]
    age = _time.time() - newest.stat().st_mtime
    if age > 20 * 60:            # 20 分鐘沒動靜 → 不是這一輪的
        return {"active": False, "lines": []}
    try:
        with open(newest, "rb") as f:
            f.seek(max(0, newest.stat().st_size - 8000))
            tail = f.read().decode("utf-8", errors="replace")
    except OSError:
        return {"active": False, "lines": []}
    lines = [ln.strip() for ln in tail.splitlines() if ln.strip()][-12:]
    return {"active": age < 30, "lines": lines}


@router.post("/{account_id}/detect-mp-groups")
async def detect_mp_groups(account_id: int, session: AsyncSession = Depends(get_session)):
    """檢測哪些已同步社團可以轉發 Marketplace：spawn 檢測任務後回 job_id。
    前端輪詢 GET /api/jobs/{job_id}，成功時由該端點完成 can_post 落庫。"""
    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="尚未綁定 FB ID")

    fbid = acc.fb_user_id
    from ..fbauto_bridge import start_long_op, cookie_exists
    if not cookie_exists(fbid):
        raise HTTPException(status_code=422, detail="cookie 已失效，請重新使用一鍵登入")

    job_id = start_long_op("detect", "src.run_detect_mp_groups",
                           ["--fbid", fbid, "--headless"],
                           account_id=account_id, fbid=fbid)
    return {"job_id": job_id, "state": "pending"}


@router.post("/{account_id}/process-detect-results")
async def process_detect_results(account_id: int, session: AsyncSession = Depends(get_session)):
    """讀取 CLI 輸出的 marketplace_groups JSON，更新 DB can_post 欄位"""
    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc or not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="帳號不存在或尚未綁定 FB ID")

    fbid = acc.fb_user_id
    from ..fbauto_bridge import FB_AUTO_DATA_DIR
    mp_file = FB_AUTO_DATA_DIR / f"marketplace_groups_{fbid}.json"

    if not mp_file.exists():
        return {"success": False, "message": "尚無檢測結果，請先執行檢測"}

    with open(mp_file, encoding="utf-8") as f:
        mp_entries = json.load(f)  # v2: [{name,url,group_id}]；舊格式: [名稱]

    mp_id_set = _normalize_mp_ids(mp_entries)
    fallback_names = _unresolved_names(mp_entries)

    all_groups = await session.execute(select(Group).where(Group.account_id == account_id))
    updated = 0
    matched_by_name = 0
    for g in all_groups.scalars().all():
        if g.group_id and g.group_id in mp_id_set:
            should_post = True
        elif g.group_name in fallback_names:
            should_post = True
            matched_by_name += 1
        else:
            should_post = False
        if g.can_post != should_post:
            g.can_post = should_post
            updated += 1

    await session.commit()

    total = await session.scalar(select(func.count(Group.id)).where(Group.account_id == account_id))
    can_post_count = await session.scalar(
        select(func.count(Group.id)).where(Group.account_id == account_id, Group.can_post == True)
    )

    return {
        "success": True,
        "total_groups": total,
        "can_post_count": can_post_count,
        "mp_groups_found": len(mp_entries),
        "updated": updated,
        "matched_by_name": matched_by_name,
    }


