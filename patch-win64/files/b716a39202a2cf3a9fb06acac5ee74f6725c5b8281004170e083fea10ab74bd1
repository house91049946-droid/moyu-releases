class AccountCreate(BaseModel):
    email: str
    password: str = ""
    note: str = ""
    two_factor_auth: str = ""
    cookie: str = ""
    proxy: str = ""
    user_agent: str = ""
    fb_version: str = "www"


class AccountUpdate(BaseModel):
    password: Optional[str] = None
    note: Optional[str] = None
    two_factor_auth: Optional[str] = None
    cookie: Optional[str] = None
    proxy: Optional[str] = None
    user_agent: Optional[str] = None
    fb_version: Optional[str] = None


class AccountResponse(BaseModel):
    id: int
    email: str
    note: str
    two_factor_auth: str
    fb_version: str
    status: str
    fb_user_id: str
    fb_name: str
    proxy: str
    user_agent: str
    created_at: str
    # 社團統計（列表端點才填；帳號設定頁的狀態列直接顯示，不必展開才看得到）
    group_count: int = 0
    mp_group_count: int = 0
    # 新帳號養號期：還剩幾天才能發文（0=已可發文）
    grace_days_left: int = 0
    # 是否已強制解除養號期（風險自負）
    grace_override: bool = False

    model_config = {"from_attributes": True}

    @field_validator('created_at', mode='before')
    @classmethod
    def coerce_created_at(cls, v):
        if isinstance(v, datetime):
            return v.isoformat()
        return str(v) if v else ''


@router.get("", response_model=list[AccountResponse])
@router.get("/", response_model=list[AccountResponse])
async def list_accounts(session: AsyncSession = Depends(get_session)):
    result = await session.execute(select(Account).order_by(Account.created_at.desc()))
    accounts = result.scalars().all()
    # 每帳號的社團數／可轉發數（單帳號產品，這裡不會是大查詢）
    counts = {r[0]: (r[1], r[2]) for r in (await session.execute(
        select(Group.account_id,
               func.count(Group.id),
               func.sum(case((Group.can_post == True, 1), else_=0)))  # noqa: E712
        .group_by(Group.account_id)
    )).all()}
    from ..database import posting_grace_remaining_sync
    out = []
    for acc in accounts:
        item = AccountResponse.model_validate(acc)
        total, mp = counts.get(acc.id, (0, 0))
        item.group_count = int(total or 0)
        item.mp_group_count = int(mp or 0)
        item.grace_days_left = posting_grace_remaining_sync(acc.fb_bound_at) if acc.fb_user_id else 0
        item.grace_override = bool(acc.grace_override)
        out.append(item)
    return out


class GraceOverrideIn(BaseModel):
    override: bool


@router.post("/{account_id}/grace-override")
async def set_grace_override(account_id: int, data: GraceOverrideIn,
                             session: AsyncSession = Depends(get_session)):
    """強制解除／恢復新帳號養號期。養號期是保護機制不是死鎖，客戶明白風險後
    可強制提前發文（前端會先跳風險警示）。"""
    acc = (await session.execute(select(Account).where(Account.id == account_id))).scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    acc.grace_override = data.override
    await session.commit()
    return {"id": acc.id, "grace_override": acc.grace_override}


@router.post("", response_model=AccountResponse)
@router.post("/", response_model=AccountResponse)
async def create_account(data: AccountCreate, session: AsyncSession = Depends(get_session)):
    # 單帳號限制
    existing_count = await session.execute(select(Account))
    if len(existing_count.scalars().all()) >= 1:
        raise HTTPException(status_code=400, detail="系統僅支援單一帳號，請先刪除既有帳號再新增")

    existing = await session.execute(select(Account).where(Account.email == data.email))
    if existing.scalar_one_or_none():
        raise HTTPException(status_code=400, detail="帳號已存在")

    from ..crypto import encrypt_secret
    acc = Account(
        email=data.email,
        password=encrypt_secret(data.password),
        note=data.note,
        two_factor_auth=data.two_factor_auth,
        cookie=data.cookie,
        proxy=data.proxy,
        user_agent=data.user_agent,
        fb_version=data.fb_version,
    )
    session.add(acc)
    await session.commit()
    await session.refresh(acc)
    return acc


@router.post("/batch")
async def batch_create_accounts(accounts: list[AccountCreate], session: AsyncSession = Depends(get_session)):
    """批量新增帳號。系統僅支援單一帳號，超過 1 筆只取第一筆。"""
    # 單帳號限制
    existing_count = await session.execute(select(Account))
    if len(existing_count.scalars().all()) >= 1:
        raise HTTPException(status_code=400, detail="系統僅支援單一帳號，請先刪除既有帳號再新增")

    if len(accounts) > 1:
        accounts = accounts[:1]  # 只取第一筆
    from ..crypto import encrypt_secret
    created = []
    skipped = []
    for data in accounts:
        existing = await session.execute(select(Account).where(Account.email == data.email))
        if existing.scalar_one_or_none():
            skipped.append(data.email)
            continue
        acc = Account(
            email=data.email,
            password=encrypt_secret(data.password),
            note=data.note,
            two_factor_auth=data.two_factor_auth,
            cookie=data.cookie,
            proxy=data.proxy,
            user_agent=data.user_agent,
            fb_version=data.fb_version,
        )
        session.add(acc)
        created.append(data.email)
    await session.commit()
    return {"created": created, "skipped": skipped, "total": len(created)}


