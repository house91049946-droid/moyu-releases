class BindFbidRequest(BaseModel):
    fbid: str


@router.post("/{account_id}/bind-fbid")
async def bind_fbid(account_id: int, data: BindFbidRequest, session: AsyncSession = Depends(get_session)):
    """綁定 FB_Auto cookie 的 fbid 到帳號"""
    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")

    from ..fbauto_bridge import cookie_exists
    fbid = data.fbid.strip()
    if not fbid:
        raise HTTPException(status_code=422, detail="fbid 不得為空白")
    if not cookie_exists(fbid):
        raise HTTPException(
            status_code=422,
            detail=f"cookie 不存在: {fbid}，請先用 FB_Auto CLI 登入該帳號",
        )

    acc.fb_user_id = fbid
    if acc.fb_bound_at is None:                 # 首次綁定 → 養號期起算點
        acc.fb_bound_at = datetime.utcnow()
    await session.commit()
    await session.refresh(acc)
    return {"id": acc.id, "email": acc.email, "fb_user_id": acc.fb_user_id}


@router.post("/{account_id}/first-login")
async def first_login(account_id: int, session: AsyncSession = Depends(get_session)):
    """一鍵登入：spawn 登入子進程後即刻回傳 pending。
    前端輪詢 GET /{id}/first-login/status，登入完成時由該端點自動綁定 fbid 並匯入社團。"""
    from ..fbauto_bridge import start_first_login, browser_busy_reason

    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，無法同時開啟帳號瀏覽器。請先按『緊急停止』或等目前工作結束後再試。")

    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.password:
        raise HTTPException(status_code=422, detail="此帳號未設定密碼，無法自動登入")

    from ..crypto import decrypt_secret, DecryptError
    try:
        plain_password = decrypt_secret(acc.password)
    except DecryptError:
        raise HTTPException(status_code=422, detail="密碼無法解密（加密金鑰遺失），請重新編輯此帳號設定密碼")

    try:
        start_first_login(
            account_id=acc.id,
            email=acc.email,
            password=plain_password,
            headless=False,
        )
    except RuntimeError:
        raise HTTPException(status_code=409, detail="登入已在進行中，請稍候或在瀏覽器完成驗證")

    acc.status = "logging_in"
    await session.commit()

    return {
        "id": acc.id,
        "email": acc.email,
        "state": "pending",
        "message": "瀏覽器已開啟，請手動完成登入。系統會自動綁定 FB ID 並匯入社團。",
    }


@router.post("/{account_id}/relogin")
async def relogin(account_id: int, session: AsyncSession = Depends(get_session)):
    """快速重新登入：只換一份新 cookie，不暖身、不重抓社團。

    被 FB 登出時客戶要的是趕快回到能發文的狀態；走「一鍵登入」會連帶跑
    暖身瀏覽＋整份社團匯入（動輒好幾分鐘），而社團清單本來就還在
    （2026-08-02 客戶回報）。進度沿用 first-login/status 輪詢。
    """
    from ..fbauto_bridge import start_first_login, browser_busy_reason

    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，無法同時開啟帳號瀏覽器。請先按『緊急停止』或等目前工作結束後再試。")

    acc = (await session.execute(select(Account).where(Account.id == account_id))).scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.password:
        raise HTTPException(status_code=422, detail="此帳號未設定密碼，無法自動登入")

    from ..crypto import decrypt_secret, DecryptError
    try:
        plain_password = decrypt_secret(acc.password)
    except DecryptError:
        raise HTTPException(status_code=422, detail="密碼無法解密（加密金鑰遺失），請重新編輯此帳號設定密碼")

    try:
        start_first_login(
            account_id=acc.id, email=acc.email, password=plain_password,
            headless=False, skip_groups=True,
        )
    except RuntimeError:
        raise HTTPException(status_code=409, detail="登入已在進行中，請稍候或在瀏覽器完成驗證")

    acc.status = "logging_in"
    await session.commit()
    return {
        "id": acc.id, "email": acc.email, "state": "pending",
        "message": "瀏覽器已開啟，請完成登入（含驗證）。拿到新 cookie 就結束，不會重抓社團。",
    }


def _normalize_mp_ids(entries: list) -> set[str]:
    """把 MP 可轉發清單正規化為 group_id 集合。
    接受：group_id 字串、URL 字串（舊格式）、{name,url,group_id} dict（detect v2）。"""
    import re
    ids: set[str] = set()
    for e in entries or []:
        if isinstance(e, dict):
            gid = e.get("group_id", "")
            if not gid:
                m = re.search(r"/groups/(\d+)/?", e.get("url", ""))
                gid = m.group(1) if m else ""
        elif isinstance(e, str):
            m = re.search(r"/groups/(\d+)/?", e)
            gid = m.group(1) if m else (e if e.isdigit() else "")
        else:
            continue
        if gid:
            ids.add(gid)
    return ids


def _unresolved_names(entries: list) -> set[str]:
    """MP 清單中解析不出 group_id 的條目名稱（僅這些允許名稱 fallback 比對）。"""
    import re
    names: set[str] = set()
    for e in entries or []:
        if isinstance(e, dict):
            gid = e.get("group_id", "")
            if not gid:
                m = re.search(r"/groups/(\d+)/?", e.get("url", ""))
                gid = m.group(1) if m else ""
            if not gid and e.get("name"):
                names.add(e["name"])
        elif isinstance(e, str) and "/groups/" not in e and not e.isdigit():
            names.add(e)  # 舊格式純名稱
    return names


def _import_groups(account_id: int, groups_list: list[dict], mp_group_ids: list):
    """以登入結果重建帳號社團列（呼叫端負責 commit）。MP 身分以 group_id 比對。"""
    import re
    mp_id_set = _normalize_mp_ids(mp_group_ids)
    rows = []
    for g in groups_list or []:
        url = g.get("url", "")
        gid = g.get("group_id", "")
        if not gid:
            m = re.search(r"/groups/(\d+)/?", url)
            gid = m.group(1) if m else ""
        can_post = bool(g.get("can_marketplace")) or (bool(gid) and gid in mp_id_set)
        rows.append(Group(
            account_id=account_id,
            group_name=g.get("name", ""),
            group_url=url,
            group_id=gid,
            can_post=can_post,
        ))
    return rows


@router.get("/{account_id}/first-login/status")
async def first_login_status(account_id: int, session: AsyncSession = Depends(get_session)):
    """輪詢一鍵登入進度。success 時在此完成落庫：綁 fbid、匯入社團、標記 MP 可轉發。"""
    from ..fbauto_bridge import poll_first_login

    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")

    poll = poll_first_login(account_id)
    state = poll["state"]

    if state == "success":
        acc.fb_user_id = poll["fbid"]
        acc.status = "active"
        if acc.fb_bound_at is None:             # 首次綁定 → 養號期起算點
            acc.fb_bound_at = datetime.utcnow()
        # 快速重登（--skip-groups）根本沒抓社團，拿空清單去 delete+import 會把客戶
        # 整份社團洗掉。保險起見連「一般登入但一個社團都沒抓到」也不覆蓋。
        if poll.get("skipped_groups") or not poll.get("groups"):
            await session.commit()
            group_count = await session.scalar(
                select(func.count(Group.id)).where(Group.account_id == account_id))
            mp_count = await session.scalar(
                select(func.count(Group.id)).where(Group.account_id == account_id, Group.can_post == True))
            return {
                "state": "success", "fb_user_id": acc.fb_user_id,
                "group_count": group_count or 0, "mp_group_count": mp_count or 0,
                "groups_kept": True,
            }
        await session.execute(delete(Group).where(Group.account_id == account_id))
        rows = _import_groups(account_id, poll.get("groups", []), poll.get("mp_group_ids", []))
        for r in rows:
            session.add(r)
        await session.commit()
        return {
            "state": "success",
            "fb_user_id": acc.fb_user_id,
            "group_count": len(rows),
            "mp_group_count": sum(1 for r in rows if r.can_post),
        }

    if state == "failed":
        acc.status = "login_failed"
        await session.commit()
        return {"state": "failed", "error": poll.get("error", ""), "fb_user_id": acc.fb_user_id}

    if state == "pending":
        return {"state": "pending", "elapsed_sec": poll.get("elapsed_sec", 0)}

    # state == "none"：無進行中工作。若帳號已綁定 → 冪等回 success（頁面重整後再問也正確）
    if acc.fb_user_id:
        if acc.status == "logging_in":       # 收尾中斷（如後端重啟）遺留的狀態 → 正規化
            acc.status = "active"
            await session.commit()
        group_count = await session.scalar(
            select(func.count(Group.id)).where(Group.account_id == account_id)
        )
        mp_count = await session.scalar(
            select(func.count(Group.id)).where(Group.account_id == account_id, Group.can_post == True)
        )
        return {
            "state": "success",
            "fb_user_id": acc.fb_user_id,
            "group_count": group_count,
            "mp_group_count": mp_count,
        }
    return {"state": "none"}


@router.post("/{account_id}/unbind-fbid")
async def unbind_fbid(account_id: int, session: AsyncSession = Depends(get_session)):
    """解除 FB ID 綁定（cookie 檔保留，重新一鍵登入或手動綁定可復原）。"""
    result = await session.execute(select(Account).where(Account.id == account_id))
