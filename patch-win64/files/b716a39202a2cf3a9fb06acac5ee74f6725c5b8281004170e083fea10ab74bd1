@router.post("/{account_id}/cookie-login")
async def cookie_login(account_id: int, session: AsyncSession = Depends(get_session)):
    """Cookie 登入：開啟瀏覽器進入 FB 主頁，保持開啟不關閉。"""
    from ..fbauto_bridge import run_cookie_login_bg, cookie_exists, browser_busy_reason

    busy = browser_busy_reason()
    if busy:
        raise HTTPException(status_code=409,
            detail=f"目前有「{busy}」正在使用瀏覽器，無法同時開啟帳號瀏覽器。請先按『緊急停止』或等目前工作結束後再試。")

    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="尚未綁定 FB ID，請先使用一鍵登入")
    if not cookie_exists(acc.fb_user_id):
        acc.status = "limited"
        await session.commit()
        raise HTTPException(status_code=422, detail="Cookie 已失效，請重新使用一鍵登入")

    # 一併把帳密帶下去：cookie 若在開啟過程中才發現失效，子進程會自動改走帳密
    # 登入；FB 換了登入版面就把瀏覽器留給客戶手動登，不再直接關掉視窗退出。
    plain_password = ""
    if acc.password:
        from ..crypto import decrypt_secret, DecryptError
        try:
            plain_password = decrypt_secret(acc.password)
        except DecryptError:
            plain_password = ""      # 解不開就退回純 cookie 行為，不擋使用者

    # 背景啟動，不等待結束（瀏覽器保持開啟直到使用者手動關閉）
    bridge_result = await run_cookie_login_bg(
        fbid=acc.fb_user_id, email=acc.email if plain_password else "", password=plain_password,
    )

    # 只是檢查 cookie 是否仍有效，實際登入在另一個 process 中進行
    acc.status = "active"
    await session.commit()
    return {
        "id": acc.id, "email": acc.email, "fb_user_id": acc.fb_user_id,
        "message": "瀏覽器已開啟，保持登入中" + ("（若 cookie 失效會自動帶入密碼，請在視窗完成驗證）" if plain_password else ""),
    }


@router.post("/{account_id}/groups/sync")
async def sync_account_groups(account_id: int, group_urls: list[dict], session: AsyncSession = Depends(get_session)):
    """同步帳號的社團列表"""
    result = await session.execute(select(Account).where(Account.id == account_id))
    acc = result.scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")

    # 清除舊社團
    await session.execute(delete(Group).where(Group.account_id == account_id))

    for g in group_urls:
        group = Group(
            account_id=account_id,
            group_name=g.get("name", ""),
            group_url=g.get("url", ""),
            group_id=g.get("group_id", ""),
        )
        session.add(group)

    await session.commit()
    return {"message": f"已同步 {len(group_urls)} 個社團"}
