def test_extract_about():
    r = extract_about(SAMPLE)
    assert r["members"] == 2041 and r["has_rules"]
    assert "歡迎仲介同行加入" in r["about"] and "不接受預售屋" in r["about"] and "須在台中市" in r["about"]
    assert "只有成員可以查看" not in r["about"]
    assert extract_about("隨便一頁")["about"] == ""
