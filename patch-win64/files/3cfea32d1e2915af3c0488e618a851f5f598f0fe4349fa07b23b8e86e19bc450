# ─── P16 Marketplace 定時發文 ──────────────────────────

class LegalInfo(Base):
    """法定欄位（房仲法規強制），全域一份，每則貼文自動附加、AI 絕不修改。"""
    __tablename__ = "legal_info"

    id = Column(Integer, primary_key=True, autoincrement=True)
    agent_name = Column(String(100), default="")     # 經紀人（保留，選填）
    company = Column(String(200), default="")         # 公司（保留，選填）
    license_no = Column(String(100), default="")      # 經紀業字號（保留，選填）
    agent_phone = Column(String(50), default="")
    # 營業員證號（老闆 2026-09-08：法定文案要有業務人員姓名、電話、營業員證號）。
    # 經紀人員＝經紀人或營業員，兩種證號都填這欄；license_no 是公司的經紀業字號，別搞混。
    agent_cert_no = Column(String(100), default="")
    # 店名／品牌（例：有巢氏不動產 太平中山富盛店）與「加盟店」標示——
    # 不動產經紀業管理條例要求加盟經營者在廣告明顯處標明「加盟店」或「加盟經營」字樣（老闆 2026-09-08 問法規）。
    store_name = Column(String(200), default="")
    is_franchise = Column(Boolean, default=False)
    extra = Column(Text, default="")                  # 其他固定附加文字
    footer_text = Column(Text, default="")            # 法定區塊純文字（貼整段，AI 絕不動）
    updated_at = Column(DateTime, default=datetime.datetime.utcnow, onupdate=datetime.datetime.utcnow)


class Property(Base):
    """物件案件（房產）。發送時自動變裝：輪替標題/內文、隨機圖片子集。"""
    __tablename__ = "properties"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    name = Column(String(200), default="")            # 內部識別名（社區名等）
    category = Column(String(50), default="其他商品")   # Marketplace 類別（分類廣告→其他商品）
    # 買賣／租件（SPEC-P34，老闆 2026-09-08）：租件的價格是月租、文案寫法與 AI 指示都不同
    deal_type = Column(String(10), default="sale")     # sale / rent
    city = Column(String(20), default="")             # 上架縣市（帶進 FB Marketplace 地點）
    condition = Column(String(20), default="new")     # new/likeNew/good/fair
    price = Column(Integer, default=0)
    base_content = Column(Text, default="")           # 使用者貼的基底文案（事實+賣點，數字鎖定）
    title_facts = Column(JSON, default=dict)          # （保留）
    titles = Column(JSON, default=list)               # 多版標題（AI 生成+人工確認，輪替用）
    bodies = Column(JSON, default=list)               # 多版內文
    image_pool = Column(JSON, default=list)           # 圖片路徑清單
    cover_ids = Column(JSON, default=list)            # 3 張首頁候選（image_pool 的索引或路徑）
    qr_image = Column(String(500), default="")        # LINE QR，選填
    source_url = Column(String(1000), default="")     # 網址匯入的來源頁（判斷「已匯入過」用）
    enabled = Column(Boolean, default=True)           # 上架開關：關掉＝退出排程輪替池（不影響已發出的刊登）
    target_groups = Column(JSON, default=list)        # 社團名稱清單
    groups_per_listing = Column(Integer, default=20)  # 每則轉發幾個社團
    live_listings = Column(JSON, default=list)        # 目前 FB 上的商品 [{item_url, posted_at}]
    last_posted_at = Column(DateTime, nullable=True)
    post_count_total = Column(Integer, default=0)
    # ── 合併 gp_listings（老闆 2026-09-06「直接改到好」）────────────────
    # 兩張表的欄位本來就幾乎一樣，社團發文只多這兩個（發文間隔）。
    sleep_min_sec = Column(Integer, default=60)       # 社團發文：兩則之間至少隔多久
    sleep_max_sec = Column(Integer, default=180)
    # 這間房要發去哪些通道：["mp"]／["gp"]／["mp","gp"]
    channels = Column(JSON, default=lambda: ["mp"])
    # ── 社團發文自己的那一份（gp_ 前綴），不跟 Marketplace 共用 ──
    # 併表後第一版讓兩邊共用 target_groups 與 health_status，實際會互相踩：
    #   ・Marketplace 的「轉發社團」和社團發文的「目標社團」是兩份不同語意的名單，
    #     在任一頁改都會把另一頁的蓋掉；
    #   ・社團發文連續卡審核 3 次 → health='problem' → Marketplace 的
    #     eligible_property_ids_sync 也把這間房濾掉，明明 Marketplace 沒事。
    # 所以行為相關的欄位各留一份。（設計檢查 2026-09-06）
    gp_target_groups = Column(JSON, default=list)
    gp_health_status = Column(String(10), default="ok")
    gp_consecutive_review = Column(Integer, default=0)
    gp_success_count = Column(Integer, default=0)
    gp_review_count = Column(Integer, default=0)
    gp_reject_count = Column(Integer, default=0)
    gp_last_status = Column(String(20), default="")
    gp_last_status_at = Column(DateTime, nullable=True)
    # 從哪一筆 gp_listings 搬過來的（0＝本來就是 Marketplace 物件）。
    # 留著是為了把舊的 gp_schedules.listing_ids 對映過來，也是回退的線索。
    gp_legacy_id = Column(Integer, default=0, index=True)

    title_cursor = Column(Integer, default=0)         # 標題輪替游標
    body_cursor = Column(Integer, default=0)          # 內文輪替游標
    cover_cursor = Column(Integer, default=0)         # 首頁輪替游標
    # P18 健康度追蹤：連續卡審核/被拒 → 標記問題物件，排程自動跳過（省額度）
    success_count = Column(Integer, default=0)
    review_count = Column(Integer, default=0)         # 累計「審核中」次數
    reject_count = Column(Integer, default=0)         # 累計「被拒」次數
    consecutive_review = Column(Integer, default=0)   # 連續審核中（成功歸零）
    health_status = Column(String(10), default="ok")  # ok / watch / problem
    last_status = Column(String(20), default="")      # 最近一次發文結果
    last_status_at = Column(DateTime, nullable=True)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class MarketplaceSchedule(Base):
    """Marketplace 定時發文排程（輪替一組物件）。"""
    __tablename__ = "marketplace_schedules"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    property_ids = Column(JSON, default=list)         # 要輪替發的物件池
    extra_platforms = Column(JSON, default=list)      # P27：["threads","ig"] FB 發完順發
    # 順發平台各自的每日上限 {"threads": 2, "ig": 1}（老闆 2026-09-08：數量分別制定）。
    # 沒設（{} 或 0）＝跟著每場發、不另外限制。上限以「同帳號當天成功發出的則數」計，
    # MP 與社團排程共用同一個額度——客戶心裡想的是「Threads 一天最多幾則」，不是每條排程各幾則。
    extra_daily_cap = Column(JSON, default=dict)
    # 同一張表單建出來的 MP＋社團兩條排程共用一個 bundle_id：清單顯示成一條、啟動停止刪除一起動
    # （老闆 2026-09-08：「加入社團發文會變成另一個排程，且重複 IG、Threads」）
    bundle_id = Column(String(32), default="")
    time_mode = Column(String(10), default="window")  # points（固定時間點）/ window（時間區段）；預設隨機（2026-09-07）
    time_points = Column(JSON, default=list)          # ["09:00","13:00",...] 3-5 個
    window_start = Column(String(5), default="09:00")
    window_end = Column(String(5), default="21:00")
    daily_count = Column(Integer, default=3)          # （相容）每天執行次數
    daily_count_min = Column(Integer, default=0)      # 每天隨機次數下限（>0 則啟用範圍）
    daily_count_max = Column(Integer, default=0)      # 每天隨機次數上限
    random_delay = Column(Boolean, default=True)      # 固定點再加隨機偏移
    batch_min_sec = Column(Integer, default=45)       # 社團補刊批次亂速下限
    batch_max_sec = Column(Integer, default=120)
    cooldown_min_sec = Column(Integer, default=300)   # 工作間冷卻 5-10 分鐘
    cooldown_max_sec = Column(Integer, default=600)
    headless = Column(Boolean, default=True)
    dry_run = Column(Boolean, default=False)
    auto_delete_days = Column(Integer, default=7)     # N 天後自動刪除 Marketplace 刊登（0=關閉）
    status = Column(String(20), default="stopped")    # running / paused / stopped
    next_run = Column(DateTime, nullable=True)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class GroupPreset(Base):
    """社團群組預設：把一組可轉發社團名稱存起來，套用到物件時不用重選。"""
    __tablename__ = "group_presets"

    id = Column(Integer, primary_key=True, autoincrement=True)
    name = Column(String(100), default="")
    group_names = Column(JSON, default=list)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class GpListing(Base):
    """社團發文「物件」— 與 Marketplace Property 完全分開（只共用帳號／社團資料）。"""
    __tablename__ = "gp_listings"

    id = Column(Integer, primary_key=True, autoincrement=True)
    account_id = Column(Integer, ForeignKey("accounts.id"), nullable=False)
    name = Column(String(200), default="")
    base_content = Column(Text, default="")
    source_url = Column(String(1000), default="")  # 網址匯入的來源頁（判斷「已匯入過」用）
    enabled = Column(Boolean, default=True)        # 上架開關：關掉＝退出排程輪替池
    titles = Column(JSON, default=list)          # 多版標題
    bodies = Column(JSON, default=list)          # 多版內文
    image_pool = Column(JSON, default=list)      # 圖片路徑列表
    target_groups = Column(JSON, default=list)   # 社團名稱列表
    # 社團間間隔。原本 45-120 秒——連發 20 個社團等於一小時內打完，節奏太整齊
    # 也太密集，是觸發垃圾訊息判定的主因之一。拉長並加大隨機幅度，讓每次的
    # 總時長與間隔分布都不一樣（既有排程沿用自己存的值，只有新建的吃這個預設）。
    sleep_min_sec = Column(Integer, default=180)
    sleep_max_sec = Column(Integer, default=600)
    success_count = Column(Integer, default=0)
    review_count = Column(Integer, default=0)
    reject_count = Column(Integer, default=0)
    consecutive_review = Column(Integer, default=0)
    health_status = Column(String(10), default="ok")  # ok / watch / problem
    last_status = Column(String(20), default="")
    last_status_at = Column(DateTime, nullable=True)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class GpGroupPreset(Base):
    """社團發文專用群組預設（與 MP group_presets 分開）。"""
    __tablename__ = "gp_group_presets"

    id = Column(Integer, primary_key=True, autoincrement=True)
    name = Column(String(100), default="")
    group_names = Column(JSON, default=list)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)


class GpSchedule(Base):
    """社團發文定時排程：逐社團直發（非轉發）。"""
    __tablename__ = "gp_schedules"

    id = Column(Integer, primary_key=True, autoincrement=True)
