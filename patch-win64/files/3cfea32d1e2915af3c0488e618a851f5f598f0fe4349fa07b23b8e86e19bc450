def budget_remaining_sync() -> tuple[int, int]:
    """回傳今日剩餘 (listings, posts)。上限依暖機週數動態放量。
    SaaS：若有雲端聚合快照（同 license 跨機器總量），剩餘取本地與雲端的較小值，
    防一把 key 多台機器各自吃滿本地額度。"""
    lu, pu = get_daily_budget_sync()
    lm, pm = current_limits_sync()
    rem_l, rem_p = max(0, lm - lu), max(0, pm - pu)
    try:
        from .cloud_client import cloud_usage_snapshot
        snap = cloud_usage_snapshot()
    except Exception:
        snap = None
    if snap:
        caps = snap.get("caps") or {}
        if caps.get("listings"):
            rem_l = min(rem_l, max(0, caps["listings"] - (snap.get("listings") or 0)))
        if caps.get("posts"):
            rem_p = min(rem_p, max(0, caps["posts"] - (snap.get("posts") or 0)))
    return rem_l, rem_p


def add_daily_usage_sync(listings: int = 0, posts: int = 0):
    d = today_taipei()
    with SyncSession() as s:
        b = s.execute(select(DailyBudget).where(DailyBudget.date == d)).scalar_one_or_none()
        if not b:
            b = DailyBudget(date=d, listings_used=0, posts_used=0)
            s.add(b)
        b.listings_used += listings
        b.posts_used += posts
        s.commit()
    # SaaS：背景回報雲端聚合（best-effort，不阻塞發文流程、失敗靜默）
    import threading
    from .cloud_client import report_usage
    threading.Thread(target=report_usage, kwargs={"listings": listings, "posts": posts},
                     daemon=True).start()


# ── P18 物件健康度 ────────────────────────────────────
REVIEW_TO_PROBLEM = 5   # 連續審核中達此次數 → 問題物件（排程跳過）
REVIEW_TO_WATCH = 3     # 連續審核中達此次數 → 觀察（僅提示）


def _classify_post_status(status_text: str, error_text: str = "") -> str:
    """把發文結果歸類為 success / review / reject / other（技術失敗）。"""
    st = status_text or ""
    blob = f"{st} {error_text or ''}".lower()
    for kw in ("拒絕", "被拒", "違反", "已移除", "rejected", "removed", "policy"):
        if kw.lower() in blob:
            return "reject"
    for kw in ("成功", "已上架", "上架成功", "published", "active", "live"):
        if kw in st:
            return "success"
    for kw in ("審核", "無法確認", "pending", "review"):
        if kw.lower() in blob:
            return "review"
    return "other"


def update_property_health_sync(prop_id: int, status_text: str, error_text: str = "") -> str:
    """依發文結果更新物件健康度。回傳歸類（success/review/reject/other）。
    problem 一旦標記，只有 reset_property_health_sync 能解除（手動恢復）。"""
    cls = _classify_post_status(status_text, error_text)
    with SyncSession() as s:
        p = s.get(Property, prop_id)
        if not p:
            return cls
        p.last_status = (status_text or "")[:20]
        p.last_status_at = datetime.datetime.utcnow()
        if cls == "success":
            p.success_count = (p.success_count or 0) + 1
            p.consecutive_review = 0
            if p.health_status != "problem":
                p.health_status = "ok"
        elif cls == "review":
            p.review_count = (p.review_count or 0) + 1
            p.consecutive_review = (p.consecutive_review or 0) + 1
            if p.health_status != "problem":
                if p.consecutive_review >= REVIEW_TO_PROBLEM:
                    p.health_status = "problem"
                elif p.consecutive_review >= REVIEW_TO_WATCH:
                    p.health_status = "watch"
        elif cls == "reject":
            p.reject_count = (p.reject_count or 0) + 1
            p.consecutive_review = 0
            p.health_status = "problem"
        # other（技術失敗/timeout）：只記 last_status，不動計數與健康度
        s.commit()
    return cls


def week_post_counts_sync(task_type: str) -> tuple[int, int]:
    """(近 7 天成功發文數, 再往前 7 天的數)。給頂部狀態列的「本週已發 vs 上週」。

    needs_manual 也算發出去了——貼文本身成功，只是收尾要人工。
    """
    now = datetime.datetime.utcnow()
    week_ago = now - datetime.timedelta(days=7)
    two_weeks_ago = now - datetime.timedelta(days=14)
    ok = ("success", "needs_manual")
    with SyncSession() as s:
        week = s.execute(
            select(func.count(RunLog.id)).where(
                RunLog.task_type == task_type, RunLog.status.in_(ok),
                RunLog.created_at >= week_ago)
        ).scalar() or 0
        prev = s.execute(
            select(func.count(RunLog.id)).where(
                RunLog.task_type == task_type, RunLog.status.in_(ok),
                RunLog.created_at >= two_weeks_ago, RunLog.created_at < week_ago)
        ).scalar() or 0
    return int(week), int(prev)


def is_postable(row) -> bool:
    """這個物件現在能不能發：使用者沒關掉，而且健康度不是 problem。

    Marketplace 物件與社團發文物件的欄位同名，共用同一個判斷——
    分成兩份寫，遲早只會改到其中一邊。

    enabled 是 None 時當成「可以發」：加欄位之前就存在的列可能沒有值，
    把 None 當成關閉會讓客戶的排程無聲停擺。
    """
    enabled = getattr(row, "enabled", None)
    if enabled is not None and not enabled:
        return False
    return (getattr(row, "health_status", "ok") or "ok") != "problem"


def eligible_property_ids_sync(ids: list[int]) -> list[int]:
    """從給定物件池濾掉「被關掉的」與 health_status='problem' 的，回傳可發送的 id。"""
    if not ids:
        return []
    with SyncSession() as s:
        rows = s.execute(select(Property).where(Property.id.in_(ids))).scalars().all()
        return [p.id for p in rows if is_postable(p)]


