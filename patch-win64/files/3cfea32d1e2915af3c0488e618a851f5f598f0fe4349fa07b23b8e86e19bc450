def posting_grace_remaining_sync(fb_bound_at) -> int:
    """這個帳號的養號期還剩幾天不能發文；0 = 已可發文。

    fb_bound_at 為 None（舊帳號、綁定時間不明）→ 視為已過養號期，回 0，
    不影響既有客戶。
    """
    if fb_bound_at is None:
        return 0
    grace = nurture_grace_days_sync()
    if grace <= 0:
        return 0
    elapsed = (datetime.datetime.utcnow() - fb_bound_at).total_seconds() / 86400
    remaining = grace - elapsed
    return int(remaining) + (1 if remaining > int(remaining) else 0) if remaining > 0 else 0


def set_system_pause_sync(paused: bool, reason: str = "", detail: str = ""):
    with SyncSession() as s:
        st = s.execute(select(SystemState)).scalars().first()
        if not st:
            st = SystemState()
            s.add(st)
        st.paused = paused
        st.pause_reason = reason if paused else ""
        st.pause_detail = detail if paused else ""
        st.paused_at = datetime.datetime.utcnow() if paused else None
        s.commit()
