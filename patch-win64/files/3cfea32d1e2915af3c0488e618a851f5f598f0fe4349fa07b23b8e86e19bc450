        ("properties", "sleep_max_sec", "INTEGER DEFAULT 180"),
        ("properties", "channels", "TEXT DEFAULT \'[\"mp\"]\'"),
        ("properties", "deal_type", "TEXT DEFAULT 'sale'"),
        ("properties", "gp_legacy_id", "INTEGER DEFAULT 0"),
        # 社團發文自己的名單與健康度（設計檢查 2026-09-06）
        ("properties", "gp_target_groups", "TEXT DEFAULT '[]'"),
        ("properties", "gp_health_status", "VARCHAR(10) DEFAULT 'ok'"),
        ("properties", "gp_consecutive_review", "INTEGER DEFAULT 0"),
        ("properties", "gp_success_count", "INTEGER DEFAULT 0"),
        ("properties", "gp_review_count", "INTEGER DEFAULT 0"),
        ("properties", "gp_reject_count", "INTEGER DEFAULT 0"),
        ("properties", "gp_last_status", "VARCHAR(20) DEFAULT ''"),
        ("properties", "gp_last_status_at", "DATETIME"),
        # 社團自動分類（2026-09-07）
        ("groups", "tags", "TEXT DEFAULT '[]'"),
        ("groups", "region", "VARCHAR(10) DEFAULT ''"),
    ]
    with sync_engine.begin() as conn:
        for table, column, ddl in additions:
            cols = {row[1] for row in conn.execute(text(f"PRAGMA table_info({table})"))}
            if column not in cols:
                conn.execute(text(f"ALTER TABLE {table} ADD COLUMN {column} {ddl}"))


def _copy_gp_state(g, target) -> None:
    """把 gp_listings 那一筆的名單與健康度搬進 Property 的 gp_* 欄位。"""
    target.gp_target_groups = list(g.target_groups or [])
    target.gp_health_status = g.health_status or "ok"
    target.gp_consecutive_review = g.consecutive_review or 0
    target.gp_success_count = g.success_count or 0
    target.gp_review_count = g.review_count or 0
    target.gp_reject_count = g.reject_count or 0
    target.gp_last_status = g.last_status or ""
    target.gp_last_status_at = g.last_status_at


def merge_gp_listings_into_properties() -> dict:
    """把 gp_listings 併進 properties（老闆 2026-09-06「直接改到好」）。

    冪等：靠 properties.gp_legacy_id 記住哪一筆已經搬過，重跑不會重複建。
    **gp_listings 一列都不刪**——出事時它就是回退的依據。

    配對規則跟畫面那一版一致：有來源網址就比網址（最可靠），
    沒有就比「同帳號＋同名稱」。配到就把 gp 併進那間房的 channels，
    配不到就新建一筆 channels=["gp"] 的 Property。

    最後把 gp_schedules.listing_ids 從舊的 gp_listings.id 換成新的
    properties.id——漏掉這步，客戶的社團發文排程會全部指到不存在的物件。
    """
    moved = linked = created = sched = 0
    with SyncSession() as session:
        listings = session.execute(select(GpListing)).scalars().all()
        if not listings:
            return {"moved": 0, "linked": 0, "created": 0, "schedules": 0}

        props = session.execute(select(Property)).scalars().all()
        done = {p.gp_legacy_id for p in props if p.gp_legacy_id}
        id_map: dict[int, int] = {p.gp_legacy_id: p.id for p in props if p.gp_legacy_id}

        def _key(x):
            return (x.source_url or "").strip() or (x.name or "").strip()

        by_url = {(p.source_url or "").strip(): p for p in props if (p.source_url or "").strip()}
        by_name = {(p.account_id, (p.name or "").strip()): p for p in props}

        by_legacy = {p.gp_legacy_id: p for p in props if p.gp_legacy_id}
        for g in listings:
            if g.id in done:                      # 這筆已經搬過
                # gp_* 欄位是後來才加的（設計檢查 2026-09-06）：先前搬過的那幾筆
                # 這些欄位還是空白，從還留著的 gp_listings 補一次。只在「全是預設值」
                # 時補——社團發文一旦真的跑過，計數就不是 0，不能被舊資料蓋回去。
                t = by_legacy.get(g.id)
                if t is not None and not (t.gp_target_groups or []) and (t.gp_health_status or "ok") == "ok" \
                        and not (t.gp_success_count or t.gp_review_count or t.gp_reject_count) \
                        and not (t.gp_last_status or ""):
                    _copy_gp_state(g, t)
                continue
            key = _key(g)
            target = by_url.get(key) if (g.source_url or "").strip() else \
                by_name.get((g.account_id, key))
            if target is not None:
                chans = list(target.channels or ["mp"])
                if "gp" not in chans:
                    chans.append("gp")
                target.channels = chans
                target.sleep_min_sec = g.sleep_min_sec or target.sleep_min_sec
                target.sleep_max_sec = g.sleep_max_sec or target.sleep_max_sec
                _copy_gp_state(g, target)          # 社團那份進 gp_*，MP 的一個都不碰
                target.gp_legacy_id = g.id
                id_map[g.id] = target.id
                linked += 1
            else:
                row = Property(
                    account_id=g.account_id, name=g.name, base_content=g.base_content,
                    titles=list(g.titles or []), bodies=list(g.bodies or []),
                    image_pool=list(g.image_pool or []),
                    cover_ids=list(g.image_pool or [])[:3],
                    source_url=g.source_url or "", enabled=bool(g.enabled),
                    sleep_min_sec=g.sleep_min_sec or 60, sleep_max_sec=g.sleep_max_sec or 180,
                    channels=["gp"], gp_legacy_id=g.id,
                )
                _copy_gp_state(g, row)
                session.add(row)
                session.flush()                   # 要拿到 id 給排程對映
                id_map[g.id] = row.id
                created += 1
            moved += 1

        # 舊排程指向的是 gp_listings.id，換成對應的 properties.id
        for sc in session.execute(select(GpSchedule)).scalars().all():
            old_ids = list(sc.listing_ids or [])
            new_ids = [id_map.get(i, i) for i in old_ids]
            if new_ids != old_ids:
                sc.listing_ids = new_ids
                sched += 1

        session.commit()
    return {"moved": moved, "linked": linked, "created": created, "schedules": sched}


def migrate_plaintext_passwords():
    """把 accounts.password 中無 enc: 前綴的明文就地加密。冪等。"""
    from .crypto import encrypt_secret, is_encrypted
    with SyncSession() as session:
        accounts = session.execute(select(Account)).scalars().all()
        changed = 0
        for acc in accounts:
            if acc.password and not is_encrypted(acc.password):
                acc.password = encrypt_secret(acc.password)
                changed += 1
        if changed:
            session.commit()
        return changed


