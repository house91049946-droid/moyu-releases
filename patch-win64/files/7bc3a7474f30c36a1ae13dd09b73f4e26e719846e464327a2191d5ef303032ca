"""P5 — 自動留言模組（www 版）。

對指定貼文 URL 進行留言，支援多 URL、隨機間隔、模擬真人打字。
"""
import random
import time
from dataclasses import dataclass

from playwright.sync_api import Page

from src.utils import enhanced_get, human_sleep, capture_screenshot, perform_checks, CheckResult


@dataclass
class CommentResult:
    url: str
    success: bool
    error: str = ""


def comment_on_post(
    page: Page,
    fbid: str,
    post_url: str,
    content: str,
    timeout_sec: int = 30,
) -> CommentResult:
    """對單一 Facebook 貼文留言。

    Args:
        page: 已登入的 Playwright Page
        fbid: FB ID（用於截圖命名）
        post_url: 貼文 URL（https://www.facebook.com/groups/xxx/posts/123 格式）
        content: 留言內容
        timeout_sec: 操作 timeout

    Returns:
        CommentResult
    """
    try:
        # 導向貼文頁面
        if not enhanced_get(page, post_url):
            return CommentResult(url=post_url, success=False, error="無法載入貼文頁面")

        human_sleep(2, 4)

        # 向下捲動確保留言框可見
        page.mouse.wheel(0, random.randint(200, 500))
        human_sleep(1, 3)

        # 方法 1：尋找 aria-label 包含「留言」的元素
        comment_box = page.locator('[aria-label*="留言" i]').first
        if comment_box.count() == 0:
            # 方法 2：尋找常見的留言輸入框 class
            comment_box = page.locator('div[role="textbox"][contenteditable="true"]').first

        if comment_box.count() == 0:
            # 方法 3：尋找有 placeholder 文字的輸入區
            comment_box = page.locator('[placeholder*="留言" i], [placeholder*="comment" i], [placeholder*="回應" i]').first

        if comment_box.count() == 0:
            # 方法 4：嘗試點擊「留言」或「Comment」按鈕展開輸入框，再找輸入區
            trigger = page.locator('text=留言 >> visible=true').first
            if trigger.count() > 0:
                trigger.click()
                human_sleep(1, 3)
                comment_box = page.locator('div[role="textbox"][contenteditable="true"]').first

        if comment_box.count() == 0:
            capture_screenshot(page, fbid, f"comment_no_box_{post_url[-20:]}")
            return CommentResult(url=post_url, success=False, error="找不到留言輸入框")

        # 模擬真人打字（逐字輸入）
        comment_box.click()
        human_sleep(0.5, 1.5)

        comment_box.fill("")  # 清空可能已有的內容
        for char in content:
            comment_box.type(char, delay=random.randint(50, 180))
            if random.random() < 0.1:
                human_sleep(0.2, 0.5)

        human_sleep(0.5, 1.5)

        # 按 Enter 送出留言
        page.keyboard.press("Enter")
        human_sleep(2, 4)

        # 嘗試點擊送出按鈕（如果 Enter 沒用）
        submit_btns = page.locator('[aria-label*="送出" i], [aria-label*="回覆" i], text=送出 >> visible=true').first
        if submit_btns.count() > 0:
            try:
                submit_btns.click(timeout=5000)
            except Exception:
                pass

        human_sleep(1, 3)

        # 健康檢查
        check = perform_checks(page, fbid)
        if check != CheckResult.OK:
            return CommentResult(url=post_url, success=False, error=f"貼文審查觸發: {check.value}")

        return CommentResult(url=post_url, success=True)

    except Exception as e:
        return CommentResult(url=post_url, success=False, error=str(e))


def comment_on_multiple_posts(
    page: Page,
    fbid: str,
    post_urls: list[str],
    content: str,
    sleep_seconds: int = 60,
) -> list[CommentResult]:
    """對多個貼文 URL 進行留言，間隔 sleep_seconds 秒。

    Args:
        page: 已登入的 Playwright Page
        fbid: FB ID
        post_urls: 貼文 URL 列表
        content: 留言內容（所有貼文共用）
        sleep_seconds: 貼文間間隔

    Returns:
        list of CommentResult
    """
    results: list[CommentResult] = []
    for i, url in enumerate(post_urls):
        print(f"[comment] {i + 1}/{len(post_urls)}: {url[-40:]}")
        result = comment_on_post(page, fbid, url, content)
        results.append(result)
        print(f"  → {'OK' if result.success else result.error}")

        if i < len(post_urls) - 1 and result.success:
            # 成功後等待一段時間再繼續
            human_sleep(sleep_seconds - 10, sleep_seconds + 10)

    return results
