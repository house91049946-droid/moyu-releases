# ── 只刪摸魚發的（老闆 2026-09-05）──────────────────────────────────────────────
# 掃到的貼文要「對得上我們自己的紀錄」才刪：網址在白名單裡，或內文含我們固定附加的
# 法定資訊／某個物件標題。兩種都對不上就跳過（記成 not_ours），寧可留著客戶手動發的。
def load_only(path: str) -> dict:
    """讀白名單檔。壞檔／不存在 → 回 None，代表「沒有白名單」。

    注意這裡回 None 而不是空 dict：兩者語意不同。
    None＝呼叫端沒給白名單（舊行為）；空的白名單＝有給但裡面沒東西，
    那就一則都不該刪——不然「紀錄是空的」會變成「全部都刪」。
    """
    if not path:
        return None
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, json.JSONDecodeError):
        print("[fbclean] ⚠ 白名單讀不到，這輪不刪任何東西（保守處理）", flush=True)
        return {"urls": [], "phrases": []}
    if isinstance(raw, dict):
        mad = raw.get("max_age_days")
        try:
            mad = None if mad is None else max(0, int(mad))
        except (TypeError, ValueError):
            mad = None
        return {"urls": [str(u) for u in (raw.get("urls") or [])],
                "phrases": [str(p) for p in (raw.get("phrases") or [])],
                "max_age_days": mad}
    return {"urls": [], "phrases": []}


def before_moyu(age_days, only: dict | None) -> bool:
    """這則比摸魚第一次發文還早，不可能是摸魚發的——不用開頁面比內文，直接留著。

    老闆 2026-09-08：「都已經是執行腳本，為什麼會這麼久」——個人頁 170 則每則都開來比，
    二十幾分鐘；摸魚才用幾天，比那之前的一律跳過，只開這幾天的十幾則。"""
    if only is None or age_days is None:
        return False
    mad = only.get("max_age_days")
    if mad is None:
        return False
    try:
        return int(age_days) > int(mad)
    except (TypeError, ValueError):
        return False


def _norm_url(u: str) -> str:
    return (u or "").split("?")[0].rstrip("/").lower()


def is_ours(url: str, text: str, only: dict | None) -> bool:
    """這則是不是摸魚發的？沒有白名單就一律當成是（維持舊行為）。"""
    if only is None:
        return True
    nu = _norm_url(url)
    if nu and any(nu == _norm_url(u) or (u and _norm_url(u) in nu) for u in only.get("urls") or []):
        return True
    body = (text or "")
    return any(p and p in body for p in only.get("phrases") or [])


def envelope(result: dict) -> dict:
    """結果 dict → 寫進檔案的樣子：頂層照舊，另鏡一份到 data。"""
    body = {k: v for k, v in result.items() if k != "data"}
    out = dict(body)
    out["data"] = body
    return out


def effective_older_than(requested: int | None, force_recent: bool = False) -> int:
    """把天數夾到合理範圍。下限是硬的——刪文不可逆，太短會刪到還在曝光的貼文。

    force_recent：使用者當下明確要「連這幾天的都刪」（老闆 2026-09-08）——只在手動、
    而且帶 --only-file（只刪摸魚發的）時才該用；排程永遠不會帶這個旗標。0＝不看天數。"""
    if force_recent and requested is not None:
        return max(0, int(requested))
    n = DEFAULT_OLDER_THAN if not requested or requested <= 0 else int(requested)
    return max(MIN_OLDER_THAN, n)


def effective_max(requested: int | None) -> int:
    """一輪的刪除上限。剩下的明天繼續刪，不要一次刪光——量太大最容易被判機器人。"""
    n = DEFAULT_MAX if not requested or requested <= 0 else int(requested)
    return max(1, min(HARD_CAP, n))


def should_delete(age_days, older_than: int) -> bool:
    """這則該不該刪？日期讀不到（None／負數／看不懂）一律不刪——寧可留著。"""
    if age_days is None:
        return False
    try:
        age = int(age_days)
    except (TypeError, ValueError):
        return False
    return age >= 0 and age >= older_than


def parse_age_days(text: str, now: datetime.datetime | None = None) -> int | None:
    """FB 的時間標記 → 幾天前發的；判不出來回 None（呼叫端要跳過，不是當成 0）。

    FB 自己多出來的講法只有「今天／昨天／前天」（時報上很常見），先在這裡吃掉；
    ISO、「2026年7月12日」、「3天前」「2週」「3 days ago」那些跟 Threads／IG 同語系，
    直接交給 run_meta_cleanup 的同一份解析，不維護兩套字表。

    now 可注入：不注入的話測試會寫死日期，過幾個月自己爆炸。
    """
    text = (text or "").strip()
    if not text:
        return None
    if any(w in text for w in _DAY_BEFORE_WORDS):
        return 2
    if any(w in text for w in _YESTERDAY_WORDS):
        return 1
    if any(w in text for w in _TODAY_WORDS):
        return 0
    got = _meta_age_days(text, now=now)
    if got is not None:
        return got
    return _month_day_age(text, now=now)


_MONTH_DAY_RE = __import__("re").compile(r"(?<!\d)(\d{1,2})月(\d{1,2})日")


def _month_day_age(text: str, now: datetime.datetime | None = None) -> int | None:
    """FB 一年內的時間戳「7月12日 下午2:10」不帶年份。
    當作今年；算出來在未來就是去年的——FB 只對一年內的貼文省略年份，不會更早。"""
    m = _MONTH_DAY_RE.search(text or "")
    if not m:
        return None
    now = now or datetime.datetime.now()
    try:
        d = datetime.datetime(now.year, int(m.group(1)), int(m.group(2)))
    except ValueError:
        return None
    if d > now:
        d = d.replace(year=now.year - 1)
    return (now - d).days


