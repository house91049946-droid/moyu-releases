def post_key_from_url(url: str, fbid: str = "", vanity: str = "") -> str:
    """FB 連結 → 「這是哪一則貼文」的唯一鍵；不是本人的貼文一律回空字串。

    認得的四種寫法（其餘一律不認，寧可少刪）：
      - /permalink.php?story_fbid=X&id=<fbid>   → X
      - /story.php?story_fbid=X&id=<fbid>       → X
      - /<fbid>/posts/X                          → X
      - /<自己的代稱>/posts/X                     → X（vanity 有給才認）

    刻意擋掉的：
      - 帶 comment_id 的連結——那是**留言**的永久連結，不是貼文本體。
        FB 的留言區裡到處都是這種連結，收進來就會去刪錯東西。
      - /groups/…/posts/… —— 社團貼文（SPEC-P32 §2 另一條路，本支不掃）。
      - 別人的貼文（id／代稱對不上）—— 別人 tag 你、朋友貼到你的時報都長這樣。
      - /photo/、/reel/、/videos/ —— 那是附件的連結，不是貼文標頭。
    """
    if not url:
        return ""
    u = urlparse(url.strip())
    qs = parse_qs(u.query or "")
    if qs.get("comment_id"):
        return ""
    path = (u.path or "").rstrip("/")
    segs = [s for s in path.split("/") if s]

    if path.endswith("permalink.php") or path.endswith("story.php"):
        sid = (qs.get("story_fbid") or [""])[0]
        owner = (qs.get("id") or [""])[0]
        if not sid:
            return ""
        if fbid and owner and owner != str(fbid):
            return ""
        return sid

    if len(segs) >= 3 and segs[1] == "posts":
        author, sid = segs[0], segs[2]
        if author in _NOT_AUTHOR:
            return ""
        allowed = {str(fbid)} | ({vanity} if vanity else set())
        if fbid and author not in allowed:
            return ""
        return sid
    return ""


def canonical_post_url(url: str, fbid: str = "", vanity: str = "") -> str:
    """把帶一堆追蹤參數（__cft__、__tn__、notif_id…）的連結收斂成乾淨網址。

    不收斂的話同一則會因為參數不同被當成好幾則，一輪的額度就被同一篇吃光。
    """
    key = post_key_from_url(url, fbid, vanity)
    if not key:
        return ""
    u = urlparse(url.strip())
    path = (u.path or "").rstrip("/")
    if path.endswith("permalink.php") or path.endswith("story.php"):
        owner = (parse_qs(u.query or "").get("id") or [str(fbid)])[0] or str(fbid)
        return f"{FB}/permalink.php?story_fbid={key}&id={owner}"
    segs = [s for s in path.split("/") if s]
    return f"{FB}/{segs[0]}/posts/{key}"


def cards_to_posts(cards: list, fbid: str = "", vanity: str = "",
                   now: datetime.datetime | None = None) -> list[dict]:
    """時報上收到的卡片 → 候選貼文 [{url, key, age_days, pinned}]，同一則只留第一筆。

    年齡優先讀時間戳連結自己的文字（「3天」「2週」）；讀不到才退回卡片開頭那段
    （名字＋時間那一行）。**絕不整張卡拿去解析**——卡片下半部是留言，留言的
    「2 小時」會把一則三個月前的貼文算成今天發的。
    """
    out: list[dict] = []
    seen: set[str] = set()
    for c in cards or []:
        href = (c or {}).get("href") or ""
        key = post_key_from_url(href, fbid, vanity)
        if not key or key in seen:
            continue
        seen.add(key)
        age = parse_age_days((c.get("stamp") or ""), now=now)
        if age is None:
            age = parse_age_days((c.get("head") or "")[:60], now=now)
        out.append({"url": canonical_post_url(href, fbid, vanity), "key": key,
                    "age_days": age, "pinned": bool(c.get("pinned"))})
    return out


def block_reason(page_text: str = "", error_text: str = "") -> str:
    """頁面文字是不是「這輪該停」的訊號？是就回原因字串，否則空字串。

    只認 action_blocked：FB 到處都有「請稍後再試」，把節流也當封鎖會天天誤停。
    """
    reason = classify_fb_block(page_text=page_text, error_text=error_text)
    return reason if reason == ACTION_BLOCKED else ""


def summarize(posts: list) -> dict:
    """結果 JSON 的計數欄位。dry-run 的那些算「本來要刪的」，不算已刪。"""
    st = [p.get("status") for p in posts or []]
    return {"deleted": st.count("deleted"),
            "skipped_undated": st.count("undated"),
            "skipped_recent": st.count("recent")}


def describe(result: dict) -> str:
    """給客戶看的一行紀錄：動詞＋對象＋數量，不能只寫「成功」。"""
    older = result.get("older_than", DEFAULT_OLDER_THAN)
    undated = result.get("skipped_undated", 0)
    tail = f"（另 {undated} 則日期讀不到，留著）" if undated else ""
    if result.get("dry_run"):
        n = sum(1 for p in result.get("posts", []) if p.get("status") == "dry_run")
        return f"FB 備份刪文試跑：找到 {n} 則超過 {older} 天的貼文（沒有真的刪）{tail}"
    return f"FB 備份刪文：清掉 {result.get('deleted', 0)} 則超過 {older} 天的貼文{tail}"


# ---------------------------------------------------------------- 瀏覽器動作

def _body_text(page, limit: int = 4000) -> str:
    with contextlib.suppress(Exception):
        return page.evaluate("()=>document.body.innerText")[:limit]
    return ""


def _blocked_reason(page, fbid: str) -> str:
    """頁面上有封鎖／驗證跡象嗎？回原因字串，沒有回空字串。

    兩層，與加好友那支同一套：既有的 perform_checks（封鎖、鎖定、檢查點）＋文字比對。
    """
    from src.utils import CheckResult, perform_checks

    with contextlib.suppress(Exception):
        chk = perform_checks(page, fbid)
        if chk != CheckResult.OK:
            return chk.value
    return block_reason(page_text=_body_text(page))


def _own_id(page) -> str:
    """登入中的帳號 id（c_user cookie）——要跟 --fbid 對得起來才准動手。"""
    with contextlib.suppress(Exception):
        for c in page.context.cookies(FB):
            if c.get("name") == "c_user" and c.get("value"):
                return str(c["value"])
    return ""


def _my_vanity(page) -> str:
    """自己的帳號代稱（有些帳號的貼文連結是 /代稱/posts/…，不是數字 id）。

    2026-09-03 mini 實測：個人頁沒有 og:url，但 profile.php?id=… 會 302 到
    /代稱/，所以先讀當下網址，再退回 og:url。讀不到就只認數字 id 的連結——
    少收幾則沒關係，收錯人的就糟了。
    """
    for getter in (lambda: page.url,
                   lambda: page.evaluate(
                       "()=>(document.querySelector('meta[property=\"og:url\"]')||{}).content||'')".replace("')", "'")) or ""):
        with contextlib.suppress(Exception):
            u = getter() or ""
            seg = [s for s in urlparse(u).path.split("/") if s]
            if seg and seg[0] not in _NOT_AUTHOR and not seg[0].endswith(".php"):
                return seg[0]
    return ""


def activity_url(fbid: str) -> str:
    return ACTIVITY_URL.format(fbid=fbid)


# 活動紀錄的一列：「蔡峻豪新增了 1 張相片。 …內文… 所有人 下午8:53 查看」，
# 「查看」是貼文連結；日期在**上方的分組標頭**（「2026年9月1日」），不在列裡。
# ⚠️ 列的內文不能拿來算年齡：「新增了 2011年9月1日的 1 則生活要事」這種列，
#    內文裡的年份是事件日期，不是發文日期——拿它算會把上個月發的當成 15 年前的貼文刪掉。
#    所以 head 一律給空字串，年齡只信標頭；標頭找不到就 undated、不刪。
_ACTIVITY_JS = """() => {
    const isDate = /^((\\d{4}年)?\\d{1,2}月\\d{1,2}日|今天|昨天|前天)/;
    const out = [];
    const links = [...document.querySelectorAll("a[href*='/posts/'], a[href*='permalink.php'], a[href*='story.php']")]
        .filter(a => !/comment_id=/.test(a.href || ''));
    for (const a of links) {
        let row = a;
        for (let i = 0; i < 10 && row.parentElement; i++) {
            row = row.parentElement;
            const t = (row.innerText || '').trim();
            if (t.length > 25 && /\\d/.test(t)) break;
        }
        let hdr = '';
        let el = row;
        for (let i = 0; i < 6 && el && !hdr; i++) {
            let sib = el.previousElementSibling;
            while (sib && !hdr) {
                const t = (sib.innerText || '').trim().split(String.fromCharCode(10))[0];
                if (isDate.test(t)) hdr = t;
                sib = sib.previousElementSibling;
            }
            el = el.parentElement;
        }
        const rowText = (row.innerText || '').slice(0, 80);
        out.push({href: a.href || '', stamp: hdr, head: '', pinned: /置頂|Pinned/.test(rowText)});
    }
    return out;
}"""


def _collect_activity_log(page, fbid: str, vanity: str, want: int, rounds: int,
                          now: datetime.datetime | None = None) -> list[dict]:
    """活動紀錄「貼文」分類：邊捲邊收（一樣是虛擬清單），直到夠用或連捲 5 次沒新東西。"""
    with contextlib.suppress(Exception):
        page.goto(activity_url(fbid), wait_until="domcontentloaded", timeout=60000)
    human_sleep(5.0, 8.0)
    if "allactivity" not in (page.url or ""):
        print("[fbclean] 活動紀錄頁被導走了，改走時報", flush=True)
        return []
    found: list[dict] = []
    keys: set[str] = set()
    empty_rounds = 0
    for _ in range(max(1, rounds)):
        before = len(found)
        cards = []
        with contextlib.suppress(Exception):
            cards = page.evaluate(_ACTIVITY_JS) or []
        for p in cards_to_posts(cards, fbid, vanity, now=now):
            if p["key"] in keys:
                continue
            keys.add(p["key"])
            p["dated_by"] = "activity"      # 日期來自 FB 自己的活動紀錄標頭，不必再到貼文頁複驗
            found.append(p)
        if len(found) >= want:
            break
        empty_rounds = empty_rounds + 1 if len(found) == before else 0
        if empty_rounds >= 5:
            break
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 2400)
        human_sleep(1.5, 3.0)
    print(f"[fbclean] 活動紀錄收到 {len(found)} 則自己的貼文", flush=True)
    return found[:want]


def _collect_cards(page) -> list[dict]:
    with contextlib.suppress(Exception):
        return page.evaluate(_CARDS_JS, {"pin": _PINNED_HINTS}) or []
    return []


def _collect_while_scrolling(page, fbid: str, vanity: str, want: int, rounds: int,
                             now: datetime.datetime | None = None) -> list[dict]:
    """邊捲邊收，不是捲完才收。

    FB 的動態時報跟 IG 九宮格一樣是**虛擬清單**：捲下去以後上面那幾則會被從 DOM 拿掉。
    「捲 N 次再抓」的寫法只會抓到最後一屏——2026-09-03 在 IG 那支實測是把 6 則抓成 1 則，
    FB 只會更嚴重（要刪的正是最舊的那批，它們在最下面）。
    """
    found: list[dict] = []
    keys: set[str] = set()
    empty_rounds = 0
    for _ in range(max(1, rounds)):
        before = len(found)
        for p in cards_to_posts(_collect_cards(page), fbid, vanity, now=now):
            if p["key"] in keys:
                continue
            keys.add(p["key"])
            found.append(p)
        if len(found) >= want:
            break
        empty_rounds = empty_rounds + 1 if len(found) == before else 0
        # FB 時報一則貼文可能佔滿整屏，而且載入慢：連續 5 次沒有新東西才算到底，
        # 每次捲 2 屏。門檻太低會提早收手——實測只掃到 1 則就停了（2026-09-03）。
        if empty_rounds >= 5:
            break
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 2400)
        human_sleep(1.5, 3.0)
    return found[:want]


def _post_age_days(page, now: datetime.datetime | None = None) -> int | None:
    """貼文頁上的時間線索 → 幾天前。留言的時間也在這頁，但它一定比貼文新，
    最壞情況是把老貼文看成新的而跳過——保守方向，可以接受。"""
    blob = ""
    with contextlib.suppress(Exception):
        blob = page.evaluate(_TIMES_JS) or ""
    for line in blob.splitlines():
        age = parse_age_days(line, now=now)
        if age is not None:
            return age
    return None


def _first_visible(loc, limit: int = 12):
    """同一個選擇器常命中兩份：FB 會把貼文對話框渲染兩次，一份藏著（2026-09-03 實測）。
    取 .first 會剛好撞到藏著的那份、is_visible() 為 False，整個流程就當作「找不到」。
    所以要在所有命中裡挑第一個看得見的。"""
    with contextlib.suppress(Exception):
        n = min(loc.count(), limit)
        for i in range(n):
            el = loc.nth(i)
            if el.is_visible():
                return el
    return None


def _find_by_texts(page, texts, roles=("menuitem", "button")):
    """依中英文字找可點的元素；找不到回 None。"""
    for t in texts:
        for role in roles:
            el = _first_visible(page.get_by_role(role, name=t, exact=True))
            if el is not None:
                return el
    for t in texts:
        el = _first_visible(page.get_by_text(t, exact=True))
        if el is not None:
            return el
    return None


def _find_more_button(page):
    """貼文右上角的「⋯」。

    2026-09-03 mini 實測：貼文永久連結是開在 div[role=dialog] 裡，後面的動態牆還在；
    ⋯ 的 aria-label 是「對{姓名}的這則貼文採取的動作」。**一定要限定在對話框內找**——
    不限定的話會抓到後面動態牆別人貼文的 ⋯（實測抓到「對陳安森的這則貼文採取的動作」，
    而且被對話框蓋住點不下去，30 秒逾時）。
    """
    scopes = ('div[role="dialog"] ', "")
    for scope in scopes:
        for lab in _MORE_LABELS:
            for sel in (f'{scope}div[role="button"][aria-label*="{lab}"]', f'{scope}[aria-label*="{lab}"]'):
                el = _first_visible(page.locator(sel))
                if el is not None:
                    return el
    return _find_by_texts(page, _MORE_LABELS, roles=("button",))


def _deleted_ok(page, url: str) -> bool:
    """真的刪掉了嗎？先看有沒有「已移到垃圾桶」之類的提示，沒有就重開這則看是不是已經不在。

    不能只憑「按了確認」就算成功——按鈕點空了、對話框卡住都不會報錯，
    數字灌水比少刪一則糟糕得多（客戶會以為舊文清乾淨了，其實還掛在牆上）。
    """
    for _ in range(8):
        if any(k in _body_text(page) for k in _DELETED_MARKS):
            return True
        human_sleep(0.8, 1.4)
    with contextlib.suppress(Exception):
        page.goto(url, wait_until="domcontentloaded", timeout=45000)
        human_sleep(2.0, 3.5)
        body = _body_text(page).lower()
        return any(k.lower() in body for k in _GONE_MARKS)
    return False


def _delete_one(page, url: str) -> bool:
    """在已開啟的貼文頁上：⋯ → 移到垃圾桶／刪除 → 確認 → 驗證。

    流程沿用 delete_club_post.www_delete_club_post_main 與 Marketplace 刪除那套
    （選單找不到就 Escape 收手，確認框一定要在 dialog 裡找，最後一定要驗證），
    任何一步找不到就放棄這則——放棄一則的代價遠小於亂點。
    """
    # 貼文頁是延遲渲染的：domcontentloaded 之後 ⋯ 常常還沒長出來（2026-09-03 實測同一則
    # 貼文有時 7 秒後有、有時沒有）。先等它掛上 DOM，最多 20 秒，再找。
    with contextlib.suppress(Exception):
        page.wait_for_selector(
            '[aria-label*="採取的動作"], [aria-label*="Actions for this post"], '
            '[aria-label*="更多選項"], [aria-label*="More options"]',
            state="attached", timeout=20000)
    more = _find_more_button(page)
    if more is None:
        print("[fbclean] ⚠ 找不到貼文的「更多選項」，跳過這則", flush=True)
        return False
    more.click()
    human_sleep(1.0, 2.0)

    item = _find_by_texts(page, _DELETE_TEXTS)
    if item is None:
        with contextlib.suppress(Exception):
            page.keyboard.press("Escape")
        print("[fbclean] ⚠ 選單裡沒有「刪除／移到垃圾桶」（可能不是自己的貼文），跳過", flush=True)
        return False
    item.click()
    human_sleep(1.0, 2.0)

    # 確認框：**只在 dialog 裡找**，不做全頁退路。
    # 「刪除」同時出現在選單與確認框，全頁找會把剛按過的選單項目再配一次（點空或點到別的東西）；
    # 確認框沒開就代表這一步沒成功——寧可 Escape 收手，也不要在不確定的畫面上亂點。
    # 2026-09-03 實測：貼文本身就開在一個 dialog 裡，確認框是後來才彈出的**最後一個** dialog。
    # 所以取 .last 不取 .first——.first 會落在貼文 dialog 裡剛好也叫「刪除」的東西上。
    confirm = None
    for t in _CONFIRM_TEXTS:
        for sel in (f'div[role="dialog"] [role="button"]:has-text("{t}")',
                    f'div[role="dialog"] button:has-text("{t}")',
                    f'div[role="dialog"] [aria-label="{t}"]'):
            # 確認框是最後彈出的 dialog：從最後一個命中往前找第一個看得見的
            with contextlib.suppress(Exception):
                loc = page.locator(sel)
                for i in range(min(loc.count(), 12) - 1, -1, -1):
                    if loc.nth(i).is_visible():
                        confirm = loc.nth(i)
                        break
            if confirm is not None:
                break
        if confirm is not None:
            break
    if confirm is None:
        with contextlib.suppress(Exception):
            page.keyboard.press("Escape")
        print("[fbclean] ⚠ 沒有出現確認框，這則不動（不在不確定的畫面上亂點）", flush=True)
        return False
    with contextlib.suppress(Exception):
        print(f"[fbclean] 確認框按鈕：{(confirm.get_attribute('aria-label') or confirm.inner_text() or '')[:40]!r}", flush=True)
    global _CONFIRM_CLICKS
    _CONFIRM_CLICKS += 1          # 按下去就算一次，不管後面驗證怎麼說
    confirm.click()
    human_sleep(1.5, 3.0)
    ok = _deleted_ok(page, url)
    if not ok:
        # 沒有這一行，紀錄裡只會看到「連續 3 則刪不掉」，完全不知道卡在哪（2026-09-03 實測）
        print("[fbclean] ⚠ 按了確認但驗證失敗：沒看到「已移到垃圾桶」，重開貼文也還在", flush=True)
    return ok


def do_cleanup(fbid: str, older_than: int, max_delete: int, headless: bool,
               dry_run: bool = False, profile_dir: str | None = None,
               only: dict | None = None) -> dict:
    from src.login import _try_cookie_login
    from src.utils import capture_screenshot, launch_browser

    browser, context, page = launch_browser(fbid=fbid, headless=headless,
                                            user_data_dir=profile_dir)
    posts: list[dict] = []
    blocked, reason, pinned_skipped = False, "", 0
    try:
        if not _try_cookie_login(page, context, fbid):
            raise RuntimeError("Cookie 登入失敗，請先用 CLI 登入一次")

        me = _own_id(page)
        if me and str(me) != str(fbid):
            # 登入的不是這個帳號還照刪，就是拿別人的帳號刪文——直接不做
            raise RuntimeError(f"目前登入的是 {me}，與指定的 {fbid} 不同，為安全起見不刪任何東西")

        why = _blocked_reason(page, fbid)
        if why:
            with contextlib.suppress(Exception):
                capture_screenshot(page, fbid, "cleanup_blocked")
            print("[fbclean] ⚠ 一進來就偵測到限制，這輪不刪任何東西", flush=True)
            return {"posts": [], "blocked": True, "block_reason": why, "skipped_pinned": 0}

        page.goto(profile_url(fbid), wait_until="domcontentloaded", timeout=60000)
        human_sleep(5.0, 8.0)            # 時報是延遲載入的，等太短就是一片空白
        why = _blocked_reason(page, fbid)
        if why:
            with contextlib.suppress(Exception):
                capture_screenshot(page, fbid, "cleanup_blocked_profile")
            print("[fbclean] ⚠ 一進動態時報就偵測到限制，這輪不刪任何東西", flush=True)
            return {"posts": [], "blocked": True, "block_reason": why, "skipped_pinned": 0}

        vanity = _my_vanity(page)
        want = max_delete * 3 + SCAN_SLACK      # 要刪的是最舊的那批，得先翻得夠深
        cands = _collect_activity_log(page, fbid, vanity, want,
                                      rounds=min(60, max_delete * 3 + 12))
        if not cands:
            with contextlib.suppress(Exception):
                page.goto(profile_url(fbid), wait_until="domcontentloaded", timeout=60000)
            human_sleep(5.0, 8.0)
            cands = _collect_while_scrolling(page, fbid, vanity, want,
                                             rounds=min(60, max_delete * 3 + 12))
        pinned_skipped = sum(1 for p in cands if p["pinned"])
        cands = [p for p in cands if not p["pinned"]]
        print(f"[fbclean] 掃到 {len(cands)} 則自己的貼文"
              f"{f'（另 {pinned_skipped} 則置頂不動）' if pinned_skipped else ''}", flush=True)

        deleted = 0
        fails = 0
        for cand in cands:
            if deleted >= max_delete:
                print(f"[fbclean] 已達本輪上限 {max_delete} 則，其餘下一輪再刪", flush=True)
                break
            url, age = cand["url"], cand["age_days"]
            if age is None:
                posts.append({"url": url, "age_days": None, "status": "undated"})
                print(f"[fbclean] 日期讀不到，留著：{url}", flush=True)
                continue
            if not should_delete(age, older_than):
                posts.append({"url": url, "age_days": age, "status": "recent"})
                continue
            if before_moyu(age, only):
                posts.append({"url": url, "age_days": age, "status": "before_moyu"})
                continue
            if only is not None:
                # 判斷「是不是摸魚發的」要看內文，所以這裡一定要開貼文頁（dry-run 也要）
                with contextlib.suppress(Exception):
                    page.goto(url, wait_until="domcontentloaded", timeout=45000)
                    human_sleep(2.0, 3.5)
                if not is_ours(url, _body_text(page, 6000), only):
                    posts.append({"url": url, "age_days": age, "status": "not_ours"})
                    print(f"[fbclean] 不是摸魚發的，留著：{url}", flush=True)
                    continue
            if dry_run:
                # 只列不刪
                posts.append({"url": url, "age_days": age, "status": "dry_run"})
                deleted += 1
                continue

            with contextlib.suppress(Exception):
                page.goto(url, wait_until="domcontentloaded", timeout=45000)
            human_sleep(2.5, 4.5)
            why = _blocked_reason(page, fbid)
            if why:
                blocked, reason = True, why
                with contextlib.suppress(Exception):
                    capture_screenshot(page, fbid, "cleanup_blocked_post")
                print("[fbclean] ⚠ 偵測到動作被限制，立即中止整輪", flush=True)
                break
            if any(m in _body_text(page, 3000) for m in _GONE_MARKS):
                # 已經不在了（多半是上一輪刪成功但沒記到）：不算失敗、不吃額度、不重試
                posts.append({"url": url, "age_days": age, "status": "gone"})
                print(f"[fbclean] 這則已經不在了，略過：{url}", flush=True)
                continue

            # 時報卡片的時間不一定準，收來的要到貼文頁複驗一次。
            # 活動紀錄來的**不複驗**：貼文頁上到處是留言、相關貼文的時間（2026-09-03 實測：
            # 23 則舊貼文全被複驗成「太新」，一則都沒刪），而活動紀錄的日期是 FB 自己記的。
            if cand.get("dated_by") != "activity":
                page_age = _post_age_days(page)
                if page_age is not None and not should_delete(page_age, older_than):
                    # 兩邊不一致就聽比較保守的那個——刪錯不可逆
                    posts.append({"url": url, "age_days": page_age, "status": "recent"})
                    continue

            if _CONFIRM_CLICKS >= max_delete:
                print(f"[fbclean] 本輪已按過 {_CONFIRM_CLICKS} 次確認，達上限，停手", flush=True)
                break
            ok = False
            try:
                ok = _delete_one(page, url)
            except Exception as e:
                print(f"[fbclean] 刪除例外：{str(e)[:160]}", flush=True)
            fails = fails + 1 if not ok else 0
            if not ok and fails >= MAX_CONSECUTIVE_FAILS:
                posts.append({"url": url, "age_days": age, "status": "failed"})
                print(f"[fbclean] ⚠ 連續 {fails} 則刪不掉，多半是版面改了，這輪停手", flush=True)
                break
            why = _blocked_reason(page, fbid)
            if why:
                posts.append({"url": url, "age_days": age, "status": "failed"})
                blocked, reason = True, why
                with contextlib.suppress(Exception):
                    capture_screenshot(page, fbid, "cleanup_blocked_delete")
                print("[fbclean] ⚠ 刪除後偵測到限制，立即中止整輪", flush=True)
                break
            posts.append({"url": url, "age_days": age, "status": "deleted" if ok else "failed"})
            if ok:
                deleted += 1
                print(f"[fbclean] 已刪除 {url}（{age} 天前，{deleted}/{max_delete}）", flush=True)
                if deleted < max_delete:
                    human_sleep(*DELETE_GAP)     # 連續刪最像腳本，一定要拉開
        return {"posts": posts, "blocked": blocked, "block_reason": reason,
                "skipped_pinned": pinned_skipped}
    except Exception as e:
        e.reason = classify_fb_block(page_text=_body_text(page), error_text=str(e))
        # 已刪的不能白刪——附在例外上讓上層照樣記錄
        e.partial = {"posts": posts, "blocked": blocked, "block_reason": reason,
                     "skipped_pinned": pinned_skipped}
        raise
    finally:
        with contextlib.suppress(Exception):
            context.close()                      # persistent context：browser 與 context 同物件


def main():
    global _JSON_PATH, _RESULT
    ap = argparse.ArgumentParser(description="FB 備份模式自動刪文（SPEC-P32 §2）")
    ap.add_argument("--fbid", required=True)
    ap.add_argument("--older-than", type=int, default=DEFAULT_OLDER_THAN,
                    help=f"刪超過幾天的貼文（預設 {DEFAULT_OLDER_THAN}，最少 {MIN_OLDER_THAN}）")
    ap.add_argument("--max", type=int, default=DEFAULT_MAX,
                    help=f"這輪最多刪幾則（硬上限 {HARD_CAP}）")
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="只列出會刪哪些，不刪任何東西")
    ap.add_argument("--force-recent", action="store_true",
                    help="允許 --older-than 小於下限（含 0＝連今天的都算）；只給手動、搭配 --only-file 用")
    ap.add_argument("--only-file", default="",
                    help="白名單 JSON：只刪對得上的貼文（摸魚自己發的）")
    ap.add_argument("--result-json")
    ap.add_argument("--profile-dir", default=None, help="瀏覽器設定檔目錄（預設 user_data/<fbid>）")
    args = ap.parse_args()

    older_than = effective_older_than(args.older_than, force_recent=args.force_recent)
    max_delete = effective_max(args.max)

    _JSON_PATH = args.result_json
    _RESULT = {"success": False, "platform": PLATFORM, "fbid": args.fbid,
               "older_than": older_than, "max": max_delete, "dry_run": bool(args.dry_run),
               "deleted": 0, "skipped_undated": 0, "skipped_recent": 0, "skipped_pinned": 0,
               "blocked": False, "block_reason": "", "error": "未完成", "posts": []}
    if _JSON_PATH:
        atexit.register(_write)

    # 夾住要講明白，不然客戶以為設定 3 天就真的 3 天
    if args.older_than and args.older_than < MIN_OLDER_THAN:
        print(f"[fbclean] --older-than {args.older_than} 太小，已提高到最少 {MIN_OLDER_THAN} 天",
              flush=True)
    if args.max and args.max > HARD_CAP:
        print(f"[fbclean] --max {args.max} 超過硬上限，已夾到 {HARD_CAP} 則", flush=True)

    def _fill(r: dict):
        _RESULT["posts"] = r.get("posts", []) or []
        _RESULT["blocked"] = bool(r.get("blocked"))
        _RESULT["block_reason"] = r.get("block_reason", "") or ""
        _RESULT["skipped_pinned"] = int(r.get("skipped_pinned") or 0)
        _RESULT.update(summarize(_RESULT["posts"]))

    try:
        r = do_cleanup(args.fbid, older_than, max_delete, args.headless,
                       dry_run=args.dry_run, profile_dir=args.profile_dir,
                       only=load_only(args.only_file))
        _fill(r)
        if _RESULT["blocked"]:
            _RESULT["error"] = f"動作被限制，已中止（已刪 {_RESULT['deleted']} 則）"
            sys.exit(1)
        _RESULT["success"] = True
        _RESULT["error"] = ""
        if args.dry_run:
            # 這份清單是老闆真的動手前唯一的依據：網址 + 幾天前，最舊的排前面
            cands = sorted((p for p in _RESULT["posts"] if p.get("status") == "dry_run"),
                           key=lambda p: -(p.get("age_days") or 0))
            for p in cands:
                print(f"[fbclean] dry-run 會刪：{p['url']}（{p['age_days']} 天前）", flush=True)
            for p in (p for p in _RESULT["posts"] if p.get("status") == "undated"):
                print(f"[fbclean] dry-run 日期讀不到，會留著：{p['url']}", flush=True)
        print("[fbclean] ✅ " + describe(_RESULT), flush=True)
    except SystemExit:
        raise
    except KeyboardInterrupt:
        _RESULT["error"] = "使用者中斷"
        sys.exit(0)
    except Exception as e:
        _fill(getattr(e, "partial", {}) or {})
        _RESULT["error"] = str(e)
        reason = getattr(e, "reason", None) or classify_fb_block(error_text=str(e))
        if reason == ACTION_BLOCKED:
            _RESULT["blocked"] = True
            _RESULT["block_reason"] = reason
        sys.exit(1)


if __name__ == "__main__":
    main()
