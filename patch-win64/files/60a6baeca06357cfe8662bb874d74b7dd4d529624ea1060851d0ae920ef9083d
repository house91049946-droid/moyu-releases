def _write():
    """任何離開路徑都要留下結果——被擋、例外、Ctrl-C 都算。

    後端橋接（fbauto_bridge._result_from_raw）只讀 raw["data"]，但人／舊工具看的是頂層，
    所以寫檔時把同一份內容鏡到 data 底下，兩邊永遠一致（與 run_meta_cleanup 同契約）。
    """
    if _JSON_PATH and _RESULT is not None:
        with open(_JSON_PATH, "w", encoding="utf-8") as f:
            json.dump(envelope(_RESULT), f, ensure_ascii=False, indent=2)
    if _RESULT is not None and not _RESULT.get("success"):
        print("[fbclean] 失敗：" + str(_RESULT.get("error") or "未知原因"), flush=True)


