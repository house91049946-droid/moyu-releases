def _age_days_from_text(text: str) -> int:
    """從卡片文字解析張貼年齡（天）。無法判定回 -1（保守：不刪）。
    優先解析銷售頁的絕對日期「M/D上架」，再退回相對時間（X天前）。"""
    if not text:
        return -1
    # 銷售頁格式：「7/12上架」/「7月12日」（絕對日期）
    m = re.search(r"(\d{1,2})\s*/\s*(\d{1,2})\s*上架", text) or re.search(r"(\d{1,2})\s*月\s*(\d{1,2})\s*日", text)
    if m:
        mon, day = int(m.group(1)), int(m.group(2))
        today = datetime.date.today()
        try:
            d = datetime.date(today.year, mon, day)
            if d > today:                       # 跨年：解析出的日期在未來 → 視為去年
                d = datetime.date(today.year - 1, mon, day)
            return (today - d).days
        except ValueError:
            return -1
    # 退回相對時間
    d = convert_text_to_post_date(text)
    if not d:
        return -1
    return calculate_post_age_in_days(d + " 00:00:00")


