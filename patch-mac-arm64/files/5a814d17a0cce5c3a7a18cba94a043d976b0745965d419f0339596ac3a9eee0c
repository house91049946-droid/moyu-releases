def calculate_post_age_in_days(post_time_str: str) -> int:
    """從 postTime 字串（YYYY/MM/DD HH:MM:SS）計算貼文年齡（天數）。"""
    try:
        post_time = datetime.datetime.strptime(post_time_str, "%Y/%m/%d %H:%M:%S")
        delta = datetime.datetime.now() - post_time
        return delta.days
    except ValueError:
        return 0


def convert_text_to_post_date(text: str) -> str | None:
    """將 FB 顯示的相對時間（如 3天前、2 hours ago）轉為 YYYY/MM/DD。"""
    now = datetime.datetime.now()
    patterns = [
        (r"(\d+)天前", "days"),
        (r"(\d+)星期前", "weeks"),
        (r"(\d+)個月前", "months"),
        (r"(\d+)年", "years"),
        (r"(\d+)\s*days?\s*ago", "days"),
        (r"(\d+)\s*weeks?\s*ago", "weeks"),
        (r"(\d+)\s*hours?\s*ago", "hours"),
        (r"(\d+)\s*分鐘前", "minutes"),
        (r"(\d+)\s*小時前", "hours"),
        (r"剛剛", "now"),
    ]
    for pattern, unit in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            if unit == "now":
                return now.strftime("%Y/%m/%d")
            num = int(match.group(1))
            if unit == "days":
                delta = datetime.timedelta(days=num)
            elif unit == "weeks":
                delta = datetime.timedelta(weeks=num)
            elif unit == "months":
                delta = datetime.timedelta(days=num * 30)
            elif unit == "years":
                delta = datetime.timedelta(days=num * 365)
            elif unit == "hours":
                delta = datetime.timedelta(hours=num)
            elif unit == "minutes":
                delta = datetime.timedelta(minutes=num)
            else:
                delta = datetime.timedelta()
            post_time = now - delta
            return post_time.strftime("%Y/%m/%d")
    return None


def www_delete_club_post_main(
    page: Page,
    fbid: str,
    group_url: str,
    post_url: str | None = None,
    lang: str = "zh",
) -> bool:
    """
    刪除指定社團中的貼文。
    post_url=None 時刪除該社團中最近一篇。

    Returns:
        是否成功刪除
    """
    print(f"[delete] Deleting post in {group_url}")

    check = perform_checks(page, fbid)
    if check != CheckResult.OK:
        return False

    if not enhanced_get(page, group_url):
        return False

    human_sleep(2, 4)

    # 找貼文的刪除按鈕
    # mbasic 版：每個貼文可能有一個 ... 或 ▼ 選單
    menu_btn = page.locator("a:has-text('...'), a:has-text('▼')").first
    if menu_btn.count() > 0:
        menu_btn.click()
        human_sleep(1, 2)

    # 找刪除選項
    delete_sel = "text=刪除貼文, text=移除, text=Delete post, text=Delete"
    if enhanced_click(page, delete_sel, timeout=5000, retries=2):
        human_sleep(1, 2)
        # 確認刪除
        confirm_sel = "text=刪除, text=確認, text=Confirm"
        enhanced_click(page, confirm_sel, timeout=3000, retries=1)
        human_sleep(1, 3)
        return True

    return False


def delete_posts_by_urls(page: Page, fbid: str, post_urls: list[str]) -> list[str]:
    """依明確的貼文 URL 清單刪除（資料源改由 backend PostHistory 提供，不再讀 postStatus.json）。
    回傳實際刪除成功的 post_url 清單。"""
    deleted: list[str] = []
    for post_url in post_urls:
        m = re.search(r"groups/(\d+)", post_url)
        if not m:
            continue
        group_url = f"https://mbasic.facebook.com/groups/{m.group(1)}/"
        try:
            if www_delete_club_post_main(page, fbid, group_url, post_url):
                deleted.append(post_url)
        except Exception as e:
            print(f"[delete] 刪除失敗 {post_url}: {e}", flush=True)
        human_sleep(3, 8)
    return deleted


def delete_old_posts(
    page: Page,
    fbid: str,
    max_age_days: int = 7,
    groups: list[str] | None = None,
    dry_run: bool = False,
) -> int:
    """
    批次刪除超過 max_age_days 天的舊貼文。

    Returns:
        刪除的貼文數量
    """
    deleted_count = 0

    # 從 postStatus.json 讀取貼文列表
    status_path = DATA_DIR / "postStatus.json"
    if not status_path.exists():
        return 0

    with open(status_path, "r", encoding="utf-8") as f:
        try:
            status_data = json.load(f)
        except json.JSONDecodeError:
            return 0

    fbid_posts = status_data.get(fbid, {})
    if not fbid_posts:
        return 0

    for post_url, info in fbid_posts.items():
        post_time = info.get("postTime", "")
        age = calculate_post_age_in_days(post_time)
        if age >= max_age_days:
            # 從 URL 中取出 group url
            group_id_match = re.search(r"groups/(\d+)", post_url)
            if group_id_match:
                group_url = f"https://mbasic.facebook.com/groups/{group_id_match.group(1)}/"
                if dry_run:
                    print(f"[delete] Would delete: {post_url} (age: {age} days)")
                else:
                    if www_delete_club_post_main(page, fbid, group_url, post_url):
                        deleted_count += 1
                        # 標記為已刪除
                        fbid_posts[post_url]["removed"] = True
                    human_sleep(3, 8)

    if not dry_run and deleted_count > 0:
        with open(status_path, "w", encoding="utf-8") as f:
            json.dump(status_data, f, ensure_ascii=False, indent=2)

    return deleted_count


