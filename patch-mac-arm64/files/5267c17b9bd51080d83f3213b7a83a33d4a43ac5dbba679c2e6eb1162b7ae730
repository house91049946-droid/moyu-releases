"""Marketplace 上架演示 — 開瀏覽器驗證 simulate_human_typing/click + 圖片上傳
   對象頁可選擇要轉發的社團（修改下方 SHARE_GROUPS 清單）"""
import json, time
from pathlib import Path
from playwright.sync_api import sync_playwright
from src.paths import COOKIES_DIR, USER_DATA_DIR, DATA_DIR
from src.utils import simulate_human_typing, simulate_human_click, human_sleep

fbid = "1133957806"

# ── 設定：要勾選哪些社團（FB 對象頁顯示的社團名稱）──
# 留空 = 只發布到 Marketplace，不轉發社團
SHARE_GROUPS: list[str] = []
# 範例：SHARE_GROUPS = ["台中買賣交流", "二手市集"]

for lock in (USER_DATA_DIR / fbid).glob("Singleton*"):
    lock.unlink()

with open(COOKIES_DIR / f"{fbid}.json") as f:
    cookies = json.load(f)

p = sync_playwright().start()
ctx = p.chromium.launch_persistent_context(
    user_data_dir=str(USER_DATA_DIR / fbid),
    headless=False,
    channel="chrome",
    viewport={"width": 1280, "height": 800},
    locale="zh-TW",
)
ctx.add_cookies(cookies)
page = ctx.new_page()

print("=" * 50)
print("Marketplace 上架演示 (模擬真人輸入 + 圖片上傳)")
print("=" * 50)

# 登入確認
page.goto("https://www.facebook.com/", wait_until="domcontentloaded", timeout=20000)
time.sleep(2)
print(f"✅ 已登入：{page.title()}")

# 進 Marketplace 建立頁
print("\n前往 Marketplace 建立頁面...")
page.goto("https://www.facebook.com/marketplace/create/item/", wait_until="domcontentloaded", timeout=30000)
time.sleep(4)

# ── 步驟 1：填標題（逐字輸入）──
print("\n📝 步驟 1：逐字輸入標題...")
inputs = page.locator("input[type='text']").all()
ok = simulate_human_typing(page, inputs[0], "測試商品 藍牙耳機 全新 599元")
print(f"   標題 {'✅' if ok else '⚠️ fill 降級'}")
time.sleep(0.5)

# ── 步驟 2：填價格（逐字輸入）──
print("💰 步驟 2：逐字輸入價格...")
ok = simulate_human_typing(page, inputs[1], "599")
print(f"   價格 {'✅' if ok else '⚠️ fill 降級'}")
time.sleep(0.5)

# ── 步驟 3：選類別（模擬點擊）──
print("📂 步驟 3：選擇類別...")
combos = page.locator("label[role='combobox']").all()
simulate_human_click(page, combos[0])
time.sleep(1.5)
opts = page.locator("[role='option']").all()
if opts:
    simulate_human_click(page, opts[0])
else:
    page.keyboard.press("ArrowDown")
    time.sleep(0.5)
    page.keyboard.press("Enter")
time.sleep(1)
print("   ✅ 類別已選")

# ── 步驟 4：選狀況（依文字選「全新」）──
print("🏷️  步驟 4：選擇狀況（全新）...")
if len(combos) >= 2:
    simulate_human_click(page, combos[1])
    time.sleep(1.5)
    cond_opts = page.locator("[role='option']").all()
    target = None
    for o in cond_opts:
        try:
            if o.inner_text().strip() == "全新":
                target = o
                break
        except Exception:
            pass
    if target:
        simulate_human_click(page, target)
        time.sleep(0.5)
        shown = combos[1].inner_text().strip().replace("\n", " ")
        print(f"   ✅ 狀況 combobox 顯示: {shown}")
    else:
        print("   ⚠️ 找不到「全新」選項")

# ── 步驟 5：上傳圖片（必填！FB 要有圖才會啟用繼續按鈕）──
print("🖼️  步驟 5：上傳測試圖片...")
test_img = str(DATA_DIR / "shop_article_images" / "test_product_1.jpg")
if Path(test_img).exists():
    # 先點「新增相片」區域
    for sel in [
        "div[role='button']:has-text('新增相片')",
        "div[aria-label*='相片']",
        "div[aria-label*='photo']",
    ]:
        try:
            btn = page.locator(sel).first
            if btn.count() > 0 and btn.is_visible():
                simulate_human_click(page, btn)
                time.sleep(0.5)
                break
        except Exception:
            continue

    file_input = page.locator("input[type='file']").first
    if file_input.count() > 0:
        file_input.set_input_files(str(test_img))
        print(f"   ✅ 已上傳 ({Path(test_img).name})")
        time.sleep(5)  # 等 FB 壓縮圖片
    else:
        print("   ⚠️ 找不到 file input")
else:
    print(f"   ❌ 找不到: {test_img}")

# ── 步驟 6：強制 blur/focus ──
print("\n⏳ blur/focus 讓 React flush...")
try:
    inputs[1].blur()
    time.sleep(0.3)
    inputs[1].focus()
except Exception:
    pass
time.sleep(1)

# ── 步驟 7：檢查繼續按鈕 ──
disabled = page.evaluate("""() => document.querySelector('div[aria-label="繼續"]')?.getAttribute('aria-disabled')""")
print(f"\n🔘 繼續按鈕狀態：{'❌ 禁用' if disabled == 'true' else '✅ 可用'}")

if disabled == "true":
    print("   🔄 JS 強制派發事件重試...")
    page.evaluate("""() => {
        document.querySelectorAll('input[type="text"]').forEach((el) => {
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
            el.dispatchEvent(new Event('blur', { bubbles: true }));
        });
    }""")
    time.sleep(1.5)
    disabled = page.evaluate("""() => document.querySelector('div[aria-label="繼續"]')?.getAttribute('aria-disabled')""")
    print(f"   重試後：{'❌ 禁用' if disabled == 'true' else '✅ 可用'}")

if disabled != "true":
    print("\n🚀 點擊繼續...")
    btn = page.locator("div[aria-label='繼續']").first
    simulate_human_click(page, btn)
    time.sleep(4)
    print(f"   URL: {page.url[:100]}")
    page.screenshot(path="screenshot/marketplace_step2.png")

    # ── 步驟 8：對象頁 — 勾選社團 ──
    if "step=audience" in page.url:
        print(f"\n👥 對象頁 — 可轉發的社團:")
        if SHARE_GROUPS:
            print(f"   目標: {SHARE_GROUPS}")
            for sel in ["div[role='button']:has-text('更多發布選項')", "span:has-text('更多發布選項')"]:
                try:
                    expand = page.locator(sel).first
                    if expand.count() > 0 and expand.is_visible():
                        simulate_human_click(page, expand)
                        time.sleep(1)
                        break
                except Exception:
                    continue
            for name in SHARE_GROUPS:
                try:
                    label = page.locator(f"span:has-text('{name}')").last
                    if label.count() == 0:
                        print(f"   ⚠️ 找不到: {name}")
                        continue
                    parent = label.locator("xpath=ancestor-or-self::*[@role='switch']").first
                    if parent.count() == 0:
                        parent = label.locator("..").first
                        for _ in range(5):
                            role = parent.get_attribute("role") or ""
                            if role == "switch":
                                break
                            np = parent.locator("..")
                            if np.count() == 0:
                                break
                            parent = np
                    aria = parent.get_attribute("aria-checked") or ""
                    if aria != "true":
                        simulate_human_click(page, parent)
                        time.sleep(0.5)
                    aria = parent.get_attribute("aria-checked") or ""
                    print(f"   [{name}] {'✅' if aria == 'true' else '⚠️'}")
                except Exception as e:
                    print(f"   [{name}] ❌ {e}")
            page.screenshot(path="screenshot/marketplace_audience.png")

    # ── 步驟 9：發布 ──
    time.sleep(1)
    print("\n📤 點擊發布...")
    for publish_sel in [
        "div[aria-label='發布']",
        "div[role='button']:has-text('發布')",
        "span:has-text('發布')",
        "div[aria-label='發佈']",
        "div[role='button']:has-text('發佈')",
    ]:
        try:
            pub = page.locator(publish_sel).first
            if pub.count() > 0 and pub.is_visible():
                simulate_human_click(page, pub)
                print(f"   ✅ 已發布")
                time.sleep(4)
                break
        except Exception:
            continue
    print(f"   最終 URL: {page.url[:100]}")
else:
    page.screenshot(path="screenshot/marketplace_disabled.png")
    print("⚠️ 按鈕仍禁用，可能需要手動檢查（FB 的反自動化機制）")

page.screenshot(path="screenshot/marketplace_final.png")
print(f"\n📸 截圖: screenshot/marketplace_final.png")

print(f"\n{'='*50}")
print("全部完成，自動關閉瀏覽器...")
time.sleep(3)

ctx.close()
p.stop()
