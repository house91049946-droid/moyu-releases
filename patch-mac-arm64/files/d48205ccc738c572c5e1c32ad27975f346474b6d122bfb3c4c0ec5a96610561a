class TestJS的兩個地雷:
    """本專案各踩過的坑，一個一條測試守著。"""

    @pytest.mark.parametrize("js", [cl._CARDS_JS, cl._TIMES_JS])
    def test_每一行的引號都成對(self, js):
        """教訓 1：三引號裡的 \\n 會變成真的換行，塞進 JS 字串常值就是 SyntaxError，
        而 evaluate 包在 suppress 裡會安靜回空——功能整個失效卻沒有任何錯誤訊息。"""
        for line in js.splitlines():
            assert line.count("'") % 2 == 0, line
            assert line.count('"') % 2 == 0, line

    def test_換行用fromCharCode而不是跳脫字元(self):
        assert "String.fromCharCode(10)" in cl._TIMES_JS
        assert "\\n" not in cl._CARDS_JS and "\\n" not in cl._TIMES_JS

    def test_卡片要往上爬再在卡片內查(self):
        """教訓 2：FB 卡片的名字／時間常常不是 <a>。從找得到的元素往上爬到整張卡，
        再**在卡片內**查詢；對 document 全域查會把上一則的資料配到下一則身上。"""
        assert "parentElement" in cl._CARDS_JS
        assert "card.querySelector(" in cl._CARDS_JS
        # 迴圈裡不准對 document 全域查（只有最外層那次「找所有時間戳連結」可以）
        body = cl._CARDS_JS.split("for (const a of", 1)[1].split("\n", 1)[1]
        assert "document.querySelector" not in body


