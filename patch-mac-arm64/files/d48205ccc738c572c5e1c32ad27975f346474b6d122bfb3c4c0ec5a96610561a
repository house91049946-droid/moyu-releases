class Test單則刪除:
    def test_完整走完才算刪掉(self, quiet):
        pg = FakePage()
        assert cl._delete_one(pg, pg.url) is True
        assert pg.steps == ["more", "menu", "confirm"]

    def test_找不到更多按鈕就跳過(self, quiet):
        pg = FakePage(has_more=False)
        assert cl._delete_one(pg, pg.url) is False
        assert pg.steps == []

    def test_選單裡沒有刪除就跳過並關掉選單(self, quiet):
        """選單裡沒有「刪除」通常代表那不是自己的貼文——更不能亂點。"""
        pg = FakePage(has_menu_item=False)
        assert cl._delete_one(pg, pg.url) is False
        assert "escape" in pg.steps

    def test_沒出現確認框就Escape收手不亂點(self, quiet):
        """「刪除」同時是選單項目也是確認鈕。確認框沒開就代表這步沒成功——
        不准退回全頁找同名文字，否則會把剛按過的選單項目再點一次。"""
        pg = FakePage(has_confirm=False)
        assert cl._delete_one(pg, pg.url) is False
        assert pg.steps.count("menu") == 1        # 選單只按一次，沒有第二次亂點
        assert pg.steps[-1] == "escape"

    def test_確認鈕只在對話框裡找(self, quiet):
        pg = FakePage()
        seen = []
        real = pg.locator
        pg.locator = lambda sel: (seen.append(sel), real(sel))[1]
        assert cl._delete_one(pg, pg.url) is True
        assert all('role="dialog"' in s for s in seen if "更多" not in s and "aria-label" not in s)

    def test_按了確認但沒有任何刪除跡象就不算成功(self, quiet, monkeypatch):
        """數字灌水比少刪一則糟糕得多：客戶會以為舊文清乾淨了，其實還掛在牆上。"""
        pg = FakePage()
        monkeypatch.setattr(pg, "locator", lambda sel: (
            _Loc(1, lambda: pg.steps.append("confirm")) if 'role="dialog"' in sel
            else _Loc(1, lambda: pg.steps.append("more")) if "aria-label" in sel
            else _Loc(0)))
        assert cl._delete_one(pg, pg.url) is False
        assert pg.gotos == [pg.url]          # 有回頭複驗那則貼文還在不在


