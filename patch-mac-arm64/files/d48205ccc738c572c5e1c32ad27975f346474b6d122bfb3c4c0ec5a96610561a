class _Loc:
    def __init__(self, n=0, on_click=None):
        self.n, self.on_click, self.clicks = n, on_click, 0

    @property
    def first(self):
        return self

    @property
    def last(self):
        return self

    def nth(self, i):
        return self

    def count(self):
        return self.n

    def is_visible(self):
        return self.n > 0

    def click(self):
        self.clicks += 1
        if self.on_click:
            self.on_click()


class FakePage:
    """只模擬 _post_age_days / _delete_one 會碰到的介面。"""

    def __init__(self, times="", body="", has_more=True, has_menu_item=True, has_confirm=True):
        self.times, self.body = times, body
        self.has_more, self.has_menu_item, self.has_confirm = has_more, has_menu_item, has_confirm
        self.menu_clicked = False        # 選單項目按過就消失（真實行為），確認框才不會誤配到它
        self.url = f"https://www.facebook.com/{FBID}/posts/pfbidAAA"
        self.steps, self.gotos = [], []
        self.keyboard = types.SimpleNamespace(press=lambda k: self.steps.append("escape"))
        self.mouse = types.SimpleNamespace(wheel=lambda x, y: None)

    def goto(self, url, **kw):
        self.gotos.append(url)

    def evaluate(self, js, *a):
        if "body.innerText" in js:
            return self.body
        if "getAttribute('datetime')" in js:
            return self.times
        return []

    def locator(self, sel):
        # ⋯ 按鈕現在也限定在 dialog 內找（selector 同時含 role="dialog" 與 aria-label*=），
        # 先判「更多」才不會把它當成確認鈕；確認鈕的 aria-label 選擇器是相等比對，沒有 *=
        if "aria-label*=" in sel:
            return _Loc(1, lambda: self.steps.append("more")) if self.has_more else _Loc(0)
        if 'role="dialog"' in sel:
            if not self.has_confirm:
                return _Loc(0)

            def _confirm():
                self.steps.append("confirm")
                self.body = "已移到垃圾桶"
            return _Loc(1, _confirm)
        if "aria-label" in sel and self.has_more:
            return _Loc(1, lambda: self.steps.append("more"))
        return _Loc(0)

    def get_by_role(self, role, name=None, exact=False):
        if self.has_menu_item and not self.menu_clicked and name in cl._DELETE_TEXTS:
            def _menu():
                self.steps.append("menu")
                self.menu_clicked = True
            return _Loc(1, _menu)
        return _Loc(0)

    def get_by_text(self, t, exact=False):
        return _Loc(0)


