def test_repeated_same_item_counts_actions_separately(monkeypatch):
    card = {"idx": 0, "item_id": "12345", "title": "測試同商品延遲消失", "age_days": 1}
    states = iter([([card], {}), ([card], {}), ([], {}), ([], {})])
    monkeypatch.setattr(m, "perform_checks", lambda *a: m.CheckResult.OK)
    monkeypatch.setattr(m, "scan_selling_listings", lambda *a: [card])
    monkeypatch.setattr(m, "_collect_cards", lambda *a: next(states))
    monkeypatch.setattr(m, "_delete_one_listing", lambda *a: True)
    monkeypatch.setattr(m, "_open_selling_page", lambda *a: True)
    monkeypatch.setattr(m, "human_sleep", lambda *a: None)
    page = mock.Mock();page.is_closed.return_value = False
    r = m.delete_old_marketplace_listings(page, 'fb', max_age_days=0, allowed_ids={'12345'})
    assert r['success']
    assert r['delete_action_count'] == 2
    assert r['deleted'] == ['https://www.facebook.com/marketplace/item/12345/']
    assert r['scanned'] == 1
