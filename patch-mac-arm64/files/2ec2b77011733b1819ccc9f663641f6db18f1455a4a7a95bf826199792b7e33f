def test_keep_newest_只留最新一則():
    """同一個案子重複上架（2026-09-27 一間掛了 24 則）：只留最新的，其餘由舊到新刪。"""
    allowed = {"中區自由路 透套華廈三房 968萬", "中區自由路 近台中火車站 透套"}
    state = [
        {"idx": 0, "title": "中區自由路 透套華廈三房 968萬", "text": "", "age_days": 10},
        {"idx": 1, "title": "中區自由路 近台中火車站 透套", "text": "", "age_days": 1},
        {"idx": 2, "title": "可愛狗狗潔牙骨 大包裝", "text": "", "age_days": 30},
        {"idx": 3, "title": "中區自由路 透套華廈三房 968萬", "text": "", "age_days": 4},
        {"idx": 4, "title": "中區自由路 近台中火車站 透套", "text": "", "age_days": -1},  # 年齡未知：不刪，但算在保留數內
    ]
    deleted = []

    def fake_delete_one(page, idx):
        nonlocal state
        card = next(c for c in state if c["idx"] == idx)
        deleted.append(card["age_days"])
        state = [c for c in state if c["idx"] != idx]
        return True

    with mock.patch.object(m, "perform_checks", return_value=m.CheckResult.OK), \
         mock.patch.object(m, "scan_selling_listings", lambda page, fbid, diag=True: list(state)), \
         mock.patch.object(m, "_collect_cards", lambda page: (list(state), {})), \
         mock.patch.object(m, "_delete_one_listing", fake_delete_one), \
         mock.patch.object(m, "_open_selling_page", lambda page: True), \
         mock.patch.object(m, "human_sleep", lambda *a, **k: None):
        page = mock.MagicMock()
        page.is_closed.return_value = False
        dry = m.delete_old_marketplace_listings(page, "fbid", max_age_days=0, dry_run=True,
                                                allowed_titles=allowed, keep_newest=1)
        r = m.delete_old_marketplace_listings(page, "fbid", max_age_days=0, dry_run=False,
                                              allowed_titles=allowed, keep_newest=1)

    assert len(dry["candidates"]) == 3
    assert deleted == [10, 4, 1]            # 由舊到新；剩下年齡未知那則 → 共留 1 則
    assert [c["idx"] for c in state] == [2, 4]
    assert r["delete_action_count"] == 3
    assert r["unidentified_delete_actions"] == 3
    assert r["deleted"] == []


