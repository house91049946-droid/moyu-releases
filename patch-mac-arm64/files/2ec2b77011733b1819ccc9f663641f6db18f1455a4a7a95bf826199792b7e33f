def test_標題比對只認完整相等_前綴不算():
    """2026-10-06 Codex 審查：前綴比對會把使用者手動貼的同前綴商品當成自己的而誤刪，改成完整正規化相等。"""
    allowed = {"太平七街 四房透天 1798萬 全新整理"}
    assert m._title_is_ours("太平七街 四房透天 1798萬 全新整理", allowed) is True
    assert m._title_is_ours("太平七街 四房透天 1798萬 全新整理 近學區", allowed) is False  # 多了字＝別筆
    assert m._title_is_ours("太平七街 四房透天 1798萬", allowed) is False                  # 少了字＝別筆
    assert m._title_is_ours("可愛狗狗潔牙骨 大包裝好評熱賣中", allowed) is False           # 帳號手動商品
    assert m._title_is_ours("太平七街 四房透天 1798萬 全新整理", set()) is False          # 空白名單


def test_FB把全形標點換成半形也要比對得出來():
    """2026-08-10 實測：工具送出全形逗號，FB 賣場頁顯示成半形，害自動刪除永遠不刪。"""
    logged = "台中太平四房透天，23坪地，近市區機能好"      # 我們記錄的（全形）
    on_fb = "台中太平四房透天,23坪地,近市區機能好"          # FB 頁面顯示的（半形）
    assert m._title_is_ours(on_fb, {logged}) is True


