            "company": legal.company, "license_no": legal.license_no,
            "agent_cert_no": getattr(legal, "agent_cert_no", "") or "",
            "store_name": getattr(legal, "store_name", "") or "",
            "is_franchise": bool(getattr(legal, "is_franchise", False)),
            "price_notice": bool(getattr(legal, "price_notice", False)),
            "agent_phone": legal.agent_phone, "extra": legal.extra} if legal else {}


class PostNowError(Exception):
    """立即發文開始前就不能發的原因（暫停中、沒綁 FB、已下架…）——API 直接回給畫面，不會默默吞掉。"""


async def prepare_post_now(property_id: int, headless: bool = False,
                           extra_platforms: list | None = None) -> tuple[dict, str]:
    """「立即發文」的前置檢查：都過了回 (snap, fbid)；不能發就拋 PostNowError（訊息給人看）。
    以前這些早退都只是回一個沒人讀的 dict，畫面說「已開始」、執行紀錄一筆都沒有。"""
    from ..fbauto_bridge import cookie_exists
    st = get_system_state_sync()
    if st["paused"]:
        raise PostNowError("系統目前暫停中，先到首頁按「恢復」")
    async with async_session_factory() as s:
        p = (await s.execute(select(Property).where(Property.id == property_id))).scalar_one_or_none()
        if not p:
            raise PostNowError("物件不存在")
        if not p.enabled:
            raise PostNowError("這個物件已下架（開關是關的），要發先把開關打開")
        acc = (await s.execute(select(Account).where(Account.id == p.account_id))).scalar_one_or_none()
        legal = (await s.execute(select(LegalInfo))).scalars().first()
        if not acc or not acc.fb_user_id:
            raise PostNowError("帳號尚未綁定 FB")
        snap = {
            "id": "manual", "manual": True, "account_id": acc.id, "status": "running",
            "property_ids": [p.id],
            "extra_platforms": [x for x in (extra_platforms or []) if x in ("ig", "threads")],
            "extra_daily_cap": {},
            "headless": bool(headless), "dry_run": False,
            "auto_delete_days": 0, "batch_min_sec": 45, "batch_max_sec": 120,
            "cooldown_min_sec": 0, "cooldown_max_sec": 0,
            "fbid": (acc.fb_user_id or "").strip(), "email": acc.email or "",
            "fb_bound_at": acc.fb_bound_at, "grace_override": True,
            "legal": _legal_dict(legal),
        }
    fbid = snap["fbid"]
    if not cookie_exists(fbid):
        raise PostNowError(f"帳號 {snap['email'] or fbid} 的 FB 登入不存在，先到帳號設定登入")
    if _MP_LOCK.locked():
        raise PostNowError("目前已有一場 Marketplace 上架在跑，等它結束再按")
    return snap, fbid


async def run_prepared_post_now(snap: dict, fbid: str, property_id: int) -> dict:
    """prepare_post_now 過了之後真正去發（背景跑，結果在執行紀錄）。"""
    async with _MP_LOCK:
        await _post_one(snap, fbid, force_prop_id=property_id)
    return {"ok": True}


async def run_property_post_now(property_id: int, headless: bool = False,
                                extra_platforms: list | None = None) -> dict:
    """「立即發文」（老闆 2026-09-10）：馬上把這一間上架到 Marketplace（含它設定的轉發社團）。
    有頭／無頭由呼叫端決定；**不受新帳號養號期限制**（客戶想馬上看成果）；仍看暫停、cookie、額度、法定文案。
    前置檢查沒過回 {"error": ...}（API 走 prepare_post_now 直接回 4xx，這個包裝給其他呼叫端）。"""
    try:
        snap, fbid = await prepare_post_now(property_id, headless, extra_platforms)
    except PostNowError as e:
        return {"error": str(e)}
    return await run_prepared_post_now(snap, fbid, property_id)


async def run_marketplace_cleanup_job(schedule_id: int, force: bool = False,
                                      dry_run_override: bool | None = None,
                                      days_override: int | None = None):
    """P17：刪除該排程帳號超過 auto_delete_days 天的 Marketplace 刊登。
    force=True：忽略排程 status（供「立即測試」用）。與發文共用 _MP_LOCK 序列化。
    days_override：覆寫天數門檻（0=刪全部現有刊登，供建立→立即刪除測試）。"""
    global _MP_LAST_FINISH
    from ..fbauto_bridge import (
        cookie_exists, run_marketplace_delete_old, create_run_log_sync, update_run_log_sync,
    )

    st = get_system_state_sync()
    if st["paused"]:
        return None

    snap = await _load_schedule_snapshot(schedule_id)
    if not snap:
        return None
    if not force and snap["status"] != "running":
        return None

    if days_override is not None:
        days = days_override           # 測試覆寫（可為 0 = 刪全部，不加隨機）
    else:
        base = snap.get("auto_delete_days", 14) or 0
        if base <= 0:
            return None                # 該排程已關閉自動刪除（僅排程路徑受此限制）
        days = max(1, base + random.randint(-2, 2))   # 反偵測：門檻 ±2 天隨機
        print(f"[mp_cleanup] 門檻隨機化：{base} → {days} 天", flush=True)

    fbid = snap["fbid"]
    if not fbid or not cookie_exists(fbid):
        return None

    dry = snap["dry_run"] if dry_run_override is None else dry_run_override
    async with _MP_LOCK:
        log_id = create_run_log_sync("mp_cleanup", fbid, snap["account_id"])
        result = await run_marketplace_delete_old(
            fbid=fbid, max_age_days=days, headless=snap["headless"], dry_run=dry,
        )
        update_run_log_sync(log_id, result)
        _MP_LAST_FINISH = datetime.datetime.utcnow()
    return result


def _pause_all_marketplace():
    """移除所有 marketplace 排程 job（暫停）。"""
    for job in list(scheduler.get_jobs()):
        if job.id.startswith("mp_"):
            job.remove()


