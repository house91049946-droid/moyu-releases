async def _load_schedule_snapshot(schedule_id: int):
    async with async_session_factory() as s:
        sch = (await s.execute(select(MarketplaceSchedule).where(MarketplaceSchedule.id == schedule_id))).scalar_one_or_none()
        if not sch:
            return None
        acc = (await s.execute(select(Account).where(Account.id == sch.account_id))).scalar_one_or_none()
        legal = (await s.execute(select(LegalInfo))).scalars().first()
        return {
            "id": sch.id, "account_id": sch.account_id, "status": sch.status,
            "property_ids": list(sch.property_ids or []),
            "extra_platforms": list(sch.extra_platforms or []),
            "extra_daily_cap": dict(sch.extra_daily_cap or {}),
            "headless": sch.headless, "dry_run": sch.dry_run,
            "auto_delete_days": sch.auto_delete_days if sch.auto_delete_days is not None else 7,
            "batch_min_sec": sch.batch_min_sec, "batch_max_sec": sch.batch_max_sec,
            "cooldown_min_sec": sch.cooldown_min_sec, "cooldown_max_sec": sch.cooldown_max_sec,
            "fbid": (acc.fb_user_id or "").strip() if acc else "",
            "email": (acc.email or "") if acc else "",     # 警訊文字要指名是哪個帳號
            "fb_bound_at": acc.fb_bound_at if acc else None,   # 新帳號養號期起算
            "grace_override": bool(acc.grace_override) if acc else False,
            # ⚠️ footer_text 一定要帶：介面上客戶填的就是這一欄（整段法定文案），
            # 結構化的 agent_name/company/... 根本沒有輸入介面、永遠是空的。
            # 這裡漏掉它，legal_footer() 就退回組結構化欄位 → 組出空字串 →
            # Marketplace 排程發文（含分批轉發社團）從來沒帶過法定文案。
            # GP 與發文任務兩條路徑都有帶，只有這裡漏（2026-08-02 客戶回報）。
            "legal": {"footer_text": legal.footer_text, "agent_name": legal.agent_name,
                      "company": legal.company, "license_no": legal.license_no, "agent_cert_no": getattr(legal, "agent_cert_no", "") or "", "store_name": getattr(legal, "store_name", "") or "", "is_franchise": bool(getattr(legal, "is_franchise", False)), "price_notice": bool(getattr(legal, "price_notice", False)),
                      "agent_phone": legal.agent_phone, "extra": legal.extra} if legal else {},
        }


