ction(){return t},j1:function(){return r}});let s="2026-09-10",r={name:"",taxId:"",contact:"",court:""},t=()=>!!(r.name&&r.contact&&r.court),i=[{id:"risk",title:"風險告知書",intro:"摸魚 MOREFISH（以下稱「本軟體」）是安裝在您自己電腦上、以您自己的社群帳號、依您自己的設定執行的自動化輔助工具。使用前請務必逐項閱讀以下風險。這些風險是「使用自動化工具」本身就存在的，不是本軟體的瑕疵，也無法藉由任何技術完全消除。",sections:[{heading:"一、社群平台帳號風險（最重要）",emphasis:!0,paragraphs:["Facebook、Instagram、Threads 等平台的使用條款，限制或禁止以自動化方式操作帳號。使用本軟體可能導致您的帳號發生下列情形：發文被移除、功能被暫時限制、被要求身分驗證、帳號被鎖定，甚至遭永久停用。","本軟體提供新帳號養號期、發文頻率限制、隨機間隔、模擬真人操作等設計，目的在降低上述風險，但這些是「降低風險的措施」，不是任何形式的保證。","帳號一旦遭到限制或停用，本公司無法代為申訴、無法保證恢復，亦不對您因此產生的業務中斷、客源流失或其他損失負責。若您無法接受此風險，請勿使用本軟體。"]},{heading:"二、不動產廣告的法規風險",emphasis:!0,paragraphs:["依不動產經紀業管理條例第 21 條，廣告及銷售內容應與事實相符；違反者依同條例第 29 條，得處新臺幣 6 萬元以上 30 萬元以下罰鍰。物件已成交、已解除委託或委託期間屆滿後，若舊廣告仍留在網路上，實務上可能被認定為廣告不實。","另依公平交易法第 21 條，不得於商品或服務之廣告上，為虛偽不實或引人錯誤之表示。","本軟體會依您設定的排程自動發文，「不會」也「無法」判斷該物件是否仍在銷售、委託是否仍有效、價格是否已變動。物件狀態的維護、過期廣告的下架與刪除，完全是您的責任。","本軟體雖提供「過期自動刪除」等輔助功能，但該功能受平台介面變動、網路狀況等因素影響，不保證每一則都成功刪除，不能取代您自己的查核。請定期自行確認線上廣告與實際銷售狀況相符。"]},{heading:"三、內容真實性與著作權風險",paragraphs:["所有發布的文案、照片、價格、坪數、格局等物件資訊，均由您提供，或由您指定來源匯入。本公司不審核、不查證其真實性與合法性。","本軟體提供從第三方網站（例如樂屋網等物件平台）匯入資料的便利功能。該等內容的著作權可能屬於原刊登者、拍攝者或平台業者。您必須確認自己有權使用該等文字與照片，例如該物件確為您所受託、或已取得權利人授權。","因內容不實、侵害他人著作權、肖像權或其他權利所生之一切爭議、賠償與行政處罰，由您自行負責。"]},{heading:"四、帳號憑證與個人資料",paragraphs:["本軟體在您的電腦上執行。您的社群帳號登入狀態（Cookie）、物件資料、社團清單與發文紀錄，都儲存在您自己的電腦，不會上傳到本公司伺服器。","您的社群帳號密碼由您在瀏覽器視窗中自行輸入，本軟體不保存密碼。","本軟體的備份檔案內含登入憑證與授權金鑰，其效力等同您的帳號本身。請妥善保管，切勿以電子郵件、通訊軟體或雲端共享連結外流。","若您透過本軟體處理他人個人資料（例如社團成員資訊、客戶聯絡方式），您應自行遵守個人資料保護法之規定。","為改善軟體品質，本軟體預設會將「執行失敗」的錯誤訊息（任務種類、失敗原因、程式版本與作業系統）自動回傳本公司；回傳前會先移除電話、電子郵件、通訊軟體 ID 與帳號識別碼，且不含文案內容、登入憑證與授權金鑰。您可隨時於「系統維護」頁關閉此功能。"]},{heading:"五、服務可用性風險",paragraphs:["社群平台可能隨時變更網頁介面、調整政策或加強自動化偵測，導致本軟體部分或全部功能暫時失效。","本公司會盡合理努力於發現後修復並提供更新，但無法保證修復時間，亦無法保證任何功能能永久維持可用。"]},{heading:"六、資料遺失風險",paragraphs:["因資料儲存在您的電腦，硬碟故障、系統重灌、誤刪或遭惡意程式破壞，都可能造成資料永久遺失。","本軟體提供備份匯出功能，請您定期自行備份並將備份檔存放於其他裝置。本公司無您資料的副本，無法為您還原。"]},{heading:"七、不保證營業成果",paragraphs:["本軟體是曝光作業的輔助工具。曝光次數、來客數、詢問量、成交件數與營業額，受市場、物件、定價、文案品質與平台演算法等眾多因素影響，不在本公司保證範圍內。"]},{heading:"八、自動加好友／自動追蹤的額外風險",emphasis:!0,paragraphs:["本軟體提供可選的「自動加好友」功能（Facebook 送出好友邀請、Instagram 與 Threads 追蹤他人）。此類主動接觸他人的自動化行為，是各平台最嚴格偵測的行為類型，被限制、被降觸及、甚至被停用帳號的機率明顯高於單純發文與瀏覽。三個平台共用同一個 Meta 帳號體系，其中一個被判定，其他平台可能連帶受影響。","本功能預設關閉。您開啟時即表示已了解並自行承擔上述風險；本軟體設有每日上限並在偵測到限制時自動暫停，但這些機制無法保證帳號不受影響。本軟體不會代您私訊、留言或接受邀請。","對方是否接受邀請、是否對您的行為提出檢舉，均非本軟體所能控制。請避免對無關聯之陌生人大量送出邀請。"]},{heading:"九、自動加入社團與自動刪文的風險",paragraphs:["本軟體提供可選的「自動加入社團」功能。加入社團是 Facebook 對帳號最敏感的行為之一，短時間內加入過多社團，可能導致帳號被限制加入社團、被社團管理員移除或封鎖。本功能預設關閉，並設有每日 3 個、每週 10 個的上限，且新加入的社團 10 天內不會自動發文；這些限制降低風險，但無法消除風險。社團是否接受您的加入、是否事後將您移除，均非本軟體所能控制。","本軟體另提供「自動刪文（備份模式）」：依您設定的天數，掃描您社群帳號上超過該天數的貼文並刪除。此功能不區分該貼文是否由本軟體發出，因此**也會刪除您自己手動發佈的舊貼文**。刪除後無法還原。請您在開啟前確認天數設定，並可先使用「試跑看看」查看將被刪除的清單。"]}]},{id:"terms",title:"服務條款（使用者規約）",intro:"本條款是您與本公司間就「摸魚 MOREFISH」軟體使用所訂立的契約。當您勾選同意並開始使用時，即表示您已閱讀、理解並同意本條款及《風險告知書》之全部內容。",sections:[{heading:"第一條　服務性質",paragraphs:["本軟體為安裝於使用者自有電腦之本機執行工具，功能為協助使用者將其自有之不動產物件資訊，依使用者自訂之排程與設定，發布至使用者自己的社群平台帳號。","本公司提供的是「工具」，並非代客操作、代客經營帳號或廣告代理服務。所有發布行為，在法律上均視為由使用者本人以自己的帳號、自己的意思所為。","本公司不接觸、不保管使用者的社群帳號密碼，亦不代為登入。"]},{heading:"第二條　使用者資格與義務",paragraphs:["您聲明並保證：您為合法經營之不動產經紀業者、依法登錄之不動產經紀人員，或就所刊登之物件具有合法刊登權限之人。","您應確保所發布之一切內容符合不動產經紀業管理條例、公平交易法、消費者保護法及其他相關法令，並依法於廣告中揭露應記載事項（如經紀業名稱等）。","您應自行遵守 Facebook、Instagram、Threads 及其他所使用平台之使用條款與社群守則。","您應於物件成交、解除委託或委託期間屆滿後，即時停止刊登並下架既有廣告。"]},{heading:"第三條　授權範圍",paragraphs:["本公司授予您於授權有效期間內、於單一台電腦上、為自身業務目的使用本軟體之非專屬、不可轉讓之權利。","未經本公司書面同意，您不得為下列行為：轉售、出租、出借、分享授權金鑰予第三人；對本軟體進行還原工程、反編譯或破解；規避授權驗證機制；將本軟體提供為對外服務或代操業務。","本軟體及其相關文件、介面設計之著作權與其他智慧財產權，均屬本公司所有。"]},{heading:"第四條　禁止行為",paragraphs:["您不得利用本軟體從事下列行為：刊登不實或引人錯誤之廣告；刊登非您受託或未獲授權之物件；刊登他人享有著作權之文字或照片而未取得授權；於社團或平台進行騷擾性、洗版式之大量張貼；假冒他人身分；或其他違反法令或平台規範之行為。","違反前項規定者，本公司得不經預告終止授權，且不退還已收取之費用；因此所生之一切責任由您自行承擔。"]},{heading:"第五條　費用與退費",paragraphs:["本軟體採期間授權制，費用、授權期間及付款方式，依訂購時雙方確認之內容為準。","因本軟體屬數位內容，一經啟用授權即開始提供服務。如您為消費者保護法所稱之消費者，您得於本公司提供之合理審閱及試用機制下評估是否購買；退費事宜依中華民國相關法令及訂購時之約定辦理。","因您違反本條款、或因您的帳號遭平台限制或停用，致無法使用本軟體者，不構成退費事由。"]},{heading:"第六條　免責聲明與責任限制",emphasis:!0,paragraphs:["本軟體係按「現狀」提供。本公司不保證本軟體之運作永不中斷、無錯誤，亦不保證能達成您預期之營業成果。","本公司特別不就下列事項負責：因平台政策或介面變更致功能失效；因使用自動化工具致您的社群帳號被限制、鎖定或停用；因您發布之內容不實、違法或侵權所生之行政處罰、民事賠償或刑事責任；因您未及時下架已成交物件所生之責任；因您電腦環境、網路或第三方軟體所生之問題。","於法令允許之最大範圍內，本公司就本契約所負之全部賠償責任總額，以您於責任發生前 12 個月內就本軟體實際支付予本公司之費用總額為上限。","前項限制，於本公司故意或重大過失之情形，不適用之。"]},{heading:"第七條　服務變更、更新與終止",paragraphs:["本公司得為維護、修復或功能改善而更新本軟體。部分更新為維持與平台相容所必要，未安裝更新可能導致功能失效。","本公司如決定停止提供本軟體，將於合理期間前公告或通知；就已收取而未屆期之授權費用，按未使用期間比例退還。","您得隨時停止使用本軟體。授權期間屆滿而未續約者，授權自動終止。"]},{heading:"第八條　個人資料之處理",paragraphs:["本軟體之營運資料儲存於您的電腦。本公司為授權驗證、客戶服務與帳務目的，可能蒐集您的姓名、公司名稱、聯絡方式與授權使用狀態。","本公司依個人資料保護法之規定處理前述資料，非經您同意或依法令規定，不對外提供。","本軟體預設會自動回傳去識別化之錯誤紀錄（見風險告知書第四條），僅供本公司改善軟體之用，保存不逾九十日；您得於「系統維護」頁隨時關閉。"]},{heading:"第九條　條款之修改",paragraphs:["本公司得修改本條款及《風險告知書》。修改後之版本將於軟體內公告，並要求您重新確認同意；您如不同意，得停止使用並依第七條辦理。"]},{heading:"第十條　準據法與管轄",paragraphs:["本條款之解釋與適用，以中華民國法律為準據法。","因本條款所生之爭議，雙方同意先以誠信協商解決；"+"協商不成時，以".concat(r.court||"【待填：管轄法院】","為第一審管轄法院。")]},{heading:"第十一條　契約當事人",paragraphs:["服務提供者：".concat(r.name||"【待填：公司或事業名稱】")+(r.taxId?"（統一編號 ".concat(r.taxId,"）"):""),"聯絡方式：".concat(r.contact||"【待填：客服信箱或電話】"),"本版本編號：".concat(s)]}]}]},8736:function(a,e,n){"use strict";n.d(e,{Z:function(){return s}});let s=(0,n(9763).Z)("FileText",[["path",{d:"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z",key:"1nnpy2"}],["polyline",{points:"14 2 14 8 20 8",key:"1ew0cm"}],["line",{x1:"16",x2:"8",y1:"13",y2:"13",key:"14keom"}],["line",{x1:"16",x2:"8",y1:"17",y2:"17",key:"17nazh"}],["line",{x1:"10",x2:"8",y1:"9",y2:"9",key:"1a5vjj"}]])}},function(a){a.O(0,[52,116,119,971,117,744],function(){return a(a.s=2529)}),_N_E=a.O()}]);