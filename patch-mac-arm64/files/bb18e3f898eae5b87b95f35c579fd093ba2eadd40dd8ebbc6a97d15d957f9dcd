MP_MAX_PHOTOS = 9


def _upload_images(page: Page, image_paths: list[str]) -> bool:
    """上傳圖片到 Marketplace 刊登表單（FB 要求至少 1 張才會啟用繼續；上限 9 張）。"""
    if len(image_paths) > MP_MAX_PHOTOS:
        print(f"[marketplace] 圖片 {len(image_paths)} 張超過上限，只取前 {MP_MAX_PHOTOS} 張", flush=True)
        image_paths = image_paths[:MP_MAX_PHOTOS]
    try:
        # 先找「新增相片」區域點擊，確保 file input 可見
        add_photo_selectors = [
            "div[role='button']:has-text('新增相片')",
            "div[role='button']:has-text('Add Photos')",
            "div[aria-label*='相片']",
            "div[aria-label*='photo']",
        ]
        for sel in add_photo_selectors:
            try:
                btn = page.locator(sel).first
                if btn.count() > 0 and btn.is_visible():
                    simulate_human_click(page, btn)
                    human_sleep(0.5, 1)
                    break
            except Exception:
                continue

        # 找 file input
        file_input = page.locator("input[type='file'][accept*='image']").first
        if file_input.count() == 0:
            file_input = page.locator("input[type='file']").first
        if file_input.count() == 0:
            print("[marketplace] ❌ 找不到圖片上傳 input")
            return False

        file_input.set_input_files(image_paths)
        # 等待 FB 處理圖片（壓縮/上傳需要時間）
        human_sleep(5, 10)
        print(f"[marketplace] ✅ 已上傳 {len(image_paths)} 張圖片")
        return True
    except Exception as e:
        print(f"[marketplace] Image upload failed: {e}")
        return False


