# 對象頁 checkbox 沒有 aria-label，社團名稱在父層容器文字的第一行。
# 先 scrollIntoView 確保座標在視野內（getBoundingClientRect 回傳 viewport 座標）。
_JS_FIND_GROUP_CHECKBOX = """(targetName) => {
    const boxes = document.querySelectorAll("[role='checkbox']");
    for (const box of boxes) {
        let node = box;
        for (let i = 0; i < 8; i++) {
            node = node.parentElement;
            if (!node) break;
            const text = (node.innerText || '').trim();
            if (text && text.length > 1) {
                if (text.split('\\n')[0].trim() === targetName) {
                    box.scrollIntoView({block: 'center'});
                    const r = box.getBoundingClientRect();
                    return {found: true, x: r.x + r.width/2, y: r.y + r.height/2,
                            checked: box.getAttribute('aria-checked')};
                }
                break;
            }
        }
    }
    return {found: false};
}"""

# 社團切換鈕：新版可能是 checkbox 或 switch
_GROUP_TOGGLE_SEL = "[role='checkbox'],[role='switch']"

_JS_LIST_GROUPS = """() => {
    const results = [];
    const seen = new Set();
    document.querySelectorAll("[role='checkbox'],[role='switch']").forEach((box) => {
        let node = box;
        for (let i = 0; i < 8; i++) {
            node = node.parentElement;
            if (!node) break;
            const text = (node.innerText || '').trim();
            if (text && text.length > 1) {
                const name = text.split('\\n')[0].trim();
                if (name && !seen.has(name) && !name.includes('Marketplace')) {
                    seen.add(name);
                    results.push(name);
                }
                break;
            }
        }
    });
    return results;
}"""

# 找社團清單那個可捲動容器並捲到底（避免滾到右側預覽）
_JS_SCROLL_LIST = """() => {
    const t = document.querySelector("[role='checkbox'],[role='switch']");
    if (!t) return -1;
    let el = t.parentElement;
    while (el && el !== document.body) {
        const s = getComputedStyle(el);
        if ((s.overflowY === 'auto' || s.overflowY === 'scroll') && el.scrollHeight > el.clientHeight + 20) {
            el.scrollTop = el.scrollHeight;
            return document.querySelectorAll("[role='checkbox'],[role='switch']").length;
        }
        el = el.parentElement;
    }
    const all = document.querySelectorAll("[role='checkbox'],[role='switch']");
    if (all.length) all[all.length - 1].scrollIntoView();
    return all.length;
}"""

# 抓到 0 時的診斷：各候選選擇器的數量，幫忙判斷 FB 現在的 DOM 用什麼
_JS_DIAG = """() => ({
    checkbox: document.querySelectorAll("[role='checkbox']").length,
    switch: document.querySelectorAll("[role='switch']").length,
    listitem: document.querySelectorAll("[role='listitem']").length,
    groupLinks: document.querySelectorAll("a[href*='/groups/']").length,
    dialogs: document.querySelectorAll("[role='dialog']").length,
    url: location.href,
})"""


def _write_detect_progress(fbid: str, count: int, done: bool):
    """把 detect 目前收集到的社團數寫進進度檔，供前端即時顯示。"""
    if not fbid:
        return
    try:
        p = DATA_DIR / f"detect_progress_{fbid}.json"
        with open(p, "w", encoding="utf-8") as f:
            json.dump({"count": count, "done": done, "ts": time.time()}, f)
    except Exception:
        pass


def get_audience_groups(page: Page, fbid: str = "") -> list[str]:
    """在 step=audience 頁抓取所有可轉發的社團名稱，並存到 data/marketplace_groups_<fbid>.json。"""
    _write_detect_progress(fbid, 0, done=False)
    # 捲動「社團清單容器」載入完整 lazy list；數量穩定就停
    prev = -1
    for _ in range(20):
        cur = page.evaluate(_JS_SCROLL_LIST)
        if isinstance(cur, int) and cur > 0:
            _write_detect_progress(fbid, cur, done=False)  # 即時回報目前收集數
        human_sleep(0.6, 1.2)
        if cur == prev and cur > 0:
            break
        prev = cur

    groups = page.evaluate(_JS_LIST_GROUPS)
    _write_detect_progress(fbid, len(groups), done=True)
    print(f"[marketplace] 對象頁共 {len(groups)} 個社團", flush=True)

    if not groups:
        try:
            diag = page.evaluate(_JS_DIAG)
            print(f"[marketplace] ⚠️ 抓到 0 個。診斷選擇器數量: {diag}", flush=True)
        except Exception:
            pass
        capture_screenshot(page, fbid or "unknown", "audience_zero_groups")

    if fbid:
        out = DATA_DIR / f"marketplace_groups_{fbid}.json"
        with open(out, "w", encoding="utf-8") as f:
            json.dump(groups, f, ensure_ascii=False, indent=2)
        print(f"[marketplace] 社團清單已存: {out}", flush=True)

    return groups


def load_share_groups(fbid: str) -> list[str]:
    """讀取使用者選擇要轉發的社團（data/marketplace_share_<fbid>.json）。

    檔案格式: {"selected": ["社團名稱1", "社團名稱2", ...]}
    """
    p = DATA_DIR / f"marketplace_share_{fbid}.json"
    if not p.exists():
        return []
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data.get("selected", [])
    except (json.JSONDecodeError, OSError):
        return []


def save_share_groups(fbid: str, selected: list[str]):
    """儲存使用者選擇的轉發社團。"""
    p = DATA_DIR / f"marketplace_share_{fbid}.json"
    with open(p, "w", encoding="utf-8") as f:
        json.dump({"selected": selected}, f, ensure_ascii=False, indent=2)


def _select_groups_on_audience_page(page: Page, group_names: list[str], fbid: str) -> int:
    """在 Marketplace step=audience 頁面勾選要轉發的社團（依名稱精確比對）。

    checkbox 無 aria-label，用 JS 從父層文字比對名稱後以滑鼠座標點擊。
    FB 限制最多 20 個社團。

    Returns: 成功勾選的社團數量
    """
    print(f"[marketplace] 在對象頁勾選 {len(group_names)} 個社團...", flush=True)
    human_sleep(2, 3)

    # 先抓完整清單（會捲動載入 + 存檔供之後選擇用）
    available = get_audience_groups(page, fbid)

    count = 0
    for name in group_names[:20]:  # FB 上限 20 個
        if name not in available:
            print(f"  [×] 找不到社團: {name[:40]}", flush=True)
            continue

        try:
            # 第一次呼叫會 scrollIntoView，等捲動完成後再取一次正確座標
            result = page.evaluate(_JS_FIND_GROUP_CHECKBOX, name)
            if not result.get("found"):
                print(f"  [×] 定位失敗: {name[:40]}", flush=True)
                continue
            human_sleep(0.5, 1)
            result = page.evaluate(_JS_FIND_GROUP_CHECKBOX, name)

            if result.get("checked") == "true":
                print(f"  [✓] 已勾選（跳過）: {name[:40]}", flush=True)
                count += 1
                continue

            page.mouse.click(result["x"], result["y"])
            human_sleep(0.8, 1.5)

            verify = page.evaluate(_JS_FIND_GROUP_CHECKBOX, name)
            if verify.get("checked") == "true":
                print(f"  [✓] 勾選成功: {name[:40]}", flush=True)
                count += 1
                continue

            # 備援：座標點擊沒生效時，改用 Playwright locator 直接點 checkbox
            idx = page.evaluate("""(targetName) => {
                const boxes = document.querySelectorAll("[role='checkbox']");
                for (let i = 0; i < boxes.length; i++) {
                    let node = boxes[i];
                    for (let j = 0; j < 8; j++) {
                        node = node.parentElement;
                        if (!node) break;
                        const text = (node.innerText || '').trim();
                        if (text && text.length > 1) {
                            if (text.split('\\n')[0].trim() === targetName) return i;
                            break;
                        }
                    }
                }
                return -1;
            }""", name)
            if idx >= 0:
                cb = page.locator("[role='checkbox']").nth(idx)
                cb.scroll_into_view_if_needed()
                human_sleep(0.3, 0.6)
                cb.click(force=True)
                human_sleep(0.8, 1.5)
                verify = page.evaluate(_JS_FIND_GROUP_CHECKBOX, name)
                if verify.get("checked") == "true":
                    print(f"  [✓] 勾選成功（備援）: {name[:40]}", flush=True)
                    count += 1
                    continue

            print(f"  [!] 勾選未確認: {name[:40]}", flush=True)
        except Exception as e:
            print(f"  [×] 錯誤 ({name[:30]}): {e}", flush=True)

    if count == 0 and group_names:
        capture_screenshot(page, fbid, "audience_no_groups")

    return count


