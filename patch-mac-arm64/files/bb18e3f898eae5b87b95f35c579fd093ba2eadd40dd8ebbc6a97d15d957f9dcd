def share_item_to_group(
    page: Page,
    fbid: str,
    item_url: str,
    group_url: str,
    share_text: str = "",
    lang: str = "zh",
) -> MarketplaceResult:
    """
    把 Marketplace 商品分享到指定社團。

    若分享按鈕定位困難，降級為：到社團發一般貼文，內文含商品 URL + 描述。
    """
    print(f"[marketplace] Sharing {item_url} to {group_url}")

    # 先佔用進入商品頁
    if not enhanced_get(page, item_url):
        return MarketplaceResult(success=False, status="失敗", error="Cannot open item page")

    human_sleep(2, 4)

    # 嘗試點擊分享按鈕
    share_success = False
    share_selectors = [
        "div[aria-label='傳送給朋友或發佈到動態。']",
        "div[aria-label='Send this to friends or post it on your timeline.']",
        "text=分享",
        "text=Share",
    ]
    for sel in share_selectors:
        if enhanced_click(page, sel, timeout=5000, retries=1):
            share_success = True
            break

    if share_success:
        human_sleep(1, 3)
        # 選擇「分享到社團」
        group_selectors = [
            "text=分享到社團",
            "text=Share to a group",
        ]
        for sel in group_selectors:
            if enhanced_click(page, sel, timeout=5000, retries=1):
                # 在彈窗中輸入群組並點擊
                human_sleep(1, 2)
                # 嘗試輸入社團名稱
                group_input_sel = "input[aria-label='搜尋社團'], input[placeholder*='社團']"
                if not enhanced_click(page, group_input_sel, timeout=3000, retries=1):
                    pass
                # 輸入 group_url 不太好，需要從群組 URL 中取得群組名稱
                human_sleep(1, 2)
                # 點發佈
                enhanced_click(page, "text=發佈, text=Post", timeout=5000)
                _write_schedule_log("上架至社團", "成功", fbid, item_url[:30], url=group_url)
                return MarketplaceResult(success=True, status="成功", item_url=item_url)
        # 備案：分享流程失敗，降級

    # ── 降級方案：以一般貼文方式發到社團，內文含商品連結 ──
    print(f"[marketplace] Share button not found, using fallback: post link to group")
    from src.generalpost_www import www_postclub_main

    post_content = f"{share_text}\n\n{item_url}" if share_text else item_url
    result = www_postclub_main(
        page=page,
        fbid=fbid,
        group_url=group_url,
        content=post_content,
    )
    if result.success:
        _write_schedule_log("上架至社團", "成功", fbid, item_url[:30], url=group_url)
        return MarketplaceResult(success=True, status="成功", item_url=item_url)
    else:
        _write_schedule_log("上架至社團", "失敗", fbid, item_url[:30], error=result.error or "")
        return MarketplaceResult(success=False, status="失敗", error=result.error)


# ── 內部輔助函式 ────────────────────────────────────────────────────

def _fill_location(page: Page, city: str) -> bool:
    """在 Marketplace 商品表單填入地點（縣市）。

    2026-08-01 在真實表單上實測驗證的流程：
      - 地點欄可能藏在「更多詳情」展開區：input[aria-label='地點']（role=combobox）
      - 純輸入文字 FB 不認帳：必須從下拉建議清單選取
      - ⚠️ 建議清單第一項**不一定**是輸入的縣市：FB 會把「上次用過的地點」
        當第一項捷徑放最上面。客戶回報「選屏東卻出現台中」就是舊版盲點第一項、
        選到殘留的台中捷徑。所以要挑「文字包含輸入縣市」的那一項，不是 .first
      - 欄位預填上次地點，輸入前必須確實清空（清不掉會變成殘值＋新輸入黏一起）
      - 選完一定要驗證欄位值真的包含目標縣市；不符就清空——寧可留白，
        也不要送出錯的縣市（填錯比不填更糟）
    地點為選填，失敗只記錄、不阻擋上架。
    """
    if not city:
        return False
    city = city.strip()
    try:
        def _find():
            return page.locator("input[aria-label='地點'], input[aria-label*='Location']")

        loc = _find()
        if loc.count() == 0:
            for kw in ("更多詳情", "顯示更多", "More details"):
                btn = page.locator(f"div[role='button']:has-text('{kw}')")
                if btn.count() > 0:
                    btn.first.click()
                    human_sleep(1.0, 1.6)
                    break
            loc = _find()
        if loc.count() == 0:
            print("[marketplace] ⚠️ 找不到地點欄位（展開更多詳情後仍無）", flush=True)
            return False
        loc = loc.first

        def _clear() -> bool:
            """清空欄位並確認真的空了（預填的上次地點清不掉會導致選錯）。"""
            for _ in range(3):
                loc.click()
                human_sleep(0.2, 0.4)
                loc.press("ControlOrMeta+a")
                human_sleep(0.1, 0.2)
                loc.press("Backspace")
                human_sleep(0.3, 0.5)
                cur = ""
                with contextlib.suppress(Exception):
                    cur = (loc.input_value() or "").strip()
                if not cur:
                    return True
            return False

        def _current() -> str:
            with contextlib.suppress(Exception):
                return (loc.input_value() or "").strip()
            return ""

        matched = False
        for attempt in range(2):
            if not _clear():
                print("[marketplace] ⚠️ 地點欄清不空，放棄以免填到殘值", flush=True)
                return False
            page.keyboard.type(city, delay=random.randint(80, 150))

            # 等下拉建議真的出現「包含該縣市」的選項（最多 6 秒）
            opt_sel = "ul[role='listbox'] li, [role='listbox'] [role='option']"
            deadline = time.time() + 6
            target = None
            while time.time() < deadline:
                opts = page.locator(opt_sel)
                n = opts.count()
                for i in range(n):
                    with contextlib.suppress(Exception):
                        txt = (opts.nth(i).inner_text() or "").strip()
                        if city in txt:
                            target = opts.nth(i)
                            break
                if target is not None:
                    break
                time.sleep(0.3)

            if target is not None:
                with contextlib.suppress(Exception):
                    target.click()
                    human_sleep(0.6, 1.1)
            else:
                # 沒有符合的建議：不要亂點第一項（那可能是別的縣市捷徑）
                print(f"[marketplace] ⚠️ 找不到含「{city}」的地點建議（第 {attempt+1} 次）", flush=True)
                continue

            final = _current()
            if city in final:
                print(f"[marketplace] ✅ 地點已選取：「{final}」（輸入「{city}」）", flush=True)
                matched = True
                break
            print(f"[marketplace] ⚠️ 選後欄位為「{final}」與「{city}」不符，重試", flush=True)

        if matched:
            return True
        # 兩次都沒選到正確縣市 → 清空，寧可留白也不要送出錯的地點
        _clear()
        page.mouse.click(10, 10)
        print(f"[marketplace] ⚠️ 地點「{city}」無法正確選取，已清空（不阻擋上架）", flush=True)
        return False
    except Exception as e:
        print(f"[marketplace] ⚠️ 地點填寫例外（不阻擋上架）: {e}", flush=True)
        return False


def _select_combobox_option(page: Page, combo_locator, option_text: str, retries: int = 2) -> bool:
    """開啟 combobox 並依文字選擇選項，選完驗證 combobox 顯示值。

    FB 的 listbox 選項是 role='option'，內含選項文字。
    以文字精確比對，找不到時退回部分比對。
    """
    for attempt in range(retries):
        try:
            simulate_human_click(page, combo_locator)
            human_sleep(1, 2)

            # 等 listbox 展開
            opts = page.locator("[role='option']").all()
            if not opts:
                human_sleep(1, 1.5)
                opts = page.locator("[role='option']").all()
            if not opts:
                continue

            # 先精確比對，再部分比對
            target = None
            for opt in opts:
                try:
                    text = opt.inner_text().strip()
                except Exception:
                    continue
                if text == option_text:
                    target = opt
                    break
            if target is None:
                for opt in opts:
                    try:
                        text = opt.inner_text().strip()
                    except Exception:
                        continue
                    if option_text in text or text in option_text:
                        target = opt
                        break

            if target is None:
                # 收合 listbox 再重試
                page.keyboard.press("Escape")
                human_sleep(0.5, 1)
                continue

            simulate_human_click(page, target)
            human_sleep(0.5, 1)

            # 驗證：combobox 上的顯示文字應包含選項文字
            try:
                shown = combo_locator.inner_text().strip()
                if option_text in shown:
                    return True
            except Exception:
                return True  # 無法驗證時視為成功

            print(f"[marketplace] combobox 顯示 '{shown}'，預期 '{option_text}'，重試...")
        except Exception as e:
            print(f"[marketplace] _select_combobox_option error: {e}")
            human_sleep(1, 2)
    return False


def _fill_marketplace_field(page: Page, label_text: str, value: str) -> bool:
    """依標籤文字找輸入框並填值。支援 label[for] 和父層/兄弟層三種關聯。"""
    # 策略1：透過 label[for] 屬性
    try:
        label = page.locator(f"label:has-text('{label_text}')").first
        if label.count() > 0:
            for_id = label.get_attribute("for") or ""
            if for_id:
                inp = page.locator(f"#{for_id}").first
                if inp.count() > 0:
                    inp.fill(value)
                    human_sleep(0.5, 1.5)
                    return True
    except Exception:
        pass

    # 策略2：找 label 兄弟節點中的 input
    try:
        for el in [page.locator(f"label:has-text('{label_text}')").first,
                    page.locator(f"span:has-text('{label_text}')").first]:
            if el.count() == 0:
                continue
            # 往上找共同父層，再往下找 input
            parent = el.locator("..")
            if parent.count() > 0:
                inp = parent.locator("input, textarea, [role='textbox']").first
                if inp.count() > 0:
                    inp.fill(value)
                    human_sleep(0.5, 1.5)
                    return True
                # 再往上一層
                grandparent = parent.locator("..")
                if grandparent.count() > 0:
                    inp = grandparent.locator("input, textarea, [role='textbox']").first
                    if inp.count() > 0:
                        inp.fill(value)
                        human_sleep(0.5, 1.5)
                        return True
    except Exception:
        pass

    # 策略3：直接用 aria-label
    return _fill_by_aria(page, label_text, value)


def _fill_by_aria(page: Page, keyword: str, value: str) -> bool:
    """用 aria-label 關鍵字找輸入框。"""
    try:
        sel = f"input[aria-label*='{keyword}'], textarea[aria-label*='{keyword}']"
        inp = page.locator(sel).first
        if inp.count() > 0:
            inp.fill(value)
            human_sleep(0.5, 1.5)
            return True
    except Exception:
        pass
    return False


def _select_condition(page: Page, condition_label: str) -> bool:
    """選擇商品狀況（全新/二手...）。"""
    try:
        # 點擊狀況選項
