# ── 資料模型 ────────────────────────────────────────────────────────

@dataclass
class MarketplaceItem:
    """商品刊登的完整資料（對應 shop_article JSON）。"""
    item_type: str            # product / house / carTruck / motorcycle / vehicleOthers
    item_name: str            # 商品名稱
    item_price: int           # 價格
    condition: str = ""       # new / likeNew / good / fair
    item_location: str = ""   # 地點
    description: str = ""     # 完整介紹文案 (原版 word 欄位)
    category: str = ""        # Marketplace 類別名稱（如「其他」）；空則選第一個
    images: list[str] = field(default_factory=list)  # 圖片絕對路徑或檔名
    fields: dict = field(default_factory=dict)        # 商品類型特定欄位


@dataclass
class MarketplaceResult:
    success: bool
    status: str               # '成功' | '失敗' | '審核' | 'need_debug'
    item_url: str | None = None
    error: str | None = None
    audience_selected: int = 0            # 對象頁勾選數（第一批 ≤20）
    extra_listed: list = field(default_factory=list)  # 補刊各批結果 [{batch, selected, errors}]


# ── 資料讀寫 ────────────────────────────────────────────────────────

def load_shop_article(article_name: str, images_dir: str = "") -> MarketplaceItem | None:
    """
    從 data/shop_article/<名稱>.json 載入商品文案。

    Args:
        article_name: 商品名稱（對應 JSON 檔名，不含 .json）
        images_dir: 圖片目錄（預設 data/shop_article_images/）

    Returns:
        MarketplaceItem 或 None
    """
    article_path = DATA_DIR / "shop_article" / f"{article_name}.json"
    if not article_path.exists():
        print(f"[marketplace] Article not found: {article_path}")
        return None

    with open(article_path, "r", encoding="utf-8") as f:
        data = json.load(f)

    content = data.get("content", {})
    item_type = content.get("itemType", "product")

    # 價格欄位：house 用 price，product 用 item_price
    price = content.get("price") or content.get("item_price", 0)

    images = data.get("images", [])
    # 轉為絕對路徑
    if not images_dir:
        images_dir = str(DATA_DIR / "shop_article_images")
    absolute_images = []
    for img in images:
        p = Path(images_dir) / img
        if p.exists():
            absolute_images.append(str(p))
        else:
            # 可能是相對路徑
            absolute_images.append(img)

    # 收集 type-specific fields
    fields = {}
    for key, val in content.items():
        if key not in ("itemType", "item_name", "item_location", "word", "item_price", "price", "condition", "images", "category"):
            fields[key] = val

    return MarketplaceItem(
        item_type=item_type,
        item_name=content.get("item_name", article_name),
        item_price=int(price) if price else 0,
        condition=content.get("condition", "new"),
        item_location=content.get("item_location", ""),
        description=content.get("word", ""),
        category=content.get("category", ""),
        images=absolute_images,
        fields=fields,
    )


def list_shop_articles() -> list[str]:
    """列出所有可用的商品文案。"""
    d = DATA_DIR / "shop_article"
    if not d.exists():
        return []
    return sorted([f.stem for f in d.glob("*.json")])


def _load_products_json() -> dict:
    """讀取 products.json。"""
    p = DATA_DIR / "products.json"
    if not p.exists():
        return {}
    with open(p, "r", encoding="utf-8") as f:
        try:
            return json.load(f)
        except json.JSONDecodeError:
            return {}


def _save_products_json(data: dict):
    """寫入 products.json。"""
    p = DATA_DIR / "products.json"
    with open(p, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def _update_products_tracking(fbid: str, item_name: str, item_url: str):
    """更新 products.json 中的商品追蹤。"""
    products = _load_products_json()
    if fbid not in products:
        products[fbid] = {}
    products[fbid][item_name] = {
        "modifiedDate": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "itemUrl": item_url,
    }
    _save_products_json(products)


def _already_posted(fbid: str, item_name: str) -> str | None:
    """檢查商品是否已上架過，回傳既有 item_url。"""
    products = _load_products_json()
    acc = products.get(fbid, {})
    item = acc.get(item_name, {})
    return item.get("itemUrl") or None


# ── 排程 log 寫入（與 P1 共用 schedule.log）─────────────────────────

def _write_schedule_log(event_type: str, result: str, fbid: str, title: str,
                         url: str = "", error: str = ""):
    ts = datetime.datetime.now().strftime("%Y/%m/%d %H:%M:%S")
    job_id = str(int(time.time() * 10000))
    line = f"{ts};{event_type};{result};{fbid};{title};{url};{job_id}"
    if error:
        line += f";err={error}"
    line += "\n"
    log_path = DATA_DIR / "schedule.log"
    with open(log_path, "a", encoding="utf-8") as f:
        f.write(line)
    print(f"[log] {line.strip()}")


# ── Marketplace 上架主流程 ──────────────────────────────────────────

# FB 類別下拉的項目不是 role=option，而是 menuitem 家族（帶 icon 的父類別）。
# 用 role-agnostic 選擇器同時吃多種角色，避免 querySelectorAll 回傳 0。
_CAT_OPT_SEL = "[role='option'],[role='menuitem'],[role='menuitemradio'],[role='menuitemcheckbox']"


def _wait_category_options(page: Page, sel: str, timeout_sec: float = 12.0) -> int:
    """等類別下拉選項出現（FB 常延遲渲染，立刻 query 會得到 0）。"""
    deadline = time.time() + timeout_sec
    last = 0
    while time.time() < deadline:
        try:
            last = page.locator(sel).count()
        except Exception:
            last = 0
        if last > 0:
            return last
        # 也等 listbox / menu 容器出現
        with contextlib.suppress(Exception):
            page.wait_for_selector(
                "[role='listbox'],[role='menu']," + sel,
                timeout=800,
                state="visible",
            )
        human_sleep(0.35, 0.7)
    return last


def _find_category_combobox(page: Page):
    """在建立表單裡找「類別」那個 combobox（而不是寫死第 0 個）。

    FB 表單有多個 label[role='combobox']（類別、狀況…），順序會變。優先用
    可見文字/aria 含「類別」定位；找不到才退回第一個 combobox（相容舊行為）。
    回傳 Locator 或 None。
    """
    with contextlib.suppress(Exception):
        by_text = page.locator(
            "label[role='combobox']:has-text('類別'), "
            "label[role='combobox']:has-text('Category'), "
            "label[role='combobox'][aria-label*='類別'], "
            "label[role='combobox'][aria-label*='Category']"
        ).first
        if by_text.count() > 0:
            return by_text
    combos = page.locator("label[role='combobox']")
    if combos.count() > 0:
        return combos.first
    return None


def _dump_category_dom(page: Page) -> None:
    """類別選不到時把「整個建立表單」的互動元素結構存檔，供對照 FB 改版。

    不只 dump 彈出選單（可能根本沒開），還列出表單裡所有 combobox/button/
    有 aria-label 的 input 的文字與角色，一次看清 FB 現在的欄位結構。
    """
    try:
        html = page.evaluate("""() => {
            const desc = (el) => {
                const t = (el.getAttribute('aria-label') || el.innerText || '').trim().slice(0, 60).replace(/\\s+/g,' ');
                return el.tagName.toLowerCase() + '[role=' + (el.getAttribute('role')||'') + '] "' + t + '"';
            };
            let out = 'url=' + location.href + '\\n';
            const combos = document.querySelectorAll("label[role='combobox'],[role='combobox']");
            out += '\\n== comboboxes (' + combos.length + ') ==\\n';
            combos.forEach(c => out += desc(c) + '\\n');
            const labels = document.querySelectorAll("label");
            out += '\\n== labels (' + labels.length + ') ==\\n';
            labels.forEach(l => { const t=(l.innerText||'').trim().slice(0,40); if(t) out += '"'+t+'" '; });
            const menus = document.querySelectorAll("[role='listbox'],[role='menu']");
            out += '\\n\\n== popup menus (' + menus.length + ') ==\\n';
            menus.forEach((c,i) => out += '--- menu '+i+' ---\\n' + c.outerHTML.slice(0, 2000) + '\\n');
            // 類別選擇器可能是對話框 + 磁磚按鈕，不是 listbox/menu
            const dialogs = document.querySelectorAll("[role='dialog']");
            out += '\\n== dialogs (' + dialogs.length + ') ==\\n';
            dialogs.forEach((d,i) => {
                const btns = d.querySelectorAll("[role='button'],[role='option'],[role='radio'],a");
                out += '--- dialog '+i+' 有 '+btns.length+' 個可點元素 ---\\n';
                let names = [];
                btns.forEach(b => { const t=(b.getAttribute('aria-label')||b.innerText||'').trim().slice(0,30).replace(/\\s+/g,' '); if(t) names.push(t); });
                out += names.slice(0, 60).join(' | ') + '\\n';
            });
            return out.slice(0, 16000);
        }""")
        from src.paths import SCREENSHOT_DIR
        import datetime
        p = SCREENSHOT_DIR / f"category_dom_{datetime.datetime.now():%Y%m%d_%H%M%S}.html"
        p.write_text(html, encoding="utf-8")
        print(f"[marketplace] 類別選單 DOM 已存供診斷: {p}", flush=True)
    except Exception as e:
        print(f"[marketplace] DOM dump 失敗: {e}", flush=True)


def _select_category_option(page: Page, category_name: str) -> bool:
    """在已開啟的類別下拉中選取指定類別（如「其他商品」在最下方）。
    會捲動選項清單載入完整項目後精確比對；找不到才退回第一個。
    選擇器與別名可由雲端下發（FB 改版免更新客戶端）。"""
    from src.served_config import get as cfg
    sel = cfg("selectors.mp_category_option_sel", _CAT_OPT_SEL)
    cfg_aliases = cfg("selectors.mp_category_aliases", ["其他商品", "其他", "其它"])
    target = (category_name or "").strip()

    n = _wait_category_options(page, sel, timeout_sec=12.0)
    if n == 0:
        print("[marketplace] 類別選單尚未出現選項，再等一輪…", flush=True)
        human_sleep(1.0, 1.8)
        n = _wait_category_options(page, sel, timeout_sec=8.0)

    # 先捲動選項清單到底（分類廣告/其他商品在最下方，可能需 lazy load）
    try:
        for _ in range(8):
            opts = page.locator(sel).all()
            if opts:
                opts[-1].scroll_into_view_if_needed(timeout=2000)
            page.mouse.wheel(0, 400)
            human_sleep(0.3, 0.6)
    except Exception:
        pass
    # 診斷截圖 + 印出目前看到的所有類別選項，方便對照
    try:
        all_opts = page.evaluate(
            """(sel) => [...document.querySelectorAll(sel)].map(o => (o.innerText||'').trim().split('\\n')[0].trim()).filter(Boolean)""",
            sel,
        )
        print(f"[marketplace] 類別選單現有選項({len(all_opts)}): {all_opts}", flush=True)
        capture_screenshot(page, "category_diag", "category_dropdown")
    except Exception:
        pass

    if target:
        # 別名正規化：若目標屬於雲端下發的別名族（如「其他」↔「其他商品」），改用完整別名清單比對
        if target in cfg_aliases:
            aliases = list(dict.fromkeys(cfg_aliases + [target]))  # 保序去重
        else:
            aliases = [target]
        # 只比對每個選項的「第一行文字」，避免比到父群組（如「分類廣告」）聚合後的整段文字
        try:
            idx = page.evaluate("""([sel, names]) => {
                const opts = [...document.querySelectorAll(sel)];
                const first = (o) => (o.innerText || '').trim().split('\\n')[0].trim();
                // Tier 1: 第一行完全相等
                for (const name of names)
                    for (let i = 0; i < opts.length; i++)
                        if (first(opts[i]) === name) return i;
                // Tier 2: 第一行以目標開頭（「其他」→「其他商品」）
                for (const name of names)
                    for (let i = 0; i < opts.length; i++)
                        if (first(opts[i]).startsWith(name)) return i;
                // Tier 3: 第一行包含目標
                for (const name of names)
                    for (let i = 0; i < opts.length; i++)
                        if (first(opts[i]).includes(name)) return i;
                return -1;
            }""", [sel, aliases])
            if idx >= 0:
                opt = page.locator(sel).nth(idx)
                chosen = ""
                with contextlib.suppress(Exception):
                    chosen = (opt.inner_text(timeout=1500) or "").strip().split("\n")[0].strip()
                opt.scroll_into_view_if_needed(timeout=2000)
                human_sleep(0.2, 0.5)
                simulate_human_click(page, opt)
                print(f"[marketplace] 類別選擇: 目標「{target}」→ 實選「{chosen}」")
                return True
            print(f"[marketplace] ⚠️ 類別選單（role）找不到「{target}」(別名 {aliases})，改用純文字定位")
        except Exception as e:
            print(f"[marketplace] 類別比對失敗: {e}")

        # 後備 1：純文字精確定位（不依賴 role），對每個別名嘗試
        for name in aliases:
            try:
                loc = page.get_by_text(name, exact=True)
                if loc.count() > 0:
                    el = loc.last  # 下拉在 DOM 較後面，取最後一個較準
                    el.scroll_into_view_if_needed(timeout=2000)
                    human_sleep(0.2, 0.5)
                    simulate_human_click(page, el)
                    print(f"[marketplace] 類別選擇(文字定位): {name}")
                    return True
            except Exception:
                continue
        print(f"[marketplace] ⚠️ 純文字也找不到「{target}」，退回第一個")

    # 退回：選第一個選項
    opts = page.locator(sel).all()
    if opts:
        simulate_human_click(page, opts[0])
        return True
    page.keyboard.press("ArrowDown")
    human_sleep(0.3, 0.5)
    page.keyboard.press("Enter")
    return False


def post_one_sale_item(
    page: Page,
    fbid: str,
    item: MarketplaceItem,
    lang: str = "zh",
    share_groups: list[str] | None = None,
    batch_min_sec: float = 45,
    batch_max_sec: float = 120,
    dry_run: bool = False,
    warmup_min_sec: float = 60,
    warmup_max_sec: float = 180,
) -> MarketplaceResult:
    """
    在 Facebook Marketplace 建立一個商品刊登（www 版）。

    ⚠️ 選擇器需要直播瀏覽器實測調整。
        若定位失敗，會回傳 status='need_debug' 並截圖。
    """
    print(f"[marketplace] Posting item: {item.item_name}")
    title = item.item_name[:30]

    # 健康檢查
    check = perform_checks(page, fbid)
    if check != CheckResult.OK:
        _write_schedule_log("自動上架", "失敗", fbid, title, error=check.value)
        return MarketplaceResult(success=False, status="失敗", error=f"Pre-check: {check.value}")

    # 反偵測：進入發文系統前，先到 FB 首頁動態瀏覽 1-3 分鐘模擬真人
    # （dry_run 縮短為 5-10 秒，僅驗流程不需拖時間）
    if dry_run:
        warm_up_browse(page, min_sec=5, max_sec=10)
    else:
        warm_up_browse(page, min_sec=warmup_min_sec, max_sec=warmup_max_sec)

    # 進入建立商品頁（URL 可由雲端下發，FB 改路徑免更新客戶端）
    from src.served_config import get as cfg
    create_url = cfg("selectors.mp_create_url", "https://www.facebook.com/marketplace/create/item/")
    if not enhanced_get(page, create_url):
        _write_schedule_log("自動上架", "失敗", fbid, title, error="cannot reach create page")
        return MarketplaceResult(success=False, status="失敗", error="Cannot reach create page")

    human_sleep(3, 6)

    # ── 新版 Marketplace 填表流程（經瀏覽器實測驗證）──
    errors = []

    # 找 input[type='text']（標題=第0個, 價格=第1個）
    text_inputs = page.locator("input[type='text']").all()
    if len(text_inputs) < 2:
        ss = capture_screenshot(page, fbid, "marketplace_no_inputs")
        _write_schedule_log("自動上架", "失敗", fbid, title, error="no inputs")
        return MarketplaceResult(success=False, status="need_debug", error=f"找不到輸入欄位. 截圖: {ss}")

    human_idle(page)  # 進表單先隨機瀏覽一下（反偵測）

    # 表單上的下拉欄位（類別、狀況、存貨狀況）。狀況步驟仍會用到，先取一次。
    combos = page.locator("label[role='combobox']").all()

    # 1. 類別：FB 新版（2026-08）建立表單會**自動帶入類別**（依標題/圖片猜，
    #    例：房屋被猜成「工具」），而且點類別欄不再開出可選清單——舊的
    #    「開下拉→選其他商品」在自動化情境下開不出來、硬等會逾時卡死整個上架
    #    （2026-08-09 老闆真實上架踩到）。策略改為：已經有類別值就接受、略過；
    #    真的空白才嘗試開選單（best-effort，永不因類別擋掉上架）。
    cat_combo = _find_category_combobox(page)
    if cat_combo is not None:
        current = ""
        with contextlib.suppress(Exception):
            current = (cat_combo.inner_text(timeout=2000) or "").replace("類別", "").replace("Category", "").strip()
        if current:
            print(f"[marketplace] 類別已自動帶入「{current}」，接受並略過選單", flush=True)
        else:
            # 空白才試著開選單選目標類別；開不出來就放它去（不硬等、不擋上架）
            simulate_human_click(page, cat_combo)
            human_sleep(1.0, 1.8)
            if not _select_category_option(page, item.category):
                _dump_category_dom(page)      # 存結構供日後 FB 再改版時對照
                with contextlib.suppress(Exception):
                    page.keyboard.press("Escape")
                print("[marketplace] 類別選單開不出來，改用 FB 預設類別繼續（不擋上架）", flush=True)
        human_sleep(0.4, 0.8)
    else:
        print("[marketplace] ⚠️ 找不到類別欄位（combobox），改用 FB 預設繼續", flush=True)
        _dump_category_dom(page)

    # 2. 標題 — 模擬真人打字後，驗證是否完整，不完整則以 fill 補齊
    simulate_human_typing(page, text_inputs[0], item.item_name)
    human_sleep(0.4, 0.9)
    try:
        cur = (text_inputs[0].input_value() or "").strip()
    except Exception:
        cur = ""
    if cur != (item.item_name or "").strip():
        try:
            text_inputs[0].fill(item.item_name)
            print(f"[marketplace] 標題以 fill 補齊（打字不完整）")
        except Exception:
            pass
    human_sleep(0.5, 1.5)

    # 3. 價格 — 模擬真人打字
    if not simulate_human_typing(page, text_inputs[1], str(item.item_price)):
        text_inputs[1].fill(str(item.item_price))
    human_sleep(0.5, 1.5)

    # 4. 狀況：best-effort。房屋類沒有「全新/二手」概念，且新版 FB 這個下拉常
    #    開不出來——選不到就跳過，絕不因它擋掉或卡住上架（與類別同策略）。
    if item.condition and len(combos) >= 2:
        cond_label = CONDITION_MAP.get(item.condition, "全新")
        try:
            if not _select_combobox_option(page, combos[1], cond_label):
                print(f"[marketplace] 狀況未選到（{cond_label}），沿用 FB 預設繼續", flush=True)
                with contextlib.suppress(Exception):
                    page.keyboard.press("Escape")
        except Exception as e:
            print(f"[marketplace] 狀況步驟略過：{e}", flush=True)

    # 5. 上傳圖片（必填：FB 要求至少 1 張圖才會啟用繼續按鈕）
    if item.images:
        _upload_images(page, item.images)
    else:
        errors.append("images")
        print("[marketplace] ⚠️ 無圖片：繼續按鈕可能維持 disabled")

    # 6. 說明/內文（文案主體 — 重要！）
    #    標題一併寫進內文開頭：Marketplace 轉發到社團時，社團貼文只帶內文、
    #    標題整個不見（客戶回報）。標題寫在內文裡，轉發出去才帶得走。
    #    內文開頭已經有標題（例如 AI 文案自帶）就不重複加。
    _desc = (item.description or "").strip()
    _title = (item.item_name or "").strip()
    if _title and _title not in _desc[: len(_title) + 40]:
        _desc = f"{_title}\n\n{_desc}" if _desc else _title
    if _desc:
        if _fill_description(page, _desc):
            print(f"[marketplace] ✅ 已填入說明（{len(_desc)} 字，標題已併入內文）", flush=True)
        else:
            errors.append("description")
            print("[marketplace] ⚠️ 說明欄位填寫失敗", flush=True)
            with contextlib.suppress(Exception):
                capture_screenshot(page, fbid, "marketplace_no_desc")
    else:
        print("[marketplace] ⚠️ item.description 為空，略過說明填寫", flush=True)

    # 6.5 地點（縣市）— best-effort，選填，失敗不阻擋上架
    if getattr(item, "item_location", ""):
        _fill_location(page, item.item_location)

    # 7. simulate_human_typing 已透過 click-body 觸發 blur，等待 React 更新
    human_sleep(1, 2)
    # 點一下頁面空白處，確保最後一個 input 的 blur 事件已觸發
    page.mouse.click(10, 10)
    human_sleep(0.5, 1)

    disabled = page.evaluate("""() => {
        const btn = document.querySelector('div[aria-label="繼續"]');
        return btn ? btn.getAttribute('aria-disabled') : 'not found';
    }""")

    if disabled == "true":
        # 最後手段：JS 端派發事件
        page.evaluate("""() => {
            document.querySelectorAll('input[type="text"]').forEach((el) => {
                el.dispatchEvent(new Event('input', { bubbles: true }));
                el.dispatchEvent(new Event('change', { bubbles: true }));
            });
        }""")
        human_sleep(1, 2)
        page.mouse.click(10, 10)
        human_sleep(0.5, 1)
        disabled = page.evaluate("""() => {
            const btn = document.querySelector('div[aria-label="繼續"]');
            return btn ? btn.getAttribute('aria-disabled') : 'not found';
        }""")

    if disabled == "true":
        ss = capture_screenshot(page, fbid, "marketplace_still_disabled")
        print(f"[marketplace] 繼續按鈕仍 disabled，截圖: {ss}")
        try:
            btn_loc = page.locator("div[aria-label='繼續']").first
            simulate_human_click(page, btn_loc)
            human_sleep(3, 6)
        except Exception:
            pass
    else:
        _click_continue(page)
        human_sleep(3, 6)

    # ── 步驟 8（可選）：在對象頁選擇轉發社團（第一批 ≤20，隨機順序）──
    group_share_count = 0
    overflow_groups: list[str] = []
    if "step=audience" in page.url:
        # 未明確指定時，讀取使用者存的選擇（data/marketplace_share_<fbid>.json）
        if share_groups is None:
            share_groups = load_share_groups(fbid)
            if share_groups:
                print(f"[marketplace] 從設定檔載入 {len(share_groups)} 個轉發社團")
        if share_groups:
            import random
            shuffled = list(share_groups)
            random.shuffle(shuffled)               # 隨機順序（FB 對重複發文高度警戒）
            first_batch = shuffled[:20]            # 對象頁一次上限 20
            overflow_groups = shuffled[20:]        # 其餘發佈後用「在更多地方上架」補刊
            group_share_count = _select_groups_on_audience_page(page, first_batch, fbid)
        else:
            # 沒有選擇任何社團時，仍抓一次清單存檔，方便使用者之後挑選
            get_audience_groups(page, fbid)

    if group_share_count > 0:
        print(f"[marketplace] 對象頁已勾選 {group_share_count} 個社團")

    # ── dry-run：走完組裝與勾選，但不發佈 ──
    if dry_run:
        capture_screenshot(page, fbid, "marketplace_dryrun")
        print("[marketplace] dry-run：已填完表單/勾選社團，未按發佈")
        return MarketplaceResult(success=True, status="dry_run",
                                 audience_selected=group_share_count)

    # ── 步驟 9：點擊發布 ──
    _click_publish_marketplace(page)
    human_sleep(3, 5)

    # ── 確認刊登狀態（輪詢，避免「你的商品」尚在 loading 就誤判審核）──
    confirmed = _confirm_listing_published(page, fbid, title, timeout_sec=45)
    item_url = confirmed.get("item_url") or _extract_item_url(page)
    current_url = page.url
    if not item_url and "marketplace/item" in current_url:
        item_url = current_url

    on_more_places = confirmed.get("on_more_places") or _on_list_in_more_places_page(page)
    seen_in_selling = bool(confirmed.get("seen_in_selling"))

    if not item_url:
        ss = capture_screenshot(page, fbid, "marketplace_unknown")
        if on_more_places or seen_in_selling:
            _write_schedule_log("自動上架", "成功", fbid, title)
            reason = "在更多地方上架頁" if on_more_places else "你的商品列表"
            print(f"[marketplace] ✓ 已發佈（{reason}確認成功，未取得 item URL）", flush=True)
            return MarketplaceResult(success=True, status="成功",
                                     audience_selected=group_share_count)
        _write_schedule_log("自動上架", "審核", fbid, title)
        return MarketplaceResult(success=True, status="審核", audience_selected=group_share_count,
                                 error=f"無法確認刊登狀態. 截圖: {ss}")

    _update_products_tracking(fbid, item.item_name, item_url)
    _write_schedule_log("自動上架", "成功", fbid, title, url=item_url)
    print(f"[marketplace] ✓ Published: {item_url}")

    # ── 步驟 10：超過 20 個社團 → 用「在更多地方上架」分批補刊（亂速）──
    extra_listed = []
    if overflow_groups:
        print(f"[marketplace] 尚有 {len(overflow_groups)} 個社團待補刊（分批 ≤20）...", flush=True)
        extra_listed = _forward_overflow_groups(
            page, fbid, item.item_name, overflow_groups, batch_min_sec, batch_max_sec)

    return MarketplaceResult(success=True, status="成功", item_url=item_url,
                             audience_selected=group_share_count, extra_listed=extra_listed)


def _forward_overflow_groups(page: Page, fbid: str, item_title: str, groups: list[str],
                             min_sec: float, max_sec: float) -> list[dict]:
    """把超過對象頁 20 上限的社團，分批（每批 ≤20）用『在更多地方上架』補刊。批次間亂速等待。"""
    import random
    results = []
    batches = [groups[i:i + 20] for i in range(0, len(groups), 20)]
    for bi, batch in enumerate(batches):
        print(f"[marketplace] 補刊第 {bi + 1}/{len(batches)} 批（{len(batch)} 個社團）...", flush=True)
        r = list_in_more_places(page, fbid, item_title, batch)
        results.append({"batch": bi + 1, "requested": len(batch),
                        "selected": r.get("selected", 0), "errors": r.get("errors", [])})
        if bi < len(batches) - 1:
            wait = random.uniform(min_sec, max_sec)   # 亂速
            print(f"[marketplace] 亂速等待 {wait:.0f}s 後發下一批...", flush=True)
            time.sleep(wait)
    return results


