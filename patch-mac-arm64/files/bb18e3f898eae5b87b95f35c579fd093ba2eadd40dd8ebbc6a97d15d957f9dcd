def list_in_more_places(page: Page, fbid: str, item_title: str, group_names_batch: list[str],
                        list_only: bool = False, dry_run: bool = False) -> dict:
    """在 selling 頁對指定商品點「在更多地方上架」，勾選本批社團（≤20）並發佈。
    回傳 {selected, errors, available}。
    - list_only=True：只開對話框、回傳可轉發社團清單、不勾選。
    - dry_run=True：勾選但不點「發佈」（安全測試用）。
    每一步拍截圖，方便對現行 FB 介面除錯。"""
    errors: list[str] = []

    if not enhanced_get(page, "https://www.facebook.com/marketplace/you/selling"):
        return {"selected": 0, "errors": ["cannot open selling page"], "available": []}
    human_sleep(3, 5)
    capture_screenshot(page, fbid, "lmp_1_selling")

    # 1. 定位商品的「...」按鈕
    btn = page.evaluate(_JS_FIND_ITEM_MORE_BTN, item_title)
    if not btn:
        capture_screenshot(page, fbid, "lmp_item_not_found")
        return {"selected": 0, "errors": [f"找不到商品或其更多按鈕: {item_title[:40]}"], "available": []}
    print(f"[lmp] 點商品更多選單 (label={btn.get('label')})", flush=True)
    page.mouse.click(btn["x"], btn["y"])
    human_sleep(1, 2)
    capture_screenshot(page, fbid, "lmp_2_menu")

    # 2. 點「在更多地方上架」（選單文字可由雲端下發，FB 改版免更新客戶端）
    from src.served_config import get as cfg
    list_more_texts = cfg("selectors.mp_list_more_texts", _MENU_LIST_MORE_TEXTS)
    if not _click_menu_item(page, list_more_texts):
        capture_screenshot(page, fbid, "lmp_menu_no_option")
        return {"selected": 0, "errors": ["選單找不到『在更多地方上架』"], "available": []}
    human_sleep(2, 4)
    capture_screenshot(page, fbid, "lmp_3_dialog")

    human_idle(page)  # 選社團前隨機游移（反偵測）
    # 對話框只列「可轉發 Marketplace」的社團 → 先抓實際可用清單
    available = get_audience_groups(page, fbid)
    print(f"[lmp] 對話框可轉發社團共 {len(available)} 個", flush=True)
    if list_only:
        return {"selected": 0, "errors": [], "available": available}

    # 只勾「本批 ∩ 可用」的社團，避免要求不存在的社團
    wanted = [g for g in group_names_batch if g in available]
    missing = [g for g in group_names_batch if g not in available]
    if missing:
        print(f"[lmp] {len(missing)} 個社團不在可轉發清單、略過: {missing[:3]}...", flush=True)

    # 3. 勾選本批社團（復用對象頁的捲動+勾選邏輯）
    selected = _select_groups_on_audience_page(page, wanted, fbid) if wanted else 0
    capture_screenshot(page, fbid, "lmp_4_selected")

    # 4. 發佈（dry_run 時跳過，只驗證勾選）
    if selected > 0 and not dry_run:
        if not _click_publish_marketplace(page):
            errors.append("發佈按鈕點擊失敗")
        human_sleep(3, 5)
        capture_screenshot(page, fbid, "lmp_5_published")
    elif selected > 0 and dry_run:
        print("[lmp] dry-run：已勾選但不發佈", flush=True)
    else:
        errors.append("本批 0 個社團勾選成功")

    return {"selected": selected, "errors": errors, "available": available}


def _click_publish_marketplace(page: Page) -> bool:
    """在 Marketplace 建立頁點擊發布（step=audience 或最終步驟）。"""
    selectors = [
        "div[aria-label='發布']",
        "div[role='button']:has-text('發布')",
        "span:has-text('發布')",
        "div[aria-label='發佈']",
        "div[role='button']:has-text('發佈')",
        "span:has-text('發佈')",
        "div[aria-label='Publish']",
        "div[role='button']:has-text('Publish')",
    ]
    human_sleep(1, 2)
    for sel in selectors:
        try:
            el = page.locator(sel).first
            if el.count() > 0 and el.is_visible():
                simulate_human_click(page, el)
                print(f"[marketplace] 已點擊: {sel}", flush=True)
                return True
        except Exception:
            continue

    for sel in selectors:
        try:
            el = page.locator(sel).first
            if el.count() > 0:
                el.click(force=True)
                return True
        except Exception:
            continue
    return False


def _confirm_listing_published(
    page: Page,
    fbid: str,
    title: str,
    timeout_sec: float = 45.0,
) -> dict:
    """發佈後輪詢確認刊登是否成功。

    回傳 dict：
      item_url / on_more_places / seen_in_selling
    """
    deadline = time.time() + timeout_sec
    title_key = (title or "").strip()[:24]
    seen_selling = False
    checked_selling = False

    while time.time() < deadline:
        # 1) 直接拿到商品 URL
        url = _extract_item_url(page)
        if url:
            return {"item_url": url, "on_more_places": False, "seen_in_selling": False}

        # 2) 「在更多地方上架」= 已建立成功
        if _on_list_in_more_places_page(page):
            return {"item_url": None, "on_more_places": True, "seen_in_selling": False}

        # 正文成功提示
        try:
            body = page.evaluate("() => (document.body && document.body.innerText) || ''") or ""
            if re.search(r"已發佈|刊登成功|Your listing is now live|Listing is live", body, re.I):
                url = _extract_item_url(page)
                return {"item_url": url, "on_more_places": False, "seen_in_selling": True}
        except Exception:
            body = ""

        # 3) 約一半超時後去「你的商品」查標題（等 loading 結束）
        if not checked_selling and time.time() > deadline - timeout_sec * 0.45:
            checked_selling = True
            with contextlib.suppress(Exception):
                page.goto(
                    "https://www.facebook.com/marketplace/you/selling",
                    wait_until="domcontentloaded",
                    timeout=30000,
                )
                human_sleep(2, 3.5)

        if "marketplace/you/selling" in (page.url or ""):
            # 等骨架屏／loading 消掉
            for _ in range(8):
                try:
                    loading = page.evaluate(r"""() => {
                      const t = (document.body && document.body.innerText) || '';
                      return /載入中|Loading/i.test(t) && !/你的商品|Your listings/i.test(t);
                    }""")
                except Exception:
                    loading = False
                if not loading:
                    break
                human_sleep(0.8, 1.4)
            try:
                found = page.evaluate(
                    """(key) => {
                      if (!key) return false;
                      const t = (document.body && document.body.innerText) || '';
                      return t.includes(key);
                    }""",
                    title_key,
                )
                if found:
                    seen_selling = True
                    url = _extract_item_url(page)
                    print(f"[marketplace] 在「你的商品」找到刊登：{title_key}…", flush=True)
                    return {
                        "item_url": url,
                        "on_more_places": False,
                        "seen_in_selling": True,
                    }
            except Exception:
                pass

        human_sleep(1.2, 2.0)

    return {
        "item_url": _extract_item_url(page),
        "on_more_places": _on_list_in_more_places_page(page),
        "seen_in_selling": seen_selling,
    }


def _on_list_in_more_places_page(page: Page) -> bool:
    """判斷是否在發佈後的「在更多地方上架」頁 —— 這代表商品已建立成功（成功訊號）。
    FB 發佈後常跳到此頁做社團擴散，而非跳到商品頁，導致抓不到 item URL。"""
    try:
        return bool(page.evaluate(r"""() => {
            const body = document.body ? (document.body.innerText || '') : '';
            // 標題出現「在更多地方上架」+ 預覽出現「上架」時間戳 = 已發佈
            const hasHeading = /在更多地方上架|List in more places/i.test(body);
            const hasListed = /上架|已在 Marketplace|Listed|posted/i.test(body);
            return hasHeading && hasListed;
        }"""))
    except Exception:
        return False


def _extract_item_url(page: Page) -> str | None:
    """從當前頁面 URL 或內容中擷取 Marketplace item URL。"""
    current_url = page.url
    if "marketplace/item/" in current_url:
        return current_url

    # 頁面上的連結
    links = page.locator("a[href*='marketplace/item/']").all()
    for link in links:
        try:
            href = link.get_attribute("href")
            if href and "marketplace/item/" in href:
                return href
        except Exception:
            continue

    return None
