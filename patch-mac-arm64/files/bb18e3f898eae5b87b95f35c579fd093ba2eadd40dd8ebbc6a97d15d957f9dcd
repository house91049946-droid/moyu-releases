def _select_category(page: Page, item_type: str) -> bool:
    """選擇 Marketplace 商品類別（FB 新版為下拉選單）。"""
    try:
        # 點擊類別標籤旁的選單
        label = page.locator("label:has-text('類別')").first
        if label.count() == 0:
            return False

        # 點擊對應的選單按鈕（通常是 label 旁邊的下拉箭頭）
        parent = label.locator("..")
        dropdown = parent.locator("[role='button'], div[aria-haspopup='listbox']").first
        if dropdown.count() == 0:
            # 備案：直接點 label 下一個可點擊元素
            dropdown = parent.locator("div[role='button']").first
        if dropdown.count() == 0:
            return False

        dropdown.click()
        human_sleep(1, 2)

        # 依 item_type 選擇對應選項
        type_labels = {
            "product": "商品/一般物品",
            "house": "房屋出租",
            "carTruck": "汽車/卡車",
            "motorcycle": "摩托車",
            "vehicleOthers": "車輛(其他)",
        }
        target = type_labels.get(item_type, "商品/一般物品")

        # 點擊選項
        option = page.locator(f"[role='option']:has-text('{target}')").first
        if option.count() > 0:
            option.click()
            human_sleep(1, 2)
            return True

        # 備案：用文字匹配
        option2 = page.locator(f"text={target}").first
        if option2.count() > 0:
            option2.click()
            human_sleep(1, 2)
            return True

        return False
    except Exception as e:
        print(f"[marketplace] Category selection failed: {e}")
        return False


def _fill_description(page: Page, text: str) -> bool:
    """填入商品說明/內文。說明欄是 textarea（標題/價格是 input）。填完驗證確認真的填進去。"""
    def _verify(loc) -> bool:
        val = ""
        with contextlib.suppress(Exception):
            val = loc.input_value() or ""
        if not val:
            with contextlib.suppress(Exception):
                val = loc.inner_text() or ""
        return bool(val) and text[:15] in val

    selectors = ["textarea", "div[contenteditable='true']", "[role='textbox']"]
    for attempt in range(2):
        for sel in selectors:
            loc = page.locator(sel).first
            try:
                if loc.count() == 0:
                    continue
                loc.scroll_into_view_if_needed(timeout=2000)
                # 先用擬真打字。舊版是先 fill() 整段塞進去（等同貼上，沒有任何
                # 鍵盤事件），只有失敗才退回 delay=6 的機械等速打字——兩種在行為
                # 指紋上都很像機器人。內文是 FB 最會拿去比對的欄位，這裡照真人打。
                simulate_human_click(page, loc)
                human_sleep(0.3, 0.6)
                page.keyboard.press("Meta+A" if page.evaluate("navigator.platform").startswith("Mac") else "Control+A")
                page.keyboard.press("Backspace")
                human_sleep(0.2, 0.5)
                human_type(page, text)
                page.mouse.click(10, 10)  # blur 觸發 React onChange
                human_sleep(0.3, 0.6)
                if _verify(loc):
                    return True
                # 打字沒進去（欄位可能擋鍵盤輸入）→ 最後才退回 fill，寧可像機器人也別發不出去
                with contextlib.suppress(Exception):
                    loc.fill(text)
                page.mouse.click(10, 10)
                human_sleep(0.3, 0.6)
                if _verify(loc):
                    print("[marketplace] 說明改用 fill 填入（打字未生效）", flush=True)
                    return True
            except Exception as e:
                print(f"[marketplace] 說明填寫嘗試失敗({sel}): {e}", flush=True)
                continue
        # 第一輪都失敗 → 嘗試展開詳細區塊再試一輪
        _expand_details_section(page)
        human_sleep(1, 1.5)
    return False


def _expand_details_section(page: Page):
    """展開「更多詳情」區塊（描述欄位藏在這裡）。"""
    try:
        expand_btn = page.locator("text=更多詳情").first
        if expand_btn.count() > 0 and expand_btn.is_visible():
