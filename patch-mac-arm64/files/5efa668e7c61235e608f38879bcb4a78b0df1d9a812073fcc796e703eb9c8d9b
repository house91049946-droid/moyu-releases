    return {"message": f"已觸發測試執行（dry_run={row.dry_run}）；結果請看執行紀錄"}


# ── one-shot post ────────────────────────────────────

class PostNowReq(BaseModel):
    account_id: int
    listing_id: int
    headless: bool = False
    dry_run: bool = False
    max_groups: Optional[int] = None  # 測試時可限制社團數


@router.post("/post")
async def post_now(data: PostNowReq, session: AsyncSession = Depends(get_session)):
    """立即對物件的目標社團逐一發文（非轉發）。"""
    listing = (await session.execute(
        select(GpListing).where(GpListing.id == data.listing_id)
    )).scalar_one_or_none()
    if not listing:
        raise HTTPException(404, "物件不存在")
    acc = (await session.execute(
        select(Account).where(Account.id == data.account_id)
    )).scalar_one_or_none()
    if not acc or not acc.fb_user_id:
        raise HTTPException(422, "帳號不存在或尚未綁定 FB")
    import asyncio
    from ..scheduler.group_post_runner import run_listing_once, _GP_LOCK

    # 已有一輪社團發文在跑：直接說清楚。原本是靜靜排隊等 _GP_LOCK，前端仍然
    # 提示「已開始發文」，但畫面一整個小時都不會有動靜，客戶只會覺得功能壞了。
    if _GP_LOCK.locked():
        raise HTTPException(
            409,
            "目前已有一輪社團發文在進行中，同一時間只能跑一輪（共用同一個瀏覽器）。"
            "請等它跑完，或到儀表板按「緊急停止」中止後再試。",
        )
    asyncio.create_task(run_listing_once(
        account_id=data.account_id,
        listing_id=data.listing_id,
        headless=data.headless,
        dry_run=data.dry_run,
        max_groups=data.max_groups,
    ))
    return {"message": "已開始社團發文，請看執行紀錄"}
