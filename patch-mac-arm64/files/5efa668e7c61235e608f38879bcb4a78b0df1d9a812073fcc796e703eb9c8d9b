class GenerateReq(BaseModel):
    base_content: str
    n_versions: int = 5


@router.post("/generate-copy")
async def generate_copy(req: GenerateReq):
    """與 MP 共用 DeepSeek／雲端文案引擎（generate_from_base），端點獨立。"""
    import asyncio
    from ..deepseek_client import DeepSeekError, generate_from_base, has_key
    from ..cloud_client import cloud_enabled
    if not (cloud_enabled() or has_key()):
        raise HTTPException(422, "尚未設定雲端授權或 DeepSeek 金鑰")
    n = max(1, min(10, int(req.n_versions or 5)))
    try:
        versions = await asyncio.to_thread(generate_from_base, req.base_content, n)
        return {"versions": versions}
    except DeepSeekError as e:
        raise HTTPException(422, str(e))


_ALLOWED_MEDIA_EXT = {
    # images
    ".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".bmp",
    # videos
    ".mp4", ".mov", ".m4v", ".webm", ".avi", ".mkv",
}
_MAX_UPLOAD_BYTES = 200 * 1024 * 1024  # 200MB（影片）


@router.post("/upload-image")
@router.post("/upload-media")
async def upload_media(file: UploadFile = File(...)):
    """上傳社團發文用圖片或影片（路徑寫入 listing.image_pool）。"""
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
    ext = os.path.splitext(file.filename or "media.bin")[1].lower() or ".bin"
    if ext not in _ALLOWED_MEDIA_EXT:
        raise HTTPException(422, f"不支援的檔案格式：{ext}（請上傳圖片或影片）")
    data = await file.read()
    if len(data) > _MAX_UPLOAD_BYTES:
        raise HTTPException(422, f"檔案過大（上限 {_MAX_UPLOAD_BYTES // (1024*1024)}MB）")
    filename = f"gp_{uuid.uuid4().hex}{ext}"
    path = UPLOAD_DIR / filename
    path.write_bytes(data)
    kind = "video" if ext in {".mp4", ".mov", ".m4v", ".webm", ".avi", ".mkv"} else "image"
    return {
        "filename": filename,
        "path": f"/uploads/group_post/{filename}",
        "kind": kind,
        "size": len(data),
    }


