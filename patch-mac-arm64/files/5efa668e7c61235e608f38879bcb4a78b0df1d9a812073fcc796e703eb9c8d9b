@router.get("/status")
async def gp_status(session: AsyncSession = Depends(get_session)):
    st = get_system_state_sync()
    listings = (await session.execute(select(func.count(GpListing.id)))).scalar() or 0
    running = (await session.execute(
        select(func.count(GpSchedule.id)).where(GpSchedule.status == "running")
    )).scalar() or 0
    # 社團發文只寫 RunLog(task_type=group_post)，不寫 PostHistory
    today = datetime.utcnow().date()
    today_posts = (await session.execute(
        select(func.count(RunLog.id)).where(
            RunLog.task_type == "group_post",
            func.date(RunLog.created_at) == today,
            RunLog.status.in_(("success", "needs_manual")),
        )
    )).scalar() or 0
    return {
        "paused": st.get("paused", False),
        "pause_reason": st.get("pause_reason", ""),
        "pause_detail": st.get("pause_detail", ""),
        "listings": listings,
        "running_schedules": running,
        "today_posts": today_posts,
    }


@router.post("/resume")
async def gp_resume():
    set_system_pause_sync(False)
    return {"message": "已恢復"}


@router.post("/stop-all")
async def gp_stop_all(session: AsyncSession = Depends(get_session)):
    set_system_pause_sync(True, reason="manual", detail="社團發文緊急停止")
    rows = (await session.execute(select(GpSchedule).where(GpSchedule.status == "running"))).scalars().all()
    from ..scheduler.group_post_runner import remove_schedule_jobs
    for s in rows:
        s.status = "stopped"
        remove_schedule_jobs(s.id)
    # 中止進行中的社團發文子進程（連同瀏覽器）——比照 marketplace stop-all
    from ..fbauto_bridge import _RUNNING, kill_job
    for key in list(_RUNNING.keys()):
        if key.startswith("gp_"):
            kill_job(key)
    await session.commit()
    return {"message": "已緊急停止全部社團發文排程"}


@router.get("/calendar")
async def gp_calendar(year: int | None = None, month: int | None = None,
                      session: AsyncSession = Depends(get_session)):
    """簡易行事曆：依 RunLog(task_type=group_post) 統計。"""
    now = datetime.utcnow()
    y = year or now.year
    m = month or now.month
    import calendar as cal
    days_in_month = cal.monthrange(y, m)[1]
    first_weekday = datetime(y, m, 1).weekday()  # Mon=0
    rows = (await session.execute(
        select(RunLog).where(
            RunLog.task_type == "group_post",
            func.strftime("%Y", RunLog.created_at) == f"{y:04d}",
            func.strftime("%m", RunLog.created_at) == f"{m:02d}",
        )
    )).scalars().all()
    by_day: dict[int, dict] = {}
    success = failed = 0
    for r in rows:
        if not r.created_at:
            continue
        d = r.created_at.day
        slot = by_day.setdefault(d, {"success": 0, "failed": 0, "total": 0})
        ok = (r.status or "") in ("success", "needs_manual")
        if ok:
            slot["success"] += 1
            success += 1
        else:
            slot["failed"] += 1
            failed += 1
        slot["total"] += 1
    total = success + failed
    return {
        "year": y, "month": m, "days_in_month": days_in_month, "first_weekday": first_weekday,
        "days": by_day,
        "summary": {
            "success": success, "failed": failed, "total": total,
            "success_rate": round(100 * success / total, 1) if total else None,
            "posts": total, "listings": 0,
        },
    }


