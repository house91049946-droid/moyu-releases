"""FB 自動加入社團（SPEC-P32 §3）。

這是整個產品裡最保守的一條路。理由：加入社團是 FB 對帳號最敏感的動作之一，
而且加錯、加太快的後果不是「這次失敗」，是整個帳號被限制——發文才是客戶買的東西。

硬規則（老闆 2026-09-02，不得放寬）：
  - 每日最多 2 個、硬上限 3；每週最多 10 個。
  - 兩次加入之間至少 30 分鐘（同一天的第二個排在 30–90 分鐘後）。
  - 加入後 10 天內不可對該社團發文（gate 在 group_post_runner，靠 groups.joined_at）。
  - 入社問題不代答，跳過並標記，讓客戶自己去回答。
  - 養號保護期內不加社團；被限制就停，暫停 3 天。
  - 候選依成員數由大到小排——人數多的優先。
"""
from __future__ import annotations

import datetime
import json
import os
import random
import tempfile

from sqlalchemy import select

from ..database import (async_session_factory, SyncSession, Account, Group,
                        GroupJoinConfig, GroupJoinCandidate)
from .marketplace_planner import plan_daily_times
from .nurture_runner import TAIPEI, _as_taipei
from .task_runner import scheduler

from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.date import DateTrigger

HARD_DAILY_CAP = 3
DEFAULT_DAILY = 2
WEEKLY_CAP = 10
MAX_KEYWORDS = 3
NO_POST_DAYS = 10             # 加入後幾天內不發文
BLOCK_PAUSE_DAYS = 3          # 被限制就停幾天
GAP_MINUTES = (30, 90)        # 同一天兩次加入之間
JOB_PREFIX = "gjoin_"


def effective_daily(requested: int | None) -> int:
    n = requested or DEFAULT_DAILY
    return max(1, min(HARD_DAILY_CAP, int(n)))


def parse_keywords(raw: str) -> list[str]:
    """最多 3 個關鍵字，去空白去重保序。多的直接丟掉——搜太多就是掃名單。"""
    out: list[str] = []
    for tok in (raw or "").split(","):
        k = tok.strip()
        if k and k not in out:
            out.append(k)
        if len(out) >= MAX_KEYWORDS:
            break
    return out


def can_post_to_group(joined_at, now: datetime.datetime | None = None) -> bool:
    """自動加入的社團滿 10 天才准發文；手動加的（joined_at 為 None）不受限。"""
    if joined_at is None:
        return True
    now = now or datetime.datetime.utcnow()
    return (now - joined_at).days >= NO_POST_DAYS


def days_until_postable(joined_at, now: datetime.datetime | None = None) -> int:
    if joined_at is None:
        return 0
    now = now or datetime.datetime.utcnow()
    left = NO_POST_DAYS - (now - joined_at).days
    return max(0, left)


def joined_this_week(now: datetime.datetime | None = None) -> int:
    now = now or datetime.datetime.utcnow()
    since = now - datetime.timedelta(days=7)
    with SyncSession() as s:
        rows = s.execute(select(GroupJoinCandidate).where(
            GroupJoinCandidate.joined_at.isnot(None),
            GroupJoinCandidate.joined_at >= since)).scalars().all()
    return len(rows)


async def get_or_create_config(session, account_id: int) -> GroupJoinConfig:
    cfg = (await session.execute(select(GroupJoinConfig).where(
        GroupJoinConfig.account_id == account_id))).scalars().first()
    if cfg is None:
        cfg = GroupJoinConfig(account_id=account_id)
        session.add(cfg)
        await session.flush()
    return cfg


def next_candidates(limit: int) -> list[GroupJoinCandidate]:
    """依成員數由大到小取待加入的候選。"""
    with SyncSession() as s:
        rows = s.execute(select(GroupJoinCandidate)
                         .where(GroupJoinCandidate.status == "new")
                         .order_by(GroupJoinCandidate.members.desc())
                         .limit(max(1, limit))).scalars().all()
        return [GroupJoinCandidate(id=r.id, group_url=r.group_url, name=r.name,
                                   members=r.members, privacy=r.privacy,
                                   status=r.status) for r in rows]


def save_candidates(items: list[dict], keyword: str = "") -> int:
    """搜尋結果入庫（同一個社團網址只留一筆）。回新增筆數。"""
    n = 0
    with SyncSession() as s:
        for it in items or []:
            url = (it.get("url") or "").strip()
            if not url:
                continue
            if s.execute(select(GroupJoinCandidate).where(
                    GroupJoinCandidate.group_url == url)).scalar_one_or_none():
                continue
            s.add(GroupJoinCandidate(
                group_url=url, name=(it.get("name") or "")[:300],
                members=int(it.get("members") or 0), privacy=it.get("privacy") or "",
                source=it.get("source") or "keyword", keyword=it.get("keyword") or keyword))
            n += 1
        s.commit()
    return n


def record_joins(account_id: int, data: dict) -> int:
    """加入結果落庫：候選標狀態，成功的同時寫進 groups（帶 joined_at，10 天內不發文）。"""
    now = datetime.datetime.utcnow()
    n = 0
    with SyncSession() as s:
        for g in (data or {}).get("groups") or []:
            url = (g.get("url") or "").strip()
            if not url:
                continue
            row = s.execute(select(GroupJoinCandidate).where(
                GroupJoinCandidate.group_url == url)).scalar_one_or_none()
            status = g.get("status") or "failed"
            if row is not None:
                row.status = status
                row.note = (g.get("note") or "")[:300]
                if status in ("joined", "existing"):
                    row.joined_at = now
            if status == "joined":
                exists = s.execute(select(Group).where(
                    Group.account_id == account_id, Group.group_url == url)).scalar_one_or_none()
                # CLI 只拿到網址，數不到成員數；候選表在搜尋時就記過了，從那裡補。
                members = int(g.get("members") or (row.members if row is not None else 0) or 0)
                name = (g.get("name") or (row.name if row is not None else "") or url)[:500]
                if exists is None:
                    s.add(Group(account_id=account_id, group_name=name,
                                group_url=url, member_count=members, joined_at=now))
                else:
                    exists.joined_at = now
                n += 1
        s.commit()
    return n


def _write_exclude_file() -> str:
    """已加入／已申請／已排除的社團網址——CLI 進頁面前就跳過。"""
    with SyncSession() as s:
        rows = s.execute(select(GroupJoinCandidate.group_url).where(
            GroupJoinCandidate.status != "new")).all()
    fd, path = tempfile.mkstemp(prefix="gjoin_", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump([u for (u,) in rows], f, ensure_ascii=False)
    return path


def make_on_done(account_id: int, exclude_path: str | None = None):
    def _cb(result):
        try:
            data = result.data or {}
            n = record_joins(account_id, data)
            with SyncSession() as s:
                cfg = s.execute(select(GroupJoinConfig).where(
                    GroupJoinConfig.account_id == account_id)).scalars().first()
                if cfg is not None:
                    cfg.last_run_date = datetime.date.today().isoformat()
                    s.commit()
            if data.get("blocked"):
                print("[gjoin] 被 FB 限制，暫停 3 天不再加社團", flush=True)
                _pause_days(account_id, BLOCK_PAUSE_DAYS)
            print(f"[gjoin] 收尾：加入 {n} 個社團", flush=True)
        finally:
            if exclude_path:
                try:
                    os.unlink(exclude_path)
                except OSError:
                    pass
    return _cb


def _pause_days(account_id: int, days: int) -> None:
    """用 last_run_date 往後推當作暫停（不另開欄位，語意仍然是「今天別跑」）。"""
    with SyncSession() as s:
        cfg = s.execute(select(GroupJoinConfig).where(
            GroupJoinConfig.account_id == account_id)).scalars().first()
        if cfg is not None:
            cfg.last_run_date = (datetime.date.today() + datetime.timedelta(days=days - 1)).isoformat()
            s.commit()


async def skip_reason(session, account_id: int, cfg: GroupJoinConfig | None) -> str:
    import asyncio
    from ..database import get_system_state_sync, posting_grace_remaining_sync
    try:
        st = await asyncio.to_thread(get_system_state_sync)
        if getattr(st, "paused", None) or (isinstance(st, dict) and st.get("paused")):
            return "系統已暫停"
    except Exception:
        pass
    acc = (await session.execute(
        select(Account).where(Account.id == account_id))).scalar_one_or_none()
    if not acc or not acc.fb_user_id:
        return "FB 尚未綁定"
    from ..fbauto_bridge import cookie_exists
    if not cookie_exists(acc.fb_user_id):
        return "FB 登入態不存在"
    days = await asyncio.to_thread(posting_grace_remaining_sync, getattr(acc, "fb_bound_at", None))
    if days > 0:
        return f"新帳號養號期還剩 {days} 天，不加社團"
    if cfg is not None and (cfg.last_run_date or "") >= datetime.date.today().isoformat():
        return "今天已經跑過一輪"
    if await asyncio.to_thread(joined_this_week) >= WEEKLY_CAP:
        return f"本週已加入 {WEEKLY_CAP} 個社團，額度用完"
    return ""


async def run_search(account_id: int) -> dict:
    """依關鍵字找社團候選（只搜尋，不加入）。"""
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    async with async_session_factory() as s:
        cfg = await get_or_create_config(s, account_id)
        await s.commit()
        kws = parse_keywords(cfg.keywords)
        if not kws:
            return {"skipped": "還沒設定關鍵字"}
        acc = (await s.execute(select(Account).where(Account.id == account_id))).scalar_one_or_none()
        if not acc or not acc.fb_user_id:
            return {"skipped": "FB 尚未綁定"}
        fbid = acc.fb_user_id
    busy = browser_busy_reason()
    if busy:
        return {"skipped": f"目前有「{busy}」正在使用瀏覽器"}
    job_id = start_long_op("gjoin_search", "src.run_fb_group_search",
                           ["--fbid", fbid, "--keywords", ",".join(kws),
                            "--max-pages", "2", "--headless"],
                           account_id=account_id, fbid=fbid,
                           on_done=lambda r: print(
                               f"[gjoin] 搜尋收尾：新增 {save_candidates((r.data or {}).get('groups') or [])} 個候選",
                               flush=True))
    return {"job_id": job_id}


async def run_join_once(account_id: int, force: bool = False, dry_run: bool = False) -> dict:
    from ..fbauto_bridge import start_long_op, browser_busy_reason
    import asyncio
    async with async_session_factory() as s:
        cfg = await get_or_create_config(s, account_id)
        await s.commit()
        if not cfg.enabled and not force:
            return {"skipped": "未開啟"}
        why = await skip_reason(s, account_id, None if force else cfg)
        if why:
            print(f"[gjoin] 略過：{why}", flush=True)
            return {"skipped": why}
        want = effective_daily(cfg.daily_max)
        acc = (await s.execute(select(Account).where(Account.id == account_id))).scalar_one()
        fbid = acc.fb_user_id
    cands = await asyncio.to_thread(next_candidates, want)
    if not cands:
        return {"skipped": "沒有待加入的候選——先執行一次「找社團」"}
    busy = browser_busy_reason()
    if busy:
        return {"skipped": f"目前有「{busy}」正在使用瀏覽器"}
    exclude_path = await asyncio.to_thread(_write_exclude_file)
    args = ["--fbid", fbid, "--urls", ",".join(c.group_url for c in cands),
            "--max", str(want), "--exclude-file", exclude_path, "--headless"]
    if dry_run:
        args.append("--dry-run")
    try:
        job_id = start_long_op("gjoin_join", "src.run_fb_group_join", args,
                               account_id=account_id, fbid=fbid,
                               on_done=make_on_done(account_id, exclude_path))
    except RuntimeError as e:
        os.unlink(exclude_path)
        return {"skipped": str(e)}
    print(f"[gjoin] 加入社團啟動：{len(cands)} 個候選（job {job_id}）", flush=True)
    return {"job_id": job_id}


async def _scheduled(account_id: int):
    await run_join_once(account_id)


def _remove_jobs():
    for job in list(scheduler.get_jobs()):
        if job.id.startswith(JOB_PREFIX) and job.id != "gjoin_daily_replan":
            job.remove()


async def plan_and_schedule() -> list[str]:
    """一天排一次（每日上限已經很小，第二個由 CLI 在同一輪內間隔處理）。"""
    _remove_jobs()
    plans = []
    async with async_session_factory() as s:
        rows = (await s.execute(select(GroupJoinConfig).where(
            GroupJoinConfig.enabled == True))).scalars().all()  # noqa: E712
        for r in rows:
            plans.append((r.account_id, (r.window_start or "10:00", r.window_end or "21:00")))
    now = datetime.datetime.now(TAIPEI)
    out = []
    for account_id, window in plans:
        times = [_as_taipei(t) for t in plan_daily_times(
            "window", [], window[0], window[1], 1, False, now.date())]
        for t in times:
            if t <= now:
                continue
            scheduler.add_job(func=_scheduled, trigger=DateTrigger(run_date=t),
                              args=[account_id], id=f"{JOB_PREFIX}join", replace_existing=True)
            out.append(t)
    labels = [t.strftime("%H:%M") for t in sorted(out)]
    if labels:
        print(f"[gjoin] 今日加入社團已排：{'、'.join(labels)}", flush=True)
    return labels


def scheduled_time_today() -> str:
    for job in scheduler.get_jobs():
        if job.id == f"{JOB_PREFIX}join" and job.next_run_time:
            return job.next_run_time.astimezone(TAIPEI).strftime("%H:%M")
    return ""


async def restore_group_join_schedule():
    try:
        await plan_and_schedule()
    except Exception as e:
        print(f"[gjoin] 啟動規劃失敗（不影響其他功能）：{e}", flush=True)
    scheduler.add_job(func=plan_and_schedule,
                      trigger=CronTrigger(hour=0, minute=30, timezone=TAIPEI),
                      id="gjoin_daily_replan", replace_existing=True)
