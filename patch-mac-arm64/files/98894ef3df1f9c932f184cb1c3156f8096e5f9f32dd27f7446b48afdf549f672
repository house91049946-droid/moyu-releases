def _auth_json(method: str, path: str, timeout: float = 20, **kw):
    """帶授權 token 的請求；401 重取一次。回 (status, json)。"""
    url = cloud_url()

    def _call(token: str):
        with http_client.client(timeout) as c:
            return c.request(method, f"{url}{path}", headers={"Authorization": f"Bearer {token}"}, **kw)
    r = _call(get_token())
    if r.status_code == 401:
        _token_cache["token"] = ""
        r = _call(get_token())
    try:
        body = r.json()
    except ValueError:
        body = {"detail": r.text[:200]}
    return r.status_code, body


