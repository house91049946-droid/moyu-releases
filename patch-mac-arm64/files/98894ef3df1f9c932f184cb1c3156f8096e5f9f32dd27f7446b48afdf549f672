def _authed(method: str, path: str, json_body=None, timeout: float = 15):
    """帶授權 token 打雲端；401 重取一次 token。回 (status, json|None)。"""
    if not cloud_enabled():
        return 0, None
    url = cloud_url()

    def _do(token: str):
        with http_client.client(timeout) as c:
            return c.request(method, f"{url}{path}", json=json_body,
                             headers={"Authorization": f"Bearer {token}"})
    try:
        r = _do(get_token())
        if r.status_code == 401:
            _token_cache["token"] = ""
            r = _do(get_token())
    except (CloudError, httpx.HTTPError) as e:
        raise CloudError(f"連線雲端失敗: {e}") from e
    try:
        body = r.json()
    except ValueError:
        body = None
    return r.status_code, body


def mobile_sync(items: list[dict], applied: list[dict], stats: dict | None = None,
                thumbs: dict | None = None, timeout: float = 15) -> list[dict]:
    """推物件快照＋回報已套用，拿回待套用指令。雲端不可用時拋 CloudError。
    thumbs：{物件 id: (hash, base64 JPEG)}，只帶這一輪新做或有變的。"""
    payload = {"items": items, "applied": applied, "stats": stats or {},
               "thumbs": {k: {"hash": h, "data": b} for k, (h, b) in (thumbs or {}).items()}}
    code, body = _authed("POST", "/mobile/sync", payload, timeout)
    if code != 200:
        raise CloudError(f"mobile/sync HTTP {code}: {str(body)[:120]}")
    if isinstance((body or {}).get("phones"), int):
        remember_phone_count(body["phones"])
    return (body or {}).get("commands", [])


PHONES_FILE_NAME = ".mobile_phones.json"


def remember_phone_count(n: int) -> None:
    """記下已綁定幾支手機，新手村「綁定手機」那一關靠它判斷（不必每次問雲端）。"""
    import json
    from .config import DATA_DIR
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        (DATA_DIR / PHONES_FILE_NAME).write_text(json.dumps({"phones": int(n)}), encoding="utf-8")
    except OSError:
        pass


def phone_count() -> int:
    import json
    from .config import DATA_DIR
    try:
        return int(json.loads((DATA_DIR / PHONES_FILE_NAME).read_text(encoding="utf-8")).get("phones") or 0)
    except (OSError, ValueError, AttributeError):
        return 0


