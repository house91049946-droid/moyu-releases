# 否定語意（2026-10-06 Codex 審查：「謝絕土地、禁止租屋」不能被標成土地＋租賃）。
# 動詞型否定可以隔幾個字（「不收土地及租屋」）；「非／不是」只認緊接著的（「非預售屋」）。
_NEG_VERBS = ("不收", "禁止", "謝絕", "勿貼", "不接", "拒絕", "嚴禁", "請勿", "不准", "不得", "不可")
_NEG_ADJ = ("非", "不是")
_NEG_GAP = 4
_NEG_BREAK = re.compile(r"[｜|，,。！!？?()（）【】\[\]「」『』~～:：;；\n]")


def is_negated(text: str, pos: int) -> bool:
    """text[pos] 開頭的關鍵字前面是不是緊跟著否定詞（同一個短句、隔不超過 _NEG_GAP 字）。"""
    for neg in _NEG_ADJ:
        if pos >= len(neg) and text[pos - len(neg):pos] == neg:
            return True
    head = text[max(0, pos - _NEG_GAP - 3):pos]
    for neg in _NEG_VERBS:
        i = head.rfind(neg)
        if i < 0:
            continue
        gap = head[i + len(neg):]
        if len(gap) <= _NEG_GAP and not _NEG_BREAK.search(gap):
            return True
    return False


def keyword_hits(text: str, kw: str) -> tuple[bool, bool]:
    """(有正向提到, 有被否定的提到)。"""
    pos_hit = neg_hit = False
    i = text.find(kw)
    while i >= 0:
        if is_negated(text, i):
            neg_hit = True
        else:
            pos_hit = True
        i = text.find(kw, i + 1)
    return pos_hit, neg_hit


def has_positive(text: str, kw: str) -> bool:
    return keyword_hits(text, kw)[0]


def norm_region(s: str) -> str:
    """縣市名正規化：臺→台、去空白、去尾巴的市／縣（「臺中市」→「台中」）。"""
    s = re.sub(r"\s+", "", s or "").replace("臺", "台")
    return re.sub(r"[縣市]$", "", s)

# 先判斷「是不是房地產社團」。實測正式機 697 個社團有 420 個是魚缸、多肉、養殖這種
# 興趣社團——往那裡發物件就是垃圾訊息，被檢舉的機率比發到對的社團高得多。
# 名字裡沒有任何房地產線索的，一律標「非房產」，讓使用者一鍵排除。
RE_MARKERS = ("房", "屋", "宅", "不動產", "地產", "店面", "透天", "大樓", "公寓", "套房", "雅房",
              "建案", "土地", "農地", "建地", "廠房", "別墅", "華廈", "社區", "房東", "仲介",
              "預售", "新成屋", "中古", "買房", "賣房", "租屋", "建商", "厝", "物件", "格局", "坪")

ALL_TAGS = ("非房產",) + tuple(TAG_RULES.keys()) + ("其他",)


def _norm(name: str) -> str:
    return re.sub(r"\s+", "", (name or "")).replace("臺", "台")


def classify_name(name: str) -> dict:
    """{'tags': [...], 'region': '台中'}。認不出類別就 tags=['其他']；認不出區域就 ''。"""
    n = _norm(name)
    if not any(m in n for m in RE_MARKERS):
        # 「二手魚缸買賣」也有「買賣」兩個字——沒有房地產線索就不套類別規則，直接非房產
        return {"tags": ["非房產"], "region": _region_of(n)}
    tags, excluded = [], []
    for tag, kws in TAG_RULES.items():
        hits = [keyword_hits(n, k) for k in kws]
        if any(p for p, _ in hits):
            tags.append(tag)
        elif any(q for _, q in hits):
            excluded.append(tag)            # 名稱明講不收這類（2026-10-06 Codex 審查）
    out = {"tags": tags or ["其他"], "region": _region_of(n)}
    if excluded:
        out["excluded"] = excluded
    return out


def _region_of(n: str, city_hint: str = "") -> str:
    """先找縣市本名（最可靠），再找行政區。多個縣市都有的區名只在 city_hint 對得上時才算。
    縣市本名出現好幾個時，帶「市／縣」的優先、再看誰先出現
    （「高鐵 40 分鐘到台北｜物件位於新北市板橋區」→ 新北；2026-10-06 Codex 審查）。"""
    best = None
    for city, kws in REGIONS.items():
        names = {kws[0]} | {k.replace("臺", "台") for k in kws[1:2] if k.startswith(("臺", "台"))}
        for nm in names:
            i = n.find(nm)
            while i >= 0:
                if not (nm == "台北" and n[max(0, i - 1):i] == "新"):
                    suffix = n[i + len(nm):i + len(nm) + 1] in ("市", "縣")
                    key = (0 if suffix else 1, i)
                    if best is None or key < best[0]:
                        best = (key, city)
                i = n.find(nm, i + 1)
    if best:
        return best[1]
    hint = norm_region(city_hint)
    for city, kws in REGIONS.items():
        for k in kws[1:]:
            if k not in n:
                continue
            if k in _AMBIGUOUS:
                if hint and hint in AMBIGUOUS_DISTRICTS[k]:
                    return hint
                continue
            if k == "北市" and "新北市" in n:
                continue
            return city
    for k, cands in AMBIGUOUS_DISTRICTS.items():
        if k in n and hint and hint in cands:
            return hint
    return ""


def classify_many(names: list[str]) -> list[dict]:
    return [classify_name(x) for x in names]


def ai_classify_leftovers(names: list[str], timeout: float = 60) -> dict[str, dict]:
    """規則認不出的丟給 AI。回 {name: {'tags': [...], 'region': ''}}；沒有 AI 可用就回空 dict。

    只走本機 DeepSeek 後備（雲端目前沒有分類端點）。任何失敗都安靜回空，
    分類是加分項，不能讓「一鍵抓取社團」因為它掛掉。
    """
    if not names:
        return {}
    try:
        from .deepseek_client import _load_key, _MODEL, _API_URL  # type: ignore[attr-defined]
        import json as _json
        from . import http_client
    except Exception:
        return {}
    key = _load_key() if callable(_load_key) else ""
    if not key:
        return {}
    allowed = "、".join(TAG_RULES.keys())
    regions = "、".join(REGIONS.keys())
    prompt = (
        "以下是台灣 Facebook 房地產社團的名稱，請幫每一個判斷：\n"
        f"1) tags：從【{allowed}】裡挑 0~3 個最貼切的，都不像就給空陣列；\n"
        f"2) region：從【{regions}】挑一個縣市，看不出來就給空字串。\n"
        "只回 JSON：{\"items\": [{\"name\": \"...\", \"tags\": [...], \"region\": \"...\"}]}\n\n"
        + "\n".join(f"- {x}" for x in names[:60])
    )
    try:
        with http_client.client(timeout) as c:
            r = c.post(_API_URL, headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
                       json={"model": _MODEL, "messages": [{"role": "user", "content": prompt}],
                             "temperature": 0.1, "response_format": {"type": "json_object"}})
        data = r.json()
        content = data["choices"][0]["message"]["content"]
        items = _json.loads(content).get("items", [])
    except Exception:
        return {}
    out = {}
    for it in items:
        nm = (it.get("name") or "").strip()
        tags = [t for t in (it.get("tags") or []) if t in TAG_RULES]
        region = it.get("region") if it.get("region") in REGIONS else ""
        if nm:
            out[nm] = {"tags": tags or ["其他"], "region": region or ""}
    return out
