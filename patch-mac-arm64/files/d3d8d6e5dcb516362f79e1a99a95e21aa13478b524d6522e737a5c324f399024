"""FB 社團探索——依關鍵字找候選社團（SPEC-P32 §3.2）。

**只找、只列，不加入**。找與加刻意拆成兩支（同 P29 探索／追蹤的拆法）：
加入社團是 FB 對新帳號最敏感的動作之一，客戶要先看得到名單、排除掉不想加的，
才輪到 `run_fb_group_join` 真的去按。這支全程唯讀，最壞情況只是搜尋紀錄多幾筆。

紅線（§3.1／§3.2，一項都不准放寬）：
  - 關鍵字最多 **3 個**，多的直接丟掉並記一行——不是報錯，客戶多打一個不該整輪失敗。
  - 每個關鍵字只抓前 **2 頁**（FB 搜尋是無限捲動，用捲動輪數換算，見 SCROLLS_PER_PAGE）。
  - 結果**依成員數由大到小**排序（老闆：人數多的優先）。

2026-09-02 加好友那支在 mini 上踩到、這裡沿用的兩個教訓：
  1. `page.evaluate` 的 JS 字串裡**絕對不能**寫 `\\n` 跳脫——Python 會先把它變成真的換行，
     JS 收到就是語法錯誤，而 evaluate 只會默默回空，查半天。要換行用 String.fromCharCode(10)。
  2. FB 的清單卡片**名字不是連結**。要從卡片裡的按鈕／連結往上找到整張卡，
     再讀卡片自己的 `a[href]` 與 innerText，不能指望「名字連結」存在。

用法：
    python -m src.run_fb_group_search --fbid <id> --keywords "台中 買房,台中 租屋" \
        --max-pages 2 [--headless] [--result-json out.json] [--profile-dir …]
"""
import argparse
import atexit
import contextlib
import json
import re
import sys
from urllib.parse import quote, urlparse

from src.meta_block import ACTION_BLOCKED, classify as classify_meta
from src.utils import human_sleep

_JSON_PATH: str | None = None
_RESULT: dict | None = None

PLATFORM = "fb"
MAX_KEYWORDS = 3                    # §3.2 硬規則
DEFAULT_PAGES = 2
MAX_PAGES = 2                       # §3.2「抓前 2 頁」——設定再大也只抓 2 頁
SCROLLS_PER_PAGE = 3                # FB 搜尋沒有分頁，一「頁」約等於捲三下

FB = "https://www.facebook.com"
SEARCH_URL = FB + "/search/groups/?q={q}"

# FB 的封鎖／限制字樣。加好友那支（P31）的清單是在真帳號上校正過的，直接沿用，
# 再補幾條社團專屬的說法；社團與好友被擋時 FB 的用字不完全一樣。
_GROUP_BLOCK_PHRASES = (
    "你目前無法加入社團", "無法加入社團", "你加入社團的速度太快",
    "你已達到可加入社團的上限", "已達可加入社團數量上限",
    "You can't join groups right now", "You're joining groups too quickly",
    "limit on the number of groups",
)

# 卡片上不是社團名字的按鈕／狀態文字（小寫比對）
_CARD_JUNK = {
    "加入社團", "加入", "已加入", "已要求加入", "查看社團", "查看更多", "更多",
    "邀請", "分享", "join", "join group", "joined", "requested", "see group",
    "see more", "more", "invite", "share", "贊助", "sponsored",
}

# 「公開／私密」這一行 FB 一定放在行首（「公開 · 2.3萬位成員」）。
# 只認行首才不會被名字裡的「公開」騙到。
_PRIVACY_RE = re.compile(r"^(公開|私密|不公開|Public|Private)(社團)?\b", re.I)

# 成員數：「1.2萬位成員」「3,456 members」「12K members」「8,742 位成員」
_MEMBER_RE = re.compile(
    r"([\d][\d,.]*)\s*([萬千億KkMm])?\s*(?:位|名)?\s*(?:成員|members?)", re.I)
_UNITS = {"萬": 10000, "千": 1000, "億": 100000000, "k": 1000, "m": 1000000}

# `/groups/` 底下這些第一段不是社團，是功能頁（getclub 也擋同一組）
_NOT_GROUP = {"joins", "feed", "discover", "create", "search", "browse",
              "category", "notifications", "your_groups", ""}


# ---------------------------------------------------------------- 純函式（可離線測）

def _write():
    """atexit：不管怎麼結束都要把結果寫出去（例外時保留已找到的部分）。"""
    if _JSON_PATH and _RESULT is not None:
        # 後端 bridge 的 `_result_from_raw` 只讀 raw["data"]（envelope v2），
        # 平面欄位是 SPEC-P32 §3.4 的契約——兩邊都給，各取所需。
        _RESULT["data"] = {k: v for k, v in _RESULT.items() if k != "data"}
        with open(_JSON_PATH, "w", encoding="utf-8") as f:
            json.dump(_RESULT, f, ensure_ascii=False, indent=2)
    if _RESULT is not None and not _RESULT.get("success"):
        print("[gsearch] 失敗：" + str(_RESULT.get("error") or "未知原因"), flush=True)


def parse_keywords(arg: str) -> list[str]:
    """逗號分隔 → 去空白、去重、保留順序，**最多 3 個**。

    多出來的丟掉並印一行就好，不報錯：客戶在 UI 多打一格，不該讓整輪找不成。
    """
    seen: set[str] = set()
    out: list[str] = []
    dropped: list[str] = []
    for raw in (arg or "").split(","):
        k = raw.strip()
        if not k or k in seen:
            continue
        seen.add(k)
        if len(out) < MAX_KEYWORDS:
            out.append(k)
        else:
            dropped.append(k)
    if dropped:
        print(f"[gsearch] 關鍵字最多 {MAX_KEYWORDS} 個，已忽略：{'、'.join(dropped)}", flush=True)
    return out


def effective_pages(requested: int | None) -> int:
    """把頁數夾到 1–2。§3.2 寫死「抓前 2 頁」，設定再大也不准多抓。"""
    n = DEFAULT_PAGES if not requested or requested <= 0 else requested
    return max(1, min(MAX_PAGES, n))


def parse_member_count(text: str) -> int:
    """把 FB 的成員數字樣解析成整數。讀不到回 0（排序時排最後，不猜）。

    「1.2萬位成員」→ 12000、「3,456 members」→ 3456、「12K members」→ 12000。
    一定要綁著「成員／members」比對：卡片上還有「每天約 10 則貼文」這種數字。
    """
    m = _MEMBER_RE.search(text or "")
    if not m:
        return 0
    num, unit = m.group(1), (m.group(2) or "").lower()
    try:
        # 「3,456」的逗號是千分位；「1.2萬」的點是小數點——先去逗號再吃小數
        val = float(num.replace(",", ""))
    except ValueError:
        return 0
    return int(round(val * _UNITS.get(unit, 1)))


def parse_privacy(text: str) -> str:
    """卡片文字 → 「公開」／「私密」／「」。只認行首的那個詞，見 _PRIVACY_RE。"""
    for line in (text or "").splitlines():
        m = _PRIVACY_RE.match(line.strip())
        if not m:
            continue
        word = m.group(1).lower()
        return "公開" if word in ("公開", "public") else "私密"
    return ""


def group_key_from_url(url: str) -> str:
    """社團網址 → 唯一鍵（數字 id 或代稱）。不是社團頁回空字串。

    - /groups/123456/posts/9/   → "123456"
    - /groups/taichung.house/   → "taichung.house"
    - /groups/discover/、/watch/ → ""
    """
    if not url:
        return ""
    path = urlparse(url.strip()).path or ""
    segs = [s for s in path.split("/") if s]
    if len(segs) < 2 or segs[0] != "groups":
        return ""
    key = segs[1]
    if key.lower() in _NOT_GROUP or not re.fullmatch(r"[A-Za-z0-9._\-]+", key):
        return ""
    return key.lower()


def normalize_group_url(url: str) -> str:
    """社團網址 → 統一成 `https://www.facebook.com/groups/<key>/`。不是社團回空字串。

    搜尋結果的連結會帶一長串追蹤參數，也可能是 m./mbasic. 版；不統一就會重複收。
    """
    key = group_key_from_url(url)
    return f"{FB}/groups/{key}/" if key else ""


def parse_group_card(text: str, href: str, keyword: str = "") -> dict | None:
    """一張搜尋結果卡片 → {url, name, members, privacy, keyword}。認不出來回 None。

    卡片長這樣（實測前的合理假設，見檔頭教訓 2）：
        台中買房交流區
        公開 · 2.3萬位成員
        每天約 10 則貼文
        加入社團
    名字取「第一行不是按鈕字、也不是公開/成員那行」的內容。
    """
    url = normalize_group_url(href)
    if not url:
        return None
    name = ""
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line or line.lower() in _CARD_JUNK:
            continue
        if _PRIVACY_RE.match(line) or _MEMBER_RE.search(line):
            continue                       # 「公開 · 2.3萬位成員」那行
        name = line[:80]
        break
    if not name:
        return None
    return {"url": url, "name": name, "members": parse_member_count(text),
            "privacy": parse_privacy(text), "keyword": keyword}


def dedupe_groups(groups: list[dict]) -> list[dict]:
    """同一個社團只留一筆，後面重複的用來補前面缺的欄位。

    為什麼要補而不是直接丟：同一張卡片我們會從「加入」按鈕和 `a[href]` 各往上走一次，
    兩次停在不同層——一邊可能只拿到名字、另一邊才有成員數。丟掉就白白少了排序依據。
    """
    order: list[str] = []
    by_key: dict[str, dict] = {}
    for g in groups:
        key = group_key_from_url(g.get("url", ""))
        if not key:
            continue
        cur = by_key.get(key)
        if cur is None:
            by_key[key] = dict(g)
            order.append(key)
            continue
        if not cur.get("members") and g.get("members"):
            cur["members"] = g["members"]
        if not cur.get("privacy") and g.get("privacy"):
            cur["privacy"] = g["privacy"]
        if len(g.get("name", "")) > len(cur.get("name", "")):
            cur["name"] = g["name"]        # 較長的那個通常是完整社團名
    return [by_key[k] for k in order]


def sort_by_members(groups: list[dict]) -> list[dict]:
    """成員數由大到小。老闆硬規則：人數多的優先加。

    同人數保持原順序（穩定排序）＝先搜到的關鍵字優先，符合客戶自己排的關鍵字順序。
    """
    return sorted(groups, key=lambda g: -int(g.get("members") or 0))


def classify_fb_block(page_text: str = "", error_text: str = "") -> str:
    """FB 社團版的失敗分類：社團專屬字樣 → 加好友那支校正過的 FB 字樣 → meta_block 通用規則。"""
    from src.run_fb_friend import classify_fb_block as classify_friend

    blob = f"{page_text}\n{error_text}".lower()
    if any(p.lower() in blob for p in _GROUP_BLOCK_PHRASES):
        return ACTION_BLOCKED
    return classify_friend(page_text=page_text, error_text=error_text)


def summarize(groups: list[dict]) -> dict:
    """給紀錄摘要用的計數：找到幾個、其中公開／私密各幾個、讀得到人數的幾個。"""
    return {
        "found": len(groups),
        "public": sum(1 for g in groups if g.get("privacy") == "公開"),
        "private": sum(1 for g in groups if g.get("privacy") == "私密"),
        "with_members": sum(1 for g in groups if int(g.get("members") or 0) > 0),
    }


# ---------------------------------------------------------------- 瀏覽器動作

def _body_text(page, limit: int = 4000) -> str:
    with contextlib.suppress(Exception):
        return page.evaluate("()=>document.body.innerText")[:limit]
    return ""


def _blocked_reason(page, fbid: str) -> str:
    """頁面上有封鎖／驗證跡象嗎？回原因字串，沒有回空字串。

    兩層：既有的 perform_checks（封鎖、鎖定、驗證檢查點）＋文字比對。
    """
    from src.utils import CheckResult, perform_checks

    with contextlib.suppress(Exception):
        chk = perform_checks(page, fbid)
        if chk != CheckResult.OK:
            return chk.value
    reason = classify_fb_block(page_text=_body_text(page))
    return reason if reason == ACTION_BLOCKED else ""


# 從搜尋結果頁收社團卡片。
# 名字不是連結（檔頭教訓 2），所以從「加入社團」鈕與 `/groups/` 連結**各往上走一次**
# 找整張卡，再讀卡片自己的連結與 innerText；Python 端再把兩次的結果併起來。
# 注意：這段裡一個 \n 跳脫都不能有（檔頭教訓 1）。
_CARDS_JS = """() => {
    const cards = new Set();
    const climb = (el) => {
        let card = el;
        for (let i = 0; i < 8 && card.parentElement; i++) {
            card = card.parentElement;
            const t = (card.innerText || '').trim();
            if (t.length > 12 && card.querySelector("a[href*='/groups/']")) break;
        }
        if (card) cards.add(card);
    };
    const wanted = /加入社團|已加入|已要求加入|Join|Joined|Requested/i;
    for (const b of document.querySelectorAll("div[role='button'],button")) {
        if (wanted.test(b.innerText || '')) climb(b);
    }
    for (const a of document.querySelectorAll("a[href*='/groups/']")) climb(a);
    const out = [];
    for (const c of cards) {
        const a = c.querySelector("a[href*='/groups/']");
        if (!a) continue;
        out.push({href: a.href, text: (c.innerText || '').trim().slice(0, 300)});
    }
    return out;
}"""


def collect_for_keyword(page, keyword: str, pages: int) -> list[dict]:
    """搜尋一個關鍵字，回這個關鍵字的候選社團。"""
    # TODO 實測校正：搜尋結果的社團分頁網址。/search/groups/?q= 是目前的直達路徑，
    # 若 FB 改成 /search/top/?q=…&filters=… 就要改走點「社團」分頁籤。
    page.goto(SEARCH_URL.format(q=quote(keyword)), wait_until="domcontentloaded", timeout=45000)
    # 搜尋結果是延遲載入的：等太短就是一片空白（加好友那支實測 5 秒不夠、9 秒才有）
    human_sleep(6.0, 9.0)
    for _ in range(pages * SCROLLS_PER_PAGE):
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 1200)
        human_sleep(1.5, 2.8)

    raw = []
    try:
        raw = page.evaluate(_CARDS_JS) or []
    except Exception as e:                  # 版面改了要看得到原因，不能默默吞掉
        print(f"[gsearch] 卡片解析失敗：{str(e)[:200]}", flush=True)
    print(f"[gsearch] 「{keyword}」卡片 {len(raw)} 張", flush=True)

    found = []
    for card in raw:
        g = parse_group_card(card.get("text", ""), card.get("href", ""), keyword)
        if g:
            found.append(g)
    return dedupe_groups(found)


def do_search(fbid: str, keywords: list[str], pages: int, headless: bool,
              profile_dir: str | None) -> dict:
    from src.login import _try_cookie_login
    from src.utils import capture_screenshot, launch_browser

    browser, context, page = launch_browser(fbid=fbid, headless=headless, user_data_dir=profile_dir)
    out: dict = {"groups": [], "blocked": False, "block_reason": ""}
    try:
        if not _try_cookie_login(page, context, fbid):
            raise RuntimeError("Cookie 登入失敗，請先用 CLI 登入一次")

        why = _blocked_reason(page, fbid)
        if why:
            out.update(blocked=True, block_reason=why)
            capture_screenshot(page, fbid, "gsearch_blocked")
            return out

        found: list[dict] = []
        for i, kw in enumerate(keywords):
            try:
                got = collect_for_keyword(page, kw, pages)
            except Exception as e:
                print(f"[gsearch] 關鍵字「{kw}」搜尋失敗（略過）：{str(e)[:120]}", flush=True)
                continue
            print(f"[gsearch] 「{kw}」找到 {len(got)} 個社團", flush=True)
            found = dedupe_groups(found + got)

            why = _blocked_reason(page, fbid)
            if why:
                # 只是搜尋就被擋＝帳號狀況不好，剩下的關鍵字不必再試，已找到的留著
                out.update(blocked=True, block_reason=why)
                print(f"[gsearch] ⚠ 偵測到被擋（{why}），停止搜尋", flush=True)
                with contextlib.suppress(Exception):
                    capture_screenshot(page, fbid, "gsearch_blocked")
                break
            if i < len(keywords) - 1:
                human_sleep(8.0, 20.0)      # 關鍵字之間喘口氣，連續搜尋最像機器

        out["groups"] = sort_by_members(found)
        return out
    except Exception as e:
        e.reason = classify_fb_block(page_text=_body_text(page), error_text=str(e))
        e.partial = out                      # 已找到的部分不能白找
        raise
    finally:
        with contextlib.suppress(Exception):
            context.close()                  # persistent context：browser 與 context 同物件


def _apply(result: dict, r: dict) -> None:
    result["groups"] = r.get("groups", [])
    result.update(summarize(result["groups"]))
    result["blocked"] = bool(r.get("blocked"))
    result["block_reason"] = r.get("block_reason", "")


def main():
    global _JSON_PATH, _RESULT
    ap = argparse.ArgumentParser(description="FB 社團探索（只找不加）")
    ap.add_argument("--fbid", required=True)
    ap.add_argument("--keywords", required=True, help=f"逗號分隔，最多 {MAX_KEYWORDS} 個")
    ap.add_argument("--max-pages", type=int, default=DEFAULT_PAGES,
                    help=f"每個關鍵字抓幾頁（硬上限 {MAX_PAGES}）")
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--result-json")
    ap.add_argument("--profile-dir", default=None, help="瀏覽器設定檔目錄（預設 user_data/<fbid>）")
    args = ap.parse_args()

    _JSON_PATH = args.result_json
    _RESULT = {
        "schema": 2, "success": False, "fbid": args.fbid, "platform": PLATFORM,
        "keywords": [], "found": 0, "public": 0, "private": 0, "with_members": 0,
        "blocked": False, "block_reason": "", "error": "未完成", "reason": "", "groups": [],
    }
    if _JSON_PATH:
        atexit.register(_write)

    keywords = parse_keywords(args.keywords)
    if not keywords:
        _RESULT["error"] = "沒有可用的關鍵字"
        sys.exit(1)
    _RESULT["keywords"] = keywords

    try:
        r = do_search(args.fbid, keywords, effective_pages(args.max_pages),
                      args.headless, args.profile_dir)
        _apply(_RESULT, r)
        _RESULT["success"] = True
        _RESULT["error"] = ""
        if _RESULT["blocked"]:
            _RESULT["reason"] = _RESULT["block_reason"]
            print(f"[gsearch] ⚠ 中斷：{_RESULT['block_reason']}"
                  f"（已找到 {_RESULT['found']} 個社團）", flush=True)
        else:
            print(f"[gsearch] ✅ 找到 {_RESULT['found']} 個候選社團"
                  f"（公開 {_RESULT['public']}、私密 {_RESULT['private']}），已依人數排序", flush=True)
    except KeyboardInterrupt:
        _RESULT["error"] = "使用者中斷"
        sys.exit(0)
    except Exception as e:
        _RESULT["error"] = str(e)
        _apply(_RESULT, getattr(e, "partial", {}) or {})
        _RESULT["reason"] = getattr(e, "reason", None) or classify_fb_block(error_text=str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
