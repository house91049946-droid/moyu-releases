# ── 只刪摸魚發的（老闆 2026-09-05）──────────────────────────────────────────────
# 掃到的貼文要「對得上我們自己的紀錄」才刪：網址在白名單裡，或內文含我們固定附加的
# 法定資訊／某個物件標題。兩種都對不上就跳過（記成 not_ours），寧可留著客戶手動發的。
def load_only(path: str) -> dict:
    """讀白名單檔。壞檔／不存在 → 回 None，代表「沒有白名單」。

    注意這裡回 None 而不是空 dict：兩者語意不同。
    None＝呼叫端沒給白名單（舊行為）；空的白名單＝有給但裡面沒東西，
    那就一則都不該刪——不然「紀錄是空的」會變成「全部都刪」。
    """
    if not path:
        return None
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, json.JSONDecodeError):
        print("[cleanup] ⚠ 白名單讀不到，這輪不刪任何東西（保守處理）", flush=True)
        return {"urls": [], "phrases": []}
    if isinstance(raw, dict):
        mad = raw.get("max_age_days")
        try:
            mad = None if mad is None else max(0, int(mad))
        except (TypeError, ValueError):
            mad = None
        return {"urls": [str(u) for u in (raw.get("urls") or [])],
                "phrases": [str(p) for p in (raw.get("phrases") or [])],
                "max_age_days": mad}
    return {"urls": [], "phrases": []}


def before_moyu(age_days, only: dict | None) -> bool:
    """這則比摸魚第一次發文還早，不可能是摸魚發的——不用開頁面比內文，直接留著。

    老闆 2026-09-08：「都已經是執行腳本，為什麼會這麼久」——個人頁 170 則每則都開來比，
    二十幾分鐘；摸魚才用幾天，比那之前的一律跳過，只開這幾天的十幾則。"""
    if only is None or age_days is None:
        return False
    mad = only.get("max_age_days")
    if mad is None:
        return False
    try:
        return int(age_days) > int(mad)
    except (TypeError, ValueError):
        return False


def _norm_url(u: str) -> str:
    return (u or "").split("?")[0].rstrip("/").lower()


def is_ours(url: str, text: str, only: dict | None) -> bool:
    """這則是不是摸魚發的？沒有白名單就一律當成是（維持舊行為）。"""
    if only is None:
        return True
    nu = _norm_url(url)
    if nu and any(nu == _norm_url(u) or (u and _norm_url(u) in nu) for u in only.get("urls") or []):
        return True
    body = (text or "")
    return any(p and p in body for p in only.get("phrases") or [])


def envelope(result: dict) -> dict:
    """結果 dict → 寫進檔案的樣子：頂層照舊，另鏡一份到 data。"""
    body = {k: v for k, v in result.items() if k != "data"}
    out = dict(body)
    out["data"] = body
    return out


def effective_older_than(requested: int | None, force_recent: bool = False) -> int:
    """把天數夾到合理範圍。下限是硬的——刪文不可逆，太短會刪到還在曝光的貼文。

    force_recent：使用者當下明確要「連這幾天的都刪」（老闆 2026-09-08）——只在手動、
    而且帶 --only-file（只刪摸魚發的）時才該用；排程永遠不會帶這個旗標。0＝不看天數。"""
    if force_recent and requested is not None:
        return max(0, int(requested))
    n = DEFAULT_OLDER_THAN if not requested or requested <= 0 else int(requested)
    return max(MIN_OLDER_THAN, n)


def effective_max(requested: int | None) -> int:
    """一輪的刪除上限。剩下的明天繼續刪，不要一次刪光——量太大最容易被判機器人。"""
    n = DEFAULT_MAX if not requested or requested <= 0 else int(requested)
    return max(1, min(HARD_CAP, n))


def should_delete(age_days, older_than: int) -> bool:
    """這則該不該刪？日期讀不到（None／負數）一律不刪——寧可留著。"""
    if age_days is None:
        return False
    try:
        age = int(age_days)
    except (TypeError, ValueError):
        return False
    return age >= 0 and age >= older_than


def parse_age_days(text: str, now: datetime.datetime | None = None) -> int | None:
    """從時間標記算出貼文幾天前發的；判不出來回 None（呼叫端要跳過，不是當成 0）。

    now 可注入：不注入的話測試會寫死日期，過幾個月自己爆炸。

    吃四種格式，由可靠到不可靠排：
      1. <time datetime="2026-07-12T08:30:00Z"> 的 ISO 值——最準，優先。
      2. 中文絕對日期「2026年7月12日」「7月12日」（沒寫年份＝今年，未來日期視為去年）。
      3. 中英相對時間「3天前」「2 weeks ago」——沿用 delete_club_post 的同一套解析。
      4. IG／Threads 卡片的短格式「3d」「2w」「5h」。
    """
    text = (text or "").strip()
    if not text:
        return None
    now = now or datetime.datetime.now()

    m = _ISO_RE.search(text)
    if m:
        y, mo, d = (int(x) for x in m.group(1, 2, 3))
        hh, mm = int(m.group(4) or 0), int(m.group(5) or 0)
        with contextlib.suppress(ValueError):
            return max(0, (now - datetime.datetime(y, mo, d, hh, mm)).days)

    m = _CJK_DATE_RE.search(text)
    if m:
        year, mon, day = m.group(1), int(m.group(2)), int(m.group(3))
        with contextlib.suppress(ValueError):
            d = datetime.datetime(int(year) if year else now.year, mon, day)
            if not year and d > now:            # 沒寫年份又落在未來 → 是去年的貼文
                d = d.replace(year=now.year - 1)
            return max(0, (now - d).days)

    # 以下都是相對時間，不吃注入的 now——「3天前」本來就是相對於「讀到它的當下」，
    # 換算成絕對日期再減注入的 now 反而會算錯。
    m = _REL_RE.search(text) or _REL_BARE_RE.search(text)
    if m:
        return max(0, int(int(m.group(1)) * _REL_DAYS[m.group(2)]))

    # 英文與「剛剛」交給 delete_club_post 的字串表（同一套語系，沒必要維護兩份）
    dstr = convert_text_to_post_date(text)
    if dstr:
        return max(0, calculate_post_age_in_days(dstr + " 00:00:00"))

    m = _SHORT_RE.search(text)
    if m:
        return max(0, int(int(m.group(1)) * _SHORT_DAYS[m.group(2)]))
    return None


def own_post_hrefs(hrefs: list, platform: str, me: str = "") -> list[str]:
    """把個人頁上的連結濾成「這個帳號自己的一般貼文」，去重保序。

    擋掉三種東西：
      - IG 的 /reel/ 與 /stories/——老闆說連動都不要動。
      - Threads 上轉發別人的串文（連結是 /@別人/post/…），那不是我們的貼文。
      - 同一則重複出現（九宮格的圖與時間各自是一個 <a>）。
    """
    me = (me or "").strip().lstrip("@").lower()
    out = []
    for raw in hrefs or []:
        h = (raw or "").strip()
        if not h:
            continue
        h = re.sub(r"^https?://(?:www\.)?(?:instagram|threads)\.(?:com|net)", "", h).split("?")[0]
        if platform == "threads":
            m = re.match(r"^/@([A-Za-z0-9._]+)/post/([A-Za-z0-9_-]+)/?$", h)
            if not m:
                continue
            if me and m.group(1).lower() != me:      # 轉發別人的：不是我們的貼文
                continue
            url = f"/@{m.group(1)}/post/{m.group(2)}"
        else:
            m = re.match(r"^(?:/([A-Za-z0-9._]+))?/p/([A-Za-z0-9_-]+)/?$", h)
            if not m:                                # /reel/、/stories/、其他路徑都在這裡被擋掉
                continue
            if m.group(1) and me and m.group(1).lower() != me:
                continue
            url = f"/p/{m.group(2)}/"
        if url not in out:
            out.append(url)
    return out


def post_url(platform: str, href: str) -> str:
    base = "https://www.threads.com" if platform == "threads" else "https://www.instagram.com"
    return base + href if href.startswith("/") else href


def block_reason(page_text: str = "", error_text: str = "") -> str:
    """頁面文字是不是「這輪該停」的訊號？回 action_blocked／rate_limited，否則空字串。

    IG 的「動作已封鎖」彈窗同時會寫「請稍後再試」——重的要先判，否則會被降級成節流。
    """
    blob = f"{page_text}\n{error_text}".lower()
    for phrase, reason in _BLOCK_EXTRA:
        if reason == ACTION_BLOCKED and phrase.lower() in blob:
            return reason
    r = classify_failure(page_text=page_text, error_text=error_text)
    if r in _STOP_REASONS:
        return r
    for phrase, reason in _BLOCK_EXTRA:
        if phrase.lower() in blob:
            return reason
    return ""


def summarize(posts: list) -> dict:
    """結果 JSON 的計數欄位。dry-run 的那些算「本來要刪的」，不算已刪。"""
    st = [p.get("status") for p in posts or []]
    return {"deleted": st.count("deleted"),
            "skipped_undated": st.count("undated"),
            "skipped_recent": st.count("recent")}


def describe(result: dict) -> str:
    """給客戶看的一行紀錄：動詞＋對象＋數量，不能只寫「成功」。"""
    name = "Threads" if result.get("platform") == "threads" else "IG"
    older = result.get("older_than", DEFAULT_OLDER_THAN)
    undated = result.get("skipped_undated", 0)
    tail = f"（另 {undated} 則日期讀不到，留著）" if undated else ""
    if result.get("dry_run"):
        n = sum(1 for p in result.get("posts", []) if p.get("status") == "dry_run")
        return f"{name} 備份刪文試跑：找到 {n} 則超過 {older} 天的貼文（沒有真的刪）{tail}"
    return f"{name} 備份刪文：清掉 {result.get('deleted', 0)} 則超過 {older} 天的貼文{tail}"


