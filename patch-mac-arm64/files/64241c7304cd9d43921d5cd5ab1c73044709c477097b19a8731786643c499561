def _body_text(page) -> str:
    with contextlib.suppress(Exception):
        return page.evaluate("()=>document.body.innerText")[:4000]
    return ""


def _page_blocked(page) -> str:
    return block_reason(page_text=_body_text(page))


def _dismiss_popups(page) -> None:
    """「稍後再說」之類的攔路彈窗：能關就關，關不掉不影響主流程。"""
    for t in ("稍後再說", "Not Now", "以後再說", "現在不要"):
        with contextlib.suppress(Exception):
            loc = page.get_by_text(t, exact=True)
            if loc.count() and loc.first.is_visible():
                loc.first.click()
                human_sleep(0.8, 1.5)
                return


def _logged_in(page) -> bool:
    """登入頁的痕跡（兩個平台的登入連結長得不一樣，兩種都認）。"""
    with contextlib.suppress(Exception):
        if page.locator('a[href*="/accounts/login"], a[href*="/login"], '
                        'input[name="username"]').first.is_visible():
            return False
    return True


def _my_handle(page, platform: str) -> str:
    """自己的帳號名。Threads 讀導覽列的 /@handle，IG 讀大頭貼那個連結。"""
    if platform == "threads":
        with contextlib.suppress(Exception):
            hrefs = page.evaluate(_HREFS_JS, "a[href^='/@']") or []
            for h in hrefs:
                m = re.match(r"^/@([A-Za-z0-9._]+)/?$", (h or "").split("?")[0])
                if m:
                    return m.group(1)
        return ""
    from src.run_ig_post import _my_username
    return _my_username(page)


def _scroll_profile(page, rounds: int) -> None:
    """個人頁要往下滑才會載出舊貼文——要刪的正是最舊的那批。"""
    for _ in range(rounds):
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 1400)
        human_sleep(1.0, 2.2)


def _collect_while_scrolling(page, platform: str, me: str, want: int,
                             rounds: int) -> tuple[list[str], set]:
    """邊捲邊收，不是捲完才收。

    2026-09-03 mini 實測：IG 個人頁的九宮格是虛擬清單——捲下去以後，上面那幾列會被
    從 DOM 拿掉。原本「捲 10 次再抓」的寫法，把 6 則抓成 1 則。Threads 也一樣穩妥。
    """
    links: list[str] = []
    pinned: set = set()
    seen_rounds_without_new = 0
    for i in range(max(1, rounds)):
        got, pin = _collect_own_posts(page, platform, me, want * 3)
        before = len(links)
        for h in got:
            if h not in links:
                links.append(h)
        pinned |= pin
        if len(links) >= want:
            break
        seen_rounds_without_new = seen_rounds_without_new + 1 if len(links) == before else 0
        if seen_rounds_without_new >= 3:
            break                       # 連捲三次沒有新東西：到底了
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 1400)
        human_sleep(1.0, 2.2)
    return links[:want], pinned


def _collect_own_posts(page, platform: str, me: str, want: int) -> tuple[list[str], set]:
    """回 (自己的貼文連結, 釘選的連結集合)。"""
    sel = "a[href*='/post/']" if platform == "threads" else "a[href*='/p/']"
    hrefs, pinned_raw = [], []
    with contextlib.suppress(Exception):
        hrefs = page.evaluate(_HREFS_JS, sel) or []
    with contextlib.suppress(Exception):
        pinned_raw = page.evaluate(_PINNED_JS, {"sel": sel, "hint": _PINNED_HINTS}) or []
    links = own_post_hrefs(hrefs, platform, me)
    pinned = set(own_post_hrefs(pinned_raw, platform, me))
    return links[:want], pinned


def _post_age_days(page) -> int | None:
    """貼文頁上的時間標記 → 幾天前。留言的時間也在這頁，但它一定比貼文新，
    最壞情況是把老貼文看成新的而跳過——保守方向，可以接受。"""
    blob = ""
    with contextlib.suppress(Exception):
        blob = page.evaluate(_TIMES_JS) or ""
    for line in blob.splitlines():
        age = parse_age_days(line)
        if age is not None:
            return age
    return None


def _find_by_texts(page, texts, roles=("menuitem", "button")):
    """依中英文字找可點的元素；找不到回 None。"""
    for t in texts:
        for role in roles:
            with contextlib.suppress(Exception):
                loc = page.get_by_role(role, name=t, exact=True).first
                if loc.count() > 0 and loc.is_visible():
                    return loc
    for t in texts:
        with contextlib.suppress(Exception):
            loc = page.get_by_text(t, exact=True).first
            if loc.count() > 0 and loc.is_visible():
                return loc
    return None


# 貼文本體的容器：⋯ 一定要在這裡面找。
# 2026-09-03 mini 實測：Threads 的側邊欄也有一顆 aria-label="更多"（外觀／設定那個選單），
# 不限定範圍就會點到它——選單開出來全是「外觀」「設定」，程式判定「選單裡找不到刪除」，
# 一則都刪不掉。IG 同理（頁尾也有 More）。
_POST_SCOPES = {
    "threads": ("div[data-pressable-container='true']", "main", ""),
    "ig": ("article", "div[role='dialog']", "main", ""),
}


def _find_more_button(page, platform: str):
    """貼文右上角的「⋯」：**先在貼文容器裡找**，找不到才放寬到整頁。

    svg 本身不可點，要點它外層的按鈕；沒有外層按鈕時才退回點 svg。
    """
    labels = _MORE_LABELS.get(platform, [])
    for scope in _POST_SCOPES.get(platform, ("",)):
        prefix = f"{scope} " if scope else ""
        for lab in labels:
            for sel in (f'{prefix}svg[aria-label="{lab}"]', f'{prefix}[aria-label="{lab}"]'):
                with contextlib.suppress(Exception):
                    loc = page.locator(sel)
                    n = min(loc.count(), 8)
                    for i in range(n):
                        el = loc.nth(i)
                        if not el.is_visible():
                            continue
                        with contextlib.suppress(Exception):
                            btn = el.locator(
                                "xpath=ancestor-or-self::*[@role='button'][1]").first
                            if btn.count() > 0 and btn.is_visible():
                                return btn
                        return el
    return _find_by_texts(page, labels, roles=("button",))


def _deleted_ok(page, url: str) -> bool:
    """真的刪掉了嗎？先看有沒有「已刪除」提示，沒有就重開這則看是不是變成找不到。

    不能只憑「按了確認」就算成功——按鈕點空了、對話框卡住都不會報錯，
    數字灌水比少刪一則糟糕得多。
    """
    for _ in range(8):
        body = _body_text(page)
        if any(k in body for k in _DELETED_MARKS):
            return True
        human_sleep(0.8, 1.4)
    with contextlib.suppress(Exception):
        page.goto(url, wait_until="commit", timeout=45000)
        human_sleep(2.0, 3.5)
        body = _body_text(page)
        return any(k.lower() in body.lower() for k in _GONE_MARKS)
    return False


def _delete_one(page, platform: str, url: str) -> bool:
    """在已開啟的貼文頁上：⋯ → 刪除 → 確認 → 驗證。任何一步找不到就放棄這則。"""
    more = _find_more_button(page, platform)
    if more is None:
        print("[cleanup] ⚠ 找不到「更多」按鈕，跳過這則", flush=True)
        return False
    more.click()
    human_sleep(1.0, 2.0)

    item = _find_by_texts(page, _DELETE_TEXTS)
    if item is None:
        with contextlib.suppress(Exception):
            page.keyboard.press("Escape")
        print("[cleanup] ⚠ 選單裡找不到「刪除」，跳過這則", flush=True)
        return False
    item.click()
    human_sleep(1.0, 2.0)

    # 確認框：優先在 dialog 裡找，避免點到頁面上其他同名文字
    confirm = None
    for t in _CONFIRM_TEXTS:
        with contextlib.suppress(Exception):
            loc = page.locator(f'div[role="dialog"] [role="button"]:has-text("{t}")').first
            if loc.count() > 0 and loc.is_visible():
                confirm = loc
                break
    confirm = confirm or _find_by_texts(page, _CONFIRM_TEXTS, roles=("button",))
    if confirm is None:
        with contextlib.suppress(Exception):
            page.keyboard.press("Escape")
        print("[cleanup] ⚠ 確認框沒有「刪除」按鈕，跳過這則", flush=True)
        return False
    confirm.click()
    human_sleep(1.5, 3.0)
    return _deleted_ok(page, url)


def do_cleanup(profile_dir: Path, platform: str, older_than: int, max_delete: int,
               headless: bool, dry_run: bool = False, only: dict | None = None) -> dict:
    from playwright.sync_api import sync_playwright

    home = THREADS_URL if platform == "threads" else IG_URL
    pw = sync_playwright().start()
    ctx, page = _launch(pw, profile_dir, headless=headless)
    posts: list[dict] = []
    blocked, reason, pinned_skipped = False, "", 0
    try:
        page.goto(home, wait_until="commit", timeout=60000)
        human_sleep(3.0, 5.0)
        _dismiss_popups(page)
        if not _logged_in(page):
            raise RuntimeError(f"尚未登入 {platform}——先到帳號設定連結一次")
        me = _my_handle(page, platform)
        if not me:
            raise RuntimeError("找不到自己的帳號名，無法確認要掃誰的個人頁")

        profile = (THREADS_PROFILE_URL if platform == "threads" else IG_PROFILE_URL).format(user=me)
        page.goto(profile, wait_until="commit", timeout=60000)
        human_sleep(3.0, 5.0)
        _dismiss_popups(page)
        reason = _page_blocked(page)
        if reason:
            _debug_shot(page, f"cleanup_{platform}_blocked_profile")
            print("[cleanup] ⚠ 一進個人頁就偵測到限制，這輪不刪任何東西", flush=True)
            return {"posts": [], "blocked": True, "block_reason": reason, "skipped_pinned": 0}

        # 要刪的是最舊的那批，得先滑到夠深才看得到
        want = max_delete * 3 + SCAN_SLACK
        links, pinned = _collect_while_scrolling(page, platform, me, want,
                                                 rounds=min(40, max_delete * 3 + 10))
        pinned_skipped = len([h for h in links if h in pinned])
        links = [h for h in links if h not in pinned]
        print(f"[cleanup] @{me} 個人頁掃到 {len(links)} 則自己的貼文"
              f"{f'（另 {pinned_skipped} 則置頂不動）' if pinned_skipped else ''}", flush=True)

        deleted = 0
        for href in links:
            if deleted >= max_delete:
                print(f"[cleanup] 已達本輪上限 {max_delete} 則，其餘下一輪再刪", flush=True)
                break
            url = post_url(platform, href)
            with contextlib.suppress(Exception):
                page.goto(url, wait_until="commit", timeout=45000)
            human_sleep(2.0, 4.0)
            if _page_blocked(page):
                blocked, reason = True, _page_blocked(page) or ACTION_BLOCKED
                _debug_shot(page, f"cleanup_{platform}_blocked")
                print("[cleanup] ⚠ 偵測到動作被限制，立即中止整輪", flush=True)
                break

            age = _post_age_days(page)
            if age is None:
                posts.append({"url": url, "age_days": None, "status": "undated"})
                print(f"[cleanup] 日期讀不到，留著：{url}", flush=True)
                continue
            if not should_delete(age, older_than):
                posts.append({"url": url, "age_days": age, "status": "recent"})
                continue
            if before_moyu(age, only):
                posts.append({"url": url, "age_days": age, "status": "before_moyu"})
                continue
            if only is not None:
                # 要判斷「是不是摸魚發的」就得看內文，所以這裡一定要開貼文頁（dry-run 也要）
                with contextlib.suppress(Exception):
                    page.goto(url, wait_until="domcontentloaded", timeout=45000)
                    human_sleep(2.0, 3.5)
                if not is_ours(url, _body_text(page), only):
                    posts.append({"url": url, "age_days": age, "status": "not_ours"})
                    print(f"[cleanup] 不是摸魚發的，留著：{url}", flush=True)
                    continue
            if dry_run:
                # 清單留給 main 一次列完（依天數排序比較好看），這裡只留個進度
                posts.append({"url": url, "age_days": age, "status": "dry_run"})
                deleted += 1
                continue

            ok = False
            try:
                ok = _delete_one(page, platform, url)
            except Exception as e:
                print(f"[cleanup] 刪除例外：{e}", flush=True)
            if _page_blocked(page):
                posts.append({"url": url, "age_days": age, "status": "failed"})
                blocked, reason = True, _page_blocked(page) or ACTION_BLOCKED
                _debug_shot(page, f"cleanup_{platform}_blocked_delete")
                print("[cleanup] ⚠ 刪除後偵測到限制，立即中止整輪", flush=True)
                break
            posts.append({"url": url, "age_days": age, "status": "deleted" if ok else "failed"})
            if ok:
                deleted += 1
                print(f"[cleanup] 已刪除 {url}（{age} 天前，{deleted}/{max_delete}）", flush=True)
                if deleted < max_delete:
                    human_sleep(*DELETE_GAP)     # 連續刪最像腳本，一定要拉開
        return {"posts": posts, "blocked": blocked, "block_reason": reason,
                "skipped_pinned": pinned_skipped}
    except Exception as e:
        e.reason = classify_failure(page_text=_body_text(page), error_text=str(e))
        # 已刪的不能白刪——附在例外上讓上層照樣記錄
        e.partial = {"posts": posts, "blocked": blocked, "block_reason": reason,
                     "skipped_pinned": pinned_skipped}
        raise
    finally:
        for close in (ctx.close, pw.stop):
            with contextlib.suppress(Exception):
                close()


def main():
    global _JSON_PATH, _RESULT
    ap = argparse.ArgumentParser(description="Threads / IG 備份模式自動刪文（SPEC-P32 §2）")
    ap.add_argument("--platform", choices=("threads", "ig"), required=True)
    ap.add_argument("--older-than", type=int, default=DEFAULT_OLDER_THAN,
                    help=f"刪超過幾天的貼文（預設 {DEFAULT_OLDER_THAN}，最少 {MIN_OLDER_THAN}）")
    ap.add_argument("--max", type=int, default=DEFAULT_MAX,
                    help=f"這輪最多刪幾則（硬上限 {HARD_CAP}）")
    ap.add_argument("--profile-dir", default=str(DEFAULT_PROFILE))
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="只列出會刪哪些，不刪任何東西")
    ap.add_argument("--force-recent", action="store_true",
                    help="允許 --older-than 小於下限（含 0＝連今天的都算）；只給手動、搭配 --only-file 用")
    ap.add_argument("--only-file", default="",
                    help="白名單 JSON：只刪對得上的貼文（摸魚自己發的）")
    ap.add_argument("--result-json")
    args = ap.parse_args()

    older_than = effective_older_than(args.older_than, force_recent=args.force_recent)
    max_delete = effective_max(args.max)

    _JSON_PATH = args.result_json
    _RESULT = {"success": False, "platform": args.platform,
               "older_than": older_than, "max": max_delete, "dry_run": bool(args.dry_run),
               "deleted": 0, "skipped_undated": 0, "skipped_recent": 0, "skipped_pinned": 0,
               "blocked": False, "block_reason": "", "error": "未完成", "posts": []}
    if _JSON_PATH:
        atexit.register(_write)

    # 夾住要講明白，不然客戶以為設定 3 天就真的 3 天
    if args.older_than and args.older_than < MIN_OLDER_THAN:
        print(f"[cleanup] --older-than {args.older_than} 太小，已提高到最少 {MIN_OLDER_THAN} 天",
              flush=True)
    if args.max and args.max > HARD_CAP:
        print(f"[cleanup] --max {args.max} 超過硬上限，已夾到 {HARD_CAP} 則", flush=True)

    def _fill(r: dict):
        _RESULT["posts"] = r.get("posts", []) or []
        _RESULT["blocked"] = bool(r.get("blocked"))
        _RESULT["block_reason"] = r.get("block_reason", "") or ""
        _RESULT["skipped_pinned"] = int(r.get("skipped_pinned") or 0)
        _RESULT.update(summarize(_RESULT["posts"]))

    try:
        r = do_cleanup(Path(args.profile_dir).expanduser(), args.platform,
                       older_than, max_delete, args.headless, dry_run=args.dry_run,
                       only=load_only(args.only_file))
        _fill(r)
        if _RESULT["blocked"]:
            _RESULT["error"] = f"動作被限制，已中止（已刪 {_RESULT['deleted']} 則）"
            sys.exit(1)
        _RESULT["success"] = True
        _RESULT["error"] = ""
        if args.dry_run:
            # 這份清單是老闆真的動手前唯一的依據：網址 + 幾天前，最舊的排前面
            cands = sorted((p for p in _RESULT["posts"] if p.get("status") == "dry_run"),
                           key=lambda p: -(p.get("age_days") or 0))
            for p in cands:
                print(f"[cleanup] dry-run 會刪：{p['url']}（{p['age_days']} 天前）", flush=True)
            for p in (p for p in _RESULT["posts"] if p.get("status") == "undated"):
                print(f"[cleanup] dry-run 日期讀不到，會留著：{p['url']}", flush=True)
        print("[cleanup] ✅ " + describe(_RESULT), flush=True)
    except SystemExit:
        raise
    except Exception as e:
        _fill(getattr(e, "partial", {}) or {})
        _RESULT["error"] = str(e)
        reason = getattr(e, "reason", None) or classify_failure(error_text=str(e))
        if reason in _STOP_REASONS:
            _RESULT["blocked"] = True
            _RESULT["block_reason"] = reason
        sys.exit(1)


if __name__ == "__main__":
    main()
