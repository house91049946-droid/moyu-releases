  "tests/test_fb_cleanup.py::TestJS的兩個地雷::test_每一行的引號都成對[(arg) => {\\n    const sel = \"a[href*='/posts/'], a[href*='permalink.php'], a[href*='story.php']\";\\n    const out = [];\\n    const pin = new RegExp(arg.pin);\\n    for (const a of document.querySelectorAll(sel)) {\\n        const href = a.href || '';\\n        if (!href) continue;\\n        let card = a;\\n        for (let i = 0; i < 12 && card.parentElement; i++) {\\n            card = card.parentElement;\\n            if (card.getAttribute && card.getAttribute('role') === 'article') break;\\n            if ((card.innerText || '').trim().length > 60) break;\\n        }\\n        // \\u4e0d\\u8981\\u7528\\u300c\\u4e00\\u5f35\\u5361\\u53ea\\u6536\\u4e00\\u6b21\\u300d\\u53bb\\u780d\\u91cd\\u8907\\uff1a\\u5f80\\u4e0a\\u722c\\u6709\\u6642\\u6703\\u505c\\u5728\\u5305\\u4f4f\\u597d\\u5e7e\\u5247\\u8cbc\\u6587\\u7684\\u5bb9\\u5668\\uff0c\\n        // \\u90a3\\u6a23\\u4e00\\u6574\\u6279\\u8cbc\\u6587\\u6703\\u88ab\\u6298\\u6210\\u4e00\\u5247\\uff082026-09-03 \\u5be6\\u6e2c\\uff1a9 \\u500b\\u9023\\u7d50\\u53ea\\u5269 1 \\u5247\\uff09\\u3002\\n        // \\u91cd\\u8907\\u4ea4\\u7d66 cards_to_posts \\u7528\\u8cbc\\u6587 key \\u53bb\\u9664\\uff0c\\u90a3\\u500b\\u5224\\u6e96\\u624d\\u662f\\u5c0d\\u7684\\u3002\\n        if (!card) continue;\\n        const head = (card.innerText || '').trim().slice(0, 160);\\n        const stamp = (a.innerText || a.getAttribute('aria-label') || '').trim();\\n        const marked = card.querySelector(\"[aria-label*='\\u7f6e\\u9802'], [aria-label*='Pinned']\");\\n        out.push({href: href, stamp: stamp, head: head, pinned: pin.test(head) || !!marked});\\n    }\\n    return out;\\n}]",
  "tests/test_fb_cleanup.py::TestJS的兩個地雷::test_每一行的引號都成對[(arg) => {\\n    const sel = \"a[href*='/posts/'], a[href*='permalink.php'], a[href*='story.php']\";\\n    const seen = new Set();\\n    const out = [];\\n    const pin = new RegExp(arg.pin);\\n    for (const a of document.querySelectorAll(sel)) {\\n        const href = a.href || '';\\n        if (!href) continue;\\n        let card = a;\\n        for (let i = 0; i < 12 && card.parentElement; i++) {\\n            card = card.parentElement;\\n            if (card.getAttribute && card.getAttribute('role') === 'article') break;\\n            if ((card.innerText || '').trim().length > 60) break;\\n        }\\n        if (!card || seen.has(card)) continue;\\n        seen.add(card);\\n        const head = (card.innerText || '').trim().slice(0, 160);\\n        const stamp = (a.innerText || a.getAttribute('aria-label') || '').trim();\\n        const marked = card.querySelector(\"[aria-label*='\\u7f6e\\u9802'], [aria-label*='Pinned']\");\\n        out.push({href: href, stamp: stamp, head: head, pinned: pin.test(head) || !!marked});\\n    }\\n    return out;\\n}]",
