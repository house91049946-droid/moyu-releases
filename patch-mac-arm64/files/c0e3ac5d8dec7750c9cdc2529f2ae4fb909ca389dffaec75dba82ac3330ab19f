"""FB 通知 → 社團審核結果（老闆 2026-09-14）"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.notice_parse import parse_notice  # noqa: E402


def test_declined_and_approved():
    d = parse_notice("管理員拒絕了你在台中不動產(中古新房20年內)專區發佈的貼文。查看意見回饋。 56分鐘",
                     "https://www.facebook.com/groups/241315693117084/my_declined_content/?h=1")
    assert d == {"kind": "declined", "group_name": "台中不動產(中古新房20年內)專區", "group_id": "241315693117084"}
    a = parse_notice("未讀 一位管理員批准了你在大台中租房、租商辦、租土地發佈的貼文。 59分鐘",
                     "https://www.facebook.com/groups/1668054373486894/posts/416066817755882")
    assert a["kind"] == "approved" and a["group_name"] == "大台中租房、租商辦、租土地" and a["group_id"] == "1668054373486894"
    assert parse_notice("歡迎加入房地產買賣交流社團。你現在可以發佈貼文", "https://www.facebook.com/groups/1/") is None
    assert parse_notice("", "") is None
