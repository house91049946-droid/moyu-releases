class TestCheck參數:
    def test_check_未登入也是exit0且留下結果(self, tmp_path, monkeypatch):
        """--check 探測到未登入是正常結果：exit 0、logged_in=false。"""
        out = tmp_path / "r.json"
        code = (
            "import sys, types; sys.argv=['x','--check','--result-json',r'%s',"
            "'--profile-dir',r'%s'];\n"
            "import src.run_threads_post as m\n"
            "m.do_check=lambda p,headless=True:{'logged_in':False,'username':''}\n"
            "try: m.main()\n"
            "except SystemExit as e: sys.exit(e.code)\n"
        ) % (out, tmp_path / "prof")
        r = subprocess.run([sys.executable, "-c", code], cwd=ROOT,
                           capture_output=True, text=True)
        assert r.returncode == 0, r.stderr
        data = json.loads(out.read_text())
        assert data["success"] is True
        assert data["data"] == {"logged_in": False, "username": ""}


class Test開啟登入視窗:
    def test_open旗標走do_open且有時限上限(self, tmp_path):
        """--open 不發文；分鐘數會被夾在 1～180。"""
        import json, subprocess, sys
        out = tmp_path / "r.json"
        code = (
            "import sys; sys.argv=['x','--open','--open-minutes','999','--result-json',r'%s']\n"
            "import src.run_threads_post as m\n"
            "seen={}\n"
            "def fake(p,url,mins,label='Threads'):\n"
            "    seen.update(url=url,mins=mins); return {'opened':True,'closed_by_user':True,'minutes':1.0}\n"
            "m.do_open=fake\n"
            "try: m.main()\n"
            "except SystemExit as e:\n"
            "    assert e.code==0, e.code\n"
            "assert seen['mins']==180 and 'threads' in seen['url'], seen\n"
        ) % out
        r = subprocess.run([sys.executable, "-c", code], cwd=ROOT, capture_output=True, text=True)
        assert r.returncode == 0, r.stderr
        d = json.loads(out.read_text())
        assert d["success"] is True and d["data"]["opened"] is True
