"""Threads 發文 CLI 的離線測試（純函式＋失敗路徑，不開瀏覽器不連網）。

執行：cd FB_Auto && python3 -m pytest tests/test_threads_post.py -v
真發文的實測要有登入態，用 --login 登入後手動跑一次 CLI 驗收。
"""
import json
import subprocess
import sys
import tempfile
from pathlib import Path

import pytest

pytest.importorskip("playwright")
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.run_threads_post import clip_text, parse_images  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]


class Test文字裁切:
    def test_短文原樣(self):
        assert clip_text("三房兩廳好宅") == ("三房兩廳好宅", False)

    def test_超過上限截斷並標記(self):
        text, truncated = clip_text("哈" * 600)
        assert truncated is True
        assert len(text) <= 500

    def test_盡量截在句尾(self):
        text = ("第一句話。" * 90) + "然後這是一段沒有標點的長尾巴" * 10
        cut, truncated = clip_text(text)
        assert truncated is True
        assert cut.endswith("。")

    def test_空字串(self):
        assert clip_text("") == ("", False)
        assert clip_text("  \n ") == ("", False)


class Test圖片參數:
    def test_空字串回空清單(self):
        assert parse_images("") == []

    def test_不存在的圖整批報錯(self):
        with pytest.raises(FileNotFoundError):
            parse_images("/tmp/絕對不存在的圖_9x8y7.jpg")

    def test_存在的圖回路徑並裁到十張(self, tmp_path):
        files = []
        for i in range(12):
            f = tmp_path / f"img{i}.jpg"
            f.write_bytes(b"fake")
            files.append(str(f))
        got = parse_images(",".join(files))
        assert len(got) == 10


class TestCLI失敗路徑:
    def _run(self, *args):
        out = Path(tempfile.mkdtemp()) / "r.json"
        proc = subprocess.run(
            [sys.executable, "-m", "src.run_threads_post", *args, "--result-json", str(out)],
            cwd=ROOT, capture_output=True, text=True, timeout=60,
        )
        return proc, json.loads(out.read_text(encoding="utf-8")) if out.exists() else None

    def test_沒有文字就報錯並寫結果檔(self):
        proc, r = self._run("--text", "")
        assert proc.returncode == 1
        assert r["success"] is False
        assert "沒有 --text" in r["error"]

    def test_圖片不存在就報錯不發(self):
        proc, r = self._run("--text", "測試", "--images", "/tmp/不存在_zz.jpg")
        assert proc.returncode == 1
        assert "找不到圖片" in r["error"]


