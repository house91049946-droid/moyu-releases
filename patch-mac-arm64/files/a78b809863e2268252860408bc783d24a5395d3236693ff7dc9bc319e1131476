class Test處理流程:
    """用假的 join_one 走 process_groups，不開瀏覽器。"""

    @pytest.fixture(autouse=True)
    def _no_sleep(self, monkeypatch):
        monkeypatch.setattr(gj, "human_sleep", lambda *a, **k: None)

    def _targets(self, n):
        return [{"key": str(i), "name": f"社團{i}", "url": f"https://www.facebook.com/groups/{i}/"}
                for i in range(n)]

    def test_做滿額度就停(self):
        calls = []

        def fake(page, fbid, t, dry_run):
            calls.append(t["key"])
            return "joined", t["name"], ""

        r = gj.process_groups(None, "1", self._targets(10), 2, False, join_one=fake, gap=(0, 0))
        assert len(calls) == 2 and gj.summarize(r["groups"])["joined"] == 2
        assert r["blocked"] is False

    def test_已是成員不算額度(self):
        seq = iter([("existing", "甲", ""), ("joined", "乙", ""), ("requested", "丙", "")])

        def fake(page, fbid, t, dry_run):
            return next(seq)

        r = gj.process_groups(None, "1", self._targets(3), 2, False, join_one=fake, gap=(0, 0))
        assert gj.summarize(r["groups"]) == {"joined": 1, "requested": 1, "question": 0,
                                             "existing": 1, "failed": 0, "dry_run": 0}

    def test_有入社問題記question且算額度(self):
        """§3.1：答錯比不答糟——一律跳過不答，但這次動作照樣算額度。"""
        seq = iter([("question", "甲", "社團要求回答入社問題，已跳過不答"), ("joined", "乙", "")])
        calls = []

        def fake(page, fbid, t, dry_run):
            calls.append(t["key"])
            return next(seq)

        r = gj.process_groups(None, "1", self._targets(5), 2, False, join_one=fake, gap=(0, 0))
        assert len(calls) == 2
        s = gj.summarize(r["groups"])
        assert s["question"] == 1 and s["joined"] == 1
        assert r["groups"][0]["reason"].startswith("社團要求回答入社問題")
        # 後端 record_joins 落庫讀的是 note，UI 靠它顯示「請自己去答」
        assert r["groups"][0]["note"] == r["groups"][0]["reason"]

    def test_被擋立刻停但保留已做的(self):
        seq = iter([("joined", "甲", ""), ("blocked", "", ACTION_BLOCKED), ("joined", "丙", "")])
        calls = []

        def fake(page, fbid, t, dry_run):
            calls.append(t["key"])
            return next(seq)

        r = gj.process_groups(None, "1", self._targets(3), 3, False, join_one=fake, gap=(0, 0))
        assert r["blocked"] is True and r["block_reason"] == ACTION_BLOCKED
        assert len(calls) == 2                                  # 第三個沒碰
        assert gj.summarize(r["groups"])["joined"] == 1          # 已加入的保留
        assert r["groups"][-1]["status"] == "failed"             # 被擋那筆不算加入成功

    def test_例外當失敗不整批炸掉(self):
        def fake(page, fbid, t, dry_run):
            raise RuntimeError("版面改了")

        r = gj.process_groups(None, "1", self._targets(2), 2, False, join_one=fake, gap=(0, 0))
        assert gj.summarize(r["groups"])["failed"] == 2 and r["blocked"] is False

    def test_dry_run不點任何東西(self):
        def fake(page, fbid, t, dry_run):
            assert dry_run is True
            return "dry_run", t["name"], ""

        r = gj.process_groups(None, "1", self._targets(5), 2, True, join_one=fake, gap=(0, 0))
        assert gj.summarize(r["groups"])["dry_run"] == 2

    def test_真的dry_run不開頁面(self):
        """`_join_one` 在 dry-run 下必須直接回傳，連 page 都不能碰（傳 None 進去驗證）。"""
        assert gj._join_one(None, "1", {"url": "u", "name": "甲"}, True) == ("dry_run", "甲", "")


