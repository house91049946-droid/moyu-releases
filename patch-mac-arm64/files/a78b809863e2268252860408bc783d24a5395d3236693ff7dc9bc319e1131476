class Test實作陷阱:
    def test_JS片段不得含真換行(self):
        """踩過兩次的坑：Python 字串裡寫 \\n，JS 收到真換行 → 整段語法錯誤、默默回空。"""
        for mod in (gs, gj):
            for line in inspect.getsource(mod).splitlines():
                if not any(t in line for t in ("querySelector", "innerText", "document.")):
                    continue
                assert "\\n" not in line, line
                if "split(" in line:
                    assert "fromCharCode" in line, line


