class Test去重與排序:
    def test_同社團兩筆合併互補(self):
        """同一張卡我們從按鈕與連結各往上走一次，資訊會落在不同層——要補不要丟。"""
        raw = [{"url": "https://www.facebook.com/groups/1/", "name": "甲社團", "members": 0, "privacy": ""},
               {"url": "https://www.facebook.com/groups/1/", "name": "甲社團（台中）", "members": 900, "privacy": "公開"},
               {"url": "https://www.facebook.com/groups/2/", "name": "乙社團", "members": 5, "privacy": "私密"}]
        out = gs.dedupe_groups(raw)
        assert len(out) == 2
        assert out[0]["members"] == 900 and out[0]["privacy"] == "公開" and out[0]["name"] == "甲社團（台中）"

    def test_人數多的排前面(self):
        """老闆硬規則：人數多的優先。"""
        raw = [{"members": 100}, {"members": 23000}, {"members": 0}, {"members": 900}]
        assert [g["members"] for g in gs.sort_by_members(raw)] == [23000, 900, 100, 0]

    def test_同人數保持原順序(self):
        raw = [{"members": 5, "name": "先"}, {"members": 5, "name": "後"}]
        assert [g["name"] for g in gs.sort_by_members(raw)] == ["先", "後"]

    def test_沒有members欄位當零(self):
        assert gs.sort_by_members([{"name": "x"}, {"members": 3, "name": "y"}])[0]["name"] == "y"


