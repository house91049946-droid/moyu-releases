@dataclass
class LoginJob:
    """一次 first-login 子進程的追蹤資訊（單帳號情境下同時最多一個）。"""
    account_id: int
    proc: subprocess.Popen
    result_path: str
    log_path: str
    started_at: float


_LOGIN_JOBS: dict[int, LoginJob] = {}


def start_first_login(
    account_id: int,
    email: str,
    password: str,
    headless: bool = False,
    skip_groups: bool = False,
) -> LoginJob:
    """spawn 登入子進程並記住其 result JSON 路徑，供 poll_first_login 回收。
    工作進行中重複呼叫會拋 RuntimeError。"""
    job = _LOGIN_JOBS.get(account_id)
    if job and job.proc.poll() is None:
        raise RuntimeError("login already in progress")

    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    LOGIN_LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = str(LOGIN_LOG_DIR / f"login_{account_id}_{int(time.time())}.log")

    cli_args = ["--email", email, "--password", password]
    if headless:
        cli_args.append("--headless")
    if skip_groups:
        # 只是重新登入拿新 cookie：別再跑暖身瀏覽＋抓社團＋慶祝頁那一整套
        cli_args.append("--skip-groups")
    full_args = [sys.executable, "-m", "src.run_login", "--result-json", result_path, *cli_args]

    log_file = open(log_path, "w", encoding="utf-8")
    try:
        proc = subprocess.Popen(
            full_args,
            cwd=str(FB_AUTO_DIR),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            **spawn_kwargs(),
        )
    finally:
        log_file.close()  # 子進程持有自己的 fd，父進程即刻關閉

    job = LoginJob(
        account_id=account_id,
        proc=proc,
        result_path=result_path,
        log_path=log_path,
        started_at=time.time(),
    )
    _LOGIN_JOBS[account_id] = job
    return job


def poll_first_login(account_id: int) -> dict:
    """查詢 first-login 工作狀態，三態：none / pending / success|failed。
    工作結束時讀回 result JSON 並清理（結果落 DB 由呼叫端負責）。"""
    job = _LOGIN_JOBS.get(account_id)
    if job is None:
        return {"state": "none"}

    if job.proc.poll() is None:
        return {"state": "pending", "elapsed_sec": int(time.time() - job.started_at)}

    # 子進程已結束 → 回收結果並移除工作
    del _LOGIN_JOBS[account_id]
    try:
        with open(job.result_path, encoding="utf-8") as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        data = None
    finally:
        with contextlib.suppress(OSError):
            os.unlink(job.result_path)

    if data and data.get("success") and data.get("fbid"):
        d = (data.get("data") or {}) if data.get("schema") == 2 else data
        return {
            "state": "success",
            "fbid": data["fbid"],
            "groups": d.get("groups", []),
            # v2 為 group_id 清單；舊格式 mp_groups 是 URL 清單（呼叫端會再正規化）
            "mp_group_ids": d.get("mp_group_ids", d.get("mp_groups", [])),
            # 快速重登（--skip-groups）沒抓社團：呼叫端絕不能拿空清單去覆蓋既有社團
            "skipped_groups": bool(d.get("skipped_groups")),
        }

    error = (data or {}).get("error", "")
    if not error:
        tail = ""
        with contextlib.suppress(OSError):
            tail = Path(job.log_path).read_text(encoding="utf-8", errors="replace")[-500:]
        error = tail or f"CLI exited {job.proc.returncode}"
    return {"state": "failed", "error": error}


async def run_first_login(
    email: str,
    password: str,
    headless: bool = False,
    timeout_sec: int = 660,
) -> BridgeResult:
    """純登入：用帳密登入 FB，取得 fbid 並儲存 cookie。
    timeout 預設 11 分鐘以配合人工驗證等待。
    
    使用 subprocess.Popen 直接 spawn，確保瀏覽器視窗能正常彈出。"""
    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    cli_args = ["--email", email, "--password", password]
    if headless:
        cli_args.append("--headless")

    full_args = [sys.executable, "-m", "src.run_login", "--result-json", result_path, *cli_args]

    # 用 subprocess.Popen 而非 create_subprocess_exec，確保瀏覽器能正確彈出
    proc = subprocess.Popen(
        full_args,
        cwd=str(FB_AUTO_DIR),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    # 用 run_in_executor 避免阻塞 event loop（不做 await asyncio.to_thread 因為後端須同步等待結果）
    try:
        loop = asyncio.get_running_loop()
        stdout, stderr = await asyncio.wait_for(
            loop.run_in_executor(None, proc.communicate),
            timeout=timeout_sec
        )
    except asyncio.TimeoutError:
        proc.kill()
        proc.wait()
        return BridgeResult(success=False, error=f"timeout after {timeout_sec}s")

    # 讀取 result JSON
    try:
        with open(result_path, encoding="utf-8") as f:
            raw = json.load(f)
        return _result_from_raw(raw)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return BridgeResult(
            success=False,
            error=f"CLI exited {proc.returncode}",
        )
    finally:
        with contextlib.suppress(OSError):
            os.unlink(result_path)


async def run_detect_mp_groups(
    fbid: str,
    headless: bool = True,
    timeout_sec: int = 600,
) -> BridgeResult:
    """檢測哪些已同步社團可以轉發 Marketplace：開瀏覽器進對象頁抓取可轉發清單。
    回傳的 groups 為 [{name, url, group_id}]（v2）；舊 CLI 為名稱字串清單。"""
    if not cookie_exists(fbid):
        return BridgeResult(success=False, error=f"cookie 不存在: {fbid}", needs_relogin=True)

    cli_args = ["--fbid", fbid]
    if headless:
        cli_args.append("--headless")
    return await _run_cli_detached("src.run_detect_mp_groups", cli_args, timeout_sec)


async def run_cookie_login(
    fbid: str,
    headless: bool = False,
    timeout_sec: int = 86400,
    email: str = "",
    password: str = "",
) -> BridgeResult:
    """Cookie 登入：用已儲存的 cookie 直接登入主頁，保持瀏覽器開啟直到使用者手動關閉。
    cookie 失效時用帳密自動登入，版面認不得就留給客戶手動登。timeout 預設 24 小時。"""
    if not cookie_exists(fbid):
        return BridgeResult(success=False, error=f"cookie 不存在: {fbid}", needs_relogin=True)
    cli_args = ["--fbid", fbid, "--keep-open"]
    if email and password:
        cli_args.extend(["--email", email, "--password", password])
    if headless:
        cli_args.append("--headless")
    return await _run_cli("src.run_cookie_login", cli_args, timeout_sec)


async def run_sync_groups(
    fbid: str,
    timeout_sec: int = 600,
) -> BridgeResult:
    """用 cookie 登入後抓取所有社團。Marketplace 檢查延後到發文時。"""
    if not cookie_exists(fbid):
        return BridgeResult(success=False, error=f"cookie 不存在: {fbid}", needs_relogin=True)
    return await _run_cli_detached("src.run_sync_groups", ["--fbid", fbid, "--headless"], timeout_sec)


async def run_cookie_login_bg(fbid: str, email: str = "", password: str = "") -> BridgeResult:
    """Cookie 登入（背景）：spawn 獨立 process，不阻塞。瀏覽器保持開啟。
    帶帳密時，cookie 失效會自動改走帳密登入／手動登入。"""
    if not cookie_exists(fbid):
        return BridgeResult(success=False, error=f"cookie 不存在: {fbid}", needs_relogin=True)

    fd, result_path = tempfile.mkstemp(suffix=".json")
    os.close(fd)

    full_args = [
        sys.executable, "-m", "src.run_cookie_login",
        "--fbid", fbid,
        "--keep-open",
        "--result-json", result_path,
    ]
    if email and password:
        full_args.extend(["--email", email, "--password", password])

    # 用 subprocess.Popen（同步）確保 process 真的被 fork 出去
    subprocess.Popen(
        full_args,
        cwd=str(FB_AUTO_DIR),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    return BridgeResult(success=True, fbid=fbid, error="")


def _apply_log_update(log, result: BridgeResult, screenshot_paths: list[str] | None):
    """把 BridgeResult 套到 RunLog 物件（不 commit）。"""
    import datetime as _dt
    log.status = "needs_manual" if result.needs_manual_action else ("success" if result.success else "failed")
    log.error_message = result.error or ""
    log.output_tail = result.output_tail or ""
    log.result_json = result.data if isinstance(result.data, dict) else {}
    shots = screenshot_paths or (result.data.get("screenshots") if isinstance(result.data, dict) else None)
    if shots:
        log.screenshot_paths = shots
    if log.created_at:
        log.duration_sec = max(0, int((_dt.datetime.utcnow() - log.created_at).total_seconds()))


# ── 同步版（供 start_long_op / poll_long_op 等 sync 呼叫點）──

def create_run_log_sync(task_type: str, fbid: str = "", account_id: int | None = None) -> int:
    from .database import SyncSession, RunLog
    with SyncSession() as session:
        log = RunLog(task_type=task_type, fbid=fbid, account_id=account_id, status="running")
        session.add(log)
        session.commit()
        return log.id


def update_run_log_sync(log_id: int, result: BridgeResult, screenshot_paths: list[str] | None = None):
    from .database import SyncSession, RunLog
    from sqlalchemy import select
    with SyncSession() as session:
        log = session.execute(select(RunLog).where(RunLog.id == log_id)).scalar_one_or_none()
        if log:
            _apply_log_update(log, result, screenshot_paths)
            session.commit()


# ── 非同步版（供 scheduler 等 async 呼叫點）──

async def create_run_log(task_type: str, fbid: str = "", account_id: int | None = None) -> int:
    from .database import async_session_factory, RunLog
    async with async_session_factory() as session:
        log = RunLog(task_type=task_type, fbid=fbid, account_id=account_id, status="running")
        session.add(log)
        await session.commit()
        return log.id


async def update_run_log(log_id: int, result: BridgeResult, screenshot_paths: list[str] | None = None):
    from .database import async_session_factory, RunLog
    from sqlalchemy import select
    async with async_session_factory() as session:
        log = (await session.execute(select(RunLog).where(RunLog.id == log_id))).scalar_one_or_none()
        if log:
            _apply_log_update(log, result, screenshot_paths)
            await session.commit()
