"""補丁更新的下載端（SPEC-P23 §4 步驟 2）。

重點在「不可信的 manifest」：它來自網路，決定要覆蓋哪些會被執行的檔案。
所以雜湊不符、路徑逃逸、超出輕層一律要擋下來，而且擋下來之後不能留半套
staging——留著會在下次啟動被 apply 套成混版。

執行：cd backend && python3 -m pytest tests/test_update_downloader.py -v
"""
import hashlib
import json
import sys
from pathlib import Path

import httpx
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

import app.update_downloader as ud
from app.updater import PENDING_NAME

MANIFEST_URL = "https://example.com/patch-win64/manifest.json"
FILES_BASE = "https://example.com/patch-win64/files"


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


@pytest.fixture
def env(tmp_path, monkeypatch):
    """假的包根 + 假的資料目錄，完全不碰真實環境。"""
    base = tmp_path / "pkg"
    (base / "backend/app").mkdir(parents=True)
    (base / "backend/app/old.py").write_bytes(b"print('old')\n")
    local = {
        "version": "1.0.4",
        "platform": "win64",
        "min_runtime": "3.12.11",
        "deps_hash": "deps-A",
        "files": [{"path": "backend/app/old.py", "sha256": sha(b"print('old')\n"), "size": 13}],
    }
    (base / "manifest.json").write_text(json.dumps(local), encoding="utf-8")

    data = tmp_path / "data"
    data.mkdir()
    monkeypatch.setattr(ud, "DATA_DIR", data)
    monkeypatch.setattr(ud, "STAGING", data / ".update_staging")
    monkeypatch.setattr(ud, "STATE_FILE", data / ".update_download.json")
    monkeypatch.setattr(ud, "package_root", lambda: base)
    monkeypatch.setattr(ud, "_endpoints", lambda _p: (MANIFEST_URL, FILES_BASE))
    return base


def serve(monkeypatch, remote: dict, blobs: dict[str, bytes], status: int = 200,
          sign_with=None, sig_override=None):
    """把 httpx 換成 MockTransport：remote manifest + 內容定址的檔案倉庫。

    sign_with 給私鑰就順便供應 manifest.json.sig（簽的是實際回傳的位元組）。
    """
    body = json.dumps(remote).encode()

    def handler(request: httpx.Request) -> httpx.Response:
        url = str(request.url)
        if url == MANIFEST_URL:
            return httpx.Response(200, content=body,
                                  headers={"content-type": "application/json"})
        if url == MANIFEST_URL + ".sig":
            if sig_override is not None:
                return httpx.Response(200, content=sig_override.encode())
            if sign_with is None:
                return httpx.Response(404)
            import base64
            return httpx.Response(200, content=base64.b64encode(sign_with.sign(body)))
        digest = url.rsplit("/", 1)[-1]
        if digest in blobs:
            return httpx.Response(status, content=blobs[digest])
        return httpx.Response(404)

    monkeypatch.setattr(ud, "_client",
                        lambda _t: httpx.Client(transport=httpx.MockTransport(handler)))


def remote_manifest(files, version="1.0.5", **over):
    m = {"version": version, "platform": "win64", "min_runtime": "3.12.11",
         "deps_hash": "deps-A", "files": files}
    m.update(over)
    return m


def test_patch_staged(env, monkeypatch):
    """正常情況：只抓變動的檔案，驗過雜湊，寫出待套用清單。"""
    new = b"print('new')\n"
    add = b"print('added')\n"
    files = [
        {"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)},
        {"path": "backend/app/added.py", "sha256": sha(add), "size": len(add)},
    ]
    serve(monkeypatch, remote_manifest(files), {sha(new): new, sha(add): add})

    r = ud.check_and_stage()

    assert r["status"] == "staged", r
    assert r["version"] == "1.0.5"
    assert (ud.STAGING / "backend/app/old.py").read_bytes() == new
    assert (ud.STAGING / "backend/app/added.py").read_bytes() == add
    pending = json.loads((ud.STAGING / PENDING_NAME).read_text(encoding="utf-8"))
    assert pending["version"] == "1.0.5"
    assert {f["path"] for f in pending["files"]} == {"backend/app/old.py", "backend/app/added.py"}
    # 本機檔案在這個階段絕不能被動到——換檔是下次啟動才做的事
    assert (env / "backend/app/old.py").read_bytes() == b"print('old')\n"


def test_unchanged_file_not_downloaded(env, monkeypatch):
    """雜湊相同的檔案不重抓（補丁的意義就在這）。"""
    same = b"print('old')\n"
    new = b"print('new')\n"
    files = [
        {"path": "backend/app/old.py", "sha256": sha(same), "size": len(same)},
        {"path": "backend/app/x.py", "sha256": sha(new), "size": len(new)},
    ]
    # 只提供 x.py 的內容；若它去抓 old.py 就會 404 而失敗
    serve(monkeypatch, remote_manifest(files), {sha(new): new})

    r = ud.check_and_stage()

    assert r["status"] == "staged"
    assert r["files"] == 1
    assert not (ud.STAGING / "backend/app/old.py").exists()


def test_tampered_content_rejected(env, monkeypatch):
    """伺服器給的內容與 manifest 的雜湊不符 → 整批放棄，不留 staging。"""
    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): b"print('evil')\n"})

    r = ud.check_and_stage()

    assert r["status"] == "error"
    assert "雜湊不符" in r["reason"]
    assert not ud.STAGING.exists()


def test_path_traversal_rejected(env, monkeypatch):
    """manifest 想寫到輕層外面（../ 或 python/）→ 擋下，不留 staging。"""
    evil = b"pwned"
    for bad in ("../../evil.py", "python/python.exe", "/etc/passwd"):
        files = [{"path": bad, "sha256": sha(evil), "size": len(evil)}]
        serve(monkeypatch, remote_manifest(files), {sha(evil): evil})

        r = ud.check_and_stage()

        assert r["status"] == "error", bad
        assert not ud.STAGING.exists(), bad
        assert not (env.parent / "evil.py").exists()


