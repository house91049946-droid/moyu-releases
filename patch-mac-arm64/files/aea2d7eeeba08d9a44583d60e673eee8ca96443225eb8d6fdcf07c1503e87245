    serve(monkeypatch, remote_manifest(files), {sha(new): new})

    r = ud.check_and_stage()

    assert r["status"] == "full"
    assert "整包下載" in r["reason"]


def test_same_version_not_restaged(env, monkeypatch):
    """已排好隊的版本不重抓（背景每 6 小時查一次，不能每次都重下載）。"""
    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): new})
    assert ud.check_and_stage()["status"] == "staged"
    mtime = (ud.STAGING / "backend/app/old.py").stat().st_mtime_ns

    serve(monkeypatch, remote_manifest(files), {})      # 這次不提供檔案內容
    r = ud.check_and_stage()

    assert r["status"] == "staged"
    assert (ud.STAGING / "backend/app/old.py").stat().st_mtime_ns == mtime


