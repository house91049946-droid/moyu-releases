def test_fetches_cloud_config_when_endpoints_missing(env, monkeypatch):
    """全新安裝第一次開啟：下發設定還沒抓過，這支要自己去抓，不能直接放棄。

    這支跑在後端啟動之前，而設定平常是後端起來才抓的——不自己抓的話，
    新客戶第一次開啟永遠不會更新（實測時就是這樣：第一次說「已是最新版本」）。
    """
    calls = []
    empty_then_filled = iter([("", ""), (MANIFEST_URL, FILES_BASE)])
    monkeypatch.setattr(ud, "_endpoints", lambda _p: next(empty_then_filled))
    monkeypatch.setattr(ud, "_fetch_cloud_config", lambda: calls.append(1))

    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): new})

    r = ud.check_and_stage()

    assert calls == [1], "應該去抓一次下發設定"
    assert r["status"] == "staged", r


def test_downloaded_patch_is_appliable(env, monkeypatch, tmp_path):
    """下載端與套用端要真的接得上：staging 排好隊 → apply_staged 換檔成功。

    這兩半分別寫在不同時間、跑在不同進程（服務中 vs 啟動前），最容易出現的
    問題就是 pending_update.json 的欄位對不上而整條鏈默默不動。
    """
    from app.updater import apply_staged

    new = b"print('new')\n"
    add = b"print('added')\n"
    files = [
        {"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)},
        {"path": "backend/app/added.py", "sha256": sha(add), "size": len(add)},
    ]
    serve(monkeypatch, remote_manifest(files), {sha(new): new, sha(add): add})
    assert ud.check_and_stage()["status"] == "staged"

    r = apply_staged(env, ud.STAGING, tmp_path / "backup")

    assert r["ok"] and r["error"] is None, r
    assert r["applied"] == 2
    assert (env / "backend/app/old.py").read_bytes() == new
    assert (env / "backend/app/added.py").read_bytes() == add
    assert r["version"] == "1.0.5"


def test_local_manifest_advances_after_apply(env, monkeypatch, tmp_path):
    """套用完本機 manifest 要跟著前進，否則會無限重抓重套同一包。

    這是 mac 實機驗收才發現的：補丁只換輕層檔案，而 manifest.json 列的是輕層、
    自己不在清單裡，所以不會被換到——客戶端就永遠認為自己還是舊版。
    """
    from app.updater import apply_staged

    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): new})
    assert ud.check_and_stage()["status"] == "staged"
    assert apply_staged(env, ud.STAGING, tmp_path / "backup")["ok"]

    assert json.loads((env / "manifest.json").read_text())["version"] == "1.0.5"

    # 再查一次：這回應該是「已是最新」，不能又排一次隊
    import shutil as _sh
    _sh.rmtree(ud.STAGING, ignore_errors=True)
    serve(monkeypatch, remote_manifest(files), {sha(new): new})
    assert ud.check_and_stage()["status"] == "none"


def test_rollback_restores_manifest_too(env, monkeypatch, tmp_path):
    """回滾後本機版本也要退回去，否則會以為自己是新版而不再更新。"""
    from app.updater import apply_staged, rollback

    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): new})
    ud.check_and_stage()
    backup = tmp_path / "backup"
    apply_staged(env, ud.STAGING, backup)

    r = rollback(env, backup)

    assert r["ok"], r
    assert json.loads((env / "manifest.json").read_text())["version"] == "1.0.4"
    assert (env / "backend/app/old.py").read_bytes() == b"print('old')\n"


def test_removed_files_flow_through(env, monkeypatch, tmp_path):
    """新版刪掉的檔案要一路帶到 apply（不然舊模組留著會被 import 到）。"""
    from app.updater import apply_staged

    keep = b"print('keep')\n"
    serve(monkeypatch, remote_manifest(
        [{"path": "backend/app/keep.py", "sha256": sha(keep), "size": len(keep)}]),
        {sha(keep): keep})
    assert ud.check_and_stage()["status"] == "staged"
    pending = json.loads((ud.STAGING / PENDING_NAME).read_text(encoding="utf-8"))
    assert pending["remove"] == ["backend/app/old.py"]

    r = apply_staged(env, ud.STAGING, tmp_path / "backup")

    assert r["ok"] and r["removed"] == 1, r
    assert not (env / "backend/app/old.py").exists()


# ── 簽章（SPEC-P23 §7）──────────────────────────────────
#
# 這裡防的不是「檔案傳壞了」（SHA256 已經涵蓋），而是「manifest 整份是假的」：
# 倉庫被入侵或後台網址被換掉時，攻擊者可以連 manifest 帶檔案一起改，雜湊全對。

@pytest.fixture
def signed(monkeypatch):
    """啟用簽章，回傳廠商私鑰。"""
    import base64
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    import app.update_signing as us

    key = Ed25519PrivateKey.generate()
    raw = key.public_key().public_bytes(
        encoding=serialization.Encoding.Raw, format=serialization.PublicFormat.Raw)
    monkeypatch.setattr(us, "PUBLIC_KEY_B64", base64.b64encode(raw).decode())
    return key


def test_valid_signature_accepted(env, monkeypatch, signed):
    new = b"print('new')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(new), "size": len(new)}]
    serve(monkeypatch, remote_manifest(files), {sha(new): new}, sign_with=signed)

    assert ud.check_and_stage()["status"] == "staged"


def test_forged_manifest_rejected(env, monkeypatch, signed):
    """攻擊者換掉 manifest 並附上自己算好的雜湊 → 沒有廠商私鑰就簽不出來。"""
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    evil = b"import os; os.system('rm -rf /')\n"
    files = [{"path": "backend/app/old.py", "sha256": sha(evil), "size": len(evil)}]
    # 用「別人的」私鑰簽——雜湊完全自洽，只有簽章對不上
    serve(monkeypatch, remote_manifest(files), {sha(evil): evil},
          sign_with=Ed25519PrivateKey.generate())

    r = ud.check_and_stage()

    assert r["status"] == "error"
    assert "簽章驗證失敗" in r["reason"]
    assert not ud.STAGING.exists()
    assert (env / "backend/app/old.py").read_bytes() == b"print('old')\n"


def test_missing_signature_rejected(env, monkeypatch, signed):
    """啟用簽章後，沒有 .sig 就不能更新（否則把簽章拿掉即可繞過）。"""
    new = b"print('new')\n"
