def collect_targets(page, fbid: str, sources: list[str], want: int) -> list[dict]:
    """依來源優先序蒐集，直到夠用為止；同一個人只留優先來源那筆。"""
    found: list[dict] = []
    for src in sources:
        if len(found) >= want:
            break
        try:
            got = _COLLECTORS[src](page, fbid, want - len(found))
        except Exception as e:
            print(f"[friend] 來源 {src} 蒐集失敗（略過）：{str(e)[:120]}", flush=True)
            continue
        print(f"[friend] 來源 {src} 找到 {len(got)} 人", flush=True)
        found = dedupe_targets(found + got)
    return found


def count_pending_requests(page) -> int | None:
    """到「已送出的邀請」數未回應數。數不出來回 None（記一行，不算失敗）。"""
    try:
        page.goto(URL_REQUESTS, wait_until="domcontentloaded", timeout=45000)
        human_sleep(2.0, 3.5)
        # TODO 實測校正：入口文字（「查看已送出的邀請」/ "View sent requests"）。
        opened = False
        for lab in ("查看已送出的邀請", "已送出的邀請", "View sent requests", "Sent requests"):
            with contextlib.suppress(Exception):
                el = page.get_by_text(lab, exact=False).first
                if el.count() > 0 and el.is_visible():
                    el.click(timeout=5000)
                    opened = True
                    break
        if not opened:
            print("[friend] 找不到「已送出的邀請」入口，略過未回應數檢查", flush=True)
            return None
        human_sleep(2.0, 3.5)
        for _ in range(4):                      # 清單是懶載入的，多滑幾下
            with contextlib.suppress(Exception):
                page.mouse.wheel(0, 1200)
            human_sleep(0.8, 1.5)
        labels = page.evaluate(
            "()=>Array.from(document.querySelectorAll(\"div[role='button'],button\"))"
            ".map(b=>(b.getAttribute('aria-label')||b.innerText||'').trim())"
        ) or []
        return count_pending_labels(labels)
    except Exception as e:
        print(f"[friend] 未回應邀請數讀取失敗（略過）：{str(e)[:120]}", flush=True)
        return None


_SKIP_HEADINGS = ("通知", "Notifications", "Facebook", "動態消息", "News Feed")

_OWNER_RE = __import__("re").compile(
    r"^將(?P<zh>.+?)加為朋友$|^Add (?P<en>.+?) as (?:a )?friend$|"
    r"^取消對(?P<zh2>.+?)的邀請$|^Cancel request to (?P<en2>.+?)$")


def owner_from_label(label: str) -> str:
    """從按鈕的 aria-label 反推這顆鈕是誰的：「將陳泊廷加為朋友」→ 陳泊廷。

    比讀頁面標題可靠：2026-09-03 實測，個人頁的第一個 h1 是**通知面板**的「通知」，
    拿它當主角名字，所有按鈕都被過濾掉，變成「找不到加朋友按鈕」。
    """
    m = _OWNER_RE.match((label or "").strip())
    if not m:
        return ""
    return next((v for v in m.groupdict().values() if v), "")


def _profile_name(page) -> str:
    """這一頁是誰的個人檔案。個人頁下方還有「你可能認識的人」，每個人都有一顆
    「將○○加為朋友」——不認人就會驗到別人的按鈕（2026-09-03 實測：按了確實送出，
    卻因為看到隔壁人的「加朋友」而記成失敗）。

    先從主要按鈕的 aria-label 反推（最準），再退回 h1（要跳過通知面板那顆）。
    """
    with contextlib.suppress(Exception):
        main = page.locator("div[role='main']")
        root = main if main.count() > 0 else page
        loc = root.locator("div[role='button'], a[role='button'], button")
        for i in range(min(loc.count(), 40)):
            el = loc.nth(i)
            with contextlib.suppress(Exception):
                if not el.is_visible():
                    continue
                name = owner_from_label(el.get_attribute("aria-label") or "")
                if name:
                    return name
    for sel in ("div[role='main'] h1", "h1"):
        with contextlib.suppress(Exception):
            loc = page.locator(sel)
            for i in range(min(loc.count(), 5)):
                name = (loc.nth(i).inner_text() or "").strip().splitlines()[0]
                if name and name not in _SKIP_HEADINGS:
                    return name[:40]
    return ""


def _find_action_button(page, owner: str = ""):
    """找個人頁上的加朋友鈕，回 (狀態, locator)。狀態見 button_status。

    2026-09-03 mini 實測：這顆鈕的 aria-label 是「將{姓名}加為朋友」——名字夾在中間，
    exact 比對永遠對不上，5 個候選有 2 個被記成「找不到加朋友按鈕」。所以改成：
    先掃頁面上所有按鈕的 aria-label／文字，交給 button_status 判斷（它本來就是「包含」比對），
    再退回原本的 exact 比對。
    """
    # **一定要限定在 div[role=main] 裡**：FB 的通知面板長駐在 DOM 上，裡面全是
    # 「標示為已讀，○○傳送了交友邀請給你」這種按鈕。不限定範圍就會掃到它們，
    # 於是「按了但沒看到已送出邀請」——因為根本沒按到個人頁上的鈕（2026-09-03 實測）。
    with contextlib.suppress(Exception):
        main = page.locator("div[role='main']")
        root = main if main.count() > 0 else page
        loc = root.locator("div[role='button'], a[role='button'], button")
        n = min(loc.count(), 60)
        best = None
        for i in range(n):
            el = loc.nth(i)
            with contextlib.suppress(Exception):
                if not el.is_visible():
                    continue
                lab = (el.get_attribute("aria-label") or el.inner_text() or "").strip()
                if owner and lab and owner not in lab and lab not in ("加朋友", "朋友", "Add friend", "Friends"):
                    continue                    # 是「你可能認識的人」裡別人的鈕，不是主角的
                st = button_status(lab)
                if st == "add":
                    return st, el                      # 可加就直接用，不必再找
                if st in ("pending", "existing") and best is None:
                    best = (st, el)                    # 已送出／已是好友：記著，但繼續找可加的
        if best is not None:
            return best
    for labels, st in ((_PENDING_LABELS, "pending"), (_ADD_LABELS, "add"), (_FRIEND_LABELS, "existing")):
        for lab in labels:
            with contextlib.suppress(Exception):
                cand = page.get_by_role("button", name=lab, exact=True).first
                if cand.count() > 0 and cand.is_visible():
                    return st, cand
    return "", None


def _friend_one(page, fbid: str, target: dict, dry_run: bool,
                like_probability: float) -> tuple[str, bool, str]:
    """對一個人送邀請。回 (status, liked, reason)。

    status：sent / existing / pending / failed / dry_run / blocked
    """
    if dry_run:
        # dry-run 只是「給我看會邀誰」，不必真的開 17 個人的個人頁——
        # 慢，而且留下一堆沒有意義的瀏覽足跡（2026-09-02 實測）。
        return "dry_run", False, ""

    page.goto(target["url"], wait_until="domcontentloaded", timeout=45000)
    human_sleep(2.0, 4.0)

    why = _blocked_reason(page, fbid)
    if why:
        return "blocked", False, why

    owner = _profile_name(page)
    st, btn = _find_action_button(page, owner)
    if st in ("existing", "pending"):
        return st, False, ""                    # 已是好友／已送過，別再點——會變成取消

    _human_browse(page)
    liked = False if dry_run else _maybe_like(page, like_probability)
    if liked:
        human_sleep(1.0, 2.5)

    if btn is None:
        # 逛完再找一次（有些版面要捲到頂才出現）
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, -3000)
        human_sleep(0.6, 1.2)
        st, btn = _find_action_button(page, owner)
        if st in ("existing", "pending"):
            return st, liked, ""
        if btn is None:
            return "failed", liked, "找不到加朋友按鈕（可能對方不開放、或版面改了）"

    if dry_run:
        return "dry_run", liked, ""

    global _CLICKED
    _CLICKED += 1                # 按下去就算一次額度：驗證誤判時也不准多送（備份刪文那課）
    btn.click(timeout=8000)
    human_sleep(1.5, 3.0)
    why = _blocked_reason(page, fbid)
    if why:
        return "blocked", liked, why

    # 按鈕要幾秒才會從「加朋友」變成「取消邀請」，只看一次常常看太早
    for _ in range(6):
        st2, _ = _find_action_button(page, owner)
        if st2 == "pending":
            _human_browse(page, (1, 2))         # 送完再逛一下才離開
            return "sent", liked, ""
        if st2 == "existing":
            return "existing", liked, ""
        human_sleep(1.0, 2.0)
    return "failed", liked, "按了但沒看到「已送出邀請」，不確定有沒有送出"


def process_targets(page, fbid: str, targets: list[dict], max_send: int, dry_run: bool,
                    like_probability: float = LIKE_PROBABILITY,
                    friend_one=_friend_one, gap: tuple[int, int] = GAP) -> dict:
    """逐一處理，直到送滿 max_send。被擋立刻停，已做的照樣回報。

    friend_one／gap 可注入，離線測試用。
    """
    done: list[dict] = []
    blocked, reason = False, ""
    sent = 0
    for i, t in enumerate(targets):
        if sent >= max_send or _CLICKED >= max_send:
            break
        rec = dict(t)
        try:
            st, liked, why = friend_one(page, fbid, t, dry_run, like_probability)
        except Exception as e:
            st, liked, why = "failed", False, str(e)[:120]
        rec.update({"liked": liked, "status": st})
        if why:
            rec["reason"] = why

        if st == "blocked":
            blocked, reason = True, why or ACTION_BLOCKED
            rec["status"] = "failed"
            done.append(rec)
            print(f"[friend] ⚠ 偵測到被擋（{reason}），立即中止整批", flush=True)
            break

        done.append(rec)
        if st in ("sent", "dry_run"):
            sent += 1
            verb = "將送出" if st == "dry_run" else "已送出"
            print(f"[friend] {verb}邀請給 {t.get('name') or t['key']}（{sent}/{max_send}）", flush=True)
        else:
            print(f"[friend] 略過 {t.get('name') or t['key']}：{st}{'，' + why if why else ''}", flush=True)

        if sent < max_send and i < len(targets) - 1:
            human_sleep(*gap)
    return {"targets": done, "blocked": blocked, "block_reason": reason}


def do_friend(fbid: str, sources: list[str], max_send: int, headless: bool, dry_run: bool,
              like_probability: float, pending_limit: int, profile_dir: str | None,
              known: set[str] | None = None) -> dict:
    from src.login import _try_cookie_login
    from src.utils import capture_screenshot, launch_browser

    browser, context, page = launch_browser(fbid=fbid, headless=headless, user_data_dir=profile_dir)
    out = {"targets": [], "blocked": False, "block_reason": "", "pending_over_limit": 0,
           "skipped_known": 0}
    try:
        if not _try_cookie_login(page, context, fbid):
            raise RuntimeError("Cookie 登入失敗，請先用 CLI 登入一次")

        why = _blocked_reason(page, fbid)
        if why:
            out.update(blocked=True, block_reason=why)
            capture_screenshot(page, fbid, "friend_blocked")
            return out

        pending = count_pending_requests(page)
        if pending is None:
            print("[friend] 未回應邀請數：讀不到，照常進行", flush=True)
        else:
            print(f"[friend] 未回應邀請 {pending} 個（上限 {pending_limit}）", flush=True)
        if not should_send(pending, pending_limit):
            out["pending_over_limit"] = pending
            print(f"[friend] 未回應邀請 {pending} 個，今天先不送", flush=True)
            return out

        want = max_send * 3                     # 多找一些：有人會是已好友／已送過
        targets = collect_targets(page, fbid, sources, want)
        targets, out["skipped_known"] = drop_known(targets, known or set())
        print(f"[friend] 候選 {len(targets)} 人（另剔除 {out['skipped_known']} 個邀請過的），"
              f"目標送出 {max_send}", flush=True)
        if dry_run:
            for t in targets[:max_send]:
                print(f"[friend] (dry-run) 會送給 {t.get('name') or t['key']} ← {t['source']} {t['url']}", flush=True)

        r = process_targets(page, fbid, targets, max_send, dry_run, like_probability)
        out.update(r)
        if r["blocked"]:
            with contextlib.suppress(Exception):
                capture_screenshot(page, fbid, "friend_blocked")
        return out
    except Exception as e:
        e.reason = classify_fb_block(page_text=_body_text(page), error_text=str(e))
        e.partial = out                          # 已做的部分不能白做
        raise
    finally:
        with contextlib.suppress(Exception):
            context.close()                      # persistent context：browser 與 context 同物件


def _apply(result: dict, r: dict) -> None:
    result["targets"] = r.get("targets", [])
    result.update(summarize(result["targets"]))
    result["blocked"] = bool(r.get("blocked"))
    result["block_reason"] = r.get("block_reason", "")
    result["pending_over_limit"] = r.get("pending_over_limit", 0) or 0
    result["skipped_known"] = r.get("skipped_known", 0) or 0


def main():
    global _JSON_PATH, _RESULT
    ap = argparse.ArgumentParser(description="FB 自動加好友（送出好友邀請）")
    ap.add_argument("--fbid", required=True)
    ap.add_argument("--max", type=int, default=DEFAULT_MAX, help=f"這輪最多送幾個（硬上限 {HARD_CAP}）")
    ap.add_argument("--sources", default=f"{SOURCE_OWN_POSTS},{SOURCE_PYMK}",
                    help="逗號分隔、依優先序：own_posts,pymk,groups")
    ap.add_argument("--like-probability", type=float, default=LIKE_PROBABILITY)
    ap.add_argument("--pending-limit", type=int, default=PENDING_LIMIT)
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="只蒐集名單、印出會送給誰，不點任何東西")
    ap.add_argument("--result-json")
    ap.add_argument("--profile-dir", default=None, help="瀏覽器設定檔目錄（預設 user_data/<fbid>）")
    ap.add_argument("--exclude-file", default=None,
                    help="JSON 字串陣列：後端已記錄邀請過的 target_key，進頁面前就剔除")
    args = ap.parse_args()

    _JSON_PATH = args.result_json
    _RESULT = {
        "schema": 2, "success": False, "fbid": args.fbid, "platform": PLATFORM,
        "sent": 0, "skipped_existing": 0, "skipped_pending": 0, "failed": 0, "dry_run": 0,
        "skipped_known": 0, "blocked": False, "block_reason": "", "pending_over_limit": 0,
        "error": "未完成", "reason": "", "targets": [],
    }
    if _JSON_PATH:
        atexit.register(_write)

    try:
        sources = parse_sources(args.sources)
    except ValueError as e:
        _RESULT["error"] = str(e)
        sys.exit(1)
    if not sources:
        _RESULT["error"] = "沒有指定對象來源"
        sys.exit(1)

    like_p = min(1.0, max(0.0, args.like_probability))
    try:
        r = do_friend(args.fbid, sources, effective_limit(args.max), args.headless, args.dry_run,
                      like_p, args.pending_limit, args.profile_dir,
                      known=load_exclude_keys(args.exclude_file))
        _apply(_RESULT, r)
        _RESULT["success"] = True
        _RESULT["error"] = ""
        if _RESULT["blocked"]:
            _RESULT["reason"] = _RESULT["block_reason"]
            print(f"[friend] ⚠ 中斷：{_RESULT['block_reason']}（已送出 {_RESULT['sent']} 個）", flush=True)
        elif _RESULT["pending_over_limit"]:
            print(f"[friend] 未回應邀請 {_RESULT['pending_over_limit']} 個，今天先不送", flush=True)
        else:
            print(f"[friend] ✅ 送出 {_RESULT['sent']} 個好友邀請，略過 {_RESULT['skipped_existing']} 個已是好友、"
                  f"{_RESULT['skipped_pending']} 個已送過", flush=True)
    except KeyboardInterrupt:
        _RESULT["error"] = "使用者中斷"
        sys.exit(0)
    except Exception as e:
        _RESULT["error"] = str(e)
        _apply(_RESULT, getattr(e, "partial", {}) or {})
        _RESULT["reason"] = getattr(e, "reason", None) or classify_fb_block(error_text=str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
