# 名稱看起來就不是人：粉專的「N 位追蹤者」、「N 人說讚」這種統計字串。
_COUNT_NAME_RE = re.compile(r"^[\d,.]+\s*(位追蹤者|人追蹤|位粉絲|人說讚|位朋友|followers?|likes?)", re.I)
# 留言區的時間戳也是連結（「1天」「3 小時」「2週」），名字絕不會長這樣。
_TIME_NAME_RE = re.compile(r"^\d+\s*(秒|分鐘|小時|天|週|周|個月|年|[smhdwy])$", re.I)


def looks_like_person(name: str) -> bool:
    """粗篩：統計數字、空白名稱都不是人。留在收集階段擋掉，省得白開一次個人頁。"""
    n = (name or "").strip()
    return bool(n) and not _COUNT_NAME_RE.match(n) and not _TIME_NAME_RE.match(n)


# ---------------------------------------------------------------- 純函式（可離線測）

def _write():
    """atexit：不管怎麼結束都要把結果寫出去（例外時保留已做的部分）。"""
    if _JSON_PATH and _RESULT is not None:
        # 後端 bridge 的 `_result_from_raw` 只讀 raw["data"]（envelope v2），
        # 平面欄位是 SPEC-P31 §4 的契約——兩邊都給，各取所需。
        _RESULT["data"] = {k: v for k, v in _RESULT.items() if k != "data"}
        with open(_JSON_PATH, "w", encoding="utf-8") as f:
            json.dump(_RESULT, f, ensure_ascii=False, indent=2)
    if _RESULT is not None and not _RESULT.get("success"):
        print("[friend] 失敗：" + str(_RESULT.get("error") or "未知原因"), flush=True)


def effective_limit(requested: int | None) -> int:
    """把設定值夾到合理範圍。上限是硬的——這種動作不該讓人隨手調到 100。"""
    n = DEFAULT_MAX if not requested or requested <= 0 else requested
    return max(1, min(HARD_CAP, n))


def parse_sources(arg: str) -> list[str]:
    """逗號分隔 → 去空白、去重、保留順序（順序＝優先序）。名字打錯直接報錯，不猜。"""
    out: list[str] = []
    for raw in (arg or "").split(","):
        s = raw.strip().lower()
        if not s:
            continue
        if s not in SOURCES:
            raise ValueError(f"不認識的來源「{s}」，可用：{','.join(SOURCES)}")
        if s not in out:
            out.append(s)
    return out


def target_key_from_url(url: str) -> str:
    """從個人檔案網址取唯一鍵：有數字 id 就用 id，否則用帳號代稱。

    - profile.php?id=100012345            → "100012345"
    - /people/王小明/100012345/           → "100012345"
    - /john.doe?comment_id=…              → "john.doe"
    - /groups/…、/photo/…、/friends/… 等  → ""（不是個人）
    """
    if not url:
        return ""
    u = urlparse(url.strip())
    path = u.path or ""
    qs = parse_qs(u.query or "")

    if path.rstrip("/").endswith("profile.php"):
        pid = (qs.get("id") or [""])[0]
        return pid if pid.isdigit() else ""

    segs = [s for s in path.split("/") if s]
    if not segs:
        return ""
    if segs[0] == "people":
        # /people/<顯示名>/<數字 id>/
        for s in segs[1:]:
            if s.isdigit():
                return s
        return ""
    head = segs[0]
    if head in _NOT_PROFILE or not re.fullmatch(r"[A-Za-z0-9.\-_]+", head):
        return ""
    if head.isdigit():
        return head
    return head


def profile_url_for_key(key: str) -> str:
    """鍵 → 可直接開的個人頁網址。"""
    if key.isdigit():
        return f"{FB}/profile.php?id={key}"
    return f"{FB}/{key}"


def dedupe_targets(targets: list[dict]) -> list[dict]:
    """同一個人只留第一筆（來源依優先序排，先出現的來源比較有意向）。沒鍵的丟掉。"""
    seen: set[str] = set()
    out: list[dict] = []
    for t in targets:
        key = (t.get("key") or "").strip()
        if not key or key in seen:
            continue
        seen.add(key)
        out.append(t)
    return out


def should_send(pending_count: int | None, limit: int = PENDING_LIMIT) -> bool:
    """未回應邀請超過上限就不送。數不出來（None）視為可送——這是保護機制，不是閘門。"""
    if pending_count is None:
        return True
    return pending_count <= limit


def load_exclude_keys(path: str | None) -> set[str]:
    """讀後端給的「已邀請過」鍵清單（JSON 字串陣列）。

    檔案不在、格式壞掉一律回空集合：這是避免重邀的輔助，不該讓整輪跑不起來。
    """
    if not path:
        return set()
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        print(f"[friend] 排除清單讀取失敗（當作空的）：{str(e)[:120]}", flush=True)
        return set()
    if not isinstance(raw, list):
        print("[friend] 排除清單不是陣列（當作空的）", flush=True)
        return set()
    return {str(k).strip() for k in raw if isinstance(k, (str, int)) and str(k).strip()}


def drop_known(targets: list[dict], known: set[str]) -> tuple[list[dict], int]:
    """把後端已記錄邀請過的人在進頁面之前就剔掉。回 (剩下的, 剔掉幾個)。"""
    if not known:
        return list(targets), 0
    kept = [t for t in targets if (t.get("key") or "") not in known]
    return kept, len(targets) - len(kept)


# 通知面板的文字長這樣：「未讀郭豈辰在一則貼文中標註了你和其他 8 人。1分鐘」。
# 名字欄位出現這些特徵就不是人名，整筆丟掉——寧可少加，也不要對系統頁送邀請。
_NOTIFICATION_HINTS = ("未讀", "說你", "標註了你", "動態回顧", "追蹤你", "個人檔案的",
                       "在一則貼文", "分享的", "的大頭貼照", "邀請你")


def looks_like_notification(name: str) -> bool:
    n = (name or "").strip()
    if not n:
        return False
    if any(h in n for h in _NOTIFICATION_HINTS):
        return True
    # 「…。1分鐘」「…。4小時」這種時間尾巴也是通知才有
    return bool(__import__("re").search(r"。\s*\d+\s*(分鐘|小時|天|週)$", n))


def button_status(label: str) -> str:
    """按鈕文字 → 'existing'（已是好友）／'pending'（已送出）／'add'（可加）／''（不相干）。

    順序有意義：「取消邀請」也含「邀請」，「加朋友」不含「朋友」以外的詞，
    先看已送出、再看已是好友、最後才是可加。
    """
    s = (label or "").strip()
    if not s:
        return ""
    low = s.lower()
    if any(p.lower() in low for p in _PENDING_LABELS):
        return "pending"
    # FB 會把名字塞進中間：「取消對陳泊廷的邀請」——整串比對永遠對不上（2026-09-03 實測）
    if ("取消" in s and "邀請" in s) or ("cancel" in low and "request" in low):
        return "pending"
    if any(p.lower() in low for p in _ADD_LABELS):
        return "add"
    if any(s == p or low == p.lower() for p in _FRIEND_LABELS):
        return "existing"
    return ""


def count_pending_labels(labels: list[str]) -> int:
    """「已送出的邀請」頁上每一筆都有一顆「取消邀請」——數這顆最可靠。"""
    return sum(1 for lab in labels if button_status(lab) == "pending")


def classify_fb_block(page_text: str = "", error_text: str = "") -> str:
    """FB 版的失敗分類：先比 FB 自己的封鎖字樣，再退回 meta_block 的通用規則。"""
    blob = f"{page_text}\n{error_text}".lower()
    if any(p.lower() in blob for p in _FB_BLOCK_PHRASES):
        return ACTION_BLOCKED
    return classify_meta(page_text=page_text, error_text=error_text)


def summarize(targets: list[dict]) -> dict:
    """依 status 計數，給結果 JSON 與紀錄摘要用。"""
    c = {"sent": 0, "skipped_existing": 0, "skipped_pending": 0, "failed": 0, "dry_run": 0}
    for t in targets:
        st = t.get("status", "")
        if st == "sent":
            c["sent"] += 1
        elif st == "existing":
            c["skipped_existing"] += 1
        elif st == "pending":
            c["skipped_pending"] += 1
        elif st == "dry_run":
            c["dry_run"] += 1
        elif st == "failed":
            c["failed"] += 1
    return c


# ---------------------------------------------------------------- 瀏覽器動作

def _body_text(page, limit: int = 4000) -> str:
    with contextlib.suppress(Exception):
        return page.evaluate("()=>document.body.innerText")[:limit]
    return ""


def _blocked_reason(page, fbid: str) -> str:
    """頁面上有封鎖／驗證跡象嗎？回原因字串，沒有回空字串。

    兩層：FB nurture 既有的 perform_checks（封鎖、鎖定、驗證檢查點）＋
    文字比對（FB 封鎖字樣、meta_block 通用規則）。
    """
    from src.utils import CheckResult, perform_checks

    with contextlib.suppress(Exception):
        chk = perform_checks(page, fbid)
        if chk != CheckResult.OK:
            return chk.value
    reason = classify_fb_block(page_text=_body_text(page))
    return reason if reason == ACTION_BLOCKED else ""


def _own_id(page) -> str:
    """自己的數字 id（c_user cookie）——蒐集名單時要把自己排掉。"""
    with contextlib.suppress(Exception):
        for c in page.context.cookies(FB):
            if c.get("name") == "c_user" and c.get("value"):
                return str(c["value"])
    return ""


def _human_browse(page, rounds: tuple[int, int] = (2, 4)) -> None:
    """滑一滑再動作——直接進頁面就按加朋友，時間軸上太乾淨了。"""
    for _ in range(random.randint(*rounds)):
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, random.randint(200, 600))
        human_sleep(0.8, 2.0)


def _maybe_like(page, probability: float = LIKE_PROBABILITY) -> bool:
    """依機率對畫面上一篇貼文按讚。沿用養號的 `_like_post`（會處理表情選單彈出）。"""
    if random.random() > probability:
        return False
    with contextlib.suppress(Exception):
        from src.raiseaccount_www import _like_post
        return bool(_like_post(page))
    return False


def _links_in(page, scope_selector: str) -> list[dict]:
    """收 scope 裡所有有文字的連結 → [{href, text}]。"""
    js = """(sel) => {
        const root = document.querySelector(sel) || document.body;
        const out = [];
        for (const a of root.querySelectorAll('a[href]')) {
            const t = (a.innerText || a.getAttribute('aria-label') || '').trim();
            if (!t) continue;
            out.push({href: a.href, text: t.split(String.fromCharCode(10))[0].slice(0, 80)});
        }
        return out;
    }"""
    with contextlib.suppress(Exception):
        return page.evaluate(js, scope_selector) or []
    return []


def _to_targets(links: list[dict], source: str, exclude: set[str]) -> list[dict]:
    out = []
    for l in links:
        key = target_key_from_url(l.get("href", ""))
        if not key or key in exclude:
            continue
        name = l.get("text", "")
        if not looks_like_person(name) or looks_like_notification(name):
            continue
        out.append({"key": key, "name": name, "source": source,
                    "url": profile_url_for_key(key)})
    return dedupe_targets(out)


def _self_keys(page, fbid: str) -> set[str]:
    """自己的所有寫法：數字 id ＋ 代稱。2026-09-03 實測：候選名單裡出現老闆本人
    （/chunhao.tsai1），因為排除清單只放了數字 id。"""
    keys = {str(fbid), _own_id(page)}
    with contextlib.suppress(Exception):
        u = page.url or ""
        seg = [x for x in u.split("?")[0].split("/") if x]
        if seg and seg[-1] not in _NOT_PROFILE and "." not in seg[-1][:4]:
            keys.add(seg[-1])
    with contextlib.suppress(Exception):
        page.goto(f"{FB}/me", wait_until="domcontentloaded", timeout=30000)
        human_sleep(2.0, 3.5)
        seg = [x for x in (page.url or "").split("?")[0].split("/") if x]
        if seg and seg[-1] not in _NOT_PROFILE:
            keys.add(seg[-1])
    return {k for k in keys if k}


def _collect_own_posts(page, fbid: str, want: int) -> list[dict]:
    """來源 1：在自己最近幾篇貼文下按讚／留言的人。

    2026-09-02 mini 實測校正過的選擇器：
      - 留言者：留言裡的名字連結會帶 `?comment_id=…`，這是最乾淨的辨識方式
        （整頁抓連結會撈到自己的粉專、學校、主控板那些東西）。
      - 按讚者：貼文下方的心情總數 aria-label 是「N 個心情；查看誰對此傳達了心情」，
        點下去才開出名單對話框。
    """
    exclude = _self_keys(page, fbid)
    found: list[dict] = []
    # /me 會被通知面板蓋住，直接進 profile.php 比較穩
    page.goto(f"{FB}/profile.php?id={fbid}", wait_until="domcontentloaded", timeout=45000)
    human_sleep(7.0, 10.0)
    for _ in range(3):
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 1500)
        human_sleep(1.5, 2.5)

    # 2026-09-03 實測：整頁抓 comment_id 連結會把**通知面板**一起抓進來——
    # 撈到的「人」是「未讀郭豈辰在一則貼文中標註了你…」「你今天有動態回顧值得看看」，
    # 連自己（chunhao.tsai1）和系統頁（onthisday）都成了候選。限定在 main 裡面找。
    js_comments = """() => {
        const root = document.querySelector("div[role='main']") || document.querySelector("main") || document.body;
        return [...root.querySelectorAll("a[href*='comment_id']")]
            .map(a => ({href: a.href, text: (a.innerText || '').trim().split(String.fromCharCode(10))[0].slice(0, 80)}))
            .filter(x => x.text);
    }"""
    try:
        raw_c = page.evaluate(js_comments) or []
    except Exception as e:
        raw_c = []
        print(f"[friend] 留言者解析失敗：{str(e)[:200]}", flush=True)
    print(f"[friend] 留言者連結 {len(raw_c)} 條", flush=True)
    found += _to_targets(raw_c, SOURCE_OWN_POSTS, exclude)

    reacts = page.locator("[aria-label*='查看誰對此傳達了心情'], [aria-label*='See who reacted']")
    n = min(reacts.count(), 3)
    for i in range(n):
        if len(found) >= want * 3:
            break
        with contextlib.suppress(Exception):
            reacts.nth(i).scroll_into_view_if_needed(timeout=3000)
            human_sleep(0.5, 1.2)
            reacts.nth(i).click(timeout=5000)
            human_sleep(2.0, 3.5)
            found += _to_targets(_links_in(page, "div[role='dialog']"), SOURCE_OWN_POSTS, exclude)
            page.keyboard.press("Escape")
            human_sleep(0.8, 1.5)
    return dedupe_targets(found)


def _collect_pymk(page, fbid: str, want: int) -> list[dict]:
    """來源 2：FB 自己推薦的「你可能認識的朋友」。

    2026-09-02 mini 實測：這頁的名字不是連結，`div[role='main']` 裡一個 a 都沒有——
    每一筆是一張卡片（頭像＋名字＋共同朋友＋「加朋友」鈕），個人頁連結藏在卡片裡。
    所以從「加朋友」按鈕往上找卡片，再從卡片取連結與名字。
    """
    exclude = {_own_id(page), fbid}
    page.goto(URL_PYMK, wait_until="domcontentloaded", timeout=45000)
    # 這頁的卡片是延遲載入的：等太短就是一片空白（實測 5 秒不夠、9 秒才有）
    human_sleep(7.0, 10.0)
    for _ in range(3):
        with contextlib.suppress(Exception):
            page.mouse.wheel(0, 1200)
        human_sleep(1.5, 2.5)
    js = """() => {
        const btns = [...document.querySelectorAll("div[role='button'],button")]
            .filter(e => /加朋友|Add friend/i.test(e.innerText || ''));
        const out = [];
        for (const b of btns) {
            let card = b;
            for (let i = 0; i < 8 && card.parentElement; i++) {
