# ─── 首頁狀態（每日預算 + 全域暫停） ────────────────────

@router.get("/status")
async def marketplace_status(session: AsyncSession = Depends(get_session)):
    from ..database import ramp_state_sync
    lu, pu = get_daily_budget_sync()
    ramp = ramp_state_sync()
    lm, pm = ramp["listings_max"], ramp["posts_max"]
    st = get_system_state_sync()
    schedules = (await session.execute(select(MarketplaceSchedule))).scalars().all()
    return {
        "budget": {"listings_used": lu, "listings_max": lm,
                   "posts_used": pu, "posts_max": pm},
        "ramp": ramp,
        "paused": st["paused"], "pause_reason": st["pause_reason"], "pause_detail": st["pause_detail"],
        "schedules_running": sum(1 for s in schedules if s.status == "running"),
        "schedules_total": len(schedules),
        "problem_properties": problem_property_count_sync(),
    }


@router.post("/stop-all")
async def stop_all(session: AsyncSession = Depends(get_session)):
    """緊急停止：暫停整個系統 + 移除所有 marketplace 排程 + 中止進行中的發送。"""
    set_system_pause_sync(True, "manual", "使用者手動緊急停止")
    from ..scheduler.marketplace_runner import _pause_all_marketplace
    from ..fbauto_bridge import _RUNNING, kill_job
    _pause_all_marketplace()
    for key in list(_RUNNING.keys()):
        kill_job(key)
    # 排程狀態設回 stopped
    rows = (await session.execute(select(MarketplaceSchedule))).scalars().all()
    for s in rows:
        if s.status == "running":
            s.status = "stopped"
    await session.commit()
    return {"message": "已緊急停止全部"}


@router.post("/resume")
async def resume_system(session: AsyncSession = Depends(get_session)):
    """使用者處理完 cookie/保護問題後，解除全域暫停並重排 running 排程。"""
    set_system_pause_sync(False)
    from ..scheduler.marketplace_runner import plan_and_schedule
    rows = (await session.execute(select(MarketplaceSchedule).where(MarketplaceSchedule.status == "running"))).scalars().all()
    for s in rows:
        plan_and_schedule(s)
    return {"message": "已恢復"}
