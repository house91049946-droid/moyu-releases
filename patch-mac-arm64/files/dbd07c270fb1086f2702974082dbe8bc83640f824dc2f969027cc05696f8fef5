# ─── AI 文案生成（建立/編輯時呼叫，不落庫；前端可改後再存） ──

class GenerateReq(BaseModel):
    base_content: str
    n_versions: int = 5


@router.post("/generate-copy")
async def generate_copy(req: GenerateReq):
    """依基底文案生成 N 個變體版本（各含 title/body，數字/事實鎖定）。"""
    import asyncio
    from ..deepseek_client import generate_from_base, has_key, DeepSeekError
    from ..cloud_client import cloud_enabled
    if not (cloud_enabled() or has_key()):
        raise HTTPException(status_code=422, detail="尚未設定雲端授權或 DeepSeek 金鑰")
    try:
        versions = await asyncio.to_thread(generate_from_base, req.base_content, req.n_versions)
        return {"versions": versions}
    except DeepSeekError as e:
        raise HTTPException(status_code=422, detail=str(e))


