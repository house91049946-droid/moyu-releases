@router.post("/schedules/{sch_id}/cleanup")
async def cleanup_schedule(sch_id: int, dry_run: bool = True, days: int | None = None,
                           session: AsyncSession = Depends(get_session)):
    """立即執行過期刊登清理（P17）。預設 dry_run=True 只掃描列出候選、不實刪。
    days 可覆寫天數門檻：傳 0 = 不看天數、視所有現有刊登為候選（供「建立→立即刪除」測試）。
    第一次務必用 dry_run 確認候選與刪除連帶下架行為，再真刪。"""
    s = (await session.execute(select(MarketplaceSchedule).where(MarketplaceSchedule.id == sch_id))).scalar_one_or_none()
    if not s:
        raise HTTPException(status_code=404, detail="排程不存在")
    effective_days = s.auto_delete_days if days is None else days
    if days is None and (s.auto_delete_days or 0) <= 0:
        raise HTTPException(status_code=422, detail="此排程未開啟自動刪除（auto_delete_days=0）；測試可傳 days 覆寫")
    if effective_days is None or effective_days < 0:
        raise HTTPException(status_code=422, detail="days 需 >= 0")
    import asyncio
    from ..scheduler.marketplace_runner import run_marketplace_cleanup_job
    asyncio.create_task(run_marketplace_cleanup_job(sch_id, force=True, dry_run_override=dry_run,
                                                    days_override=effective_days))
    mode = "掃描（dry-run）" if dry_run else "實際刪除"
    scope = "全部現有刊登（不看天數）" if effective_days == 0 else f"門檻 {effective_days} 天"
    return {"message": f"已觸發過期清理｜{mode}｜{scope}；結果請看執行紀錄"}


class CleanupListingsReq(BaseModel):
    account_id: int
    days: int = 7          # 0 = 不看天數、刪全部現有刊登
    dry_run: bool = True
    headless: bool = True


@router.post("/cleanup-listings")
async def cleanup_listings(data: CleanupListingsReq, session: AsyncSession = Depends(get_session)):
    """獨立的 Marketplace 刊登清理（以帳號為單位，不需發文排程；供系統維護頁使用）。
    回傳 job_id 供輪詢；dry_run=True 只掃描列出候選，days=0 = 不看天數刪全部。"""
    acc = (await session.execute(select(Account).where(Account.id == data.account_id))).scalar_one_or_none()
    if not acc:
        raise HTTPException(status_code=404, detail="帳號不存在")
    if not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="此帳號尚未綁定 FB ID")
    if data.days < 0:
        raise HTTPException(status_code=422, detail="days 需 >= 0")
    from ..fbauto_bridge import start_long_op, cookie_exists
    if not cookie_exists(acc.fb_user_id):
        raise HTTPException(status_code=422, detail=f"cookie 不存在: {acc.fb_user_id}，請先用 CLI 登入")
    args = ["--fbid", acc.fb_user_id, "--max-age-days", str(data.days)]
    if data.dry_run:
        args.append("--dry-run")
    if data.headless:
        args.append("--headless")
    job_id = start_long_op("mp_cleanup", "src.run_delete_marketplace", args,
                           account_id=acc.id, fbid=acc.fb_user_id)
    return {"job_id": job_id, "state": "pending"}


@router.get("/calendar")
async def marketplace_calendar(year: Optional[int] = None, month: Optional[int] = None,
                               session: AsyncSession = Depends(get_session)):
    """月成功率行事曆：以台北日期彙總該月 Marketplace 發文成功/失敗數，供方塊行事曆用。"""
    import datetime as _dt
    import calendar as _cal
    from ..database import RunLog, TAIPEI

    now = _dt.datetime.now(TAIPEI)
    y = year or now.year
    m = month or now.month
    # created_at 存 UTC；台北 = UTC+8。查詢範圍抓寬一天避免邊界漏。
    start_utc = _dt.datetime(y, m, 1) - _dt.timedelta(hours=8, days=1)
    last_day = _cal.monthrange(y, m)[1]
    end_utc = _dt.datetime(y, m, last_day, 23, 59, 59) - _dt.timedelta(hours=8) + _dt.timedelta(days=1)

    rows = (await session.execute(
        select(RunLog).where(
            RunLog.task_type == "marketplace",
            RunLog.created_at >= start_utc,
            RunLog.created_at <= end_utc,
        )
    )).scalars().all()

    days: dict[str, dict] = {}
    tot_s = tot_f = 0
    for r in rows:
        taipei_dt = (r.created_at or now.replace(tzinfo=None)) + _dt.timedelta(hours=8)
        if taipei_dt.year != y or taipei_dt.month != m:
            continue
        key = taipei_dt.date().isoformat()
        d = days.setdefault(key, {"success": 0, "failed": 0})
        if r.status == "success":
            d["success"] += 1; tot_s += 1
        elif r.status in ("failed", "needs_manual"):
            d["failed"] += 1; tot_f += 1
    total = tot_s + tot_f

    # 月總則（含刊登+轉發）與月刊登件數：從每日額度彙總（date 為台北 YYYY-MM-DD）
    from ..database import DailyBudget
    prefix = f"{y}-{m:02d}"
    bud_rows = (await session.execute(
        select(DailyBudget).where(DailyBudget.date.like(f"{prefix}%"))
    )).scalars().all()
    month_posts = sum(b.posts_used or 0 for b in bud_rows)
    month_listings = sum(b.listings_used or 0 for b in bud_rows)

    return {
        "year": y, "month": m, "days_in_month": last_day,
        "first_weekday": _dt.date(y, m, 1).weekday(),   # 0=週一
        "summary": {"success": tot_s, "failed": tot_f, "total": total,
                    "success_rate": round(tot_s / total, 3) if total else None,
                    "posts": month_posts, "listings": month_listings},
        "days": days,
    }


