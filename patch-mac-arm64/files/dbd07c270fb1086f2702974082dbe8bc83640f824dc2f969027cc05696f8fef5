    await session.commit()
    return {"message": "已儲存法定欄位"}


# ─── Marketplace 類別清單（快取 + 從 FB 偵測） ──────────

_CATEGORY_FALLBACK = ["其他商品", "家庭用品", "傢俱", "電子產品", "服飾", "運動用品", "玩具與遊戲"]


@router.get("/categories")
async def get_categories():
    """回傳快取的 FB 類別清單（無快取則回退用建議清單）。"""
    import json
    from ..fbauto_bridge import FB_AUTO_DATA_DIR
    p = FB_AUTO_DATA_DIR / "mp_categories.json"
    try:
        with open(p, encoding="utf-8") as f:
            cats = json.load(f)
        if isinstance(cats, list) and cats:
            return {"categories": cats, "cached": True}
    except (OSError, ValueError):
        pass
    return {"categories": _CATEGORY_FALLBACK, "cached": False}


@router.post("/detect-categories")
async def detect_categories(account_id: int, session: AsyncSession = Depends(get_session)):
    """開瀏覽器（headless）抓 FB 建立商品頁的完整類別清單並快取。回 job_id 供輪詢。"""
    acc = (await session.execute(select(Account).where(Account.id == account_id))).scalar_one_or_none()
    if not acc or not acc.fb_user_id:
        raise HTTPException(status_code=422, detail="帳號不存在或尚未綁定 FB ID")
    from ..fbauto_bridge import start_long_op, cookie_exists
    if not cookie_exists(acc.fb_user_id):
        raise HTTPException(status_code=422, detail="cookie 已失效，請重新登入")
    job_id = start_long_op("categories", "src.run_list_categories",
                           ["--fbid", acc.fb_user_id, "--headless"],
                           account_id=account_id, fbid=acc.fb_user_id)
    return {"job_id": job_id, "state": "pending"}


