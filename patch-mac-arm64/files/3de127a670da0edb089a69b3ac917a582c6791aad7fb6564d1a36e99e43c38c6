  <script>
    window.__moyu = {
      started: Date.now(),
      phase: '準備中…',
      groups: 0,
      stop: false,
      done: false
    };

    var groupsEl = document.getElementById('groups');
    var displayCount = 0;
    var animating = false;
    var pendingTarget = null;

    function tierClass(n) {
      groupsEl.classList.remove('big', 'huge');
      if (n >= 300) groupsEl.classList.add('huge');
      else if (n >= 80) groupsEl.classList.add('big');
      var glow = Math.min(90, 12 + n * 0.09);
      groupsEl.style.setProperty('--glow', glow + 'px');
    }

    function runCountAnim(to) {
      tierClass(to);
      var delta = Math.abs(to - displayCount);
      // 差距越大越慢，讓使用者感受到「持續增加」而不是一次跳完
      var duration = Math.min(9, Math.max(1.4, delta * 0.055));
      animating = true;
      if (window.gsap) {
        var obj = { v: displayCount };
        gsap.to(obj, {
          v: to, duration: duration, ease: 'none',
          onUpdate: function () {
            displayCount = Math.round(obj.v);
            groupsEl.textContent = String(displayCount);
            tierClass(displayCount);
          },
          onComplete: function () {
            displayCount = to;
            groupsEl.textContent = String(to);
            animating = false;
            if (pendingTarget !== null && pendingTarget !== to) {
              var next = pendingTarget;
              pendingTarget = null;
              runCountAnim(next);
            } else {
              pendingTarget = null;
            }
          }
        });
      } else {
        displayCount = to;
        groupsEl.textContent = String(to);
        animating = false;
      }
    }

    function animateCount(to) {
      if (to <= displayCount && !animating) {
        displayCount = to;
        groupsEl.textContent = String(to);
        tierClass(to);
        return;
      }
      if (animating) {
        pendingTarget = to;
        return;
      }
      runCountAnim(to);
    }

    function swimLogo() {
      if (!window.gsap) return;
      var logo = document.getElementById('logo');
      gsap.timeline()
        .to(logo, { x: 18, rotation: 8, duration: 0.55, ease: 'sine.inOut' })
        .to(logo, { x: -10, rotation: -6, duration: 0.55, ease: 'sine.inOut' })
        .to(logo, { x: 0, rotation: 0, duration: 0.5, ease: 'sine.inOut' });
    }

    // ── 科技感背景：代碼雨 + 大型漂浮字／魚 ──
    (function setupBg() {
      var canvas = document.getElementById('matrix');
      var ctx = canvas.getContext('2d');
      var cols = [], fontSize = 14;
      var chars = '01{}[]<>/;moyu魚社團排程async await def class return true false null ERROR WARN OK';

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        var n = Math.floor(canvas.width / fontSize);
        cols = [];
        for (var i = 0; i < n; i++) cols.push(Math.random() * canvas.height / fontSize);
      }
      resize();
      window.addEventListener('resize', resize);

      function draw() {
        ctx.fillStyle = 'rgba(2,6,23,0.12)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.font = fontSize + 'px monospace';
        for (var i = 0; i < cols.length; i++) {
          var ch = chars[Math.floor(Math.random() * chars.length)];
          var red = Math.random() < 0.08;
          ctx.fillStyle = red ? 'rgba(248,113,113,0.55)' : 'rgba(56,189,248,0.35)';
          ctx.fillText(ch, i * fontSize, cols[i] * fontSize);
          if (cols[i] * fontSize > canvas.height && Math.random() > 0.975) cols[i] = 0;
          cols[i]++;
        }
        requestAnimationFrame(draw);
      }
      draw();

      var snippets = [
        'queue.push(group)', 'await human_sleep(1,2)', 'fbid=' + Math.floor(Math.random()*1e9),
        'status: scraping', 'SELECT * FROM clubs', 'retry_count++', 'warmup_browse()',
        'ERROR: rate_limit', 'WARN: slow_scroll', 'collect_so_far()', 'mp.can_post=true',
        'cookie.ok', 'groups.length++', '~~ 摸魚 ~~', 'async def run_getclub'
      ];
      var fishGlyph = '><(((º>';

      function spawnFloater() {
        if (window.__moyu.done) return;
        var el = document.createElement('div');
        el.className = 'floater';
        var kind = Math.random();
        var text;
        if (kind < 0.18) {
          el.classList.add('fish');
          text = fishGlyph;
          el.style.fontSize = (28 + Math.random() * 48) + 'px';
        } else {
          text = snippets[Math.floor(Math.random() * snippets.length)];
          el.style.fontSize = (12 + Math.random() * 42) + 'px';
          if (Math.random() < 0.22 || /ERROR|WARN/.test(text)) el.classList.add('red');
        }
        el.textContent = text;
        document.body.appendChild(el);

        var w = window.innerWidth, h = window.innerHeight;
        var horizontal = Math.random() < 0.55;
        var from, to;
        if (horizontal) {
          var y = 40 + Math.random() * (h - 80);
          from = { x: Math.random() < 0.5 ? -200 : w + 40, y: y };
          to = { x: from.x < 0 ? w + 80 : -240, y: y + (Math.random() - 0.5) * 80 };
        } else {
          var x = 40 + Math.random() * (w - 80);
          from = { x: x, y: Math.random() < 0.5 ? -80 : h + 40 };
          to = { x: x + (Math.random() - 0.5) * 100, y: from.y < 0 ? h + 80 : -100 };
        }
        el.style.left = '0px';
        el.style.top = '0px';
        var dur = 8 + Math.random() * 14;
        if (window.gsap) {
          gsap.fromTo(el,
            { x: from.x, y: from.y, opacity: 0 },
            {
              x: to.x, y: to.y, opacity: 0.3, duration: dur, ease: 'none',
              onComplete: function () { el.remove(); }
            }
          );
        } else {
          setTimeout(function () { el.remove(); }, dur * 1000);
        }
      }
      for (var i = 0; i < 6; i++) setTimeout(spawnFloater, i * 400);
      setInterval(spawnFloater, 1800);
    })();

    setInterval(function () {
      if (window.__moyu.done) return;
      var s = Math.floor((Date.now() - window.__moyu.started) / 1000);
      document.getElementById('elapsed').textContent = String(s);
      document.getElementById('phase').textContent = window.__moyu.phase;
    }, 400);

    setInterval(function () {
      if (!window.__moyu.done) swimLogo();
    }, 7000);
    setTimeout(swimLogo, 600);

    document.getElementById('stopBtn').addEventListener('click', function () {
      window.__moyu.stop = true;
      window.__moyu.phase = '正在結束並保存目前社團…';
      this.disabled = true;
      this.textContent = '結束中…';
    });

    window.__moyuUpdate = function (phase, groups) {
      if (phase) window.__moyu.phase = phase;
      if (typeof groups === 'number' && groups !== window.__moyu.groups) {
        window.__moyu.groups = groups;
        animateCount(groups);
      }
    };

    window.__moyuShouldStop = function () { return !!window.__moyu.stop; };

    window.__moyuCelebrate = function (groups) {
      return new Promise(function (resolve) {
        window.__moyu.done = true;
        window.__moyu.groups = groups || window.__moyu.groups;
        document.getElementById('runPanel').classList.add('hide');
        document.getElementById('donePanel').classList.add('show');
        document.getElementById('doneCount').textContent = String(window.__moyu.groups);
        document.getElementById('doneSub').textContent =
          window.__moyu.stop ? '已依你的指示，保存目前收集到的社團' : '社團已匯入完成';
        document.title = '摸魚 — 恭喜完成';

        if (window.gsap) {
          gsap.from('#congrats', { scale: 0.6, opacity: 0, duration: 0.55, ease: 'back.out(1.8)' });
          gsap.from('#countdown', { scale: 0.4, opacity: 0, duration: 0.7, ease: 'back.out(1.4)' });
          swimLogo();
          var burst = document.getElementById('burst');
          for (var i = 0; i < 22; i++) {
            var d = document.createElement('div');
            d.style.cssText = 'position:absolute;width:8px;height:8px;border-radius:50%;background:#38bdf8;left:50%;top:30%;opacity:0';
            burst.appendChild(d);
            gsap.to(d, {
              x: (Math.random() - 0.5) * 400,
              y: (Math.random() - 0.5) * 300,
              opacity: 1, duration: 0.8, ease: 'power2.out',
              delay: Math.random() * 0.2
            });
            gsap.to(d, { opacity: 0, duration: 0.6, delay: 0.7 + Math.random() * 0.3 });
          }
        }

        var left = 10;
        var el = document.getElementById('countdown');
        el.textContent = String(left);
        var t = setInterval(function () {
          left -= 1;
          el.textContent = String(Math.max(0, left));
          if (window.gsap) {
            gsap.fromTo(el, { scale: 1.12 }, { scale: 1, duration: 0.35, ease: 'power2.out' });
          }
          if (left <= 0) { clearInterval(t); resolve(true); }
        }, 1000);
      });
    };
  </script>
</body>
</html>
"""


def main():
    global _JSON_PATH, _RESULT

    parser = argparse.ArgumentParser(description="FB Auto — 純登入 + 抓社團（取得 fbid、cookie、社團清單）")
    parser.add_argument("--email", required=True, help="FB 登入 email")
    parser.add_argument("--password", required=True, help="FB 密碼")
    parser.add_argument("--headless", action="store_true")
    parser.add_argument("--result-json", help="結果 JSON 輸出路徑")
    args = parser.parse_args()

    _JSON_PATH = args.result_json
    _RESULT = {
        "schema": 2,
        "success": False,
        "fbid": "",
        "error": "未完成",
        "data": {"groups": [], "mp_group_ids": []},
    }
    if _JSON_PATH:
        atexit.register(_write_result_json)

    browser = context = page = None
    progress_page = None
    try:
        from src.paths import USER_DATA_DIR
        old_profile = USER_DATA_DIR / "temp"
        if old_profile.exists():
            import shutil
            try:
                shutil.rmtree(str(old_profile))
                print(f"[run_login] 已清除舊的 temp profile")
            except Exception:
                pass

        browser, context, page = launch_browser(fbid="temp", headless=args.headless)

        from src.login import login_facebook, _get_fbid_from_cookies, _click_continue_if_present, _save_cookies_to_file

        result = login_facebook(page, context, args.email, args.password)
        print(f"登入結果: {result.status}")

        need_manual_statuses = {"need_human", "locked", "captcha"}
        if result.status not in need_manual_statuses:
            # 驗證頁上連點「繼續/儲存」會干擾使用者手動驗證 → 僅在非人工狀態時點掉確認頁
            _click_continue_if_present(page)
        final_fbid = ""

        if result.fbid:
            final_fbid = result.fbid
            print(f"✓ 登入成功，fbid={final_fbid}")
        elif result.status in need_manual_statuses:
            capture_screenshot(page, "temp", f"login_{result.status}")
            print(f"\n{'═' * 55}")
            print(f"⚠  FB 要求驗證：{result.status} — {result.message}")
            print(f"   瀏覽器視窗保持開啟，請手動完成驗證")
            print(f"   系統會自動偵測驗證完成（最長等待 {_MANUAL_VERIFY_TIMEOUT} 秒）")
            print(f"{'═' * 55}")

            final_fbid = _wait_for_cookie(context, page, _MANUAL_VERIFY_TIMEOUT) or ""
            if final_fbid:
                print(f"✓ 驗證完成，fbid={final_fbid}")
            else:
                _RESULT["error"] = f"驗證等待逾時（{_MANUAL_VERIFY_TIMEOUT}s），請重試"
                print(f"❌ {_RESULT['error']}")
                sys.exit(1)
        else:
            final_fbid = _get_fbid_from_cookies(context) or ""
            if not final_fbid:
                print(f"[run_login] 尚未偵測到登入 cookie，等待手動登入（最長 {_MANUAL_VERIFY_TIMEOUT}s）...")
                final_fbid = _wait_for_cookie(context, page, _MANUAL_VERIFY_TIMEOUT) or ""
            if final_fbid:
                print(f"[run_login] 從 cookie 取得 fbid={final_fbid}")
            else:
                _RESULT["error"] = f"登入失敗: {result.status} — {result.message}"
                print(f"❌ {_RESULT['error']}")
                sys.exit(1)

        # 手動驗證/後備路徑不經過 login_facebook 的存檔 → 這裡統一存一次
        # （login profile 用完即棄的 temp，後續操作全靠 data/cookies/<fbid>.json）
        _save_cookies_to_file(context, final_fbid)

        _RESULT["success"] = True
        _RESULT["fbid"] = final_fbid
        _RESULT["error"] = ""

        # 登入完成 → 進度分頁；FB 分頁背景繼續做事
        progress_page = _open_progress_tab(context)
        _update_progress(progress_page, "暖身瀏覽中（約 30 秒～2 分鐘）…", 0)

        # 進社團頁前：首頁隨意滑動暖身（30s–2min）
        print("\n[run_login] 暖身瀏覽首頁…")
        try:
            warm_up_browse(page, min_sec=30, max_sec=120)
        except Exception as e:
            print(f"[run_login] 暖身略過: {e}")
        if progress_page:
            try:
                progress_page.bring_to_front()
            except Exception:
                pass

        _update_progress(progress_page, "開始匯入社團…", 0)
        print(f"\n[run_login] 開始抓取社團清單...")
        try:
            import re as _re
            from src.getclub import run_getclub

            def _on_groups(n: int):
                _update_progress(progress_page, f"匯入社團中（已找到 {n} 個）…", n)
                if progress_page:
                    try:
                        progress_page.bring_to_front()
                    except Exception:
                        pass

            def _should_stop() -> bool:
                return _progress_should_stop(progress_page)

            groups = run_getclub(
                page, final_fbid, on_progress=_on_groups, should_stop=_should_stop
            )
            group_list = []
            for name, url in groups.items():
                m = _re.search(r"/groups/(\d+)/?", url)
                group_list.append({
                    "name": name,
                    "url": url,
                    "group_id": m.group(1) if m else "",
                    "can_marketplace": None,
                })
            _RESULT["data"]["groups"] = group_list
            print(f"  ✓ 抓到 {len(groups)} 個社團")
            _celebrate_and_wait(progress_page, len(groups))
        except Exception as e:
            print(f"  ⚠ 社團抓取失敗: {e}（登入仍算成功）")
            _update_progress(progress_page, f"社團匯入遇到問題（登入仍成功）：{e}", 0)
            time.sleep(2)

    except KeyboardInterrupt:
        _RESULT["error"] = "使用者中斷"
        sys.exit(0)
    except Exception as e:
        _RESULT["error"] = str(e)
        if page:
            capture_screenshot(page, "temp", "login_error")
        sys.exit(1)
    finally:
        if context:
            context.close()


def _open_progress_tab(context):
    """以 file:// 載入進度頁（含真實 favicon.svg），Chrome 分頁 icon 才會顯示。"""
    try:
        tmp = Path(tempfile.mkdtemp(prefix="moyu_progress_"))
        fav = tmp / "favicon.svg"
        fav.write_text(_FISH_SVG_FILE, encoding="utf-8")
        html = _PROGRESS_HTML.replace("__FAVICON__", fav.as_uri())
        index = tmp / "index.html"
        index.write_text(html, encoding="utf-8")
        progress = context.new_page()
        progress.goto(index.as_uri(), wait_until="domcontentloaded")
        progress.bring_to_front()
        return progress
    except Exception as e:
        print(f"[run_login] 無法開啟進度分頁: {e}")
        return None


def _update_progress(progress_page, phase: str, groups: int) -> None:
    if not progress_page:
        return
    try:
        progress_page.evaluate(
            "(args) => window.__moyuUpdate && window.__moyuUpdate(args.phase, args.groups)",
            {"phase": phase, "groups": groups},
        )
    except Exception:
        pass


def _progress_should_stop(progress_page) -> bool:
    if not progress_page:
        return False
    try:
        return bool(progress_page.evaluate("() => !!(window.__moyuShouldStop && window.__moyuShouldStop())"))
    except Exception:
        return False


def _celebrate_and_wait(progress_page, groups: int) -> None:
    """恭喜完成動畫 + 倒數 10 秒後返回（由 finally 關瀏覽器）。"""
    if not progress_page:
        time.sleep(1.5)
        return
    try:
        progress_page.bring_to_front()
        progress_page.evaluate(
            """async (n) => {
              if (window.__moyuCelebrate) { await window.__moyuCelebrate(n); }
              else { await new Promise(r => setTimeout(r, 10000)); }
            }""",
            groups,
        )
    except Exception as e:
        print(f"[run_login] 完成動畫略過: {e}")
        time.sleep(3)


def _wait_for_cookie(context, page, timeout_sec: int) -> str | None:
    from src.login import _get_fbid_from_cookies

    start = time.time()
    while time.time() - start < timeout_sec:
        fbid = _get_fbid_from_cookies(context)
        if fbid:
            return fbid

        elapsed = int(time.time() - start)
        if elapsed % 30 == 0 or elapsed <= 5:
            print(f"[等待驗證] 已等待 {elapsed}s / {timeout_sec}s...")

        # 客戶這時正在手動輸入驗證碼／處理 FB 的關卡，畫面順不順比早半秒偵測到
        # 登入完成重要得多。所以：關閉偵測改用 is_closed()（本地狀態，不打瀏覽器），
        # 讀 cookie 的間隔拉到 2 秒——原本每秒讀一次 cookie 又執行一次 JS，
        # 等於每秒插隊兩次（客戶回報「登入時瀏覽超級 LAG」的另一半原因）。
        if page.is_closed() or not context.pages:
            print("[等待驗證] 瀏覽器已關閉")
            return None

        time.sleep(2)

    return None


